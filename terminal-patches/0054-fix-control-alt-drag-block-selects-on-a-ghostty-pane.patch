 .../TerminalControl/GhosttyControlCore.h      | 14 ++++-
 .../TerminalControl/GhosttySelectionMods.h    | 57 +++++++++++++++++++
 .../TerminalControlLib.vcxproj                |  1 +
 .../Control.UnitTests.vcxproj                 |  1 +
 .../GhosttySelectionModsTests.cpp             | 54 ++++++++++++++++++
 6 files changed, 159 insertions(+), 5 deletions(-)
