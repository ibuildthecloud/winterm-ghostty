diff --git a/src/cascadia/UnitTests_Control/GhosttySelectionModsTests.cpp b/src/cascadia/UnitTests_Control/GhosttySelectionModsTests.cpp
new file mode 100644
index 000000000..30502c147
--- /dev/null
+++ b/src/cascadia/UnitTests_Control/GhosttySelectionModsTests.cpp
@@ -0,0 +1,54 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Alt+drag block-selects on a cascadia pane. It did nothing on a ghostty one,
+// because the two engines ask for the modifier differently: cascadia is told
+// `SetBlockSelection(alt)` once at the click, and ghostty re-reads the mouse
+// modifiers on every event and wants ctrl+alt for a rectangle on any platform
+// that is not macOS.
+//
+// This pins the translation. The rest of the drag needs a live surface, so
+// this is the part a unit test can reach.
+
+#include "pch.h"
+#include "../TerminalControl/GhosttySelectionMods.h"
+
+using namespace WEX::Logging;
+using namespace WEX::TestExecution;
+using namespace WEX::Common;
+
+using namespace winrt::Microsoft::Terminal::Control::implementation;
+
+namespace ControlUnitTests
+{
+    class GhosttySelectionModsTests
+    {
+        BEGIN_TEST_CLASS(GhosttySelectionModsTests)
+            TEST_CLASS_PROPERTY(L"TestTimeout", L"0:0:10")
+        END_TEST_CLASS()
+
+        TEST_METHOD(AnOrdinaryDragCarriesNoModifiers);
+        TEST_METHOD(ABlockSelectionCarriesCtrlAndAlt);
+    };
+
+    // Not "whatever the user is holding": a plain drag has to look plain to the
+    // engine. Shift especially - to ghostty that is the mouse-reporting
+    // override, and WT has already decided what a shift+drag means by the time
+    // it calls the selection path at all.
+    void GhosttySelectionModsTests::AnOrdinaryDragCarriesNoModifiers()
+    {
+        VERIFY_ARE_EQUAL(GHOSTTY_MODS_NONE, GhosttySelectionMods(false));
+    }
+
+    // Ctrl is the part that is easy to "clean up" and must not be: ghostty's
+    // SurfaceMouse.isRectangleSelectState is `mods.ctrlOrSuper() and mods.alt`
+    // off macOS, so alt on its own produces an ordinary linear selection - the
+    // bug this pins.
+    void GhosttySelectionModsTests::ABlockSelectionCarriesCtrlAndAlt()
+    {
+        const auto mods = GhosttySelectionMods(true);
+        VERIFY_IS_TRUE((mods & GHOSTTY_MODS_ALT) != 0, L"alt, as WT's own gesture");
+        VERIFY_IS_TRUE((mods & GHOSTTY_MODS_CTRL) != 0, L"and ctrl, as the engine's predicate");
+        VERIFY_IS_TRUE((mods & GHOSTTY_MODS_SHIFT) == 0, L"never shift - that is the VT-mouse override");
+    }
+}
