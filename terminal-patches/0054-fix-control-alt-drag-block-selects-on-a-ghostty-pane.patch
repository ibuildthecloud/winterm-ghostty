diff --git a/src/cascadia/TerminalControl/GhosttyControlCore.cpp b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
index dc111942e..0c2812fb7 100644
--- a/src/cascadia/TerminalControl/GhosttyControlCore.cpp
+++ b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
@@ -6,6 +6,7 @@
 #include "GhosttySettingsTranslator.h"
 #include "GhosttyKeyTranslator.h"
 #include "GhosttyCopyFormat.h"
+#include "GhosttySelectionMods.h"
 
 #include "GhosttyControlCore.g.cpp"
 
@@ -1213,6 +1214,16 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         ghostty_surface_mouse_pos(_surface, x, y, mods);
     }
 
+    // Every mouse event of a selection carries these, because the engine reads
+    // block-vs-linear off the modifiers of each event rather than latching a
+    // mode at the press. GhosttySelectionMods.h has the engine's rule; what is
+    // decided here is only *when* WT considers a drag to be a block one, which
+    // is the alt state at the click, held for the drag.
+    ghostty_input_mods_e GhosttyControlCore::_selectionMods() const noexcept
+    {
+        return GhosttySelectionMods(_blockSelect);
+    }
+
     // Windows Terminal never tells the core that the button came up: only VT
     // mouse mode sees a release, and selection is the non-VT path. ghostty
     // needs one, or it treats the next pointer move as a continued drag.
@@ -1255,7 +1266,13 @@ namespace winrt::Microsoft::Terminal::Control::implementation
 
         _releaseMouseIfHeld();
         _bindingAction("clear_selection");
-        _mouseTo(positionCore);
+        _mouseTo(positionCore, _selectionMods());
+
+        // The press carries no modifiers, and that is deliberate: ghostty reads
+        // the rectangle off each mouse *position*, but off the press it reads
+        // something else entirely - `if (mods.ctrlOrSuper()) .output else .line`
+        // picks what a third click would select. A press claiming ctrl would
+        // quietly turn alt+triple-click into "select the command's output".
         ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
         _mouseDown = true;
 
@@ -1276,7 +1293,7 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     void GhosttyControlCore::SetEndSelectionPoint(const Core::Point positionCore)
     {
         // Only meaningful mid-drag, which is the only time WT calls it.
-        _mouseTo(positionCore);
+        _mouseTo(positionCore, _selectionMods());
         _renderNow();
     }
 
@@ -1296,7 +1313,7 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     // the replay always starts from zero.
     void GhosttyControlCore::LeftClickOnTerminal(const Core::Point terminalPositionCore,
                                                  const int32_t numberOfClicks,
-                                                 const bool /*altEnabled*/,
+                                                 const bool altEnabled,
                                                  const bool /*shiftEnabled*/,
                                                  const bool /*isOnOriginalPosition*/,
                                                  bool& selectionNeedsToBeCopied)
@@ -1306,6 +1323,13 @@ namespace winrt::Microsoft::Terminal::Control::implementation
             return;
         }
 
+        // Alt at the click is what makes the drag that follows a block
+        // selection, exactly as it is for cascadia (ControlCore's
+        // SetBlockSelection(altEnabled) on this same call). The drag arrives
+        // later, through SetSelectionAnchor and SetEndSelectionPoint, and
+        // neither is told about modifiers - so the answer is latched here.
+        _blockSelect = altEnabled;
+
         // A new physical click ends whatever drag ghostty still thinks is in
         // progress. Without this a press below is swallowed as a move and the
         // click extends the previous selection instead of starting one.
@@ -1314,7 +1338,12 @@ namespace winrt::Microsoft::Terminal::Control::implementation
 
         if (numberOfClicks > 1)
         {
-            _mouseTo(terminalPositionCore);
+            // A double- or triple-click drag selects by word or by line, and
+            // ghostty's gesture ignores `rectangle` for both - the same as
+            // cascadia, whose expansion modes overrule block mode too. So the
+            // position carries the drag's modifiers for whatever follows, and
+            // the presses stay bare for the reason SetSelectionAnchor gives.
+            _mouseTo(terminalPositionCore, _selectionMods());
             for (auto i = 0; i < numberOfClicks; ++i)
             {
                 ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
diff --git a/src/cascadia/TerminalControl/GhosttyControlCore.h b/src/cascadia/TerminalControl/GhosttyControlCore.h
index bce44549d..c1ac2d434 100644
--- a/src/cascadia/TerminalControl/GhosttyControlCore.h
+++ b/src/cascadia/TerminalControl/GhosttyControlCore.h
@@ -266,9 +266,13 @@ namespace winrt::Microsoft::Terminal::Control::implementation
 
         // Selection is driven through ghostty's mouse handling, because that
         // is the only thing that both sets the selection *and* draws it.
-        void _mouseTo(Core::Point cell, ghostty_input_mods_e mods = GHOSTTY_MODS_NONE) const;
+        void _mouseTo(Core::Point cell, ghostty_input_mods_e mods) const;
         void _releaseMouseIfHeld() const;
 
+        // The modifiers every mouse event of a selection carries - the engine
+        // reads block-vs-linear off them, per event. See GhosttySelectionMods.h.
+        ghostty_input_mods_e _selectionMods() const noexcept;
+
         // Output has to draw itself; libghostty's wakeup coalesces. Same
         // reasoning as _connectionOutputHandler's render.
         void _renderNow() const;
@@ -330,6 +334,14 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         // _releaseMouseIfHeld.
         mutable bool _mouseDown{ false };
 
+        // Whether the drag in progress is a block selection. Alt at the moment
+        // of the click decides it, as it does on cascadia, and it holds for the
+        // whole drag - releasing alt halfway through does not turn a block
+        // selection back into a linear one. ghostty would happily change its
+        // mind on the next mouse position; WT's semantics are the latch, so
+        // every event of the drag repeats what the click said.
+        bool _blockSelect{ false };
+
         // Scroll state, from the SCROLLBAR action.
         int32_t _scrollOffset{ 0 };
         int32_t _viewHeight{ 0 };
diff --git a/src/cascadia/TerminalControl/GhosttySelectionMods.h b/src/cascadia/TerminalControl/GhosttySelectionMods.h
new file mode 100644
index 000000000..2b9ad7f3f
--- /dev/null
+++ b/src/cascadia/TerminalControl/GhosttySelectionMods.h
@@ -0,0 +1,57 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Module Name:
+// - GhosttySelectionMods.h
+//
+// Abstract:
+// - Windows Terminal's "this drag is a block selection" -> the modifiers
+//   libghostty has to see on the mouse before it makes one. Pure, so it can be
+//   tested without an engine; the rest of the selection path needs a live
+//   surface.
+
+#pragma once
+
+#include <ghostty.h>
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    // WT block-selects on alt+drag. ghostty has the same feature - a
+    // rectangular selection - but it asks for different keys, and it asks per
+    // *mouse event* rather than once per drag: `SelectionGesture.drag` takes a
+    // `rectangle` flag, and `Surface` fills it in from the modifiers that came
+    // with the latest mouse position, through `SurfaceMouse`:
+    //
+    //     pub fn isRectangleSelectState(mods: input.Mods) bool {
+    //         return if (comptime builtin.target.os.tag.isDarwin())
+    //             mods.alt
+    //         else
+    //             mods.ctrlOrSuper() and mods.alt;
+    //     }
+    //
+    // Windows takes the second branch, so alt on its own is not a rectangle to
+    // this engine - which is why a ghostty pane used to answer an alt+drag with
+    // an ordinary linear selection while a cascadia pane block-selected. Ctrl
+    // is asserted alongside it to satisfy that predicate.
+    //
+    // These belong on mouse *positions* only. A press is read differently -
+    // `if (mods.ctrlOrSuper()) .output else .line` decides what a third click
+    // selects - so the presses of a selection stay bare and only the moves
+    // carry these, which is all the engine needs for a drag. Measured:
+    // GHOSTTY_HARNESS_SELECT_BLOCK produces the same rectangle either way.
+    //
+    // Claiming ctrl costs nothing beyond that. The only thing WT's ctrl adds to
+    // a left click is the hyperlink gesture, and ControlInteractivity takes that
+    // branch before the selection path runs at all (and a ghostty pane reports
+    // no hyperlinks anyway - GD-01). Nothing else in ghostty's non-VT mouse path
+    // reads ctrl: link highlighting wants ctrl *alone* and so stays off.
+    //
+    // If this ever stops producing block selections, read isRectangleSelectState
+    // first - the rule is the engine's, not ours.
+    constexpr ghostty_input_mods_e GhosttySelectionMods(const bool blockSelection) noexcept
+    {
+        return blockSelection ?
+                   static_cast<ghostty_input_mods_e>(GHOSTTY_MODS_CTRL | GHOSTTY_MODS_ALT) :
+                   GHOSTTY_MODS_NONE;
+    }
+}
