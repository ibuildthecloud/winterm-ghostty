 .../TerminalSettingsModel/Profile.cpp         |  5 +-
 .../TerminalSettingsSerializationHelpers.h    | 20 ++++++
 .../UnitTests_SettingsModel/ProfileTests.cpp  | 66 ++++++++++++++++---
 3 files changed, 80 insertions(+), 11 deletions(-)

diff --git a/src/cascadia/TerminalSettingsModel/Profile.cpp b/src/cascadia/TerminalSettingsModel/Profile.cpp
index 6cd019ad8..ea4874092 100644
--- a/src/cascadia/TerminalSettingsModel/Profile.cpp
+++ b/src/cascadia/TerminalSettingsModel/Profile.cpp
@@ -218,7 +218,10 @@ void Profile::LayerJson(const Json::Value& json)
         const auto& engineJson = json[JsonKey(EngineKey)];
         if (engineJson.isString())
         {
-            _EngineValueUnrecognized = engineJson.asString() != "cascadia";
+            // Ask the mapper, rather than naming the engines a second time
+            // here - that duplication is exactly what made "ghostty" warn
+            // about being unrecognised after the engine shipped.
+            _EngineValueUnrecognized = !JsonUtils::ConversionTrait<Microsoft::Terminal::Control::TerminalEngine>::IsKnownName(engineJson.asString());
         }
     }
 
diff --git a/src/cascadia/TerminalSettingsModel/TerminalSettingsSerializationHelpers.h b/src/cascadia/TerminalSettingsModel/TerminalSettingsSerializationHelpers.h
index 16074cf50..05325b784 100644
--- a/src/cascadia/TerminalSettingsModel/TerminalSettingsSerializationHelpers.h
+++ b/src/cascadia/TerminalSettingsModel/TerminalSettingsSerializationHelpers.h
@@ -196,6 +196,26 @@ JSON_ENUM_MAPPER(::winrt::Microsoft::Terminal::Control::TerminalEngine)
         }
         return ValueType::Cascadia;
     }
+
+    // Whether a name is one we actually know.
+    //
+    // Because FromJson falls back silently, the caller cannot tell a real
+    // engine from a typo by its return value - so Profile::LayerJson asks
+    // this to decide whether to raise SettingsLoadWarnings::UnknownEngine.
+    // It reads `mappings` rather than repeating the names, which is the whole
+    // point: a hardcoded second list is how "ghostty" ended up warning after
+    // it was already supported.
+    static bool IsKnownName(std::string_view name) noexcept
+    {
+        for (const auto& pair : mappings)
+        {
+            if (pair.first == name)
+            {
+                return true;
+            }
+        }
+        return false;
+    }
 };
 
