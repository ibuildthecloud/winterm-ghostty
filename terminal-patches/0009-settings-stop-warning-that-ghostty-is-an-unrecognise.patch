+    void ProfileTests::ProfileKnownEngineDoesNotWarn()
+    {
+        // The other half of ProfileEngineSetting, and the half that was
+        // missing: a profile naming a *shipping* engine must load silently.
+        // Without this, nothing stops the warning's notion of "known" from
+        // drifting away from the parser's - which is precisely what happened.
+        static constexpr std::string_view userSettings{ R"({
+            "profiles": {
+                "list": [
+                    {
+                        "name": "cascadia",
+                        "guid": "{6239a42c-0000-49a3-80bd-e8fdd045185c}",
+                        "engine": "cascadia"
+                    },
+                    {
+                        "name": "ghostty",
+                        "guid": "{6239a42c-1111-49a3-80bd-e8fdd045185c}",
+                        "engine": "ghostty"
+                    }
+                ]
+            }
+        })" };
+
+        const auto settings = winrt::make_self<implementation::CascadiaSettings>(userSettings);
+
+        for (const auto& warning : settings->Warnings())
+        {
+            VERIFY_ARE_NOT_EQUAL(SettingsLoadWarnings::UnknownEngine,
+                                 warning,
+                                 L"a shipping engine must not be reported as unrecognised");
+        }
+    }
+
