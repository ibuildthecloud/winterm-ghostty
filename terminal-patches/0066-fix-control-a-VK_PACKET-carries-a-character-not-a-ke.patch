 .../TerminalControl/GhosttyControlCore.h      | 801 +++++++++---------
 .../TerminalControl/GhosttyKeyTranslator.cpp  | 406 +++++----
 .../TerminalControl/GhosttyKeyTranslator.h    | 236 +++---
 .../UnitTests_Control/GhosttyKeyTests.cpp     |  52 ++
