+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Module Name:
+// - GhosttyKeyTranslator.h
+//
+// Abstract:
+// - The rules a Windows key event has to satisfy before libghostty will make
+//   sense of it. Each was learned from a bug; each is a pure function so it can
+//   be unit tested without an engine, a surface or a keyboard.
+
+#pragma once
+
+#include <string>
+#include <string_view>
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    // ghostty_input_key_s::keycode is the *native* platform keycode - not a
+    // virtual key, and not a value from ghostty_input_key_e. On Windows its
+    // table (ghostty's src/input/keycodes.zig) stores the scan code, with
+    // 0xE000 set for the extended keys:
+    //
+    //     //   USB     evdev    XKB     Win     Mac   Code
+    //     .{ 0x070004, 0x001e, 0x0026, 0x001e, 0x0000, "KeyA" },
+    //     .{ 0x07004a, 0x0066, 0x006e, 0xe047, 0x0073, "Home" },
+    //
+    // Passing the virtual key instead resolves to whatever unrelated key
+    // shares that number, which is how `d` came to behave like Delete.
+    constexpr uint32_t GhosttyNativeKeycode(const uint16_t scanCode, const bool extended) noexcept
+    {
+        return extended ? (0xE000u | scanCode) : scanCode;
+    }
+
+    // The text to hand to libghostty with a key, given what the keyboard
+    // layout translated it to. Empty means "this key produces no text".
+    std::string GhosttyKeyText(std::wstring_view translated);
+
+    // The text a key produces under a given set of modifiers, as UTF-8.
+    //
+    // `modifiers` is a ControlKeyStates value - the console-style bitfield from
+    // <wincon.h> - taken *from the key event*. That is the whole point: the
+    // obvious implementation asks GetKeyboardState() instead, and it is wrong.
+    // GetKeyboardState reports the state as of the last message the calling
+    // thread retrieved, while XAML raises KeyDown as a routed event some way
+    // behind its message pump, so under real typing speed the snapshot has
+    // already moved on. Shift arriving early or leaving late is enough to turn
+    // `?` into `/`: typing "echo A?B/C" quickly into a ghostty pane produced
+    // "????ECH?O A??B?C", and the same keys 200ms apart came out right. A
+    // cascadia pane is immune only because it never calls ToUnicode - its text
+    // arrives as CharacterReceived, which Windows generated with the right
+    // state.
+    //
+    // Pass 0 for the modifiers to get the unshifted text, which is what key
+    // bindings match against.
+    std::string GhosttyKeyTextFor(uint32_t modifiers, uint16_t vkey, uint16_t scanCode);
+
+    // The modifiers a key event actually happened under, which is not the same
+    // question as what a snapshot says is held *now*.
+    //
+    // TermControl samples the modifier keys with CoreWindow::GetKeyState when
+    // XAML raises KeyDown, and that answer is "now" - some way behind the
+    // message that carried the key. A person holds shift for around a tenth of
+    // a second, so the two agree and nothing shows. A remote desktop client
+    // sends shift-down, the key, and shift-up back to back, and by the time the
+    // handler asks, shift is up again: `?` arrives as `/` and `A` as `a`.
+    // See KD-25.
+    //
+    // The event stream cannot drift the same way, because it is ordered: the
+    // shift press is delivered before the key it modifies and the release
+    // after it. So the modifier keys are tracked as they arrive, in `held`,
+    // and the snapshot is treated as a floor rather than as the truth - a
+    // modifier held before this pane had focus is in the snapshot but was
+    // never seen as an event.
+    //
+    // `held` is the caller's state across events, and this updates it. Reset it
+    // when focus changes: a release that happens while another window owns the
+    // keyboard is never delivered here, and a modifier stuck down would put
+    // every subsequent key in the wrong case.
+    //
+    // The lock keys are deliberately not tracked. Caps Lock is a state rather
+    // than a hold, it is reported as locked rather than pressed, and it is not
+    // subject to the race.
+    uint32_t GhosttyModifiersFor(uint32_t& held,
+                                 uint32_t snapshot,
+                                 uint16_t vkey,
+                                 bool extended,
+                                 bool keyDown) noexcept;
+
+    // The text a VK_PACKET event carries.
+    //
+    // A VK_PACKET is not a key at all. A client that cannot express a character
+    // as a key press on the server's layout - which is every remote desktop
+    // client whose keyboard is an on-screen one - injects the character itself,
+    // and Windows carries it in the *scan code* as a UTF-16 code unit.
+    //
+    // Reading that as a scan code asks the wrong question entirely: "what key
+    // is scan code 0x41" is F7, where "what character is 0x41" is `A`. Typed
+    // from the Windows App on Android, `:` (0x3A, the Caps Lock scan code)
+    // reached the pane as nothing at all and `A` as F7's escape sequence, with
+    // the character event that would have carried the text suppressed because
+    // the key was reported handled. See KD-25.
+    //
+    // A character outside the BMP arrives as two packets, a high surrogate then
+    // a low one. `pendingHighSurrogate` is the caller's state between the two:
+    // this returns empty text for the first and the whole character for the
+    // second. Reset it when focus changes, like the modifier state.
+    std::string GhosttyPacketText(uint16_t& pendingHighSurrogate, uint16_t scanCode);
+
+    // What a key press means once the child is gone.
+    enum class GhosttyExitKey
+    {
+        None,
+        Close,
+        Restart,
+    };
+
+    // The two keys the connection promises the user after the child exits:
+    //
+    //     [process exited with code 56 (0x00000038)]
+    //     You can now close this terminal with Ctrl+D, or press Enter to restart.
+    //
+    // They belong to the host, not to the terminal, and a pane whose connection
+    // is Closed has to answer them itself. See KD-24.
+    //
+    // Modifiers are a ControlKeyStates bitfield, as everywhere else here.
+    GhosttyExitKey GhosttyExitKeyFor(uint16_t vkey, uint32_t modifiers) noexcept;
+}
