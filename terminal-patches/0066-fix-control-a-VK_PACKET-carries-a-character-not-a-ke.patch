diff --git a/src/cascadia/TerminalControl/GhosttyControlCore.cpp b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
index f09f5aa7d..173081e0f 100644
--- a/src/cascadia/TerminalControl/GhosttyControlCore.cpp
+++ b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
@@ -970,12 +970,20 @@ namespace winrt::Microsoft::Terminal::Control::implementation
             return false;
         }
 
+        // A VK_PACKET is a character the client injected, not a key: its scan
+        // code is a UTF-16 code unit. Everything below that reads the scan code
+        // as a scan code has to be told, or `A` is asked about as if it were
+        // F7's scan code - see GhosttyPacketText and KD-25.
+        const auto isPacket = (vkey == VK_PACKET);
+
         ghostty_input_key_s ev{};
         ev.action = keyDown ? GHOSTTY_ACTION_PRESS : GHOSTTY_ACTION_RELEASE;
 
         // Native keycode, not the virtual key - see GhosttyKeyTranslator.h for
-        // why, and what happened when it was the virtual key.
-        ev.keycode = GhosttyNativeKeycode(scanCode, (modifiers.Value() & ENHANCED_KEY) != 0);
+        // why, and what happened when it was the virtual key. A packet has no
+        // key behind it at all, so it carries none: the text is the whole
+        // event.
+        ev.keycode = isPacket ? 0 : GhosttyNativeKeycode(scanCode, (modifiers.Value() & ENHANCED_KEY) != 0);
         ev.composing = false;
 
         const auto mods = GhosttyMods(held);
@@ -997,15 +1005,33 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         std::string unshifted;
         if (keyDown)
         {
-            // Under what was held when the key arrived, never the thread's
-            // keyboard state - see GhosttyKeyTextFor and GhosttyModifiersFor,
-            // and the two separate ways `?` came out as `/`.
-            text = GhosttyKeyTextFor(held.Value(), vkey, scanCode);
+            if (isPacket)
+            {
+                // The character is in the event. There is no key to ask the
+                // layout about, and nothing for a binding to match.
+                text = GhosttyPacketText(_pendingHighSurrogate, scanCode);
+            }
+            else
+            {
+                // Under what was held when the key arrived, never the thread's
+                // keyboard state - see GhosttyKeyTextFor and
+                // GhosttyModifiersFor, and the two separate ways `?` came out
+                // as `/`.
+                text = GhosttyKeyTextFor(held.Value(), vkey, scanCode);
+
+                // What key bindings match against, so it has to ignore Shift
+                // and the lock keys - otherwise ctrl+shift+c would fail to
+                // match a binding written against `c`.
+                unshifted = GhosttyKeyTextFor(0, vkey, scanCode);
+            }
+        }
 
-            // What key bindings match against, so it has to ignore Shift and
-            // the lock keys - otherwise ctrl+shift+c would fail to match a
-            // binding written against `c`.
-            unshifted = GhosttyKeyTextFor(0, vkey, scanCode);
+        if (isPacket && (!keyDown || text.empty()))
+        {
+            // Nothing to send - the release half of an injected character, or
+            // the first half of a surrogate pair. Reported handled all the
+            // same, so the character event does not deliver it a second time.
+            return true;
         }
         // Which modifiers were *consumed* to produce that text, which is not
         // the same question as which were held. Shift held while typing `?` is
@@ -1048,8 +1074,38 @@ namespace winrt::Microsoft::Terminal::Control::implementation
                 if (held.IsAltPressed()) { consumed = static_cast<ghostty_input_mods_e>(consumed | GHOSTTY_MODS_ALT); }
             }
         }
+        if (isPacket)
+        {
+            // Whatever was held, the client already accounted for it when it
+            // chose the character - so all of it is consumed, and ghostty's
+            // kitty encoder sends the text as it stands rather than as a
+            // modified key.
+            consumed = mods;
+        }
         ev.consumed_mods = consumed;
 
+        // What the pane was actually handed, for the cases where guessing it
+        // from outside has proved wrong twice: a remote client can deliver a
+        // character as a VK_PACKET whose scan code is the code point rather
+        // than as a key, and which of those arrived is invisible from any
+        // other vantage point. Off unless GHOSTTY_TRACE_KEYS is set, because
+        // this is one debugger round trip per keystroke.
+        static const bool traceKeys = []() {
+            wchar_t buf[8];
+            return GetEnvironmentVariableW(L"GHOSTTY_TRACE_KEYS", buf, ARRAYSIZE(buf)) > 0;
+        }();
+        if (traceKeys)
+        {
+            _trace(L"key %s vkey=0x%02X scan=0x%02X mods=0x%04X held=0x%04X text=%hs unshifted=%hs",
+                   keyDown ? L"down" : L"up",
+                   vkey,
+                   scanCode,
+                   modifiers.Value(),
+                   held.Value(),
+                   text.empty() ? "(none)" : text.c_str(),
+                   unshifted.empty() ? "(none)" : unshifted.c_str());
+        }
+
         ev.text = text.empty() ? nullptr : text.c_str();
         ev.unshifted_codepoint = (!unshifted.empty() && gsl::narrow_cast<unsigned char>(unshifted[0]) < 0x80) ?
                                      gsl::narrow_cast<uint32_t>(gsl::narrow_cast<unsigned char>(unshifted[0])) :
@@ -1171,6 +1227,7 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         // cannot be wrong in the direction that matters - a modifier believed
         // held that is not would put every key in the wrong case.
         _heldMods = 0;
+        _pendingHighSurrogate = 0;
         if (_surface)
         {
             ghostty_surface_set_focus(_surface, true);
@@ -1189,6 +1246,7 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         // never reach us at all, leaving shift stuck down here forever.
         _keyMods = GHOSTTY_MODS_NONE;
         _heldMods = 0;
+        _pendingHighSurrogate = 0;
         if (_surface)
         {
             ghostty_surface_set_focus(_surface, false);
