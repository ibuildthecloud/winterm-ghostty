+#include "pch.h"
+#include "GhosttyKeyTranslator.h"
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    std::string GhosttyKeyText(const std::wstring_view translated)
+    {
+        if (translated.empty())
+        {
+            return {};
+        }
+
+        // Control characters are not text. Backspace, Tab, Enter, Escape and
+        // ctrl+letter all come back from the keyboard layout as
+        // 0x01-0x1A/0x1B/0x7F, but they are keys whose terminal encoding
+        // ghostty owns, and which depend on modes nothing here knows about -
+        // backspace-is-delete, the kitty keyboard protocol, application cursor
+        // keys.
+        //
+        // Forwarding them is destructive rather than merely redundant:
+        // ghostty's key_encode short circuits on a non-empty utf8 field
+        // (`if (event.utf8.len > 0) return try writer.writeAll(event.utf8);`),
+        // so a control character here would *replace* ghostty's own encoding
+        // of the key. ghostty guards the same hazard internally with
+        // isControlUtf8.
+        for (const auto c : translated)
+        {
+            if (c < 0x20 || c == 0x7F)
+            {
+                return {};
+            }
+        }
+
+        return til::u16u8(translated);
+    }
+
+    std::string GhosttyKeyTextFor(const uint32_t modifiers, const uint16_t vkey, const uint16_t scanCode)
+    {
+        constexpr BYTE down = 0x80;
+        constexpr BYTE locked = 0x01;
+
+        BYTE keyboard[256]{};
+        if (modifiers & SHIFT_PRESSED)
+        {
+            keyboard[VK_SHIFT] = keyboard[VK_LSHIFT] = down;
+        }
+        // Left and right are kept apart because AltGr is reported as left ctrl
+        // plus right alt, and a layout with an AltGr mapping for a key looks at
+        // exactly that pair.
+        if (modifiers & LEFT_CTRL_PRESSED)
+        {
+            keyboard[VK_CONTROL] = keyboard[VK_LCONTROL] = down;
+        }
+        if (modifiers & RIGHT_CTRL_PRESSED)
+        {
+            keyboard[VK_CONTROL] = keyboard[VK_RCONTROL] = down;
+        }
+        if (modifiers & LEFT_ALT_PRESSED)
+        {
+            keyboard[VK_MENU] = keyboard[VK_LMENU] = down;
+        }
+        if (modifiers & RIGHT_ALT_PRESSED)
+        {
+            keyboard[VK_MENU] = keyboard[VK_RMENU] = down;
+        }
+        if (modifiers & CAPSLOCK_ON)
+        {
+            keyboard[VK_CAPITAL] = locked;
+        }
+
+        // The 1<<2 flag is load-bearing: it tells ToUnicode not to modify
+        // kernel-side keyboard state. Without it, translating a dead key here
+        // consumes it and the next key silently loses its accent.
+        wchar_t buf[8]{};
+        const auto n = ToUnicode(vkey, scanCode, keyboard, buf, ARRAYSIZE(buf), 1 << 2);
+        if (n <= 0)
+        {
+            // 0 is "no translation"; negative is a dead key.
+            return {};
+        }
+
+        return GhosttyKeyText(std::wstring_view{ buf, gsl::narrow_cast<size_t>(n) });
+    }
+
+    namespace
+    {
+        // The bit a modifier key press sets, or 0 for a key that is not a
+        // modifier.
+        //
+        // Left and right are kept apart because AltGr arrives as left ctrl plus
+        // right alt and the layout looks at exactly that pair. XAML reports the
+        // sided virtual key for a modifier (OriginalKey), but the generic one
+        // still turns up - from an injected event, or from a client that sends
+        // VK_SHIFT rather than VK_LSHIFT - so both are handled, with the
+        // extended-key flag standing in for the side when it has to.
+        uint32_t ModifierBitFor(const uint16_t vkey, const bool extended) noexcept
+        {
+            switch (vkey)
+            {
+            case VK_SHIFT:
+            case VK_LSHIFT:
+            case VK_RSHIFT:
+                // ControlKeyStates has one shift bit, not two.
+                return SHIFT_PRESSED;
+            case VK_LCONTROL:
+                return LEFT_CTRL_PRESSED;
+            case VK_RCONTROL:
+                return RIGHT_CTRL_PRESSED;
+            case VK_CONTROL:
+                return extended ? RIGHT_CTRL_PRESSED : LEFT_CTRL_PRESSED;
+            case VK_LMENU:
+                return LEFT_ALT_PRESSED;
+            case VK_RMENU:
+                return RIGHT_ALT_PRESSED;
+            case VK_MENU:
+                return extended ? RIGHT_ALT_PRESSED : LEFT_ALT_PRESSED;
+            default:
+                return 0;
+            }
+        }
+    }
+
+    uint32_t GhosttyModifiersFor(uint32_t& held,
+                                 const uint32_t snapshot,
+                                 const uint16_t vkey,
+                                 const bool extended,
+                                 const bool keyDown) noexcept
+    {
+        if (const auto bit = ModifierBitFor(vkey, extended))
+        {
+            if (keyDown)
+            {
+                held |= bit;
+            }
+            else
+            {
+                held &= ~bit;
+            }
+        }
+
+        return snapshot | held;
+    }
+
+    std::string GhosttyPacketText(uint16_t& pendingHighSurrogate, const uint16_t scanCode)
+    {
+        const auto unit = scanCode;
+
+        if (unit >= 0xD800 && unit <= 0xDBFF)
+        {
+            // First half of a surrogate pair. Nothing to send yet, and the
+            // second half is the next packet.
+            pendingHighSurrogate = unit;
+            return {};
+        }
+
+        if (pendingHighSurrogate != 0)
+        {
+            const auto high = pendingHighSurrogate;
+            pendingHighSurrogate = 0;
+
+            if (unit >= 0xDC00 && unit <= 0xDFFF)
+            {
+                const wchar_t pair[2]{ static_cast<wchar_t>(high), static_cast<wchar_t>(unit) };
+                return GhosttyKeyText(std::wstring_view{ pair, 2 });
+            }
+
+            // A high surrogate not followed by a low one is not a character.
+            // Dropping it and carrying on with this unit is the only reading
+            // that does not corrupt what follows.
+        }
+
+        const auto ch = static_cast<wchar_t>(unit);
+        return GhosttyKeyText(std::wstring_view{ &ch, 1 });
+    }
+
+    // Deliberately keyed on the virtual key rather than on the text the layout
+    // produces, which is what cascadia matches: its check lives in
+    // SendCharEvent and compares the character against 0x04 and CR.
+    //
+    // A ghostty pane cannot ask the same question that way. The text path here
+    // is GhosttyKeyTextFor, and it drops every control character on purpose -
+    // ctrl+d and Enter both come back empty - so there is nothing to compare.
+    // The vkey is what is left, and it is the more direct question anyway.
+    //
+    // Two knowingly-small differences from the character rule, both harmless:
+    // ctrl+m produces CR and restarts a cascadia pane but not a ghostty one,
+    // and a layout that puts `d` somewhere other than VK_D closes on the
+    // physical D key rather than on the letter.
+    GhosttyExitKey GhosttyExitKeyFor(const uint16_t vkey, const uint32_t modifiers) noexcept
+    {
+        const auto ctrl = (modifiers & (LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED)) != 0;
+        const auto alt = (modifiers & (LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED)) != 0;
+
+        // Alt is never part of either promise, and alt+enter is WT's own
+        // fullscreen binding - it must not reach this at all.
+        if (alt)
+        {
+            return GhosttyExitKey::None;
+        }
+
+        // ctrl+enter is LF rather than CR, and cascadia does not restart on it.
+        if (vkey == VK_RETURN && !ctrl)
+        {
+            return GhosttyExitKey::Restart;
+        }
+
+        // Shift is allowed: ctrl+shift+d is still 0x04, so cascadia closes on
+        // it too.
+        if (vkey == 'D' && ctrl)
+        {
+            return GhosttyExitKey::Close;
+        }
+
+        return GhosttyExitKey::None;
+    }
+}
