-    std::string GhosttyKeyText(const std::wstring_view translated)
-    {
-        if (translated.empty())
-        {
-            return {};
-        }
-
-        // Control characters are not text. Backspace, Tab, Enter, Escape and
-        // ctrl+letter all come back from the keyboard layout as
-        // 0x01-0x1A/0x1B/0x7F, but they are keys whose terminal encoding
-        // ghostty owns, and which depend on modes nothing here knows about -
-        // backspace-is-delete, the kitty keyboard protocol, application cursor
-        // keys.
-        //
-        // Forwarding them is destructive rather than merely redundant:
-        // ghostty's key_encode short circuits on a non-empty utf8 field
-        // (`if (event.utf8.len > 0) return try writer.writeAll(event.utf8);`),
-        // so a control character here would *replace* ghostty's own encoding
-        // of the key. ghostty guards the same hazard internally with
-        // isControlUtf8.
-        for (const auto c : translated)
-        {
-            if (c < 0x20 || c == 0x7F)
-            {
-                return {};
-            }
-        }
-
-        return til::u16u8(translated);
-    }
