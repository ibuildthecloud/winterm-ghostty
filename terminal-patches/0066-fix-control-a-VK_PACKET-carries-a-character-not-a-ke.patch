+    // What the Windows App on Android actually sends, measured with
+    // harness/keylog and confirmed by the pane's own trace: not a key, but the
+    // character in a VK_PACKET whose scan code is a UTF-16 unit.
+    //
+    // The values are the ones from that trace. Read as scan codes - which is
+    // what the pane did - 0x3A is Caps Lock, 0x3F is F5 and 0x41 is F7, so `:`
+    // vanished and `A` sent an escape sequence. KD-25.
+    void GhosttyKeyTests::APacketCarriesItsCharacterInTheScanCode()
+    {
+        uint16_t pending = 0;
+
+        VERIFY_ARE_EQUAL(":", GhosttyPacketText(pending, 0x3A));
+        VERIFY_ARE_EQUAL("?", GhosttyPacketText(pending, 0x3F));
+        VERIFY_ARE_EQUAL("A", GhosttyPacketText(pending, 0x41));
+        VERIFY_ARE_EQUAL("a", GhosttyPacketText(pending, 0x61));
+
+        // Non-ASCII goes through as UTF-8 - a packet is how a remote client
+        // sends anything its layout cannot express as a key. Asserted as bytes
+        // rather than as a literal, because a literal here is only as reliable
+        // as the source file's encoding and the test harness's idea of it.
+        const auto eAcute = GhosttyPacketText(pending, 0x00E9);
+        VERIFY_ARE_EQUAL(size_t{ 2 }, eAcute.size());
+        VERIFY_ARE_EQUAL(0xC3u, static_cast<unsigned>(static_cast<unsigned char>(eAcute[0])));
+        VERIFY_ARE_EQUAL(0xA9u, static_cast<unsigned>(static_cast<unsigned char>(eAcute[1])));
+
+        // A character outside the BMP arrives as two packets. The first
+        // produces nothing and is remembered; the second produces the whole
+        // character - U+1F600, four bytes of UTF-8.
+        VERIFY_IS_TRUE(GhosttyPacketText(pending, 0xD83D).empty());
+        VERIFY_ARE_EQUAL(static_cast<uint16_t>(0xD83D), pending);
+        const auto grin = GhosttyPacketText(pending, 0xDE00);
+        VERIFY_ARE_EQUAL(size_t{ 4 }, grin.size());
+        VERIFY_ARE_EQUAL(0xF0u, static_cast<unsigned>(static_cast<unsigned char>(grin[0])));
+        VERIFY_ARE_EQUAL(0x9Fu, static_cast<unsigned>(static_cast<unsigned char>(grin[1])));
+        VERIFY_ARE_EQUAL(0x98u, static_cast<unsigned>(static_cast<unsigned char>(grin[2])));
+        VERIFY_ARE_EQUAL(0x80u, static_cast<unsigned>(static_cast<unsigned char>(grin[3])));
+        VERIFY_ARE_EQUAL(static_cast<uint16_t>(0), pending);
+
+        // A high surrogate followed by something that is not a low one is not
+        // a character: it is dropped, and the unit that followed it still
+        // arrives rather than being swallowed with it.
+        GhosttyPacketText(pending, 0xD83D);
+        VERIFY_ARE_EQUAL("A", GhosttyPacketText(pending, 0x41));
+        VERIFY_ARE_EQUAL(static_cast<uint16_t>(0), pending);
+
+        // Control characters are not text here either - ghostty owns those
+        // encodings, and an empty answer is what tells the caller to send
+        // nothing rather than to overwrite ghostty's own.
+        VERIFY_IS_TRUE(GhosttyPacketText(pending, 0x0D).empty());
+    }
+
     // The pane's process has exited and the connection has printed "You can now
     // close this terminal with Ctrl+D, or press Enter to restart". Which key
     // means which, and - as much as it matters - which keys mean neither.
