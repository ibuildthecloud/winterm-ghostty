-        // The 1<<2 flag is load-bearing: it tells ToUnicode not to modify
-        // kernel-side keyboard state. Without it, translating a dead key here
-        // consumes it and the next key silently loses its accent.
-        wchar_t buf[8]{};
-        const auto n = ToUnicode(vkey, scanCode, keyboard, buf, ARRAYSIZE(buf), 1 << 2);
-        if (n <= 0)
-        {
-            // 0 is "no translation"; negative is a dead key.
-            return {};
-        }
-
-        return GhosttyKeyText(std::wstring_view{ buf, gsl::narrow_cast<size_t>(n) });
-    }
