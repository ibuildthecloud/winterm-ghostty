@@ -0,0 +1,95 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Runtime opacity belongs to GhosttyControlCore rather than the settings
+// translator: XAML reads it back through IControlCore and updates the pane's
+// background brush from TransparencyChanged.
+
+#include "pch.h"
+#include "../TerminalControl/GhosttyControlCore.h"
+#include "MockControlSettings.h"
+
+using namespace WEX::TestExecution;
+using namespace winrt;
+using namespace winrt::Microsoft::Terminal;
+
+namespace ControlUnitTests
+{
+    class GhosttyOpacityTests
+    {
+        BEGIN_TEST_CLASS(GhosttyOpacityTests)
+            TEST_CLASS_PROPERTY(L"TestTimeout", L"0:0:10")
+        END_TEST_CLASS()
+
+        TEST_METHOD(ProfileRuntimeAndClamp);
+        TEST_METHOD(SettingsReloadResetsRuntimeAndBackground);
+
+    private:
+        static winrt::com_ptr<Control::implementation::GhosttyControlCore> _core(
+            const winrt::com_ptr<MockControlSettings>& settings)
+        {
+            const Control::IControlAppearance noUnfocusedAppearance{ nullptr };
+            const TerminalConnection::ITerminalConnection noConnection{ nullptr };
+            return winrt::make_self<Control::implementation::GhosttyControlCore>(
+                *settings,
+                noUnfocusedAppearance,
+                noConnection);
+        }
+    };
+
+    void GhosttyOpacityTests::ProfileRuntimeAndClamp()
+    {
+        auto settings = winrt::make_self<MockControlSettings>();
+        settings->Opacity(0.5f);
+        auto core = _core(settings);
+
+        VERIFY_ARE_EQUAL(0.5f, core->Opacity());
+
+        size_t changes = 0;
+        float last = 0.0f;
+        core->TransparencyChanged([&](auto&&, const Control::TransparencyChangedEventArgs& args) {
+            ++changes;
+            last = args.Opacity();
+        });
+
+        core->AdjustOpacity(0.25f, true);
+        VERIFY_ARE_EQUAL(0.75f, core->Opacity());
+        VERIFY_ARE_EQUAL(0.75f, last);
+        VERIFY_ARE_EQUAL(size_t{ 1 }, changes);
+        VERIFY_ARE_EQUAL(0.5f, settings->Opacity(), L"runtime adjustment must not mutate the profile");
+
+        core->AdjustOpacity(2.0f, true);
+        VERIFY_ARE_EQUAL(1.0f, core->Opacity(), L"relative adjustment clamps to one");
+        VERIFY_ARE_EQUAL(size_t{ 2 }, changes);
+
+        core->AdjustOpacity(-2.0f, false);
+        VERIFY_ARE_EQUAL(0.0f, core->Opacity(), L"absolute adjustment clamps to zero");
+        VERIFY_ARE_EQUAL(size_t{ 3 }, changes);
+
+        core->AdjustOpacity(0.0f, false);
+        VERIFY_ARE_EQUAL(size_t{ 3 }, changes, L"an unchanged opacity raises no event");
+    }
+
+    void GhosttyOpacityTests::SettingsReloadResetsRuntimeAndBackground()
+    {
+        auto original = winrt::make_self<MockControlSettings>();
+        original->Opacity(0.5f);
+        const til::color originalColor{ 0x11, 0x22, 0x33 };
+        original->DefaultBackground(originalColor);
+        auto core = _core(original);
+
+        VERIFY_ARE_EQUAL(originalColor, core->BackgroundColor());
+        core->AdjustOpacity(0.25f, false);
+        VERIFY_ARE_EQUAL(0.25f, core->Opacity());
+
+        auto replacement = winrt::make_self<MockControlSettings>();
+        replacement->Opacity(0.75f);
+        const til::color replacementColor{ 0x44, 0x55, 0x66 };
+        replacement->DefaultBackground(replacementColor);
+        const Control::IControlAppearance noUnfocusedAppearance{ nullptr };
+        core->UpdateSettings(*replacement, noUnfocusedAppearance);
+
+        VERIFY_ARE_EQUAL(0.75f, core->Opacity(), L"reload discards the runtime override, matching cascadia");
+        VERIFY_ARE_EQUAL(replacementColor, core->BackgroundColor());
+    }
+}
