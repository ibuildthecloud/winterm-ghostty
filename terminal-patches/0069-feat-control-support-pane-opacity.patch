                     BackgroundColorChanged.raise(*this, nullptr);
                 }
                 TabColorChanged.raise(*this, nullptr);
@@ -1745,10 +1747,22 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     {
         _settings = settings;
         _setUnfocusedAppearance(newAppearance);
+        _resetAppearanceState();
 
         _pushSettings();
     }
 
+    void GhosttyControlCore::_resetAppearanceState()
+    {
+        // A settings reload discards the runtime override, as cascadia does.
+        // TermControl rebuilds its XAML brush after UpdateSettings returns.
+        _runtimeOpacity.reset();
+        if (const auto appearance = FocusedAppearance())
+        {
+            _backgroundColor = til::color{ appearance.DefaultBackground() };
+        }
+    }
+
     void GhosttyControlCore::_setUnfocusedAppearance(const IControlAppearance& newAppearance)
     {
         _hasUnfocusedAppearance = static_cast<bool>(newAppearance);
@@ -1792,11 +1806,35 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     void GhosttyControlCore::SetOverrideColorScheme(const Core::ICoreScheme&) {}
 
     til::color GhosttyControlCore::ForegroundColor() const { return til::color{ 0xFF, 0xFF, 0xFF }; }
-    til::color GhosttyControlCore::BackgroundColor() const { return til::color{ 0x28, 0x2C, 0x34 }; }
+    til::color GhosttyControlCore::BackgroundColor() const { return _backgroundColor; }
 
-    float GhosttyControlCore::Opacity() const noexcept { return 1.0f; }
+    float GhosttyControlCore::Opacity() const noexcept
+    {
+        if (_runtimeOpacity)
+        {
+            return *_runtimeOpacity;
+        }
+        return _settings ? _settings.Opacity() : 1.0f;
+    }
+
+    // Acrylic is a separate presentation feature. Returning false keeps this
+    // patch to solid XAML opacity while preserving the existing behaviour for
+    // profiles that request acrylic.
     bool GhosttyControlCore::UseAcrylic() const noexcept { return false; }
-    void GhosttyControlCore::AdjustOpacity(const float /*opacity*/, const bool /*relative*/) {}
+
+    void GhosttyControlCore::AdjustOpacity(const float opacity, const bool relative)
+    {
+        const auto current = Opacity();
+        const auto next = std::clamp(relative ? current + opacity : opacity, 0.0f, 1.0f);
+        if (next == current)
+        {
+            return;
+        }
+
+        _runtimeOpacity = next;
+        auto args = winrt::make_self<TransparencyChangedEventArgs>(next);
+        TransparencyChanged.raise(*this, *args);
+    }
     void GhosttyControlCore::ToggleShaderEffects() {}
     void GhosttyControlCore::ResumeRendering() {}
     void GhosttyControlCore::WindowVisibilityChanged(const bool /*showOrHide*/) {}
