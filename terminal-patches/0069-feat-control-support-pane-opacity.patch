     }
 
+    // TermControl already paints the profile background with a XAML brush and
+    // applies the profile/runtime opacity to that brush. If ghostty also paints
+    // its default background, it covers the brush; if both layers apply 0.9,
+    // the result is effectively 0.99 opaque. Only the default background is
+    // transparent: explicit ANSI cell backgrounds must remain opaque.
+    void GhosttySettingsTests::DefaultBackgroundIsTransparentForXamlComposition()
+    {
+        const auto entries = Control::implementation::TranslateGhosttySettings(*_settings());
+
+        VERIFY_IS_TRUE(_has(entries, "background-opacity", "0"));
+        VERIFY_IS_TRUE(_has(entries, "background-opacity-cells", "false"));
+    }
+
     // The colours matter for more than looks: while the pane was drawn in
     // ghostty's defaults and WT's padding in the profile's background, the
     // mismatch showed up as a visible frame around the terminal.
