-    const std::vector<til::point_span>& ControlCore::SearchResultRows() const noexcept
+    // Distinct buffer rows containing a search hit, in order.
+    //
+    // The results are spans, but the only consumer draws one scrollbar pip per
+    // row, so the consecutive-duplicate filtering that used to live in
+    // TermControl happens here instead: that keeps til::point_span - which is
+    // not projectable - off the IControlCore ABI.
+    Windows::Foundation::Collections::IVector<int32_t> ControlCore::SearchResultRows() const
+    {
+        std::vector<int32_t> rows;
+        auto lastRow = til::CoordTypeMin;
+        for (const auto& span : _searcher.Results())
+        {
+            if (lastRow != span.start.y)
+            {
+                lastRow = span.start.y;
+                rows.push_back(lastRow);
+            }
+        }
+        return winrt::single_threaded_vector<int32_t>(std::move(rows));
+    }
+
+    // Whether a buffer row is currently visible.
+    //
+    // Replaces a GetRenderData()->GetViewport() escape. Both bounds are read
+    // under a single lock, as the original did. ICoreState::ScrollOffset is not
+    // a substitute: Terminal::_VisibleStartIndex() reports 0 in the alt buffer
+    // while GetViewport().Top() does not.
+    bool ControlCore::IsBufferRowInViewport(int32_t bufferRow) const
     {
-        return _searcher.Results();
+        const auto lock = _terminal->LockForReading();
+        const auto viewport = _terminal->GetViewport();
+        return bufferRow >= viewport.Top() && bufferRow <= viewport.BottomInclusive();
     }
 
