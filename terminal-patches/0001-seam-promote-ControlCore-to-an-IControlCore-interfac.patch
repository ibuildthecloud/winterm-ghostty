+import "IControlCore.idl";
+import "ICoreState.idl";
+import "IControlSettings.idl";
+import "EventArgs.idl";
+
+namespace Microsoft.Terminal.Control
+{
+    // The cascadia engine: implementation #1 of IControlCore (ADR 0001).
+    //
+    // Everything this class used to declare now lives on IControlCore, so the
+    // shell talks to the interface and a second engine can be dropped in beside
+    // this one. Only the constructor stays here - it is what the factory calls
+    // to produce this particular engine.
+    // [default_interface] marks this as a marker class. Every member now lives
+    // on IControlCore, so the class body holds only the constructor - and MIDL
+    // requires a runtimeclass that is constructed (or passed as a parameter) to
+    // have a default interface.
+    [default_interface] runtimeclass ControlCore : IControlCore, ICoreState
+    {
+        ControlCore(IControlSettings settings,
+                    IControlAppearance unfocusedAppearance,
+                    Microsoft.Terminal.TerminalConnection.ITerminalConnection connection);
+    };
+}
