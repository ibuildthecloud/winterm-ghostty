+        // reaching through the projection into the concrete cascadia type,
+        // which a second engine could not satisfy.
+        // Distinct buffer rows containing a search hit, in order. The only
+        // consumer draws one scrollbar pip per row, so projecting rows rather
+        // than til::point_span keeps the ABI simple and moves the
+        // consecutive-duplicate filtering to the implementation.
+        IVector<Int32> SearchResultRows();
