+        // GetRenderData()->GetViewport() while holding the console lock.
+        //
+        // Deliberately a single predicate rather than separate Top/Bottom
+        // accessors: the original read both bounds under one lock, and
+        // ICoreState's ScrollOffset cannot substitute because
+        // Terminal::_VisibleStartIndex() special-cases the alt buffer to 0
+        // while GetViewport().Top() does not.
+        Boolean IsBufferRowInViewport(Int32 bufferRow);
