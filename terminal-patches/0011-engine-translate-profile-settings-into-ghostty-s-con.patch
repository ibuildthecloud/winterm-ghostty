+    void GhosttyEngine::RunWithEngineStack(const std::function<void()>& work) noexcept
+    {
+        struct Payload
+        {
+            const std::function<void()>* work;
+        } payload{ &work };
+
+        wil::unique_handle thread{ CreateThread(
+            nullptr,
+            EngineThreadStackReserve,
+            [](LPVOID param) -> DWORD {
+                const auto p = static_cast<Payload*>(param);
+                try
+                {
+                    (*p->work)();
+                }
+                CATCH_LOG();
+                return 0;
+            },
+            &payload,
+            STACK_SIZE_PARAM_IS_A_RESERVATION,
+            nullptr) };
+
+        if (!thread)
+        {
+            LOG_LAST_ERROR_MSG("could not start a large-stack thread for libghostty");
+            return;
+        }
+
+        // Synchronous by design: the caller is mid-construction and the work
+        // must be done before it continues. `payload` lives until then.
+        WaitForSingleObject(thread.get(), INFINITE);
+    }
+
     void GhosttyEngine::_tickLoop() noexcept
     {
         while (!_stopping.load(std::memory_order_acquire))
diff --git a/src/cascadia/TerminalControl/GhosttyEngine.h b/src/cascadia/TerminalControl/GhosttyEngine.h
index 1feb978a3..11c4db7cb 100644
--- a/src/cascadia/TerminalControl/GhosttyEngine.h
+++ b/src/cascadia/TerminalControl/GhosttyEngine.h
@@ -35,6 +35,18 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         // must ghostty_config_free it.
         ghostty_config_t NewConfig() const noexcept;
 
+        // Run work that touches libghostty deeply, on a thread with enough
+        // stack for it, and wait for it.
+        //
+        // libghostty needs far more stack than the 1 MB MSVC gives WT's UI
+        // thread - Config is an enormous struct and parsing an entry copies it
+        // around. Bringing the engine up overflowed the UI thread first; then
+        // so did applying a config to a surface. Rather than discover the next
+        // one as a crash, anything that parses or applies configuration goes
+        // through here. Pane creation and settings changes are rare enough that
+        // a thread per call costs nothing worth optimising.
+        static void RunWithEngineStack(const std::function<void()>& work) noexcept;
+
         ~GhosttyEngine();
 
     private:
