     uint64_t GhosttyControlCore::SwapChainHandle() const
     {
         if (!_surface)
@@ -634,7 +747,36 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     {
         _settings = settings;
         _unfocusedAppearance = newAppearance;
-        // Applying them needs the config C API; see _applySettingsToConfig.
+
+        _pushSettings();
+    }
+
+    // Translate the profile into a ghostty_config_t and apply it to the
+    // surface. A surface is born with the *app's* config, so without the
+    // update call this is a silent no-op - the pane comes up correct in every
+    // respect except that it ignores every setting, which is exactly how the
+    // first version of this shipped.
+    //
+    // All of it runs on a large-stack thread: parsing config entries overflows
+    // WT's UI thread. See GhosttyEngine::RunWithEngineStack.
+    void GhosttyControlCore::_pushSettings()
+    {
+        if (!_surface || !_engine)
+        {
+            return;
+        }
+
+        GhosttyEngine::RunWithEngineStack([this]() {
+            const auto config = _engine->NewConfig();
+            if (!config)
+            {
+                return;
+            }
+            const auto freeConfig = wil::scope_exit([&]() { ghostty_config_free(config); });
+
+            _applySettingsToConfig(config);
+            ghostty_surface_update_config(_surface, config);
+        });
     }
 
     void GhosttyControlCore::ApplyAppearance(const bool /*focused*/) {}
