@@ -447,36 +516,80 @@ namespace winrt::Microsoft::Terminal::Control::implementation
 
 #pragma region Size and font
 
+    // TermControl hands out the panel's size in DIPs, but ghostty_surface_set_size
+    // takes physical pixels - it is sizing the swap chain, not a layout box.
+    // Passing DIPs makes an undersized swap chain that the panel then upscales
+    // by the composition scale: glyphs come out magnified and soft, and the
+    // edges do not quite reach, which reads as a border around the terminal.
+    // Cascadia does the same multiply (ControlCore.cpp: _panelWidth * _compositionScale).
     void GhosttyControlCore::SizeChanged(const float width, const float height)
+    {
+        _panelWidth = width;
+        _panelHeight = height;
+        _pushSize();
+    }
+
+    void GhosttyControlCore::ScaleChanged(const float scale)
+    {
+        _compositionScale = scale;
+        if (_surface)
+        {
+            ghostty_surface_set_content_scale(_surface, scale, scale);
+        }
+        _pushSize();
+    }
+
+    void GhosttyControlCore::SizeOrScaleChanged(const float width, const float height, const float scale)
+    {
+        _compositionScale = scale;
+        _panelWidth = width;
+        _panelHeight = height;
+        if (_surface)
+        {
+            ghostty_surface_set_content_scale(_surface, scale, scale);
+        }
+        _pushSize();
+    }
+
+    void GhosttyControlCore::_pushSize()
     {
         if (!_surface)
         {
             return;
         }
-        const auto w = static_cast<uint32_t>(std::max(0.0f, width));
-        const auto h = static_cast<uint32_t>(std::max(0.0f, height));
+
+        const auto w = static_cast<uint32_t>(std::lrint(std::max(0.0f, _panelWidth) * _compositionScale));
+        const auto h = static_cast<uint32_t>(std::lrint(std::max(0.0f, _panelHeight) * _compositionScale));
+
+        // Windows sends 0x0 on minimize, and a swap chain cannot be resized to
+        // zero.
         if (w == 0 || h == 0)
         {
             return;
         }
+
+        _trace(L"pushSize panel=%.1fx%.1f dips scale=%.3f -> %ux%u px", _panelWidth, _panelHeight, _compositionScale, w, h);
         ghostty_surface_set_size(_surface, w, h);
     }
 
