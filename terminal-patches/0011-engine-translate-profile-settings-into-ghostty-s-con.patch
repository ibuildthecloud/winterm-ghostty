@@ -132,13 +129,83 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     // acrylic, background image, cursor and selection colours, bell style - is
     // Phase 6 parity work and is left at ghostty's defaults on purpose, so a
     // half-applied setting never looks like a translator bug.
-    void GhosttyControlCore::_applySettingsToConfig(ghostty_config_t /*config*/) const
+    void GhosttyControlCore::_applySettingsToConfig(ghostty_config_t config) const
     {
-        // TODO(phase-5): ghostty_config_set_* has no C entry point yet - the
-        // config is populated from strings/CLI today. Wiring the five fields
-        // needs a small additive C API on the ghostty side, which is a patch of
-        // its own rather than something to fake here. Until then a ghostty pane
-        // renders with ghostty's defaults, which is visibly a working terminal.
+        if (!_settings)
+        {
+            return;
+        }
+
+        const auto set = [config](const std::string& entry) {
+            // A rejected entry is worth a log line but not a failed pane: the
+            // rest of the configuration is still worth applying.
+            if (!ghostty_config_set(config, entry.c_str()))
+            {
+                LOG_HR_MSG(E_INVALIDARG, "ghostty rejected config entry");
+                _trace(L"REJECTED %hs", entry.c_str());
+            }
+            else
+            {
+                _trace(L"set %hs", entry.c_str());
+            }
+        };
+
+        // Values may contain spaces (font families especially), and the entry
+        // syntax is the config file's, so they are quoted the way a file would.
+        const auto setQuoted = [&set](std::string_view key, std::wstring_view value) {
+            if (value.empty())
+            {
+                return;
+            }
+            set(fmt::format("{} = \"{}\"", key, til::u16u8(value)));
+        };
+
+        // --- Font ---------------------------------------------------------
+        setQuoted("font-family", _settings.FontFace());
+        if (const auto size = _settings.FontSize(); size > 0)
+        {
+            set(fmt::format("font-size = {}", size));
+        }
+
+        // --- Scrollback ---------------------------------------------------
+        // WT counts lines; ghostty's byte limit is separate and left alone.
+        // A negative HistorySize means "infinite" in WT, which is ghostty's
+        // default for the line limit, so it is simply not set.
+        if (const auto history = _settings.HistorySize(); history >= 0)
+        {
+            set(fmt::format("scrollback-limit-lines = {}", history));
+        }
+
+        // --- Padding ------------------------------------------------------
+        // WT already insets the SwapChainPanel by this same padding, so asking
+        // ghostty to pad as well would double it. Ours is therefore zero, and
+        // the pane's padding is whatever WT drew around us.
+        set("window-padding-x = 0");
+        set("window-padding-y = 0");
+        set("window-padding-balance = false");
+
+        // --- Colour scheme ------------------------------------------------
+        if (const auto scheme = _settings.try_as<Core::ICoreScheme>())
+        {
+            const auto hex = [](const Core::Color& c) {
+                return fmt::format("#{:02x}{:02x}{:02x}", c.R, c.G, c.B);
+            };
+
+            set(fmt::format("background = {}", hex(scheme.DefaultBackground())));
+            set(fmt::format("foreground = {}", hex(scheme.DefaultForeground())));
+            set(fmt::format("selection-background = {}", hex(scheme.SelectionBackground())));
+            set(fmt::format("cursor-color = {}", hex(scheme.CursorColor())));
+
+            // The 16 ANSI entries. ghostty takes them as `palette = N=#rrggbb`,
+            // one entry per line, which is why this is a loop rather than one
+            // string - the same shape a config file would have.
+            winrt::com_array<Core::Color> table;
+            scheme.GetColorTable(table);
+            for (uint32_t i = 0; i < table.size(); ++i)
+            {
+                set(fmt::format("palette = {}={}", i, hex(table[i])));
+            }
+        }
     }
 
