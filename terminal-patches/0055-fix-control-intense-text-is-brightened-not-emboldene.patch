+    // intenseTextStyle is two switches, and both were missing. Found by
+    // running `top` in a ghostty pane next to a cascadia one on the same
+    // profile: cascadia drew the intense headers bright white (#F2F2F2) where
+    // ghostty left them the plain foreground (#CCCCCC), and ghostty drew them
+    // with a bold face where cascadia - under WT's default, which is bright
+    // and not bold - drew regular strokes.
+    void GhosttySettingsTests::IntenseTextStyleIsForwarded()
+    {
+        // A scheme whose foreground is also palette entry 7, which is the
+        // ordinary case - Campbell and every scheme derived from it are built
+        // that way - and the case that made this visible.
+        const auto scheme = [](bool bright, bool bold) {
+            auto s = _settings();
+            s->IntenseIsBright(bright);
+            s->IntenseIsBold(bold);
+            s->DefaultForeground(til::color{ 0xcc, 0xcc, 0xcc });
+
+            std::array<winrt::Microsoft::Terminal::Core::Color, 16> table{};
+            for (uint32_t i = 0; i < table.size(); ++i)
+            {
+                table[i] = til::color{ gsl::narrow_cast<uint8_t>(i), 0x20, 0x30 };
+            }
+            table[7] = til::color{ 0xcc, 0xcc, 0xcc };
+            table[15] = til::color{ 0xf2, 0xf2, 0xf2 };
+            s->SetColorTable(table);
+            return s;
+        };
+
+        // WT's default: bright, not bold.
+        {
+            const auto entries = Control::implementation::TranslateGhosttySettings(*scheme(true, false));
+
+            VERIFY_IS_TRUE(_has(entries, "bold-color", "#f2f2f2"),
+                           L"the default foreground is palette 7, so intense text is its bright twin");
+            VERIFY_IS_TRUE(_has(entries, "font-style-bold", "false"),
+                           L"cascadia does not reach for a bold face unless asked");
+        }
+
+        // "all": both halves on, so ghostty keeps its own bold face.
+        {
+            const auto entries = Control::implementation::TranslateGhosttySettings(*scheme(true, true));
+
+            VERIFY_IS_TRUE(_has(entries, "bold-color", "#f2f2f2"));
+            VERIFY_IS_FALSE(_hasKey(entries, "font-style-bold"),
+                            L"a bold face is ghostty's default; say nothing");
+        }
+
+        // "none": neither, which is the one case that leaves the colour alone.
+        {
+            const auto entries = Control::implementation::TranslateGhosttySettings(*scheme(false, false));
+
+            VERIFY_IS_FALSE(_hasKey(entries, "bold-color"),
+                            L"without bright, intense text keeps its colour");
+            VERIFY_IS_TRUE(_has(entries, "font-style-bold", "false"));
+        }
+
+        // A foreground that is not in the dark half of the palette: cascadia
+        // leaves it as it is, and so must we - `bright` still moves the
+        // indexed colours, which is all cascadia moves here too.
+        {
+            auto s = scheme(true, false);
+            s->DefaultForeground(til::color{ 0xab, 0xcd, 0xef });
+
+            const auto entries = Control::implementation::TranslateGhosttySettings(*s);
+
+            VERIFY_IS_TRUE(_has(entries, "bold-color", "bright"));
+        }
+    }
+
     // The one escaping rule left, and it belongs to the field rather than to
     // the entry. ghostty parses selection-word-chars as a Zig string literal,
     // so a lone backslash starts an escape sequence there - and WT's default
