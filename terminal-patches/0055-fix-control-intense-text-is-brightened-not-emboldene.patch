+        // A triple click highlights the whole width of the line here, the way
+        // cascadia's does. ghostty's own default stops where the line's content
+        // stops, which reads as a highlight that falls short next to a cascadia
+        // pane in the same window. What gets copied is trimmed either way, so
+        // this widens the highlight without putting trailing spaces on the
+        // clipboard - measured, because that was the regression to fear.
+        set("selection-trim-line", "false");
+
+        // --- Cursor -------------------------------------------------------
+        // Found by hand: a ghostty pane drew a block where the cascadia pane
+        // beside it drew a bar, because the profile's cursorShape was never
+        // forwarded and ghostty used its own default.
+        //
+        // All six shapes map exactly. ghostty had four until patch 31 added the
+        // two DECSCUSR has no name for - a stacked double underline and the
+        // thick bottom bar the Windows console has drawn for decades. They were
+        // both collapsed onto a plain underline before that, which was not an
+        // approximation so much as a different shape.
+        //
+        // CursorHeight is still not forwarded: it exists to size Vintage, and
+        // cursor-style underline_thick is a fixed quarter of the cell - which is
+        // what WT itself defaults cursorHeight to. Sending a height would imply
+        // an effect ghostty has no setting for.
+        //
+        // Only the default is set here. A program can still ask for a different
+        // shape with DECSCUSR, on either engine, and ghostty's shell
+        // integration puts a bar at the prompt regardless - so a profile's
+        // cursorShape is the starting point rather than the last word.
+        if (const auto appearance = settings.try_as<Core::ICoreAppearance>())
+        {
+            switch (appearance.CursorShape())
+            {
+            case Core::CursorStyle::Bar:
+                set("cursor-style", "bar");
+                break;
+            case Core::CursorStyle::Underscore:
+                set("cursor-style", "underline");
+                break;
+            case Core::CursorStyle::DoubleUnderscore:
+                set("cursor-style", "underline_double");
+                break;
+            case Core::CursorStyle::Vintage:
+                set("cursor-style", "underline_thick");
+                break;
+            case Core::CursorStyle::EmptyBox:
+                set("cursor-style", "block_hollow");
+                break;
+            case Core::CursorStyle::FilledBox:
+                set("cursor-style", "block");
+                break;
+            }
+
+            // --- Intense text, the face half ------------------------------
+            // WT's intenseTextStyle is two independent switches, and neither
+            // was forwarded. This is the one that runs against ghostty:
+            // cascadia only reaches for a bold *face* when the style includes
+            // bold, and WT's default does not - so under the same profile the
+            // ghostty pane was the one drawing heavier strokes. `false` is
+            // ghostty's own spelling for "this style is disabled", and a
+            // disabled style falls back to the regular face, which is what
+            // cascadia draws.
+            //
+            // Bold+italic is deliberately left alone. Matching cascadia there
+            // means "italic, not bold-italic", which ghostty can only be told
+            // as a named style of that particular font; disabling the style
+            // instead would drop the italic rather than the weight.
+            //
+            // The colour half needs the palette, so it lives with the scheme
+            // below.
+            if (!appearance.IntenseIsBold())
+            {
+                set("font-style-bold", "false");
+            }
+        }
+
+        // Cascadia draws no cursor at all in an unfocused pane; ghostty's
+        // default - like most terminals - is a hollow block, so every shape
+        // became the same hollow box the moment focus moved. Next to a cascadia
+        // pane that is simply wrong rather than merely different.
+        set("cursor-style-unfocused", "hidden");
+
         // --- Padding ------------------------------------------------------
         // WT already insets the SwapChainPanel by this same padding, so asking
         // ghostty to pad as well would double it. Ours is therefore zero, and
@@ -185,6 +207,43 @@ namespace winrt::Microsoft::Terminal::Control::implementation
             {
                 set("palette", fmt::format("{}={}", i, hex(table[i])));
             }
+
+            // --- Intense text, the colour half ----------------------------
+            // Found by running `top` in both panes on one profile: cascadia
+            // drew the intense headers bright white and ghostty left them the
+            // plain foreground. Sampled off the screenshot, #F2F2F2 against
+            // #CCCCCC.
+            //
+            // `bold-color = bright` alone does not close that gap. It lifts a
+            // *palette* colour to its bright twin, but text in the default
+            // foreground has no index to brighten, and on a `top` screen that
+            // is most of the intense text. cascadia handles that case by
+            // looking the default foreground up in the dark half of the
+            // palette and using the bright entry it matches - so do the same
+            // lookup here and hand ghostty that colour outright. Naming a
+            // colour also turns the rest of the bold colours bright, which is
+            // the other half of cascadia's rule, so this one entry covers
+            // both.
+            //
+            // No match means the foreground is genuinely its own colour, which
+            // is the case cascadia leaves alone too; `bright` is then exactly
+            // right, because only indexed colours move.
+            if (const auto appearance = settings.try_as<Core::ICoreAppearance>();
+                appearance && appearance.IntenseIsBright())
+            {
+                const auto fg = scheme.DefaultForeground();
+                std::string bold;
+                for (uint32_t i = 0; i + 8 < table.size() && i < 8; ++i)
+                {
+                    const auto& c = table[i];
+                    if (c.R == fg.R && c.G == fg.G && c.B == fg.B)
+                    {
+                        bold = hex(table[i + 8]);
+                        break;
+                    }
+                }
+                set("bold-color", bold.empty() ? "bright" : bold);
+            }
         }
 
         return entries;
