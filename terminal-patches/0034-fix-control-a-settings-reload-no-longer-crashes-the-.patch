     }
 
+    // The two engines count matches from opposite ends of the buffer.
+    //
+    // ghostty's first selection is the *newest* match and carries index 0
+    // (search/screen.zig: selectNext with no prior match takes
+    // active_results[len - 1] and assigns idx 0), and the index grows going
+    // backwards in time. Windows Terminal's status box means "the Nth match
+    // counting from the top". Reported unconverted, "1/9" highlighted what
+    // cascadia calls 9.
+    int32_t GhosttyControlCore::_currentMatchFromTop() const noexcept
+    {
+        if (_searchSelected < 0 || _searchTotal <= 0 || _searchSelected >= _searchTotal)
+        {
+            return -1;
+        }
+        return _searchTotal - 1 - _searchSelected;
+    }
+
+    // Same inversion, applied to the direction. ghostty's "next" walks *up* the
+    // buffer - it increments an index that counts backwards in time - where
+    // WT's "find next" walks down it. Forwarded unconverted, Enter and
+    // shift+Enter moved the highlight the wrong way in a ghostty pane while the
+    // numbers next to them counted the right way.
+    void GhosttyControlCore::_navigateSearch(bool goForward) const
