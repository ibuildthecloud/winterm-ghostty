   <Identity
-    Name="WintermGhostty"
+    Name="WintermGhosttyDev"
     Publisher="CN=Darren Shepherd"
     Version="0.1.0.0" />
 
@@ -76,17 +76,16 @@
       </uap:VisualElements>
 
       <Extensions>
-        <!-- Alias wtg, not wtd. An app execution alias is machine-global:
-             shipping "wtd.exe" would take the alias away from a real Windows
-             Terminal Dev install, and people running a Dev build are exactly
-             who would install this.
+        <!-- wtgd: the dev channel's alias, distinct from the shipped wtg.exe
+             so both can be installed at once, and from upstream's wtd.exe so
+             neither takes the alias from a real Windows Terminal Dev install.
              Executable stays wtd.exe - that names a file *inside* the package,
              which is what src\cascadia\wt builds under Dev branding, and the
-             two do not have to match. The alias file Windows creates is named
-             after Alias, so WtExeUtils.h looks for wtg.exe. -->
+             two do not have to match; MakeAppx rejects an Executable naming a
