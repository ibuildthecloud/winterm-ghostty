+++ b/src/cascadia/UnitTests_Control/GhosttySearchTests.cpp
@@ -0,0 +1,188 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Search across a synchronous/asynchronous seam.
+//
+// IControlCore::Search is synchronous: Windows Terminal asks and expects the
+// answer in the return value. ghostty searches on a thread of its own and
+// reports the counts back later, as actions. So the ghostty core's Search()
+// starts the work and returns what it knows at the time - which, for a needle
+// it has not seen before, is nothing.
+//
+// What it returns while it waits is the part worth pinning. A negative total is
+// not a placeholder: SearchBoxControl renders it as "Searching...", so the
+// honest answer and the right-looking one are the same answer. Returning 0
+// would say "no matches" about a search that has not run.
+//
+// This drives the real core through IControlCore, so it needs no
+// implementation access - and on a machine where libghostty cannot start, the
+// factory hands back cascadia's core instead and the ghostty-specific
+// expectations are skipped rather than failed.
+
+#include "pch.h"
+#include "../TerminalControl/ControlInteractivity.h"
+#include "../TerminalControl/ControlCore.h"
+#include "MockControlSettings.h"
+#include "MockConnection.h"
+
+using namespace WEX::Logging;
+using namespace WEX::TestExecution;
+using namespace WEX::Common;
+
+using namespace winrt;
+using namespace winrt::Microsoft::Terminal;
+
+namespace ControlUnitTests
+{
+    class GhosttySearchTests
+    {
+        BEGIN_TEST_CLASS(GhosttySearchTests)
+            TEST_CLASS_PROPERTY(L"TestTimeout", L"0:1:00")
+        END_TEST_CLASS()
+
+        TEST_METHOD(CascadiaSupportsRegexAndCase);
+        TEST_METHOD(GhosttySupportsNeitherRegexNorCase);
+        TEST_METHOD(ANewNeedleIsInvalidatedAndNotYetCounted);
+        TEST_METHOD(NavigatingTheSameNeedleDoesNotInvalidate);
+        TEST_METHOD(AnEmptySearchClears);
+
+    private:
+        struct Core
+        {
+            winrt::com_ptr<Control::implementation::ControlInteractivity> interactivity;
+            Control::IControlCore core{ nullptr };
+            bool isGhostty{ false };
+        };
+
+        static Core _core(Control::TerminalEngine engine)
+        {
+            auto settings = winrt::make_self<MockControlSettings>();
+            settings->Engine(engine);
+            auto conn = winrt::make_self<MockConnection>();
+
+            Core c;
+            c.interactivity = winrt::make_self<Control::implementation::ControlInteractivity>(
+                *settings, *settings, *conn);
+            VERIFY_IS_NOT_NULL(c.interactivity);
+
+            // Same as the rest of this suite: cascadia's core starts a real
+            // renderer otherwise, and tearing one down in a test host hangs.
+            if (const auto cascadia = c.interactivity->_cascadiaCore())
+            {
+                cascadia->_inUnitTests = true;
+            }
+            else
+            {
+                c.isGhostty = true;
+            }
+            c.core = c.interactivity->Core();
+            VERIFY_IS_NOT_NULL(c.core);
+            return c;
+        }
+
+        // Returns false and logs when libghostty did not come up here, so the
+        // ghostty-specific tests skip rather than fail on such a machine.
+        static bool _requireGhostty(const Core& c)
+        {
+            if (!c.isGhostty)
+            {
+                Log::Comment(L"libghostty is unavailable here; the factory fell back to cascadia. Skipping.");
+            }
+            return c.isGhostty;
+        }
+
+        static Control::SearchRequest _request(std::wstring_view text, bool execute, bool forward = true)
+        {
+            return Control::SearchRequest{
+                .Text = winrt::hstring{ text },
+                .GoForward = forward,
+                .CaseSensitive = false,
+                .RegularExpression = false,
+                .ExecuteSearch = execute,
+                .ScrollIntoView = true,
+                .ScrollOffset = 0,
+            };
+        }
+    };
+
+    void GhosttySearchTests::CascadiaSupportsRegexAndCase()
+    {
+        const auto c = _core(Control::TerminalEngine::Cascadia);
+        VERIFY_IS_TRUE(c.core.SearchSupportsRegex());
+        VERIFY_IS_TRUE(c.core.SearchSupportsCaseSensitivity());
+    }
+
+    // ghostty's needle is a plain byte string - no regex, no case folding. The
+    // search box reads these and disables the toggles; a toggle left clickable
+    // would let a user ask for something and be told, by results that look
+    // authoritative, that they got it.
+    void GhosttySearchTests::GhosttySupportsNeitherRegexNorCase()
+    {
+        const auto c = _core(Control::TerminalEngine::Ghostty);
+        if (!_requireGhostty(c))
+        {
+            return;
+        }
+        VERIFY_IS_FALSE(c.core.SearchSupportsRegex());
+        VERIFY_IS_FALSE(c.core.SearchSupportsCaseSensitivity());
+    }
+
+    // The first ask for a needle: the search has been started and nothing has
+    // come back yet. SearchInvalidated is what makes TermControl redraw the
+    // scrollbar, and a negative total is what the status box reads as
+    // "Searching..." - both are true, and neither is a guess.
+    void GhosttySearchTests::ANewNeedleIsInvalidatedAndNotYetCounted()
+    {
+        const auto c = _core(Control::TerminalEngine::Ghostty);
+        if (!_requireGhostty(c))
+        {
+            return;
+        }
+
+        const auto results = c.core.Search(_request(L"needle", false));
+        VERIFY_IS_TRUE(results.SearchInvalidated, L"a new needle invalidates the previous results");
+        VERIFY_ARE_EQUAL(-1, results.TotalMatches, L"nothing has been counted yet - not zero, unknown");
+        VERIFY_ARE_EQUAL(-1, results.CurrentMatch);
+        VERIFY_IS_FALSE(results.SearchRegexInvalid, L"there is no regex to be invalid");
+    }
+
+    // Every keystroke in the search box asks again with the same needle, and
+    // Enter asks again with ExecuteSearch. Neither is a new search: saying so
+    // would make TermControl rebuild the scrollbar on every navigation.
+    void GhosttySearchTests::NavigatingTheSameNeedleDoesNotInvalidate()
+    {
+        const auto c = _core(Control::TerminalEngine::Ghostty);
+        if (!_requireGhostty(c))
+        {
+            return;
+        }
+
+        VERIFY_IS_TRUE(c.core.Search(_request(L"needle", false)).SearchInvalidated);
+        VERIFY_IS_FALSE(c.core.Search(_request(L"needle", true)).SearchInvalidated);
+        VERIFY_IS_FALSE(c.core.Search(_request(L"needle", true, false)).SearchInvalidated);
+        VERIFY_IS_TRUE(c.core.Search(_request(L"other", false)).SearchInvalidated,
+                       L"a different needle is a different search");
+    }
+
+    // Clearing the box ends the search rather than searching for nothing, and
+    // it forgets the needle - so retyping the same one starts over instead of
+    // being mistaken for navigation within a search that no longer exists.
+    void GhosttySearchTests::AnEmptySearchClears()
+    {
+        const auto c = _core(Control::TerminalEngine::Ghostty);
+        if (!_requireGhostty(c))
+        {
+            return;
+        }
+
+        c.core.Search(_request(L"needle", false));
+
+        const auto cleared = c.core.Search(_request(L"", false));
+        VERIFY_ARE_EQUAL(0, cleared.TotalMatches);
+        VERIFY_ARE_EQUAL(0, cleared.CurrentMatch);
+        VERIFY_IS_FALSE(cleared.SearchInvalidated);
+
+        VERIFY_IS_TRUE(c.core.Search(_request(L"needle", false)).SearchInvalidated,
+                       L"the same needle after a clear is a new search, not a navigation");
+    }
+}
