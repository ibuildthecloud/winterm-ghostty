+// Type Description:
+// - Which IControlCore implementation backs a pane (ADR 0007).
+//
+// This one deliberately does NOT inherit EnumMapper's strictness. Every other
+// enum setting throws DeserializationError on an unrecognised value, and
+// SettingsLoader rethrows that as a hard settings-load failure - the user gets
+// an error dialog and none of their settings apply.
+//
+// That is the wrong outcome here. "ghostty" is the value users will reach for
+// first, and it stays unrecognised until that engine ships, so a typo-grade
+// mistake would break the whole settings file. Instead an unknown value falls
+// back to the default; Profile::LayerJson notices the fallback and raises
+// SettingsLoadWarnings::UnknownEngine.
+JSON_ENUM_MAPPER(::winrt::Microsoft::Terminal::Control::TerminalEngine)
+{
+    static constexpr std::array<pair_type, 1> mappings = {
+        pair_type{ "cascadia", ValueType::Cascadia }
+    };
+
+    ValueType FromJson(const Json::Value& json) const
+    {
+        const auto name{ Detail::GetStringView(json) };
+        for (const auto& pair : mappings)
+        {
+            if (pair.first == name)
+            {
+                return pair.second;
+            }
+        }
+        return ValueType::Cascadia;
+    }
+};
+
 // Type Description:
 // - Helper for converting a user-specified closeOnExit value to its corresponding enum
 JSON_ENUM_MAPPER(::winrt::Microsoft::Terminal::Settings::Model::CloseOnExitMode)
