+    void ProfileTests::ProfileEngineSetting()
+    {
+        // The per-profile "engine" setting (ADR 0007). Only "cascadia" is valid
+        // today, so this pins the three behaviours the phase contracts for:
+        // it parses, it defaults, and an unknown value degrades to a warning
+        // rather than failing the whole settings load.
+        static constexpr std::string_view userSettings{ R"({
+            "profiles": {
+                "list": [
+                    {
+                        "name": "explicit",
+                        "guid": "{6239a42c-0000-49a3-80bd-e8fdd045185c}",
+                        "engine": "cascadia"
+                    },
+                    {
+                        "name": "unset",
+                        "guid": "{6239a42c-1111-49a3-80bd-e8fdd045185c}"
+                    },
+                    {
+                        "name": "unknown",
+                        "guid": "{6239a42c-2222-49a3-80bd-e8fdd045185c}",
+                        "engine": "ghostty"
+                    }
+                ]
+            }
+        })" };
+
+        // Note this does not throw. Every other enum setting would: an
+        // unrecognised value normally becomes a DeserializationError that
+        // SettingsLoader rethrows as a hard settings-load failure.
+        const auto settings = winrt::make_self<implementation::CascadiaSettings>(userSettings);
+        const auto allProfiles = settings->AllProfiles();
+        VERIFY_ARE_EQUAL(3u, allProfiles.Size());
+
+        // "cascadia" parses.
+        VERIFY_ARE_EQUAL(winrt::Microsoft::Terminal::Control::TerminalEngine::Cascadia,
+                         allProfiles.GetAt(0).Engine());
+
+        // Absent means cascadia - it stays the default indefinitely (ADR 0007).
+        VERIFY_ARE_EQUAL(winrt::Microsoft::Terminal::Control::TerminalEngine::Cascadia,
+                         allProfiles.GetAt(1).Engine());
+
+        // An unknown engine falls back rather than failing the load. "ghostty"
+        // is the value users will reach for first, and it stays unrecognised
+        // until that engine ships.
+        VERIFY_ARE_EQUAL(winrt::Microsoft::Terminal::Control::TerminalEngine::Cascadia,
+                         allProfiles.GetAt(2).Engine());
+
+        // ...and the fallback is reported rather than silent.
+        auto sawUnknownEngine = false;
+        for (const auto& warning : settings->Warnings())
+        {
+            if (warning == SettingsLoadWarnings::UnknownEngine)
+            {
+                sawUnknownEngine = true;
+            }
+        }
+        VERIFY_IS_TRUE(sawUnknownEngine, L"expected SettingsLoadWarnings::UnknownEngine");
+    }
+
     void ProfileTests::SettingInheritanceFallback()
     {
         // Verify that when no layer defines a setting, the default value is used.
