+// Method Description:
+// - Warns if any profile named an "engine" that is not recognised (ADR 0007).
+//   Unlike other enum settings, an unknown engine does not fail the settings
+//   load - it falls back to the default - so without this the substitution
+//   would be silent.
+void CascadiaSettings::_validateEnginesExist()
+{
+    for (const auto& profile : _allProfiles)
+    {
+        if (winrt::get_self<Profile>(profile)->_EngineValueUnrecognized)
+        {
+            _warnings.Append(SettingsLoadWarnings::UnknownEngine);
+            return;
+        }
+    }
+}
