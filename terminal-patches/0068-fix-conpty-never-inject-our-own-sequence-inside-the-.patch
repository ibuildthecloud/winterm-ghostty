@@ -607,6 +683,28 @@ void VtIo::Writer::WriteUTF16(std::wstring_view str) const
 
 // When DISABLE_NEWLINE_AUTO_RETURN is not set (Bad! Don't do it!) we'll do newline translation for you.
 // That's the only difference of this function from WriteUTF16: It does LF -> CRLF translation.
+// The application's own output, passed through verbatim.
+//
+// Told apart from everything else we write because it is the only thing that
+// can leave the stream mid-sequence: a write can end anywhere, including inside
+// an escape sequence, and the rest arrives later. Following it here is what lets
+// _ownSink() hold our own sequences back until the application's is finished.
+void VtIo::Writer::WritePassthrough(const std::wstring_view str, const bool disableNewlineTranslation) const
+{
+    const auto trackFrom = _io->_back.size();
+
+    if (disableNewlineTranslation)
+    {
+        WriteUTF16(str);
+    }
+    else
+    {
+        WriteUTF16TranslateCRLF(str);
+    }
+
+    _io->_trackPassthrough(std::string_view{ _io->_back }.substr(trackFrom));
+}
