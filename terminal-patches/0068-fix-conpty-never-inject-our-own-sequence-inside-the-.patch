+// Follows the application's own bytes through their escape sequences, so that
+// _ownSink() knows whether it is safe to add ours.
+//
+// Only enough VT to answer one question: is the passthrough stream mid-sequence?
+// Ground means every sequence it has written so far is finished.
+void VtIo::_trackPassthrough(const std::string_view chunk) noexcept
+{
+    for (const auto ch : chunk)
+    {
+        const auto c = static_cast<unsigned char>(ch);
+
+        switch (_passthroughState)
+        {
+        case PassthroughState::Ground:
+            if (c == 0x1b)
+            {
+                _passthroughState = PassthroughState::Escape;
+            }
+            break;
+        case PassthroughState::Escape:
+            if (c == '[')
+            {
+                _passthroughState = PassthroughState::Csi;
+            }
+            else if (c == ']' || c == 'P' || c == 'X' || c == '^' || c == '_')
+            {
+                _passthroughState = PassthroughState::String;
+            }
+            else
+            {
+                // A two-byte escape, and the ST of a string sequence lands here
+                // as well - either way the sequence is over.
+                _passthroughState = PassthroughState::Ground;
+            }
+            break;
+        case PassthroughState::Csi:
+            // Parameter and intermediate bytes are 0x20-0x3f; a final byte in
+            // 0x40-0x7e ends it.
+            if (c >= 0x40 && c <= 0x7e)
+            {
+                _passthroughState = PassthroughState::Ground;
+            }
+            break;
+        case PassthroughState::String:
+            if (c == 0x07)
+            {
+                _passthroughState = PassthroughState::Ground;
+            }
+            else if (c == 0x1b)
+            {
+                // Presumably the ESC of an ST; the next byte returns us to
+                // ground whatever it is.
+                _passthroughState = PassthroughState::Escape;
+            }
+            break;
+        }
+    }
+
+    // Back at a boundary: anything of ours that was waiting can go out now,
+    // after the application's completed sequence rather than inside it.
+    if (_passthroughState == PassthroughState::Ground && !_pendingOwnWrites.empty())
+    {
+        _back.append(_pendingOwnWrites);
+        _pendingOwnWrites.clear();
+    }
+}
+
+// Where a sequence *we* generate should go: straight out if the application is
+// between sequences, or into the pending buffer if it is part-way through one.
+std::string& VtIo::_ownSink() noexcept
+{
+    return _passthroughState == PassthroughState::Ground ? _back : _pendingOwnWrites;
+}
+
 void VtIo::Writer::BackupCursor() const
 {
     if (!_io->_writerRestoreCursor)
     {
         _io->_writerRestoreCursor = true;
-        _io->_back.append("\x1b\x37"); // DECSC: DEC Save Cursor (+ attributes)
+        _io->_ownSink().append("\x1b\x37"); // DECSC: DEC Save Cursor (+ attributes)
     }
 }
 
