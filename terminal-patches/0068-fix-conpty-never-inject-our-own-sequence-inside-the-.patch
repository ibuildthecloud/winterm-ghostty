+        // NoInjectionInsideAnIncompleteSequence.
+        enum class PassthroughState : uint8_t
+        {
+            Ground,
+            Escape,
+            Csi,
+            String, // OSC, DCS, SOS, PM, APC - anything ended by BEL or ST
+        };
+        PassthroughState _passthroughState = PassthroughState::Ground;
+        std::string _pendingOwnWrites;
+
+        void _trackPassthrough(std::string_view chunk) noexcept;
+        std::string& _ownSink() noexcept;
+
         OVERLAPPED* _overlapped = nullptr;
