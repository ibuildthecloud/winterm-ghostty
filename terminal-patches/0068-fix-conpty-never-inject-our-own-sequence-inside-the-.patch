diff --git a/src/host/ut_host/VtIoTests.cpp b/src/host/ut_host/VtIoTests.cpp
index 6de23ae0f..f2b41df2c 100644
--- a/src/host/ut_host/VtIoTests.cpp
+++ b/src/host/ut_host/VtIoTests.cpp
@@ -270,6 +270,116 @@ class ::Microsoft::Console::VirtualTerminal::VtIoTests
         VERIFY_ARE_EQUAL(expected, actual);
     }
 
+    // conpty: conhost must never put its own escape sequence inside one the
+    // application is still writing.
+    //
+    // In ConPTY mode the application's bytes are passed through verbatim, and a
+    // single write can end in the middle of a sequence - WSL splits writes at
+    // arbitrary offsets, as the comment in stateMachine.cpp about "16 byte
+    // chunks" notes. Anything conhost appends to the same buffer at that moment
+    // lands between the head and the tail. The terminal then sees a complete
+    // CSI wedged inside an incomplete one: the inner ESC aborts the sequence in
+    // progress, and the tail is printed as text.
+    //
+    // Seen in the wild after the cursor re-sync began firing on every unknown
+    // sequence, appending ESC [ 6 n: an SGR arrived at the terminal as the bare
+    // text ";240m", another as "[95m", and an ECH as "291X" - three fragments,
+    // three split offsets, one cause. Any conhost-originated write carries the
+    // same hazard, so this test provokes it with a cursor position report,
+    // which needs no VT input thread.
+    TEST_METHOD(NoInjectionInsideAnIncompleteSequence)
+    {
+        resetContents();
+        readOutput();
+
+        // The passthrough path is the one an application with VT processing on
+        // takes - which is what a WSL shell does, and the only path where an
+        // escape sequence survives to be split.
+        const auto initialMode = screenInfo->OutputMode;
+        const auto cleanup = wil::scope_exit([=]() {
+            screenInfo->OutputMode = initialMode;
+        });
+        screenInfo->OutputMode = ENABLE_PROCESSED_OUTPUT | ENABLE_VIRTUAL_TERMINAL_PROCESSING | DISABLE_NEWLINE_AUTO_RETURN;
+
+        size_t written;
+
+        // The head of an SGR sequence: this is where the pipe split it.
+        THROW_IF_FAILED(routines.WriteConsoleWImpl(*screenInfo, L"\x1b[38;5", written, nullptr));
+
+        // conhost emits something of its own, as it does for a cursor re-sync
+        // or any API call that has to report state.
+        THROW_IF_FAILED(routines.SetConsoleCursorPositionImpl(*screenInfo, { 2, 1 }));
+
+        // The rest of the application's sequence.
+        THROW_IF_FAILED(routines.WriteConsoleWImpl(*screenInfo, L";240m", written, nullptr));
+
+        const auto actual = readOutput();
+
+        // The failure is an ESC arriving between the head and the tail.
+        const auto torn = actual.find("\x1b[38;5\x1b") != std::string_view::npos;
+        if (torn)
+        {
+            Log::Comment(NoThrowString().Format(L"torn stream: %hs", std::string{ actual }.c_str()));
+        }
+        VERIFY_IS_FALSE(torn, L"conhost injected its own sequence inside the application's");
+
+        // And the application's sequence still has to arrive whole.
+        VERIFY_IS_TRUE(actual.find("\x1b[38;5;240m") != std::string_view::npos,
+                       L"the application's sequence did not survive intact");
+    }
+
+    // The same hazard for a string sequence. These end on BEL or ST rather than
+    // a final byte, so they stay open across far more bytes than a CSI does -
+    // an OSC 8 hyperlink or a long title is easily split.
+    TEST_METHOD(NoInjectionInsideAnIncompleteStringSequence)
+    {
+        resetContents();
+        readOutput();
+
+        const auto initialMode = screenInfo->OutputMode;
+        const auto cleanup = wil::scope_exit([=]() {
+            screenInfo->OutputMode = initialMode;
+        });
+        screenInfo->OutputMode = ENABLE_PROCESSED_OUTPUT | ENABLE_VIRTUAL_TERMINAL_PROCESSING | DISABLE_NEWLINE_AUTO_RETURN;
+
+        size_t written;
+
+        // An OSC that has not been terminated yet.
+        THROW_IF_FAILED(routines.WriteConsoleWImpl(*screenInfo, L"\x1b]0;partial", written, nullptr));
+        THROW_IF_FAILED(routines.SetConsoleCursorPositionImpl(*screenInfo, { 2, 1 }));
+        // ST, which closes it.
+        THROW_IF_FAILED(routines.WriteConsoleWImpl(*screenInfo, L"\x1b\\", written, nullptr));
+
+        const auto actual = readOutput();
+        VERIFY_IS_TRUE(actual.find("\x1b]0;partial\x1b\\") != std::string_view::npos,
+                       L"the application's string sequence did not survive intact");
+    }
+
+    // The other half of the contract: waiting for a sequence to finish must not
+    // turn into holding our own writes back when there is nothing to wait for.
+    // Between sequences they go out as they always did.
+    TEST_METHOD(OwnWritesAreNotHeldBackBetweenSequences)
+    {
+        resetContents();
+        readOutput();
+
+        const auto initialMode = screenInfo->OutputMode;
+        const auto cleanup = wil::scope_exit([=]() {
+            screenInfo->OutputMode = initialMode;
+        });
+        screenInfo->OutputMode = ENABLE_PROCESSED_OUTPUT | ENABLE_VIRTUAL_TERMINAL_PROCESSING | DISABLE_NEWLINE_AUTO_RETURN;
+
+        size_t written;
+
+        // A complete sequence this time.
+        THROW_IF_FAILED(routines.WriteConsoleWImpl(*screenInfo, L"\x1b[38;5;240m", written, nullptr));
+        THROW_IF_FAILED(routines.SetConsoleCursorPositionImpl(*screenInfo, { 2, 1 }));
+
+        const auto actual = readOutput();
+        VERIFY_IS_TRUE(actual.find("\x1b[2;3H") != std::string_view::npos,
+                       L"our own sequence was withheld when the stream was at a boundary");
+    }
+
     TEST_METHOD(WriteConsoleOutputW)
     {
         resetContents();
