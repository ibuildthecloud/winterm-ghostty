diff --git a/src/cascadia/TerminalControl/GhosttySettingsTranslator.cpp b/src/cascadia/TerminalControl/GhosttySettingsTranslator.cpp
new file mode 100644
index 000000000..7383149bd
--- /dev/null
+++ b/src/cascadia/TerminalControl/GhosttySettingsTranslator.cpp
@@ -0,0 +1,96 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+
+#include "pch.h"
+#include "GhosttySettingsTranslator.h"
+
+using namespace winrt::Microsoft::Terminal;
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    // Settings -> the `key = value` entries ghostty's config parser takes.
+    //
+    // The MVP scope is deliberately five fields (font, size, scheme,
+    // scrollback, padding): the ones without which a pane is visibly wrong
+    // rather than merely unstyled. Everything else - opacity, acrylic,
+    // background image, bell style - is Phase 6 parity work and is left at
+    // ghostty's defaults on purpose, so a half-applied setting never looks
+    // like a translator bug.
+    //
+    // Pure on purpose, and in its own file so that file can be compiled into
+    // the unit tests: it touches no engine state, so it needs no libghostty,
+    // no GPU and no pty - unlike everything else in GhosttyControlCore, which
+    // needs a live surface. Every rule encoded here (quoting, the
+    // negative-history case, padding pinned to zero) was learned from a bug,
+    // so each one is worth pinning down in a test.
+    std::vector<std::string> TranslateGhosttySettings(const Control::IControlSettings& settings)
+    {
+        std::vector<std::string> entries;
+        if (!settings)
+        {
+            return entries;
+        }
+
+        // Values may contain spaces (font families especially), and the entry
+        // syntax is the config file's, so they are quoted the way a file would.
+        const auto setQuoted = [&entries](std::string_view key, std::wstring_view value) {
+            if (value.empty())
+            {
+                return;
+            }
+            entries.push_back(fmt::format("{} = \"{}\"", key, til::u16u8(value)));
+        };
+        const auto set = [&entries](std::string entry) {
+            entries.push_back(std::move(entry));
+        };
+
+        // --- Font ---------------------------------------------------------
+        setQuoted("font-family", settings.FontFace());
+        if (const auto size = settings.FontSize(); size > 0)
+        {
+            set(fmt::format("font-size = {}", size));
+        }
+
+        // --- Scrollback ---------------------------------------------------
+        // WT counts lines; ghostty's byte limit is separate and left alone.
+        // A negative HistorySize means "infinite" in WT, which is ghostty's
+        // default for the line limit, so it is simply not set.
+        if (const auto history = settings.HistorySize(); history >= 0)
+        {
+            set(fmt::format("scrollback-limit-lines = {}", history));
+        }
+
+        // --- Padding ------------------------------------------------------
+        // WT already insets the SwapChainPanel by this same padding, so asking
+        // ghostty to pad as well would double it. Ours is therefore zero, and
+        // the pane's padding is whatever WT drew around us.
+        set("window-padding-x = 0");
+        set("window-padding-y = 0");
+        set("window-padding-balance = false");
+
+        // --- Colour scheme ------------------------------------------------
+        if (const auto scheme = settings.try_as<Core::ICoreScheme>())
+        {
+            const auto hex = [](const Core::Color& c) {
+                return fmt::format("#{:02x}{:02x}{:02x}", c.R, c.G, c.B);
+            };
+
+            set(fmt::format("background = {}", hex(scheme.DefaultBackground())));
+            set(fmt::format("foreground = {}", hex(scheme.DefaultForeground())));
+            set(fmt::format("selection-background = {}", hex(scheme.SelectionBackground())));
+            set(fmt::format("cursor-color = {}", hex(scheme.CursorColor())));
+
+            // The 16 ANSI entries. ghostty takes them as `palette = N=#rrggbb`,
+            // one entry per line, which is why this is a loop rather than one
+            // string - the same shape a config file would have.
+            winrt::com_array<Core::Color> table;
+            scheme.GetColorTable(table);
+            for (uint32_t i = 0; i < table.size(); ++i)
+            {
+                set(fmt::format("palette = {}={}", i, hex(table[i])));
+            }
+        }
+
+        return entries;
+    }
+}
