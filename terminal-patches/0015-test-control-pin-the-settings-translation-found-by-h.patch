diff --git a/src/cascadia/UnitTests_Control/GhosttySettingsTests.cpp b/src/cascadia/UnitTests_Control/GhosttySettingsTests.cpp
new file mode 100644
index 000000000..fb0b1206a
--- /dev/null
+++ b/src/cascadia/UnitTests_Control/GhosttySettingsTests.cpp
@@ -0,0 +1,146 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Regression tests for the settings -> ghostty config translation.
+//
+// Every rule pinned here came out of a bug found by hand, not by review:
+// values with spaces need the config file's quoting, WT's "infinite"
+// scrollback is a negative number that must not be forwarded, and ghostty's
+// padding has to be zero because Windows Terminal already insets the pane.
+//
+// The translation is deliberately a pure function so it can be tested here at
+// all. The rest of GhosttyControlCore needs a live engine, a GPU and a pty; a
+// unit test cannot reach it, which is exactly why this part was carved out.
+
+#include "pch.h"
+#include "../TerminalControl/GhosttySettingsTranslator.h"
+#include "MockControlSettings.h"
+
+using namespace WEX::Logging;
+using namespace WEX::TestExecution;
+using namespace WEX::Common;
+
+using namespace winrt;
+using namespace winrt::Microsoft::Terminal;
+
+namespace ControlUnitTests
+{
+    class GhosttySettingsTests
+    {
+        BEGIN_TEST_CLASS(GhosttySettingsTests)
+            TEST_CLASS_PROPERTY(L"TestTimeout", L"0:0:10")
+        END_TEST_CLASS()
+
+        TEST_METHOD(FontFamilyIsQuoted);
+        TEST_METHOD(InfiniteScrollbackIsNotForwarded);
+        TEST_METHOD(FiniteScrollbackIsForwarded);
+        TEST_METHOD(PaddingIsZeroBecauseWindowsTerminalAlreadyPads);
+        TEST_METHOD(SchemeProducesForegroundBackgroundAndFullPalette);
+        TEST_METHOD(NullSettingsProduceNothing);
+
+    private:
+        static bool _has(const std::vector<std::string>& entries, std::string_view entry)
+        {
+            return std::find(entries.begin(), entries.end(), entry) != entries.end();
+        }
+
+        static bool _hasPrefix(const std::vector<std::string>& entries, std::string_view prefix)
+        {
+            return std::any_of(entries.begin(), entries.end(), [&](const std::string& e) {
+                return e.rfind(prefix, 0) == 0;
+            });
+        }
+
+        static winrt::com_ptr<MockControlSettings> _settings()
+        {
+            auto s = winrt::make_self<MockControlSettings>();
+            s->FontFace(L"Cascadia Mono");
+            s->FontSize(12.0f);
+            s->HistorySize(9001);
+            return s;
+        }
+    };
+
+    // A font family with a space in it is the case a naive implementation gets
+    // wrong: unquoted, ghostty's parser sees "Cascadia" and drops "Mono".
+    void GhosttySettingsTests::FontFamilyIsQuoted()
+    {
+        const auto entries = Control::implementation::TranslateGhosttySettings(
+            *_settings());
+
+        VERIFY_IS_TRUE(_has(entries, "font-family = \"Cascadia Mono\""),
+                       L"font family must carry the config file's quoting");
+        VERIFY_IS_TRUE(_has(entries, "font-size = 12"));
+    }
+
+    // WT spells "infinite scrollback" as a negative historySize. ghostty's line
+    // limit is already unlimited by default, so the entry must be omitted
+    // rather than forwarded - "scrollback-limit-lines = -1" is not a thing.
+    void GhosttySettingsTests::InfiniteScrollbackIsNotForwarded()
+    {
+        auto s = _settings();
+        s->HistorySize(-1);
+
+        const auto entries = Control::implementation::TranslateGhosttySettings(*s);
+
+        VERIFY_IS_FALSE(_hasPrefix(entries, "scrollback-limit-lines"),
+                        L"a negative historySize means infinite; do not forward it");
+    }
+
+    void GhosttySettingsTests::FiniteScrollbackIsForwarded()
+    {
+        const auto entries = Control::implementation::TranslateGhosttySettings(
+            *_settings());
+
+        VERIFY_IS_TRUE(_has(entries, "scrollback-limit-lines = 9001"));
+    }
+
+    // Windows Terminal already insets the SwapChainPanel by the profile's
+    // padding. If ghostty pads as well the pane is inset twice, which is what
+    // made the first working pane look like it had a border round it.
+    void GhosttySettingsTests::PaddingIsZeroBecauseWindowsTerminalAlreadyPads()
+    {
+        const auto entries = Control::implementation::TranslateGhosttySettings(
+            *_settings());
+
+        VERIFY_IS_TRUE(_has(entries, "window-padding-x = 0"));
+        VERIFY_IS_TRUE(_has(entries, "window-padding-y = 0"));
+        VERIFY_IS_TRUE(_has(entries, "window-padding-balance = false"));
+    }
+
+    // The colours matter for more than looks: while the pane was drawn in
+    // ghostty's defaults and WT's padding in the profile's background, the
+    // mismatch showed up as a visible frame around the terminal.
+    void GhosttySettingsTests::SchemeProducesForegroundBackgroundAndFullPalette()
+    {
+        auto s = _settings();
+        s->DefaultBackground(til::color{ 0x0c, 0x0c, 0x0c });
+        s->DefaultForeground(til::color{ 0xcc, 0xcc, 0xcc });
+
+        std::array<winrt::Microsoft::Terminal::Core::Color, 16> table{};
+        for (uint32_t i = 0; i < table.size(); ++i)
+        {
+            table[i] = til::color{ gsl::narrow_cast<uint8_t>(i), 0x20, 0x30 };
+        }
+        s->SetColorTable(table);
+
+        const auto entries = Control::implementation::TranslateGhosttySettings(*s);
+
+        VERIFY_IS_TRUE(_has(entries, "background = #0c0c0c"));
+        VERIFY_IS_TRUE(_has(entries, "foreground = #cccccc"));
+
+        // All sixteen, each as its own entry - the shape a config file has.
+        for (uint32_t i = 0; i < 16; ++i)
+        {
+            const auto expected = fmt::format("palette = {}=#{:02x}2030", i, i);
+            VERIFY_IS_TRUE(_has(entries, expected),
+                           fmt::format(L"missing palette entry {}", i).c_str());
+        }
+    }
+
+    void GhosttySettingsTests::NullSettingsProduceNothing()
+    {
+        const Control::IControlSettings none{ nullptr };
+        VERIFY_ARE_EQUAL(0u, Control::implementation::TranslateGhosttySettings(none).size());
+    }
+}
