--- /dev/null
+++ b/src/cascadia/TerminalControl/GhosttySettingsTranslator.h
@@ -0,0 +1,30 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Module Name:
+// - GhosttySettingsTranslator.h
+//
+// Abstract:
+// - Turns a WT profile into the `key = value` entries ghostty's config parser
+//   takes (ADR 0003, PLAN Phase 5).
+//
+// - Deliberately free of any libghostty dependency: it produces strings and
+//   nothing else. That is what lets it be unit tested with a mock settings
+//   object, with no engine, GPU or pty involved. Everything else in
+//   GhosttyControlCore needs a live surface and cannot be reached from a unit
+//   test, so the part that *can* be tested is kept separable on purpose.
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+// The projection, not the implementation type: this file is compiled into the
+// unit tests as well, where no implementation exists.
+#include <winrt/Microsoft.Terminal.Core.h>
+#include <winrt/Microsoft.Terminal.Control.h>
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    std::vector<std::string> TranslateGhosttySettings(const Control::IControlSettings& settings);
+}
