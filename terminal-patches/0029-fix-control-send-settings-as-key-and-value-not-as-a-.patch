diff --git a/src/cascadia/TerminalControl/GhosttyControlCore.cpp b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
index decd3bea6..e40ddb833 100644
--- a/src/cascadia/TerminalControl/GhosttyControlCore.cpp
+++ b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
@@ -134,18 +134,18 @@ namespace winrt::Microsoft::Terminal::Control::implementation
 
     void GhosttyControlCore::_applySettingsToConfig(ghostty_config_t config) const
     {
-        for (const auto& entry : TranslateGhosttySettings(_settings))
+        for (const auto& [key, value] : TranslateGhosttySettings(_settings))
         {
             // A rejected entry is worth a log line but not a failed pane: the
             // rest of the configuration is still worth applying.
-            if (!ghostty_config_set(config, entry.c_str()))
+            if (!ghostty_config_set_kv(config, key.data(), key.size(), value.data(), value.size()))
             {
                 LOG_HR_MSG(E_INVALIDARG, "ghostty rejected config entry");
-                _trace(L"REJECTED %hs", entry.c_str());
+                _trace(L"REJECTED %hs = %hs", key.c_str(), value.c_str());
             }
             else
             {
-                _trace(L"set %hs", entry.c_str());
+                _trace(L"set %hs = %hs", key.c_str(), value.c_str());
             }
         }
     }
