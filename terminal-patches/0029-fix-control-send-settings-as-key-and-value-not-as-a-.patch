+#include "pch.h"
+#include "GhosttySettingsTranslator.h"
+
+using namespace winrt::Microsoft::Terminal;
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    // Settings -> the key/value pairs ghostty's config takes.
+    //
+    // The MVP scope is deliberately five fields (font, size, scheme,
+    // scrollback, padding): the ones without which a pane is visibly wrong
+    // rather than merely unstyled. Everything else - opacity, acrylic,
+    // background image, bell style - is Phase 6 parity work and is left at
+    // ghostty's defaults on purpose, so a half-applied setting never looks
+    // like a translator bug.
+    //
+    // Pure on purpose, and in its own file so that file can be compiled into
+    // the unit tests: it touches no engine state, so it needs no libghostty,
+    // no GPU and no pty - unlike everything else in GhosttyControlCore, which
+    // needs a live surface. Every rule encoded here (the negative-history
+    // case, padding pinned to zero, the one field whose own syntax still needs
+    // escaping) was learned from a bug, so each is worth pinning in a test.
+    std::vector<GhosttySetting> TranslateGhosttySettings(const Control::IControlSettings& settings)
+    {
+        std::vector<GhosttySetting> entries;
+        if (!settings)
+        {
+            return entries;
+        }
+
+        // Values go over as they are. There is no entry syntax to escape for:
+        // ghostty_config_set_kv takes the key and the value separately and
+        // parses neither, so a font family with spaces, or a delimiter set full
+        // of punctuation, needs nothing done to it on the way out.
+        const auto setText = [&entries](std::string_view key, std::wstring_view value) {
+            if (value.empty())
+            {
+                return;
+            }
+            entries.emplace_back(std::string{ key }, til::u16u8(value));
+        };
+        const auto set = [&entries](std::string_view key, std::string value) {
+            entries.emplace_back(std::string{ key }, std::move(value));
+        };
+
+        // --- Font ---------------------------------------------------------
+        setText("font-family", settings.FontFace());
+        if (const auto size = settings.FontSize(); size > 0)
+        {
+            set("font-size", fmt::format("{}", size));
+        }
+
+        // --- Scrollback ---------------------------------------------------
+        // WT counts lines; ghostty's byte limit is separate and left alone.
+        // A negative HistorySize means "infinite" in WT, which is ghostty's
+        // default for the line limit, so it is simply not set.
+        if (const auto history = settings.HistorySize(); history >= 0)
+        {
+            set("scrollback-limit-lines", fmt::format("{}", history));
+        }
+
+        // --- Selection ----------------------------------------------------
+        // WT's wordDelimiters is global, so both engines' panes already agree
+        // on it in the settings file - but ghostty never saw it and used its
+        // own default set, which is why a double click picked out different
+        // words in the two panes (WT's set includes `.`, ghostty's does not).
+        //
+        // Both are "the characters that end a word", despite ghostty's name.
+        //
+        // The one value that still needs escaping, and for a different reason
+        // than the old entry syntax did. selection-word-chars is parsed as a
+        // Zig string literal by the *field*, so a lone backslash starts an
+        // escape sequence there - and WT's default delimiters contain `\(`,
+        // which is not a valid one. The field rejects the whole value and says
+        // so only through a diagnostic, which libghostty built without an app
+        // runtime never surfaces: the setting looks forwarded and ghostty
+        // quietly keeps its own defaults, which is how a double click came back
+        // with the trailing `.` that cascadia left out.
+        //
+        // Doubling the backslashes is therefore about *this key's* syntax, not
+        // about how the value is delivered. Nothing else here needs it.
+        {
+            std::string chars;
+            for (const auto c : til::u16u8(settings.WordDelimiters()))
+            {
+                if (c == '\\')
+                {
+                    chars.push_back('\\');
+                }
+                chars.push_back(c);
+            }
+            if (!chars.empty())
+            {
+                set("selection-word-chars", std::move(chars));
+            }
+        }
+
+        // --- Padding ------------------------------------------------------
+        // WT already insets the SwapChainPanel by this same padding, so asking
+        // ghostty to pad as well would double it. Ours is therefore zero, and
+        // the pane's padding is whatever WT drew around us.
+        set("window-padding-x", "0");
+        set("window-padding-y", "0");
+        set("window-padding-balance", "false");
+
+        // --- Colour scheme ------------------------------------------------
+        if (const auto scheme = settings.try_as<Core::ICoreScheme>())
+        {
+            const auto hex = [](const Core::Color& c) {
+                return fmt::format("#{:02x}{:02x}{:02x}", c.R, c.G, c.B);
+            };
+
+            set("background", hex(scheme.DefaultBackground()));
+            set("foreground", hex(scheme.DefaultForeground()));
+            set("selection-background", hex(scheme.SelectionBackground()));
+            set("cursor-color", hex(scheme.CursorColor()));
+
+            // The 16 ANSI entries. ghostty's palette key takes one `N=#rrggbb`
+            // per entry, which is why this is a loop rather than one value.
+            winrt::com_array<Core::Color> table;
+            scheme.GetColorTable(table);
+            for (uint32_t i = 0; i < table.size(); ++i)
+            {
+                set("palette", fmt::format("{}={}", i, hex(table[i])));
+            }
+        }
+
+        return entries;
+    }
+}
