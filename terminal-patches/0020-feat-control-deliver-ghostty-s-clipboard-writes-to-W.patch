diff --git a/src/cascadia/TerminalControl/GhosttyCopyFormat.h b/src/cascadia/TerminalControl/GhosttyCopyFormat.h
new file mode 100644
index 000000000..e4d660b04
--- /dev/null
+++ b/src/cascadia/TerminalControl/GhosttyCopyFormat.h
@@ -0,0 +1,39 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Module Name:
+// - GhosttyCopyFormat.h
+//
+// Abstract:
+// - Windows Terminal's CopyFormat -> the argument of ghostty's
+//   `copy_to_clipboard` binding action. Pure, so it can be tested without an
+//   engine; the rest of the copy path needs a live selection.
+
+#pragma once
+
+#include <string_view>
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    // ghostty offers exactly four: plain, vt, html, mixed.
+    //
+    // `vt` wins over everything because it is a different *question* - the
+    // caller asked for the escape sequences, not for a presentation format.
+    //
+    // `mixed` is the answer whenever HTML is wanted, because it puts plain and
+    // HTML on the clipboard together, each MIME-tagged; asking for `html`
+    // alone would strip the plain-text flavour that most paste targets use.
+    //
+    // RTF has no ghostty equivalent, so a request for RTF alone degrades to
+    // plain. That is deliberate: silently substituting HTML would put markup
+    // where an application asked for RTF and get pasted as literal tags.
+    constexpr std::string_view GhosttyCopyAction(const bool withControlSequences,
+                                                 const bool wantsHtml) noexcept
+    {
+        if (withControlSequences)
+        {
+            return "vt";
+        }
+        return wantsHtml ? "mixed" : "plain";
+    }
+}
diff --git a/src/cascadia/TerminalControl/GhosttyEngine.cpp b/src/cascadia/TerminalControl/GhosttyEngine.cpp
index aecfbf7da..2fd9e1b45 100644
--- a/src/cascadia/TerminalControl/GhosttyEngine.cpp
+++ b/src/cascadia/TerminalControl/GhosttyEngine.cpp
@@ -245,12 +245,49 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     {
     }
 
-    void GhosttyEngine::_writeClipboard(void* userdata, ghostty_clipboard_e /*loc*/, const ghostty_clipboard_content_s* /*content*/, size_t /*len*/, bool /*confirm*/) noexcept
+    // Everything ghostty puts on the clipboard arrives here: a copy_to_clipboard
+    // binding action, and OSC 52 from inside the terminal. The payload is an
+    // array of MIME-tagged representations - `mixed` sends plain and HTML
+    // together - which is the only place styled copy exists, since read-back
+    // carries no attributes.
+    void GhosttyEngine::_writeClipboard(void* userdata,
+                                        ghostty_clipboard_e /*loc*/,
+                                        const ghostty_clipboard_content_s* content,
+                                        size_t len,
+                                        bool /*confirm*/) noexcept
+    try
     {
-        // OSC 52. Phase 6 wires this to WriteToClipboard; until then a clipboard
-        // write from inside the terminal is dropped rather than half-applied.
-        UNREFERENCED_PARAMETER(userdata);
+        const auto core = static_cast<GhosttyControlCore*>(userdata);
+        if (!core || !content)
+        {
+            return;
+        }
+
+        std::string plain;
+        std::string html;
+        for (size_t i = 0; i < len; ++i)
+        {
+            const auto& one = content[i];
+            if (!one.mime || !one.data)
+            {
+                continue;
+            }
+            const std::string_view mime{ one.mime };
+            // text/plain wins over anything unrecognised, and an untagged
+            // representation is treated as plain rather than dropped.
+            if (mime.starts_with("text/html"))
+            {
+                html = one.data;
+            }
+            else if (mime.starts_with("text/plain") || mime.empty())
+            {
+                plain = one.data;
+            }
+        }
+
+        core->WriteClipboard(std::move(plain), std::move(html));
     }
+    CATCH_LOG()
 
     void GhosttyEngine::_closeSurface(void* userdata, bool /*processAlive*/) noexcept
     {
