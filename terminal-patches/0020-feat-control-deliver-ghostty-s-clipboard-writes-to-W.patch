--- /dev/null
+++ b/src/cascadia/UnitTests_Control/GhosttyCopyFormatTests.cpp
@@ -0,0 +1,53 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Windows Terminal's CopyFormat has four flags; ghostty's copy_to_clipboard
+// takes one of four names, and they do not line up. This pins the mapping.
+//
+// The rest of the copy path needs a live selection and a real clipboard, so
+// this is the part a unit test can reach.
+
+#include "pch.h"
+#include "../TerminalControl/GhosttyCopyFormat.h"
+
+using namespace WEX::Logging;
+using namespace WEX::TestExecution;
+using namespace WEX::Common;
+
+using namespace winrt::Microsoft::Terminal::Control::implementation;
+
+namespace ControlUnitTests
+{
+    class GhosttyCopyFormatTests
+    {
+        BEGIN_TEST_CLASS(GhosttyCopyFormatTests)
+            TEST_CLASS_PROPERTY(L"TestTimeout", L"0:0:10")
+        END_TEST_CLASS()
+
+        TEST_METHOD(PlainIsTheDefault);
+        TEST_METHOD(HtmlBecomesMixedSoPlainSurvives);
+        TEST_METHOD(ControlSequencesWinOverEverything);
+    };
+
+    void GhosttyCopyFormatTests::PlainIsTheDefault()
+    {
+        VERIFY_ARE_EQUAL("plain", GhosttyCopyAction(false, false));
+    }
+
+    // Not "html". Asking ghostty for html alone puts *only* markup on the
+    // clipboard, so pasting into anything that wants text gets tags. `mixed`
+    // sends both, each MIME-tagged, which is what WT's own copy does.
+    void GhosttyCopyFormatTests::HtmlBecomesMixedSoPlainSurvives()
+    {
+        VERIFY_ARE_EQUAL("mixed", GhosttyCopyAction(false, true));
+        VERIFY_ARE_NOT_EQUAL("html", GhosttyCopyAction(false, true));
+    }
+
+    // `vt` is a different question from the presentation formats - the caller
+    // asked for the escape sequences - so it is not overridden by HTML.
+    void GhosttyCopyFormatTests::ControlSequencesWinOverEverything()
+    {
+        VERIFY_ARE_EQUAL("vt", GhosttyCopyAction(true, false));
+        VERIFY_ARE_EQUAL("vt", GhosttyCopyAction(true, true));
+    }
+}
