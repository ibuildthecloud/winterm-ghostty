diff --git a/src/cascadia/TerminalControl/GhosttyControlCore.cpp b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
index 61a0fbd85..d2bee9a30 100644
--- a/src/cascadia/TerminalControl/GhosttyControlCore.cpp
+++ b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
@@ -4,7 +4,8 @@
 #include "pch.h"
 #include "GhosttyControlCore.h"
 #include "GhosttySettingsTranslator.h"
-#include "GhosttyKeyTranslator.h"
+#include "GhosttyKeyTranslator.h"
+#include "GhosttyCopyFormat.h"
 
 #include "GhosttyControlCore.g.cpp"
 
@@ -211,6 +212,29 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         _raiseOnUiThread([this]() { CloseTerminalRequested.raise(*this, nullptr); });
     }
 
+    void GhosttyControlCore::WriteClipboard(std::string&& plain, std::string&& html) noexcept
+    try
+    {
+        if (plain.empty() && html.empty())
+        {
+            return;
+        }
+
+        auto args = winrt::make<WriteToClipboardEventArgs>(
+            winrt::hstring{ til::u8u16(plain) },
+            std::move(html),
+            // ghostty has no RTF. Sending an empty one is honest: the
+            // clipboard simply carries no RTF flavour.
+            std::string{});
+
+        // Arrives on libghostty's thread; the event is one TermControl expects
+        // on the UI thread.
+        _raiseOnUiThread([this, args = std::move(args)]() {
+            WriteToClipboard.raise(*this, args);
+        });
+    }
+    CATCH_LOG()
+
 #pragma region Connection
 
     TerminalConnection::ITerminalConnection GhosttyControlCore::Connection()
@@ -936,12 +960,7 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         }
         _releaseMouseIfHeld();
 
-        // `vt` keeps the escape sequences; `mixed` puts plain and HTML on
-        // together, which is what WT wants whenever HTML is asked for; `plain`
-        // is the honest answer for everything else. ghostty has no RTF, so a
-        // request for it degrades to plain rather than silently producing HTML.
-        const auto wantsHtml = WI_IsFlagSet(formats, CopyFormat::HTML);
-        const auto* which = withControlSequences ? "vt" : (wantsHtml ? "mixed" : "plain");
+        const auto which = GhosttyCopyAction(withControlSequences, WI_IsFlagSet(formats, CopyFormat::HTML));
         return _bindingAction(fmt::format("copy_to_clipboard:{}", which));
     }
 
