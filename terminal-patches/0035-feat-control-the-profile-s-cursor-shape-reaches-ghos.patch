+        TEST_METHOD(CursorShapeIsForwarded);
         TEST_METHOD(BackslashesAreDoubledForTheWordCharsFieldOnly);
         TEST_METHOD(NullSettingsProduceNothing);
 
@@ -183,6 +184,44 @@ namespace ControlUnitTests
                        L"a triple click must highlight the full width of the line");
     }
 
+    // Found by hand: a ghostty pane drew a block cursor beside a cascadia pane
+    // drawing a bar, because the profile's cursorShape was never forwarded.
+    //
+    // ghostty has four shapes to WT's six. Vintage and DoubleUnderscore both
+    // land on underline - those two are approximations and the mapping should
+    // say so out loud rather than be discovered later.
+    void GhosttySettingsTests::CursorShapeIsForwarded()
+    {
+        struct Case
+        {
+            Core::CursorStyle shape;
+            std::string_view expected;
+        };
+        static constexpr Case cases[] = {
+            { Core::CursorStyle::Bar, "bar" },
+            { Core::CursorStyle::FilledBox, "block" },
+            { Core::CursorStyle::EmptyBox, "block_hollow" },
+            { Core::CursorStyle::Underscore, "underline" },
+            // Approximations: ghostty has neither.
+            { Core::CursorStyle::DoubleUnderscore, "underline" },
+            { Core::CursorStyle::Vintage, "underline" },
+        };
+
+        for (const auto& c : cases)
+        {
+            auto s = _settings();
+            s->CursorShape(c.shape);
+
+            const auto entries = Control::implementation::TranslateGhosttySettings(*s);
+
+            VERIFY_IS_TRUE(_has(entries, "cursor-style", c.expected),
+                           fmt::format(L"cursor shape {} must become '{}'",
+                                       static_cast<int>(c.shape),
+                                       til::u8u16(c.expected))
+                               .c_str());
+        }
+    }
+
     // The one escaping rule left, and it belongs to the field rather than to
     // the entry. ghostty parses selection-word-chars as a Zig string literal,
     // so a lone backslash starts an escape sequence there - and WT's default
