+    // IsBufferRowInViewport replaced a get_self escape that reached
+    // GetRenderData()->GetViewport() (ADR 0001). These two tests pin the
+    // behaviour it has to preserve.
+    void ControlCoreTests::TestIsBufferRowInViewport()
+    {
+        auto [settings, conn] = _createSettingsAndConnection();
+        auto core = createCore(*settings, *conn);
+        VERIFY_IS_NOT_NULL(core);
+        _standardInit(core);
+
+        // 20 rows tall, nothing printed yet, so the viewport is rows 0-19.
+        VERIFY_IS_TRUE(core->IsBufferRowInViewport(0));
+        VERIFY_IS_TRUE(core->IsBufferRowInViewport(19));
+        VERIFY_IS_FALSE(core->IsBufferRowInViewport(20));
+        VERIFY_IS_FALSE(core->IsBufferRowInViewport(-1));
+
+        // Scroll the buffer so the viewport no longer starts at row 0. Row 0
+        // has left the top of the screen; the bottom has moved down.
+        for (auto i = 0; i < 40; ++i)
+        {
+            conn->WriteInput(winrt_wstring_to_array_view(L"Foo\r\n"));
+        }
+
+        {
+            const auto viewport = core->_terminal->GetViewport();
+            VERIFY_IS_GREATER_THAN(viewport.Top(), 0, L"the viewport should have scrolled");
+
+            VERIFY_IS_FALSE(core->IsBufferRowInViewport(0), L"row 0 has scrolled off the top");
+            VERIFY_IS_TRUE(core->IsBufferRowInViewport(viewport.Top()));
+            VERIFY_IS_TRUE(core->IsBufferRowInViewport(viewport.BottomInclusive()));
+            VERIFY_IS_FALSE(core->IsBufferRowInViewport(viewport.Top() - 1));
+            VERIFY_IS_FALSE(core->IsBufferRowInViewport(viewport.BottomInclusive() + 1));
+        }
+
+        // Scrolling back must move the answer with the visible viewport.
+        core->UserScrollViewport(5);
+        {
+            const auto viewport = core->_terminal->GetViewport();
+            VERIFY_ARE_EQUAL(5, viewport.Top());
+
+            VERIFY_IS_TRUE(core->IsBufferRowInViewport(viewport.Top()));
+            VERIFY_IS_TRUE(core->IsBufferRowInViewport(viewport.BottomInclusive()));
+            VERIFY_IS_FALSE(core->IsBufferRowInViewport(viewport.Top() - 1));
+            VERIFY_IS_FALSE(core->IsBufferRowInViewport(viewport.BottomInclusive() + 1));
+        }
+    }
+
+    // Records how ICoreState::ScrollOffset relates to GetViewport().Top() in the
+    // alt buffer.
+    //
+    // An earlier note here claimed the two diverge, because
+    // Terminal::_VisibleStartIndex() short-circuits to 0 in the alt buffer.
+    // Measured, they agree - GetViewport() returns the *visible* viewport, which
+    // is 0-based in the alt buffer too. They also agree in the main buffer, both
+    // at the bottom and scrolled back.
+    //
+    // So the derivation is not the reason IsBufferRowInViewport exists. The
+    // reason is atomicity: the escape it replaced read both bounds under a
+    // single console lock, and two separate property reads would take two.
+    // This test exists to catch a future divergence, not to assert one.
+    void ControlCoreTests::TestIsBufferRowInViewportAltBuffer()
+    {
+        auto [settings, conn] = _createSettingsAndConnection();
+        auto core = createCore(*settings, *conn);
+        VERIFY_IS_NOT_NULL(core);
+        _standardInit(core);
+
+        // Scroll first, so the main-buffer viewport top is genuinely non-zero.
+        for (auto i = 0; i < 40; ++i)
+        {
+            conn->WriteInput(winrt_wstring_to_array_view(L"Foo\r\n"));
+        }
+
+        // Enter the alt buffer (DECSET 1049).
+        conn->WriteInput(winrt_wstring_to_array_view(L"\x1b[?1049h"));
+
+        const auto viewport = core->_terminal->GetViewport();
+        const auto scrollOffset = core->ScrollOffset();
+
+        Log::Comment(NoThrowString().Format(
+            L"alt buffer: GetViewport().Top()=%d, ScrollOffset()=%d", viewport.Top(), scrollOffset));
+        VERIFY_ARE_EQUAL(viewport.Top(), scrollOffset,
+                         L"measured: these agree in the alt buffer, contrary to an earlier assumption");
+
+        // Whatever the relationship, the predicate follows the real viewport.
+        VERIFY_IS_TRUE(core->IsBufferRowInViewport(viewport.Top()));
+        VERIFY_IS_TRUE(core->IsBufferRowInViewport(viewport.BottomInclusive()));
+        VERIFY_IS_FALSE(core->IsBufferRowInViewport(viewport.BottomInclusive() + 1));
+    }
