diff --git a/src/cascadia/UnitTests_Control/GhosttyKeyTests.cpp b/src/cascadia/UnitTests_Control/GhosttyKeyTests.cpp
new file mode 100644
index 000000000..939f2fd8c
--- /dev/null
+++ b/src/cascadia/UnitTests_Control/GhosttyKeyTests.cpp
@@ -0,0 +1,91 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Regression tests for the two rules a Windows key event has to satisfy before
+// libghostty makes sense of it. Both came out of one bug, found by typing `cd`
+// into a ghostty pane and landing in cmd's F9 prompt.
+//
+// Neither rule is reachable from a unit test through GhosttyControlCore - it
+// needs a live surface - which is why they live in their own translation unit.
+
+#include "pch.h"
+#include "../TerminalControl/GhosttyKeyTranslator.h"
+
+using namespace WEX::Logging;
+using namespace WEX::TestExecution;
+using namespace WEX::Common;
+
+using namespace winrt::Microsoft::Terminal::Control::implementation;
+
+namespace ControlUnitTests
+{
+    class GhosttyKeyTests
+    {
+        BEGIN_TEST_CLASS(GhosttyKeyTests)
+            TEST_CLASS_PROPERTY(L"TestTimeout", L"0:0:10")
+        END_TEST_CLASS()
+
+        TEST_METHOD(KeycodeIsTheScanCodeNotTheVirtualKey);
+        TEST_METHOD(ExtendedKeysCarryTheE000Prefix);
+        TEST_METHOD(PrintableTextPassesThrough);
+        TEST_METHOD(ControlCharactersAreNotText);
+    };
+
+    // The scan code passes through untouched. Spelled out with the values that
+    // made the original bug visible: ghostty's table gives KeyA scan code
+    // 0x1E, and `A`'s *virtual* key is 0x41 - so if a virtual key is ever
+    // passed here again, this is the number that will be wrong.
+    void GhosttyKeyTests::KeycodeIsTheScanCodeNotTheVirtualKey()
+    {
+        VERIFY_ARE_EQUAL(0x1Eu, GhosttyNativeKeycode(0x1E, false), L"KeyA is scan code 0x1E");
+        VERIFY_ARE_NOT_EQUAL(0x41u, GhosttyNativeKeycode(0x1E, false), L"...not virtual key 0x41");
+
+        // `D` - the key that used to behave like Delete because 0x44 was sent
+        // as a native keycode.
+        VERIFY_ARE_EQUAL(0x20u, GhosttyNativeKeycode(0x20, false), L"KeyD is scan code 0x20");
+    }
+
+    // ghostty's table stores the extended keys with 0xE0 in the high byte:
+    //     .{ 0x07004a, 0x0066, 0x006e, 0xe047, 0x0073, "Home" }
+    // Home, the arrows, Delete and the navigation cluster all live there, so
+    // dropping the prefix makes them resolve as their numpad twins.
+    void GhosttyKeyTests::ExtendedKeysCarryTheE000Prefix()
+    {
+        VERIFY_ARE_EQUAL(0xE047u, GhosttyNativeKeycode(0x47, true), L"Home is 0xE047, not 0x47");
+        VERIFY_ARE_EQUAL(0xE04Bu, GhosttyNativeKeycode(0x4B, true), L"ArrowLeft");
+        VERIFY_ARE_EQUAL(0xE053u, GhosttyNativeKeycode(0x53, true), L"Delete");
+
+        // The same scan code without the extended bit is a different key.
+        VERIFY_ARE_NOT_EQUAL(GhosttyNativeKeycode(0x47, true), GhosttyNativeKeycode(0x47, false));
+    }
+
+    void GhosttyKeyTests::PrintableTextPassesThrough()
+    {
+        VERIFY_ARE_EQUAL("d", GhosttyKeyText(L"d"));
+        VERIFY_ARE_EQUAL("D", GhosttyKeyText(L"D"));
+
+        // Non-ASCII has to survive as UTF-8, since that is what the field is.
+        VERIFY_ARE_EQUAL("\xC3\xA9", GhosttyKeyText(L"é"), L"e-acute as UTF-8");
+    }
+
+    // The load-bearing one. ghostty's key_encode short circuits on a non-empty
+    // utf8 field, so a control character here does not merely duplicate
+    // ghostty's encoding of the key - it *replaces* it, and the modes that
+    // encoding depends on (backspace-is-delete, the kitty keyboard protocol,
+    // application cursor keys) are invisible from this side.
+    void GhosttyKeyTests::ControlCharactersAreNotText()
+    {
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x08").empty(), L"Backspace");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x09").empty(), L"Tab");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x0d").empty(), L"Enter");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x1b").empty(), L"Escape");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x03").empty(), L"ctrl+c");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x7f").empty(), L"Delete");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"").empty(), L"a key that produces nothing");
+
+        // One control character poisons the whole string rather than being
+        // stripped out of it: a mixed result would still short circuit
+        // ghostty's encoding, just less obviously.
+        VERIFY_IS_TRUE(GhosttyKeyText(L"a\x08").empty());
+    }
+}
