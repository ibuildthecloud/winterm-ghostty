diff --git a/src/cascadia/TerminalControl/GhosttyKeyTranslator.cpp b/src/cascadia/TerminalControl/GhosttyKeyTranslator.cpp
new file mode 100644
index 000000000..80c4980f0
--- /dev/null
+++ b/src/cascadia/TerminalControl/GhosttyKeyTranslator.cpp
@@ -0,0 +1,39 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+
+#include "pch.h"
+#include "GhosttyKeyTranslator.h"
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    std::string GhosttyKeyText(const std::wstring_view translated)
+    {
+        if (translated.empty())
+        {
+            return {};
+        }
+
+        // Control characters are not text. Backspace, Tab, Enter, Escape and
+        // ctrl+letter all come back from the keyboard layout as
+        // 0x01-0x1A/0x1B/0x7F, but they are keys whose terminal encoding
+        // ghostty owns, and which depend on modes nothing here knows about -
+        // backspace-is-delete, the kitty keyboard protocol, application cursor
+        // keys.
+        //
+        // Forwarding them is destructive rather than merely redundant:
+        // ghostty's key_encode short circuits on a non-empty utf8 field
+        // (`if (event.utf8.len > 0) return try writer.writeAll(event.utf8);`),
+        // so a control character here would *replace* ghostty's own encoding
+        // of the key. ghostty guards the same hazard internally with
+        // isControlUtf8.
+        for (const auto c : translated)
+        {
+            if (c < 0x20 || c == 0x7F)
+            {
+                return {};
+            }
+        }
+
+        return til::u16u8(translated);
+    }
+}
diff --git a/src/cascadia/TerminalControl/GhosttyKeyTranslator.h b/src/cascadia/TerminalControl/GhosttyKeyTranslator.h
new file mode 100644
index 000000000..c34dff75b
--- /dev/null
+++ b/src/cascadia/TerminalControl/GhosttyKeyTranslator.h
@@ -0,0 +1,38 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Module Name:
+// - GhosttyKeyTranslator.h
+//
+// Abstract:
+// - The two rules a Windows key event has to satisfy before libghostty will
+//   make sense of it. Both were learned from a bug; both are pure functions so
+//   they can be unit tested without an engine, a surface or a keyboard.
+
+#pragma once
+
+#include <string>
+#include <string_view>
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    // ghostty_input_key_s::keycode is the *native* platform keycode - not a
+    // virtual key, and not a value from ghostty_input_key_e. On Windows its
+    // table (ghostty's src/input/keycodes.zig) stores the scan code, with
+    // 0xE000 set for the extended keys:
+    //
+    //     //   USB     evdev    XKB     Win     Mac   Code
+    //     .{ 0x070004, 0x001e, 0x0026, 0x001e, 0x0000, "KeyA" },
+    //     .{ 0x07004a, 0x0066, 0x006e, 0xe047, 0x0073, "Home" },
+    //
+    // Passing the virtual key instead resolves to whatever unrelated key
+    // shares that number, which is how `d` came to behave like Delete.
+    constexpr uint32_t GhosttyNativeKeycode(const uint16_t scanCode, const bool extended) noexcept
+    {
+        return extended ? (0xE000u | scanCode) : scanCode;
+    }
+
+    // The text to hand to libghostty with a key, given what the keyboard
+    // layout translated it to. Empty means "this key produces no text".
+    std::string GhosttyKeyText(std::wstring_view translated);
+}
