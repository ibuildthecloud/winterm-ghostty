From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Darren Shepherd <darren@obot.ai>
Date: Thu, 6 Aug 2026 22:28:36 -0700
Subject: [PATCH] fix(control): translate key text under the event's modifiers

`?` could not be typed into a ghostty pane. It arrived as `/`, and at any
speed the damage spread: typing "echo A?B/C" produced "????ECH?O A??B?C",
with Shift smeared onto neighbouring keys. A cascadia pane in the same
window, given the identical keystrokes, was correct.

TrySendKeyEvent asked GetKeyboardState() for the state to translate the
key under. That reports the state as of the last message the calling
thread retrieved, and XAML raises KeyDown as a routed event some way
behind its message pump - so the snapshot has already moved on. Shift
arriving early or leaving late is enough to pick the wrong character out
of the layout. Cascadia never notices because it never calls ToUnicode:
its text comes from CharacterReceived, which Windows generated with the
correct state.

The modifiers that came *with* the event cannot drift from it, so they
are what ToUnicode is given now. The translation moves to
GhosttyKeyTranslator, next to the other two rules learned this way, where
it is a pure function of (modifiers, vkey, scanCode) and reachable from a
unit test. The unshifted codepoint falls out as the same call with no
modifiers at all.

The new test fails against the old code for the reason the bug existed:
no key is held while it runs, so a GetKeyboardState implementation sees
Shift up and answers `/`.

unitControl 63/63.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../TerminalControl/GhosttyControlCore.cpp    | 37 ++++----------
 .../TerminalControl/GhosttyKeyTranslator.cpp  | 48 +++++++++++++++++++
 .../TerminalControl/GhosttyKeyTranslator.h    | 25 ++++++++--
 .../UnitTests_Control/GhosttyKeyTests.cpp     | 39 +++++++++++++++
 4 files changed, 117 insertions(+), 32 deletions(-)

diff --git a/src/cascadia/TerminalControl/GhosttyControlCore.cpp b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
index 90d24eaee..75d6b5f78 100644
--- a/src/cascadia/TerminalControl/GhosttyControlCore.cpp
+++ b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
@@ -738,19 +738,6 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     // The 1<<2 flag is load-bearing: it tells ToUnicode not to modify
     // kernel-side keyboard state. Without it, probing a dead key here consumes
     // it and the next key silently loses its accent.
-    static std::string _keyText(const WORD vkey, const WORD scanCode, const BYTE* keyboard)
-    {
-        wchar_t buf[8]{};
-        const auto n = ToUnicode(vkey, scanCode, keyboard, buf, ARRAYSIZE(buf), 1 << 2);
-        if (n <= 0)
-        {
-            // 0 is "no translation"; negative is a dead key.
-            return {};
-        }
-
-        return GhosttyKeyText(std::wstring_view{ buf, gsl::narrow_cast<size_t>(n) });
-    }
-
     bool GhosttyControlCore::TrySendKeyEvent(const WORD vkey,
                                              const WORD scanCode,
                                              const ControlKeyStates modifiers,
@@ -784,22 +771,14 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         std::string unshifted;
         if (keyDown)
         {
-            BYTE keyboard[256];
-            if (GetKeyboardState(keyboard))
-            {
-                text = _keyText(vkey, scanCode, keyboard);
-
-                // What key bindings match against, so it has to ignore Shift
-                // and the lock keys - otherwise ctrl+shift+c would fail to
-                // match a binding written against `c`.
-                BYTE plain[256];
-                memcpy(plain, keyboard, sizeof(plain));
-                plain[VK_SHIFT] = plain[VK_LSHIFT] = plain[VK_RSHIFT] = 0;
-                plain[VK_CONTROL] = plain[VK_LCONTROL] = plain[VK_RCONTROL] = 0;
-                plain[VK_MENU] = plain[VK_LMENU] = plain[VK_RMENU] = 0;
-                plain[VK_CAPITAL] = 0;
-                unshifted = _keyText(vkey, scanCode, plain);
-            }
+            // From the event's modifiers, never the thread's keyboard state -
+            // see GhosttyKeyTextFor, and the `?` that came out as `/`.
+            text = GhosttyKeyTextFor(modifiers.Value(), vkey, scanCode);
+
+            // What key bindings match against, so it has to ignore Shift and
+            // the lock keys - otherwise ctrl+shift+c would fail to match a
+            // binding written against `c`.
+            unshifted = GhosttyKeyTextFor(0, vkey, scanCode);
         }
         ev.text = text.empty() ? nullptr : text.c_str();
         ev.unshifted_codepoint = (!unshifted.empty() && gsl::narrow_cast<unsigned char>(unshifted[0]) < 0x80) ?
diff --git a/src/cascadia/TerminalControl/GhosttyKeyTranslator.cpp b/src/cascadia/TerminalControl/GhosttyKeyTranslator.cpp
index 80c4980f0..6a3da9a30 100644
--- a/src/cascadia/TerminalControl/GhosttyKeyTranslator.cpp
+++ b/src/cascadia/TerminalControl/GhosttyKeyTranslator.cpp
@@ -36,4 +36,52 @@ namespace winrt::Microsoft::Terminal::Control::implementation
 
         return til::u16u8(translated);
     }
+
+    std::string GhosttyKeyTextFor(const uint32_t modifiers, const uint16_t vkey, const uint16_t scanCode)
+    {
+        constexpr BYTE down = 0x80;
+        constexpr BYTE locked = 0x01;
+
+        BYTE keyboard[256]{};
+        if (modifiers & SHIFT_PRESSED)
+        {
+            keyboard[VK_SHIFT] = keyboard[VK_LSHIFT] = down;
+        }
+        // Left and right are kept apart because AltGr is reported as left ctrl
+        // plus right alt, and a layout with an AltGr mapping for a key looks at
+        // exactly that pair.
+        if (modifiers & LEFT_CTRL_PRESSED)
+        {
+            keyboard[VK_CONTROL] = keyboard[VK_LCONTROL] = down;
+        }
+        if (modifiers & RIGHT_CTRL_PRESSED)
+        {
+            keyboard[VK_CONTROL] = keyboard[VK_RCONTROL] = down;
+        }
+        if (modifiers & LEFT_ALT_PRESSED)
+        {
+            keyboard[VK_MENU] = keyboard[VK_LMENU] = down;
+        }
+        if (modifiers & RIGHT_ALT_PRESSED)
+        {
+            keyboard[VK_MENU] = keyboard[VK_RMENU] = down;
+        }
+        if (modifiers & CAPSLOCK_ON)
+        {
+            keyboard[VK_CAPITAL] = locked;
+        }
+
+        // The 1<<2 flag is load-bearing: it tells ToUnicode not to modify
+        // kernel-side keyboard state. Without it, translating a dead key here
+        // consumes it and the next key silently loses its accent.
+        wchar_t buf[8]{};
+        const auto n = ToUnicode(vkey, scanCode, keyboard, buf, ARRAYSIZE(buf), 1 << 2);
+        if (n <= 0)
+        {
+            // 0 is "no translation"; negative is a dead key.
+            return {};
+        }
+
+        return GhosttyKeyText(std::wstring_view{ buf, gsl::narrow_cast<size_t>(n) });
+    }
 }
diff --git a/src/cascadia/TerminalControl/GhosttyKeyTranslator.h b/src/cascadia/TerminalControl/GhosttyKeyTranslator.h
index c34dff75b..e9b328d6b 100644
--- a/src/cascadia/TerminalControl/GhosttyKeyTranslator.h
+++ b/src/cascadia/TerminalControl/GhosttyKeyTranslator.h
@@ -5,9 +5,9 @@
 // - GhosttyKeyTranslator.h
 //
 // Abstract:
-// - The two rules a Windows key event has to satisfy before libghostty will
-//   make sense of it. Both were learned from a bug; both are pure functions so
-//   they can be unit tested without an engine, a surface or a keyboard.
+// - The rules a Windows key event has to satisfy before libghostty will make
+//   sense of it. Each was learned from a bug; each is a pure function so it can
+//   be unit tested without an engine, a surface or a keyboard.
 
 #pragma once
 
@@ -35,4 +35,23 @@ namespace winrt::Microsoft::Terminal::Control::implementation
     // The text to hand to libghostty with a key, given what the keyboard
     // layout translated it to. Empty means "this key produces no text".
     std::string GhosttyKeyText(std::wstring_view translated);
+
+    // The text a key produces under a given set of modifiers, as UTF-8.
+    //
+    // `modifiers` is a ControlKeyStates value - the console-style bitfield from
+    // <wincon.h> - taken *from the key event*. That is the whole point: the
+    // obvious implementation asks GetKeyboardState() instead, and it is wrong.
+    // GetKeyboardState reports the state as of the last message the calling
+    // thread retrieved, while XAML raises KeyDown as a routed event some way
+    // behind its message pump, so under real typing speed the snapshot has
+    // already moved on. Shift arriving early or leaving late is enough to turn
+    // `?` into `/`: typing "echo A?B/C" quickly into a ghostty pane produced
+    // "????ECH?O A??B?C", and the same keys 200ms apart came out right. A
+    // cascadia pane is immune only because it never calls ToUnicode - its text
+    // arrives as CharacterReceived, which Windows generated with the right
+    // state.
+    //
+    // Pass 0 for the modifiers to get the unshifted text, which is what key
+    // bindings match against.
+    std::string GhosttyKeyTextFor(uint32_t modifiers, uint16_t vkey, uint16_t scanCode);
 }
diff --git a/src/cascadia/UnitTests_Control/GhosttyKeyTests.cpp b/src/cascadia/UnitTests_Control/GhosttyKeyTests.cpp
index 939f2fd8c..3559969e4 100644
--- a/src/cascadia/UnitTests_Control/GhosttyKeyTests.cpp
+++ b/src/cascadia/UnitTests_Control/GhosttyKeyTests.cpp
@@ -29,6 +29,7 @@ namespace ControlUnitTests
         TEST_METHOD(ExtendedKeysCarryTheE000Prefix);
         TEST_METHOD(PrintableTextPassesThrough);
         TEST_METHOD(ControlCharactersAreNotText);
+        TEST_METHOD(ShiftComesFromTheEventNotTheThread);
     };
 
     // The scan code passes through untouched. Spelled out with the values that
@@ -88,4 +89,42 @@ namespace ControlUnitTests
         // ghostty's encoding, just less obviously.
         VERIFY_IS_TRUE(GhosttyKeyText(L"a\x08").empty());
     }
+
+    // The `?` bug. Text has to be translated under the modifiers the key event
+    // carried, not under whatever the calling thread's keyboard state happens
+    // to say - the two diverge as soon as anyone types at speed, because XAML
+    // raises KeyDown behind its own message pump.
+    //
+    // No key is pressed while this test runs, so the thread's Shift is up. An
+    // implementation that reaches for GetKeyboardState() therefore fails the
+    // very first assertion, which is exactly the bug: `?` arrived as `/`.
+    void GhosttyKeyTests::ShiftComesFromTheEventNotTheThread()
+    {
+        // US layout. Skipping rather than failing elsewhere: the mapping being
+        // asserted is the layout's, not ours.
+        const auto layout = GetKeyboardLayout(0);
+        if (LOWORD(reinterpret_cast<UINT_PTR>(layout)) != 0x0409)
+        {
+            Log::Result(WEX::Logging::TestResults::Skipped, L"not a US layout");
+            return;
+        }
+
+        constexpr uint16_t vkOem2 = VK_OEM_2; // the `/?` key
+        constexpr uint16_t scanOem2 = 0x35;
+
+        VERIFY_ARE_EQUAL("?", GhosttyKeyTextFor(SHIFT_PRESSED, vkOem2, scanOem2));
+        VERIFY_ARE_EQUAL("/", GhosttyKeyTextFor(0, vkOem2, scanOem2));
+
+        // The same asymmetry on a letter, where Caps Lock is a second way in.
+        constexpr uint16_t vkA = 'A';
+        constexpr uint16_t scanA = 0x1E;
+        VERIFY_ARE_EQUAL("a", GhosttyKeyTextFor(0, vkA, scanA));
+        VERIFY_ARE_EQUAL("A", GhosttyKeyTextFor(SHIFT_PRESSED, vkA, scanA));
+        VERIFY_ARE_EQUAL("A", GhosttyKeyTextFor(CAPSLOCK_ON, vkA, scanA));
+        VERIFY_ARE_EQUAL("a", GhosttyKeyTextFor(CAPSLOCK_ON | SHIFT_PRESSED, vkA, scanA));
+
+        // ctrl+c translates to 0x03, which is not text - ghostty owns that
+        // encoding. Proves the ctrl bit reaches ToUnicode at all.
+        VERIFY_IS_TRUE(GhosttyKeyTextFor(LEFT_CTRL_PRESSED, 'C', 0x2E).empty());
+    }
 }
