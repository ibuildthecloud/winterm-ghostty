     }
 
+    // SearchResultRows used to return std::vector<til::point_span> and the sole
+    // consumer (TermControl's scrollbar pips) filtered consecutive duplicates
+    // itself. til::point_span is not projectable, so promoting the escape to
+    // IControlCore (ADR 0001) moved that filtering behind the interface.
+    //
+    // This pins the contract that move created: one entry per matching row, in
+    // ascending order, however many times the term occurs on that row.
+    void ControlCoreTests::TestSearchResultRowsAreDistinct()
+    {
+        auto [settings, conn] = _createSettingsAndConnection();
+        auto core = createCore(*settings, *conn);
+        VERIFY_IS_NOT_NULL(core);
+        _standardInit(core);
+
+        // Row 0 holds the term twice, row 1 not at all, row 2 once.
+        conn->WriteInput(winrt_wstring_to_array_view(L"foo foo\r\n"));
+        conn->WriteInput(winrt_wstring_to_array_view(L"bar\r\n"));
+        conn->WriteInput(winrt_wstring_to_array_view(L"foo\r\n"));
+
+        Control::SearchRequest request{
+            L"foo", // Text
+            true, // GoForward
+            false, // CaseSensitive
+            false, // RegularExpression
+            true, // ExecuteSearch
+            false, // ScrollIntoView
+            0 // ScrollOffset
+        };
+        const auto results = core->Search(request);
+
+        // Three occurrences of the term...
+        VERIFY_ARE_EQUAL(3, results.TotalMatches);
+
+        // ...but only two rows to draw a pip on, and row 0 appears once despite
+        // holding two matches.
+        const auto rows = core->SearchResultRows();
+        VERIFY_ARE_EQUAL(2u, rows.Size(), L"two matching rows, not three matches");
+        VERIFY_ARE_EQUAL(0, rows.GetAt(0));
+        VERIFY_ARE_EQUAL(2, rows.GetAt(1));
+    }
+
     void ControlCoreTests::TestClearScrollback()
     {
