+    void GhosttyControlCore::_selectionDroveTheMouse()
+    {
+        _hoveredCell.reset();
+        _selectionDrove = true;
+    }
+
+    // Whether the application has asked for the mouse. This is the switch that
+    // makes ControlInteractivity route pointer events to SendMouseEvent instead
+    // of the selection path, so answering false - as this did - is what left
+    // applications reading the selection machinery's leftovers (GD-07).
+    //
+    // ghostty_surface_mouse_captured is the same question ghostty asks itself
+    // when deciding whether to report, so the two sides cannot disagree about
+    // which mode the terminal is in.
+    bool GhosttyControlCore::IsVtMouseModeEnabled() const
+    {
+        return _surface && ghostty_surface_mouse_captured(_surface);
+    }
+    bool GhosttyControlCore::ShouldSendAlternateScroll(const uint32_t /*uiButton*/, const int32_t /*delta*/) const { return false; }
+    // Where the cursor is, in cells, for the IME candidate window.
+    //
+    // libghostty answers in pixels rather than cells - ghostty_surface_ime_point
+    // gives the point an IME should anchor to, already in DIPs and already
+    // accounting for the width of any preedit and the surface's padding - so
+    // this converts. Windows Terminal wants cells because it multiplies by the
+    // font size itself.
+    //
+    // The y arithmetic is why this needs a comment rather than a division:
+    // imePoint returns the *bottom* of the cursor cell (Surface.zig: "We want
+    // the bottom"), so dividing by the cell height lands one row below the
+    // cursor, and TermControl adds a row's height of its own to get the bottom
+    // of the rect. Subtracting the row here means the candidate window sits
+    // under the cursor rather than under the line below it.
+    Core::Point GhosttyControlCore::CursorPosition() const
+    {
+        if (!_surface || _cellSize.Width <= 0 || _cellSize.Height <= 0)
+        {
+            return {};
+        }
+
+        // Same reasoning as SetPreedit: this runs on WT's UI thread, and
+        // anything that walks into libghostty from there gets the big stack.
+        double x{};
+        double y{};
+        double width{};
+        double height{};
+        GhosttyEngine::RunWithEngineStack([&]() {
+            ghostty_surface_ime_point(_surface, &x, &y, &width, &height);
+        });
+
+        // imePoint is in DIPs; _cellSize is physical.
+        const auto cellWidth = _cellSize.Width / _compositionScale;
+        const auto cellHeight = _cellSize.Height / _compositionScale;
+
+        return {
+            std::max(0, static_cast<int32_t>(x / cellWidth)),
+            std::max(0, static_cast<int32_t>(y / cellHeight) - 1),
+        };
+    }
+
+    // The provisional text an IME shows at the cursor before it is committed.
+    // ghostty draws its own, so this is the whole of it - the attributes and
+    // cursor offset TSF also produces describe how *WT's* renderer should style
+    // it and have no counterpart here.
+    void GhosttyControlCore::SetPreedit(const hstring& text) const
+    {
+        if (!_surface)
+        {
+            return;
+        }
+
+        // On a large-stack thread, like every other call into libghostty that
+        // does real work. ghostty_surface_preedit needs more than the 1 MB MSVC
+        // gives WT's UI thread, and typing a single character into a ghostty
+        // pane through an IME took the whole window down with a stack overflow
+        // in __chkstk. The ledger already warned about this - "any future call
+        // into libghostty from a WT-owned thread has to be checked against
+        // this" - and this is the call that did not check.
+        const auto utf8 = til::u16u8(text);
+        GhosttyEngine::RunWithEngineStack([&]() {
+            ghostty_surface_preedit(_surface, utf8.data(), utf8.size());
+        });
+    }
+    bool GhosttyControlCore::ForceCursorVisible() const noexcept { return false; }
+    void GhosttyControlCore::ForceCursorVisible(bool /*force*/) {}
+
+    // Whether the application has turned on DEC mode 2004.
+    //
+    // This is not what frames a paste. ghostty_surface_text is documented as
+    // "treated like a paste", so libghostty has been wrapping our pastes in
+    // ESC[200~/ESC[201~ correctly since the first ghostty pane - PasteText
+    // must not add a second pair. What was missing is WT *knowing*, and three
+    // things above the core read it: whether to trim the pasted text
+    // (TrimPaste), whether an empty clipboard still sends bare fenceposts, and
+    // whether to raise the multi-line paste warning. All three were deciding
+    // as though every application were paste-blind.
+    bool GhosttyControlCore::BracketedPasteEnabled() const noexcept
+    {
+        return _surface && ghostty_surface_bracketed_paste_enabled(_surface);
+    }
+    void GhosttyControlCore::ClearBuffer(Control::ClearBufferType /*clearType*/) {}
+    // The whole screen, scrollback included. GHOSTTY_POINT_SCREEN counts from
+    // the start of the scrollback rather than the viewport, and the TOP_LEFT /
+    // BOTTOM_RIGHT coords mean "the edge of that row" - so this is the entire
+    // buffer without having to know how big it is.
+    hstring GhosttyControlCore::ReadEntireBuffer() const
+    {
+        if (!_surface)
+        {
+            return {};
+        }
+
+        ghostty_selection_s all{};
+        all.top_left.tag = GHOSTTY_POINT_SCREEN;
+        all.top_left.coord = GHOSTTY_POINT_COORD_TOP_LEFT;
+        all.bottom_right.tag = GHOSTTY_POINT_SCREEN;
+        all.bottom_right.coord = GHOSTTY_POINT_COORD_BOTTOM_RIGHT;
+        all.rectangle = false;
+
+        ghostty_text_s text{};
+        if (!ghostty_surface_read_text(_surface, all, &text))
+        {
+            return {};
+        }
+        const auto release = wil::scope_exit([&]() { ghostty_surface_free_text(_surface, &text); });
+
+        if (!text.text || text.text_len == 0)
+        {
+            return {};
+        }
+        return winrt::hstring{ til::u8u16(std::string_view{ text.text, text.text_len }) };
+    }
+    Control::CommandHistoryContext GhosttyControlCore::CommandHistory() const { return nullptr; }
+    bool GhosttyControlCore::QuickFixesAvailable() const noexcept { return false; }
+    void GhosttyControlCore::UpdateQuickFixes(const Windows::Foundation::Collections::IVector<hstring>& /*quickFixes*/) {}
+    void GhosttyControlCore::ClearQuickFix() {}
+    void GhosttyControlCore::ColorSelection(const Control::SelectionColor& /*fg*/, const Control::SelectionColor& /*bg*/, Core::MatchMode /*matchMode*/) {}
+    void GhosttyControlCore::PersistTo(int64_t /*handle*/) const {}
+    void GhosttyControlCore::RestoreFromPath(const hstring& /*path*/) const {}
+    void GhosttyControlCore::PreviewInput(const hstring& /*input*/) {}
+    void GhosttyControlCore::OpenCWD() {}
+
+#pragma endregion
+}
