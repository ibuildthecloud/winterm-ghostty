+    // ghostty tracks prompts and nothing else - its SemanticPrompt is a u2
+    // with none/prompt/prompt_continuation - so this is prompt-to-prompt
+    // movement, which is what jump_to_prompt does. WT's mark categories
+    // (command/output/error) have no counterpart; see PLAN's Phase 6 block.
+    //
+    // The First/Last directions have no jump_to_prompt equivalent either: it
+    // counts relative prompts, not absolute ones. Treating them as one step is
+    // wrong in a way the user would notice, so they scroll to the buffer edge
+    // instead, which is at least what "first"/"last" means.
+    void GhosttyControlCore::ScrollToMark(const Control::ScrollToMarkDirection& direction)
+    {
+        switch (direction)
+        {
+        case Control::ScrollToMarkDirection::Previous:
+            _bindingAction("jump_to_prompt:-1");
+            break;
+        case Control::ScrollToMarkDirection::Next:
+            _bindingAction("jump_to_prompt:1");
+            break;
+        case Control::ScrollToMarkDirection::First:
+            _bindingAction("scroll_to_top");
+            break;
+        case Control::ScrollToMarkDirection::Last:
+            _bindingAction("scroll_to_bottom");
+            break;
+        }
+    }
