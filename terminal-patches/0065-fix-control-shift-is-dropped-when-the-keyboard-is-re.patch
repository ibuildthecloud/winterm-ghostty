+    uint32_t GhosttyModifiersFor(uint32_t& held,
+                                 const uint32_t snapshot,
+                                 const uint16_t vkey,
+                                 const bool extended,
+                                 const bool keyDown) noexcept
+    {
+        if (const auto bit = ModifierBitFor(vkey, extended))
+        {
+            if (keyDown)
+            {
+                held |= bit;
+            }
+            else
+            {
+                held &= ~bit;
+            }
+        }
+
+        return snapshot | held;
