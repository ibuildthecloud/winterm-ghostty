-    // Sizing and DPI bugs here are invisible from the outside - the pane just
-    // looks wrong - and a packaged app has no stdout, so the traces go to the
-    // debugger channel where `scripts\smoke-release.ps1` can also read them and
-    // prove which engine a window is running.
-    //
-    // They go out on their own thread, and that is not tidiness.
-    // OutputDebugString is **not** the free call this code used to claim it was
-    // when no debugger is attached: DBWIN is a machine-wide channel, and once
-    // anything has attached to it and stopped servicing it - a debugger that was
-    // killed, a script that exited without closing the shared events - every
-    // writer on the machine waits on DBWIN_BUFFER_READY and gives up only after
-    // **ten seconds**, per call. Measured here at 10,005 ms a call after a probe
-    // script leaked its listener. A pane traces about forty lines while it comes
-    // up, on the UI thread, so the terminal window took minutes to appear and
-    // looked for all the world like a hang - reported as "nothing pops up, the
-    // terminal is never shown".
-    //
-    // A bounded queue drained by one worker means a wedged channel costs a
-    // trace and never the terminal. Formatting stays on the caller so the line
-    // reflects the moment it was traced.
-    namespace
-    {
-        class TraceSink
-        {
-        public:
-            static TraceSink& Get()
-            {
-                // Deliberately leaked. The worker has to outlive static
-                // destruction: a trace emitted while the process is tearing
-                // itself down must not reach a half-destroyed object.
-                static TraceSink* sink = new TraceSink();
-                return *sink;
-            }
-
-            void Write(std::wstring line)
-            {
-                {
-                    std::lock_guard<std::mutex> guard{ _mutex };
-                    // Drop rather than grow without bound or wait, which is the
-                    // whole point of being here.
-                    if (_queue.size() >= 512)
-                    {
-                        return;
-                    }
-                    _queue.push_back(std::move(line));
-                }
-                _cv.notify_one();
-            }
-
-        private:
-            TraceSink()
-            {
-                std::thread{ [this]() { _run(); } }.detach();
-            }
-
-            void _run()
-            {
-                for (;;)
-                {
-                    std::wstring line;
-                    {
-                        std::unique_lock<std::mutex> guard{ _mutex };
-                        _cv.wait(guard, [this]() { return !_queue.empty(); });
-                        line = std::move(_queue.front());
-                        _queue.pop_front();
-                    }
-                    // One call per line, not three: each is a round trip on the
-                    // channel, and three was three times the exposure.
-                    OutputDebugStringW(line.c_str());
-                }
-            }
-
-            std::mutex _mutex;
-            std::condition_variable _cv;
-            std::deque<std::wstring> _queue;
-        };
-    }
-
-    void GhosttyControlCore::_trace(const wchar_t* format, ...)
-    {
-        wchar_t buf[512];
-        va_list args;
-        va_start(args, format);
-        const auto n = _vsnwprintf_s(buf, _TRUNCATE, format, args);
-        va_end(args);
-        if (n > 0)
-        {
-            TraceSink::Get().Write(L"[ghostty] " + std::wstring{ buf } + L"\n");
-        }
-    }
