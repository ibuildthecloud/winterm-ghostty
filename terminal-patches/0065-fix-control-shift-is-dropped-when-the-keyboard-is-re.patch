-#pragma region Selection
-
-    // What WT hands out is not a cell under the pointer - it is a selection
-    // *boundary*, already rounded. ControlInteractivity does that rounding
-    // before the core is called: the drag anchor floors the touchdown point and
-    // adds one when the drag runs leftwards, and the far end rounds to the
-    // nearest cell edge. Measured against the real cascadia core in
-    // UnitTests_Control::SelectionDragGeometryTests; see docs/selection-geometry.md.
-    //
-    // ghostty is a boundary model too, but it derives the boundary from where
-    // in the cell the pointer is: at or past 60% of the cell width, the
-    // boundary is the cell's right edge, otherwise its left edge
-    // (SelectionGesture.zig, threshold `@round(cell_width * 0.6)`; confirmed on
-    // the real engine with GHOSTTY_HARNESS_SELECT_SWEEP).
-    //
-    // So to mean boundary B, send a pixel inside cell B below that threshold.
-    // A quarter of the way across leaves margin on both sides: the cell's own
-    // left edge below, the 60% threshold above, with room for the content scale
-    // and for ghostty truncating to whole pixels. The cell *centre*, which this
-    // used to send, also lands below 60% - the far end of a drag was never the
-    // bug - but 0.1 of a cell is not a margin worth relying on.
-    void GhosttyControlCore::_mouseTo(const Core::Point cell, const ghostty_input_mods_e mods) const
-    {
-        if (!_surface)
-        {
-            return;
-        }
-        // DIPs, not physical pixels. libghostty applies the content scale to
-        // mouse positions itself, and _cellSize is in pixels - so multiplying
-        // cells by it directly lands scale-times too far across the screen.
-        // On a 100% display that is invisible; at 200% a selection starts
-        // roughly twice as far right as the pointer.
-        //
-        // Measured, not reasoned: driving this sequence in harness/hwnd-host
-        // with GHOSTTY_HARNESS_SELECT on a 200% monitor asked for cells 2..4
-        // and got 5..8 back, and asked for 5..9 and got 11..14.
-        //
-        // No padding term: the settings translator pins window-padding-x/y to
-        // zero because WT insets the SwapChainPanel itself. ghostty's own
-        // arithmetic does subtract padding_left before taking the fraction, so
-        // if that ever stops being zero this has to grow the term with it.
-        const auto cellWidth = _cellSize.Width / _compositionScale;
-        const auto cellHeight = _cellSize.Height / _compositionScale;
-        const auto x = (static_cast<double>(cell.X) + 0.25) * cellWidth;
-        const auto y = (static_cast<double>(cell.Y) + 0.5) * cellHeight;
-        ghostty_surface_mouse_pos(_surface, x, y, mods);
-    }
-
-    // Every mouse event of a selection carries these, because the engine reads
-    // block-vs-linear off the modifiers of each event rather than latching a
-    // mode at the press. GhosttySelectionMods.h has the engine's rule; what is
-    // decided here is only *when* WT considers a drag to be a block one, which
-    // is the alt state at the click, held for the drag.
-    ghostty_input_mods_e GhosttyControlCore::_selectionMods() const noexcept
-    {
-        return GhosttySelectionMods(_blockSelect);
-    }
-
-    // Windows Terminal never tells the core that the button came up: only VT
-    // mouse mode sees a release, and selection is the non-VT path. ghostty
-    // needs one, or it treats the next pointer move as a continued drag.
-    //
-    // So the release is synthesised lazily - immediately before anything that
-    // starts or ends a selection. Between the user letting go and that next
-    // action, no mouse events are sent at all, so ghostty's belief that a drag
-    // is still live has nothing to act on.
-    void GhosttyControlCore::_releaseMouseIfHeld() const
-    {
-        if (!_surface || !_mouseDown)
-        {
-            return;
-        }
-
-        // ghostty opens a link on the *release* of a click over one
-        // (Surface.zig, processLinks). This release is not a click - WT never
-        // said the button came up, we are inferring it - so a URL that opened
-        // out of it would be one nobody asked for. The action arrives
-        // synchronously, on this thread, so a flag separates the two.
-        _suppressOpenUrl = true;
-        ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_RELEASE, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
-        _suppressOpenUrl = false;
-        _mouseDown = false;
-    }
-
-    // This is where a drag's anchor actually comes from, and it is the only
-    // place that knows it: ControlInteractivity calls it on the first pointer
-    // movement past the drag threshold, with the *touchdown* point floored, and
-    // one cell further right when the drag runs leftwards. That +1 is why the
-    // character you started on stays selected whichever way you drag.
-    //
-    // The press has to happen here rather than at the click. ghostty latches
-    // its anchor when the button goes down and will not re-latch, so pressing
-    // at click time - before the direction is known - latched WT's *rounded*
-    // click position instead, one character late whenever the click landed in
-    // the right half of a character. That was the reported bug.
-    //
-    // clear_selection first, because a press within one cell width of the last
-    // one is a double click to ghostty and would select by word. The action
-    // ends the click sequence, so this press counts as one.
-    void GhosttyControlCore::SetSelectionAnchor(const Core::Point positionCore)
-    {
-        if (!_surface)
-        {
-            return;
-        }
-
-        _releaseMouseIfHeld();
-        _bindingAction("clear_selection");
-        _selectionDroveTheMouse();
-        _mouseTo(positionCore, _selectionMods());
-
-        // The press carries no modifiers, and that is deliberate: ghostty reads
-        // the rectangle off each mouse *position*, but off the press it reads
-        // something else entirely - `if (mods.ctrlOrSuper()) .output else .line`
-        // picks what a third click would select. A press claiming ctrl would
-        // quietly turn alt+triple-click into "select the command's output".
-        ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
-        _mouseDown = true;
-
-        // A drag is about to make a selection, and ControlInteractivity decides
-        // whether to copy it on release from this event - the click that began
-        // the drag had nothing to copy yet and said so.
-        //
-        // ClearMarkers is *true*, as it is on cascadia for a mouse drag: the
-        // markers are the keyboard/mark-mode affordance, and ControlCore only
-        // asks for them when SelectionMode() >= Keyboard. Passing false instead
-        // told TermControl to show them, and it places them from SelectionInfo(),
-        // which this engine cannot fill in - so both handles were drawn at cell
-        // (0,0) and a stray sliver appeared at the top-left of the pane on every
-        // rightward drag.
-        UpdateSelectionMarkers.raise(*this, winrt::make<implementation::UpdateSelectionMarkersEventArgs>(true));
-    }
-
-    void GhosttyControlCore::SetEndSelectionPoint(const Core::Point positionCore)
-    {
-        // Only meaningful mid-drag, which is the only time WT calls it.
-        _selectionDroveTheMouse();
-        _mouseTo(positionCore, _selectionMods());
-    }
-
-    // The click that begins a selection.
-    //
-    // A single click sends no press at all. The position WT gives here is
-    // rounded to the nearest cell edge, which is a guess at where the selection
-    // should start; the drag anchor that follows knows, because by then the
-    // direction is known. Pressing on that guess is what latched the anchor a
-    // character late. All a single click owes ghostty is that the old selection
-    // goes away, and clear_selection does that without latching anything.
-    //
-    // Multi-clicks do press, once per click, so ghostty's own count reaches the
-    // behaviour Windows already decided on: two presses select a word, three a
-    // line. Replaying rather than forwarding a count keeps the two sides'
-    // click-timing rules out of it - and because click one cleared the sequence,
-    // the replay always starts from zero.
-    void GhosttyControlCore::LeftClickOnTerminal(const Core::Point terminalPositionCore,
-                                                 const int32_t numberOfClicks,
-                                                 const bool altEnabled,
-                                                 const bool /*shiftEnabled*/,
-                                                 const bool /*isOnOriginalPosition*/,
-                                                 bool& selectionNeedsToBeCopied)
-    {
-        if (!_surface)
-        {
-            return;
-        }
-
-        // Alt at the click is what makes the drag that follows a block
-        // selection, exactly as it is for cascadia (ControlCore's
-        // SetBlockSelection(altEnabled) on this same call). The drag arrives
-        // later, through SetSelectionAnchor and SetEndSelectionPoint, and
-        // neither is told about modifiers - so the answer is latched here.
-        _blockSelect = altEnabled;
-
-        // A new physical click ends whatever drag ghostty still thinks is in
-        // progress. Without this a press below is swallowed as a move and the
-        // click extends the previous selection instead of starting one.
-        _releaseMouseIfHeld();
-        _bindingAction("clear_selection");
-        _selectionDroveTheMouse();
-
-        if (numberOfClicks > 1)
-        {
-            // A double- or triple-click drag selects by word or by line, and
-            // ghostty's gesture ignores `rectangle` for both - the same as
-            // cascadia, whose expansion modes overrule block mode too. So the
-            // position carries the drag's modifiers for whatever follows, and
-            // the presses stay bare for the reason SetSelectionAnchor gives.
-            _mouseTo(terminalPositionCore, _selectionMods());
-            for (auto i = 0; i < numberOfClicks; ++i)
-            {
-                ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
-            }
-            _mouseDown = true;
-        }
-
-
-        // Cascadia's meaning, not "is copy-on-select on": the flag says whether
-        // there is now a selection worth copying when the button comes up. A
-        // single click cleared one, so there is nothing; a double or triple
-        // click just made one.
-        //
-        // A drag makes one too, and says so from SetSelectionAnchor - the
-        // release that would copy it comes long after this call.
-        selectionNeedsToBeCopied = numberOfClicks > 1;
-    }
