-    void GhosttyControlCore::LostFocus()
-    {
-        _trace(L"LostFocus (surface=%p)", _surface);
-        _focused = false;
-
-        // What is held while another window owns the keyboard is not ours to
-        // report. Keeping it would let a ctrl released elsewhere go on
-        // highlighting links here on the next hover.
-        _keyMods = GHOSTTY_MODS_NONE;
-        if (_surface)
-        {
-            ghostty_surface_set_focus(_surface, false);
-        }
-    }
-
-    // Mouse reporting: the path an application takes when it has asked for the
-    // mouse with DECSET 1000/1002/1003/1006 and friends.
-    //
-    // Returning false here used to mean "not handled", which routed every
-    // pointer event down WT's *selection* path instead. Applications still saw
-    // events, because the selection path drives ghostty's mouse to make
-    // selections and ghostty reports whatever mouse input it receives - but
-    // what they saw was the shape of the selection machinery rather than their
-    // input: presses arrived twice (SetSelectionAnchor presses, and
-    // LeftClickOnTerminal replays one press per click of a multi-click), a
-    // plain single click sent no press at all, and the right button, the
-    // middle button and the wheel never arrived because the selection path only
-    // ever sends GHOSTTY_MOUSE_LEFT. See GD-07 and docs/MOUSE-DUPLICATE-REPORTS.md.
-    //
-    // The arbitration between "this is a selection" and "the application owns
-    // the mouse" is not ours: ControlInteractivity::_canSendVTMouseInput picks
-    // this path over the selection path, and it also implements the convention
-    // that holding shift suppresses reporting so a user can always select. All
-    // this has to do is answer honestly and do what it is told.
-    bool GhosttyControlCore::SendMouseEvent(const Core::Point viewportPosCore,
-                                            const uint32_t uiButton,
-                                            const ControlKeyStates states,
-                                            const int16_t wheelDelta,
-                                            const Control::MouseButtonState /*state*/)
-    {
-        if (!_surface || !ghostty_surface_mouse_captured(_surface))
-        {
-            return false;
-        }
-
-        const auto mods = GhosttyMods(states);
-
-        // Every report carries a position, so the pointer moves first whatever
-        // the event is. ghostty derives the reported cell from this.
-        _mouseTo(viewportPosCore, mods);
-
-        const auto button = [&]() {
-            switch (uiButton)
-            {
-            case WM_LBUTTONDOWN:
-            case WM_LBUTTONUP:
-                return GHOSTTY_MOUSE_LEFT;
-            case WM_RBUTTONDOWN:
-            case WM_RBUTTONUP:
-                return GHOSTTY_MOUSE_RIGHT;
-            case WM_MBUTTONDOWN:
-            case WM_MBUTTONUP:
-                return GHOSTTY_MOUSE_MIDDLE;
-            default:
-                return GHOSTTY_MOUSE_UNKNOWN;
-            }
-        }();
-
-        switch (uiButton)
-        {
-        case WM_LBUTTONDOWN:
-        case WM_RBUTTONDOWN:
-        case WM_MBUTTONDOWN:
-            ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, button, mods);
-            // The selection path synthesises a release before it starts or ends
-            // a selection, keyed off this flag. A press sent from here must set
-            // it too, or leaving mouse mode mid-drag leaves ghostty believing a
-            // button is still down.
-            _mouseDown = true;
-            break;
-
-        case WM_LBUTTONUP:
-        case WM_RBUTTONUP:
-        case WM_MBUTTONUP:
-            ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_RELEASE, button, mods);
-            _mouseDown = false;
-            break;
-
-        case WM_MOUSEWHEEL:
-        case WM_MOUSEHWHEEL:
-        {
-            // ghostty documents its own convention on scrollCallback: "negative
-            // is down, left; positive is up, right", and in a non-precision
-            // event the offset is in wheel *ticks*. Windows agrees on both
-            // signs, so this is a division by WHEEL_DELTA and not a negation -
-            // getting that wrong inverts scrolling, which is easy to ship and
-            // annoying to live with.
-            const auto ticks = static_cast<double>(wheelDelta) / WHEEL_DELTA;
-            const auto x = uiButton == WM_MOUSEHWHEEL ? ticks : 0.0;
-            const auto y = uiButton == WM_MOUSEHWHEEL ? 0.0 : ticks;
-            // Scroll mods are precision/momentum, which a Windows wheel has
-            // neither of; a mouse wheel is exactly the non-precision case.
-            ghostty_surface_mouse_scroll(_surface, x, y, 0);
-            break;
-        }
-
-        default:
-            // WM_MOUSEMOVE and anything else: the position above is the whole
-            // event. ghostty decides whether motion is worth reporting from the
-            // modes the application set (1002 wants drags, 1003 wants all
-            // motion), which is not a decision to duplicate here.
-            break;
-        }
-
-        return true;
-    }
