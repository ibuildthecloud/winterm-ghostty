-    // The modifier bits libghostty wants, from the modifier state Windows
-    // Terminal reports on the event that carried them. Every path into
-    // libghostty that takes modifiers comes through here, so they cannot drift
-    // apart.
-    static ghostty_input_mods_e GhosttyMods(const ControlKeyStates states) noexcept
-    {
-        auto mods = GHOSTTY_MODS_NONE;
-        if (states.IsShiftPressed()) { mods = static_cast<ghostty_input_mods_e>(mods | GHOSTTY_MODS_SHIFT); }
-        if (states.IsCtrlPressed()) { mods = static_cast<ghostty_input_mods_e>(mods | GHOSTTY_MODS_CTRL); }
-        if (states.IsAltPressed()) { mods = static_cast<ghostty_input_mods_e>(mods | GHOSTTY_MODS_ALT); }
-        return mods;
-    }
-
-    // The text a key press produces, as UTF-8, or empty for keys that produce
-    // none. ToUnicode rather than waiting for the CharacterReceived event, so
-    // the text arrives *with* the key ghostty is given rather than as a
-    // separate message that would have to be correlated back to it.
-    //
-    // The 1<<2 flag is load-bearing: it tells ToUnicode not to modify
-    // kernel-side keyboard state. Without it, probing a dead key here consumes
-    // it and the next key silently loses its accent.
-    bool GhosttyControlCore::TrySendKeyEvent(const WORD vkey,
-                                             const WORD scanCode,
-                                             const ControlKeyStates modifiers,
-                                             const bool keyDown)
-    {
-        // Once the child has exited, ctrl+d and Enter are the host's keys, not
-        // the terminal's - the connection has just printed a message promising
-        // that they close the pane and restart it. Cascadia keeps that promise
-        // in SendCharEvent, which a ghostty pane never reaches: libghostty
-        // encodes Enter and ctrl+d itself and reports the key handled, so no
-        // CharacterReceived event follows. Answered here instead, ahead of the
-        // surface, and the release is swallowed with the press so the dead
-        // surface is not handed a lone key-up. See KD-24.
-        //
-        // Before the read-only check on purpose: a read-only pane whose process
-        // is gone still has to be closable, which is cascadia's behaviour too.
-        if (_connection && _connection.State() >= TerminalConnection::ConnectionState::Closed)
-        {
-            switch (GhosttyExitKeyFor(vkey, modifiers.Value()))
-            {
-            case GhosttyExitKey::Close:
-                // Already on the UI thread - this is TermControl's key handler.
-                if (keyDown)
-                {
-                    CloseTerminalRequested.raise(*this, nullptr);
-                }
-                return true;
-            case GhosttyExitKey::Restart:
-                if (keyDown)
-                {
-                    // The host answers by handing us a fresh connection.
-                    RestartTerminalRequested.raise(*this, nullptr);
-                }
-                return true;
-            default:
-                break;
-            }
-        }
-
-        if (!_surface || _readOnly)
-        {
-            return false;
-        }
-
-        ghostty_input_key_s ev{};
-        ev.action = keyDown ? GHOSTTY_ACTION_PRESS : GHOSTTY_ACTION_RELEASE;
-
-        // Native keycode, not the virtual key - see GhosttyKeyTranslator.h for
-        // why, and what happened when it was the virtual key.
-        ev.keycode = GhosttyNativeKeycode(scanCode, (modifiers.Value() & ENHANCED_KEY) != 0);
-        ev.composing = false;
-
-        const auto mods = GhosttyMods(modifiers);
-        ev.mods = mods;
-
-        // Kept for the pointer, which has to state the modifiers on every
-        // position it sends and is handed none by WT's hover call. Not a second
-        // source of truth: ghostty derives its own modifier state from these
-        // same key events, so the two can only ever agree.
-        _keyMods = mods;
-        // consumed_mods is set below, once the text is known - it cannot be
-        // decided before we have seen what the layout produced.
-
-        // The text has to travel with the key. TermControl treats a handled
-        // key as "the terminal translated it" and suppresses the
-        // CharacterReceived event that would otherwise carry the character, so
-        // a key reported as handled with no text would swallow it.
-        std::string text;
-        std::string unshifted;
-        if (keyDown)
-        {
-            // From the event's modifiers, never the thread's keyboard state -
-            // see GhosttyKeyTextFor, and the `?` that came out as `/`.
-            text = GhosttyKeyTextFor(modifiers.Value(), vkey, scanCode);
-
-            // What key bindings match against, so it has to ignore Shift and
-            // the lock keys - otherwise ctrl+shift+c would fail to match a
-            // binding written against `c`.
-            unshifted = GhosttyKeyTextFor(0, vkey, scanCode);
-        }
-        // Which modifiers were *consumed* to produce that text, which is not
-        // the same question as which were held. Shift held while typing `?` is
-        // consumed by the layout: the character already accounts for it.
-        //
-        // This was hardcoded to NONE, and only the kitty keyboard protocol
-        // noticed. ghostty computes effectiveMods() = mods.unset(consumed_mods)
-        // and sends text directly only when the result is empty
-        // (key_encode.zig, "Send plain-text non-modified text directly"). With
-        // nothing marked consumed, `?` looked like shift+<something>, so the
-        // branch was skipped and it encoded CSI 47;2u instead - the *unshifted*
-        // codepoint 47 (`/`) plus a shift modifier. An application reading the
-        // base key printed `/` for a typed `?`.
-        //
-        // Legacy apps never saw it because that path writes the UTF-8 as-is,
-        // which is why this looked like a single misbehaving application rather
-        // than a defect here.
-        //
-        // Determined by asking the layout, not by assuming a US keyboard: if
-        // removing a modifier changes the text it produces, that modifier was
-        // consumed.
-        auto consumed = GHOSTTY_MODS_NONE;
-        if (keyDown && !text.empty())
-        {
-            const auto raw = modifiers.Value();
-            if (modifiers.IsShiftPressed() &&
-                GhosttyKeyTextFor(raw & ~SHIFT_PRESSED, vkey, scanCode) != text)
-            {
-                consumed = static_cast<ghostty_input_mods_e>(consumed | GHOSTTY_MODS_SHIFT);
-            }
-
-            // AltGr arrives as ctrl+alt on Windows and is consumed the same
-            // way - on a German layout it is what turns `q` into `@`.
-            constexpr uint32_t ctrlAlt = LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED |
-                                         LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED;
-            if ((modifiers.IsCtrlPressed() || modifiers.IsAltPressed()) &&
-                GhosttyKeyTextFor(raw & ~ctrlAlt, vkey, scanCode) != text)
-            {
-                if (modifiers.IsCtrlPressed()) { consumed = static_cast<ghostty_input_mods_e>(consumed | GHOSTTY_MODS_CTRL); }
-                if (modifiers.IsAltPressed()) { consumed = static_cast<ghostty_input_mods_e>(consumed | GHOSTTY_MODS_ALT); }
-            }
-        }
-        ev.consumed_mods = consumed;
-
-        ev.text = text.empty() ? nullptr : text.c_str();
-        ev.unshifted_codepoint = (!unshifted.empty() && gsl::narrow_cast<unsigned char>(unshifted[0]) < 0x80) ?
-                                     gsl::narrow_cast<uint32_t>(gsl::narrow_cast<unsigned char>(unshifted[0])) :
-                                     0;
-
-        return ghostty_surface_key(_surface, ev);
-    }
-
-    // A character the key path did not consume, written literally.
-    //
-    // Not ghostty_surface_text: that is libghostty's *paste* entry point, and
-    // input/paste.zig replaces every control character with a space. A char
-    // event is the user typing, so the bytes go through as they are - which is
-    // what cascadia does too, encoding the character and writing it to the
-    // connection rather than pasting it. See GD-15.
-    bool GhosttyControlCore::SendCharEvent(const wchar_t ch, const WORD /*scanCode*/, const ControlKeyStates /*modifiers*/)
-    {
-        // The same two post-exit keys as TrySendKeyEvent, matched on the
-        // character exactly as cascadia matches them. In practice the key path
-        // above answers first and nothing arrives here; this is for the char
-        // that reaches us without a key event we recognised - an IME commit, an
-        // injected VK_PACKET - so the promise does not depend on which path the
-        // character took. See KD-24.
-        if (_connection && _connection.State() >= TerminalConnection::ConnectionState::Closed)
-        {
-            if (ch == L'\x04')
-            {
-                CloseTerminalRequested.raise(*this, nullptr);
-                return true;
-            }
-            if (ch == L'\r')
-            {
-                RestartTerminalRequested.raise(*this, nullptr);
-                return true;
-            }
-        }
-
-        if (!_surface || _readOnly)
-        {
-            return false;
-        }
-
-        const wchar_t buf[2]{ ch, L'\0' };
-        WriteToConnection(til::u16u8(std::wstring_view{ buf, 1 }));
-        return true;
-    }
-
-    // Bytes the user deliberately asked to send: the `sendInput` action and
-    // broadcast input (RawWriteString). Literal - unfiltered and unframed.
-    //
-    // This used to call ghostty_surface_text, whose own doc comment says it is
-    // "treated like a paste so this isn't useful for sending escape
-    // sequences". It was not: every ESC in a sendInput action arrived as a
-    // space, wrapped in a ESC[200~/ESC[201~ pair the action never asked for
-    // (GD-15). Only PasteText wants that encoder, and only PasteText calls it.
-    //
-    // What a direct write skips is libghostty's scroll-to-bottom, which
-    // completeClipboardPaste does on the way through. That is the paste's
-    // behaviour, not this path's: cascadia does not snap the viewport for
-    // SendInput either - TrySnapOnInput sits on the key and paste paths only -
-    // so not scrolling here is the parity behaviour rather than an omission.
-    void GhosttyControlCore::SendInput(std::wstring_view wstr)
-    {
-        if (_readOnly || wstr.empty())
-        {
-            return;
-        }
-        WriteToConnection(til::u16u8(wstr));
-    }
-
-    void GhosttyControlCore::PasteText(const winrt::hstring& hstr)
-    {
-        if (!_surface || _readOnly)
-        {
-            return;
-        }
-
-        // Non-empty text needs nothing from us: ghostty_surface_text is
-        // libghostty's paste entry point, so it already fenceposts the data
-        // when mode 2004 is on and strips the bytes xterm strips. Adding our
-        // own ESC[200~ here would send two of them. This is the one caller
-        // that wants that encoder - SendInput stopped routing through it in
-        // GD-15.
-        //
-        // Empty text is the exception, and it is not a no-op. An empty
-        // bracketed paste is how an application learns a paste happened with
-        // nothing on the clipboard - WT's own core calls that load-bearing and
-        // GNOME Terminal does the same. libghostty returns early on
-        // zero-length input before the encoder ever sees it, so the bare pair
-        // has to come from here.
-        //
-        // Reachable only since BracketedPasteEnabled started telling the
-        // truth: TerminalPage discards an empty paste outright when it thinks
-        // the mode is off, which it always did before.
-        if (hstr.empty())
-        {
-            if (BracketedPasteEnabled())
-            {
-                WriteToConnection("\x1b[200~\x1b[201~");
-            }
-            return;
-        }
-
-        const auto utf8 = til::u16u8(std::wstring_view{ hstr });
-        ghostty_surface_text(_surface, utf8.data(), utf8.size());
-    }
-
-    // Focus is traced because it is not observable any other way and it decides
-    // whether an idle pane costs a rebuild and a present every 600 ms. These
-    // are XAML's *routed* focus events on the control, which is not the same
-    // thing as the window being active - see _createSurface and KD-04.
-    void GhosttyControlCore::GotFocus()
-    {
-        _trace(L"GotFocus (surface=%p)", _surface);
-        _focused = true;
