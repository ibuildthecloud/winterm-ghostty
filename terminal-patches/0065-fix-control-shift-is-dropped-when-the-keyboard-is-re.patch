+        // The bit a modifier key press sets, or 0 for a key that is not a
+        // modifier.
+        //
+        // Left and right are kept apart because AltGr arrives as left ctrl plus
+        // right alt and the layout looks at exactly that pair. XAML reports the
+        // sided virtual key for a modifier (OriginalKey), but the generic one
+        // still turns up - from an injected event, or from a client that sends
+        // VK_SHIFT rather than VK_LSHIFT - so both are handled, with the
+        // extended-key flag standing in for the side when it has to.
+        uint32_t ModifierBitFor(const uint16_t vkey, const bool extended) noexcept
+        {
+            switch (vkey)
+            {
+            case VK_SHIFT:
+            case VK_LSHIFT:
+            case VK_RSHIFT:
+                // ControlKeyStates has one shift bit, not two.
+                return SHIFT_PRESSED;
+            case VK_LCONTROL:
+                return LEFT_CTRL_PRESSED;
+            case VK_RCONTROL:
+                return RIGHT_CTRL_PRESSED;
+            case VK_CONTROL:
+                return extended ? RIGHT_CTRL_PRESSED : LEFT_CTRL_PRESSED;
+            case VK_LMENU:
+                return LEFT_ALT_PRESSED;
+            case VK_RMENU:
+                return RIGHT_ALT_PRESSED;
+            case VK_MENU:
+                return extended ? RIGHT_ALT_PRESSED : LEFT_ALT_PRESSED;
+            default:
+                return 0;
+            }
+        }
