+    // Detach happens when the content outlives its control - tearing a tab out
+    // into its own window is the everyday case. The core keeps running the
+    // whole time.
+    //
+    // The connection subscriptions therefore stay: revoking them here silently
+    // severed the pty for the rest of the session, so a torn-off tab never
+    // showed another byte. Cascadia does not touch its connection here either.
+    //
+    // What must go is anything bound to the UI thread we are leaving. The new
+    // control may live on a *different* UI thread, and events marshalled to the
+    // old dispatcher would never arrive.
+    void GhosttyControlCore::Detach()
+    {
+        _dispatcher = nullptr;
+    }
+
+    void GhosttyControlCore::AttachToNewControl()
+    {
+        // Re-capture the dispatcher on whichever UI thread we have landed on.
+        // Cascadia does the same via _setupDispatcherAndCallbacks, and its
+        // comment on Detach says why: "on a possibly new UI thread".
+        _dispatcher = winrt::Windows::System::DispatcherQueue::GetForCurrentThread();
+
+        // The new control binds the swap chain from this event's args, so a
+        // torn-off pane needs the current handle pushed at it.
+        _raiseSwapChainChanged();
+
+        Attached.raise(*this, nullptr);
+    }
