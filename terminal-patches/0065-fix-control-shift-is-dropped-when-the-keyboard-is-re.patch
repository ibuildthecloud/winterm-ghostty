+
+    // Search, across a synchronous/asynchronous seam.
+    //
+    // WT asks a question and expects the answer in the return value. ghostty
+    // runs its search on a thread of its own and reports the counts back later,
+    // as SEARCH_TOTAL and SEARCH_SELECTED actions. So this starts the work and
+    // returns what is known now - which, for a brand-new needle, is nothing.
+    //
+    // That gap is not papered over. A negative total is what SearchBoxControl
+    // renders as "Searching...", so the honest answer and the right-looking one
+    // are the same answer. When the counts do arrive, SearchResultsChanged
+    // brings TermControl back round to ask again.
+    //
+    // Case sensitivity and regex are not forwarded because ghostty's needle is
+    // a plain byte string. SearchSupportsRegex/SearchSupportsCaseSensitivity
+    // report that, and the search box disables the toggles - the request's
+    // fields are ignored here rather than silently changing nothing.
+    SearchResults GhosttyControlCore::Search(const SearchRequest& request)
+    {
+        if (request.Text.empty())
+        {
+            ClearSearch();
+            return {};
+        }
+
+        const auto needle = std::wstring{ request.Text };
+        const auto isNewNeedle = needle != _searchNeedle;
+
+        if (isNewNeedle)
+        {
+            _searchNeedle = needle;
+            _searchSelected = -1;
+            // Selecting a match is ours to ask for: ghostty highlights every
+            // match but selects none until it is navigated, and WT's status box
+            // renders "no current match" as a literal "?" next to the total.
+            _selectFirstMatch = true;
+            _searchTotal = -1;
+
+            // ghostty replaces any active search, so this is both "start" and
+            // "change the terms".
+            _bindingAction(fmt::format("search:{}", til::u16u8(needle)));
+        }
+        else if (request.ExecuteSearch)
+        {
+            _navigateSearch(request.GoForward);
+        }
+
+        return {
+            // Nothing is known about this needle yet, and there is no honest
+            // number for that. -1 would render as "Searching...", which at
+            // ghostty's speed is gone before it can be read and looks like the
+            // status box glitching; 0 would claim there are no matches for a
+            // search that has not run. SearchStatusUnchanged is the third
+            // answer: leave the status alone until there is something true to
+            // put in it. SearchInvalidated still goes out, so the scrollbar
+            // rebuilds on time.
+            .TotalMatches = _searchTotal < 0 ? SearchStatusUnchanged : _searchTotal,
+            .CurrentMatch = _currentMatchFromTop(),
+            .SearchInvalidated = isNewNeedle,
+            // ghostty has no regex to be invalid, and the toggle is disabled.
+            .SearchRegexInvalid = false,
+        };
+    }
+
+    // The two engines count matches from opposite ends of the buffer.
+    //
+    // ghostty's first selection is the *newest* match and carries index 0
+    // (search/screen.zig: selectNext with no prior match takes
+    // active_results[len - 1] and assigns idx 0), and the index grows going
+    // backwards in time. Windows Terminal's status box means "the Nth match
+    // counting from the top". Reported unconverted, "1/9" highlighted what
+    // cascadia calls 9.
+    int32_t GhosttyControlCore::_currentMatchFromTop() const noexcept
+    {
+        if (_searchSelected < 0 || _searchTotal <= 0 || _searchSelected >= _searchTotal)
+        {
+            return -1;
+        }
+        return _searchTotal - 1 - _searchSelected;
+    }
+
+    // Same inversion, applied to the direction. ghostty's "next" walks *up* the
+    // buffer - it increments an index that counts backwards in time - where
+    // WT's "find next" walks down it. Forwarded unconverted, Enter and
+    // shift+Enter moved the highlight the wrong way in a ghostty pane while the
+    // numbers next to them counted the right way.
+    void GhosttyControlCore::_navigateSearch(bool goForward) const
+    {
+        _bindingAction(goForward ? "navigate_search:previous" : "navigate_search:next");
+    }
+
+    // Scrollbar pips need a row per match, and ghostty reports counts rather
+    // than positions - SEARCH_TOTAL is a number, and the match geometry never
+    // leaves the renderer. Empty, therefore, rather than wrong: a partial list
+    // would draw pips in the wrong places. Tracked as a documented diff.
+    Windows::Foundation::Collections::IVector<int32_t> GhosttyControlCore::SearchResultRows() const { return winrt::single_threaded_vector<int32_t>(); }
+    bool GhosttyControlCore::IsBufferRowInViewport(int32_t bufferRow) const { return bufferRow >= _scrollOffset && bufferRow < _scrollOffset + _viewHeight; }
+
+    void GhosttyControlCore::ClearSearch()
+    {
+        _searchNeedle.clear();
+        _searchTotal = -1;
+        _searchSelected = -1;
+        _bindingAction("end_search");
+    }
