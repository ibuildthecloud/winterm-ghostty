+
+    // Where the pointer is. Nothing here looks for a URL: ghostty finds links
+    // itself and reports the one under its *own* cursor as MOUSE_OVER_LINK, so
+    // all this owes it is a cursor that is where the pointer is.
+    //
+    // Until this existed the only positions ghostty ever got came from a
+    // selection or from VT mouse reporting, so its cursor sat wherever the last
+    // click had left it. Holding ctrl still lit up a link - ghostty re-runs
+    // link detection when the modifiers change - but it was the link at that
+    // stale point, and ctrl+click opened nothing at all (KD-20).
+    void GhosttyControlCore::SetHoveredCell(Core::Point terminalPosition)
+    {
+        // A drag owns the mouse. ControlInteractivity calls this at the end of
+        // every pointer move, a drag's moves included, and the drag has just
+        // sent this same position with the *selection's* modifiers - repeating
+        // it with the keyboard's would turn a block selection back into a
+        // linear one halfway through.
+        //
+        // The flag is per event, so it also swallows the first hover after an
+        // auto-scroll tick, which drives the mouse with no pointer move behind
+        // it. That costs one mouse move of latency and nothing else.
+        if (_selectionDrove)
+        {
+            _selectionDrove = false;
+            return;
+        }
+
+        if (!_surface || _closing)
+        {
+            return;
+        }
+
+        // The application owns the mouse. It is already being told where the
+        // pointer is, by SendMouseEvent, with the real event's modifiers; a
+        // second position from here would report an extra motion event to it.
+        if (ghostty_surface_mouse_captured(_surface))
+        {
+            return;
+        }
+
+        // The button is up, and this is the first thing WT calls after a drag
+        // ends - it reports no release outside VT mouse mode - so this is where
+        // the synthesised release belongs. Without it ghostty reads these hover
+        // positions as a drag that never ended, and the selection follows the
+        // pointer with no button held.
+        _releaseMouseIfHeld();
+
+        // A move within one cell is not worth a position: ghostty re-runs link
+        // detection on every one it is given, and WT sends one per pixel.
+        const til::point cell{ terminalPosition };
+        if (_hoveredCell == cell)
+        {
+            return;
+        }
+        _hoveredCell = cell;
+        _mouseTo(terminalPosition, _keyMods);
+    }
+
+    // The pointer left the control. A negative position is what ghostty reads
+    // as "outside": it drops the highlight and reports the link gone, which is
+    // what clears _hoveredUri.
+    void GhosttyControlCore::ClearHoveredCell()
+    {
+        _hoveredCell.reset();
+
+        // Not mid-drag. A drag that leaves the control keeps the pointer
+        // captured and the selection live, and "outside" would end it.
+        if (!_surface || _closing || _mouseDown)
+        {
+            return;
+        }
+        ghostty_surface_mouse_pos(_surface, -1.0, -1.0, _keyMods);
+    }
+
+    // The URL under the pointer, or empty for none.
+    //
+    // The position is ignored, deliberately. ghostty's answer is *about* the
+    // pointer's cell and arrives as an action rather than as an answer to a
+    // question, and the one caller - ControlInteractivity's ctrl+click - asks
+    // about the cell the pointer is in. So this is the same answer, and it is
+    // the only one available: the C API has no "what is at this point" call.
+    winrt::hstring GhosttyControlCore::GetHyperlink(const Core::Point /*position*/) const { return _hoveredUri; }
+
+    winrt::hstring GhosttyControlCore::HoveredUriText() const { return _hoveredUri; }
+
+    // Where TermControl draws the tooltip. Null when no link is under the
