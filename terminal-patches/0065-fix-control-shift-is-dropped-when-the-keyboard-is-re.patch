-
-    void GhosttyControlCore::Connection(const TerminalConnection::ITerminalConnection& connection)
-    {
-        _connectionOutputRevoker.revoke();
-        _connectionStateRevoker.revoke();
-
-        _connection = connection;
-        if (!_connection)
-        {
-            return;
-        }
-
-        _connectionOutputRevoker = _connection.TerminalOutput(winrt::auto_revoke, [this](const winrt::array_view<const char16_t>& data) {
-            _connectionOutputHandler(data);
-        });
-        _connectionStateRevoker = _connection.StateChanged(winrt::auto_revoke, [this](auto&&, auto&&) {
-            _connectionStateChangedHandler();
-        });
-    }
-
-    // Raised on the connection's own output thread, never the UI thread
-    // (ConptyConnection creates it with CreateThread). That matters: this call
-    // blocks until libghostty has parsed the bytes, and blocking here is
-    // exactly how backpressure reaches the child - the pipe fills and the child
-    // stalls on write.
-    //
-    // The contract that makes it safe: hold no WT-side lock across the call and
-    // do not wait on the dispatcher. libghostty's parse and render threads must
-    // never be able to block on something this thread holds.
-    void GhosttyControlCore::_connectionOutputHandler(const winrt::array_view<const char16_t>& data)
-    {
-        if (!_surface || _closing)
-        {
-            return;
-        }
-
-        const std::wstring_view wide{ reinterpret_cast<const wchar_t*>(data.data()), data.size() };
-
-        _utf8Scratch.clear();
-        if (FAILED(til::u16u8(wide, _utf8Scratch, _u16State)))
-        {
-            return;
-        }
-        if (_utf8Scratch.empty())
-        {
-            // A lone high surrogate: buffered in _u16State until its partner
-            // arrives in a later event.
-            return;
-        }
-
-        ghostty_surface_write_pty_output(_surface,
-                                         reinterpret_cast<const uint8_t*>(_utf8Scratch.data()),
-                                         _utf8Scratch.size());
-        // No render is forced here, and that is deliberate.
-        //
-        // Until 2026-08-07 this handler called ghostty_surface_render_now on
-        // every chunk, later throttled to 8ms, to work around a pane that froze
-        // mid-output. The freeze was blamed on libghostty's wakeup coalescing.
-        // It was not: on Windows, pty output never woke the renderer at all,
-        // because ghostty held the renderer wakeup by value and libxev's IOCP
-        // async keeps its state in the struct - so the copy's notify() set a
-        // bool nobody read. Fixed in ghostty patch 34; output now drives
-        // rendering by itself, measured at 321 renders in the second where it
-        // used to manage 2.
-        //
-        // Forcing a render here was expensive as well as unnecessary: this runs
-        // on the connection's output thread, whose blocking *is* the
-        // backpressure to the child, and render_now is a synchronous rebuild
-        // and present.
-    }
-
-    void GhosttyControlCore::_connectionStateChangedHandler()
-    {
-        // Re-apply the grid size the moment the pty can receive it.
-        //
-        // ConptyConnection::Resize only reaches the pseudoconsole while the
-        // connection is Connected; before that it just remembers the numbers for
-        // Start() to use. But Start() transitions to Connecting, *then* creates
-        // the pseudoconsole, and only reaches Connected afterwards - so a resize
-        // arriving in that window is recorded and never applied to anything.
-        //
-        // That window is exactly where ours arrives. TermControl initializes the
-        // core before starting the connection, libghostty sizes its surface
-        // during that initialization, and the resulting resize_pty callback is
-        // the one carrying the real grid. The result was a child that spent its
-        // whole life believing the terminal was 56x18 while the pane was 109x27:
-        // `stty size` disagreed with the pane's own CSI 18 t, long lines wrapped
-        // at half the width, and any full-screen program drew into a box a third
-        // of the pane. Resizing the window fixed it, because by then the state
-        // was Connected - which is what made it look like a rendering quirk
-        // rather than a pty bug.
-        //
-        // Resize is idempotent, so replaying it costs nothing when the size
-        // already took.
-        if (_connection && !_closing && _ptyColumns > 0 && _ptyRows > 0 &&
-            _connection.State() == TerminalConnection::ConnectionState::Connected)
-        {
-            _trace(L"reapplying pty size %ux%u on connect", _ptyColumns, _ptyRows);
-            _connection.Resize(_ptyRows, _ptyColumns);
-        }
-
-        _raiseOnUiThread([this]() { ConnectionStateChanged.raise(*this, nullptr); });
-    }
-
-    // Bytes the terminal wants to send to the child, arriving on libghostty's
-    // io thread. WriteInput is thread-safe on ConptyConnection, so this goes
-    // straight through rather than hopping to the UI thread.
-    void GhosttyControlCore::WriteToConnection(std::string_view utf8) noexcept
-    try
-    {
-        if (!_connection || _closing || _readOnly)
-        {
-            return;
-        }
-
-        const auto wide = til::u8u16(utf8);
-        _connection.WriteInput(winrt::array_view<const char16_t>{
-            reinterpret_cast<const char16_t*>(wide.data()),
-            reinterpret_cast<const char16_t*>(wide.data() + wide.size()) });
-    }
-    CATCH_LOG()
-
-    void GhosttyControlCore::ResizeConnection(uint16_t columns, uint16_t rows) noexcept
-    try
-    {
-        // Remembered even when there is no connection to tell yet: this is the
-        // authoritative grid size, and _connectionStateChangedHandler replays it
-        // once the pty can actually receive it.
-        _ptyColumns = columns;
-        _ptyRows = rows;
-
-        if (!_connection || _closing)
-        {
-            return;
-        }
-        _trace(L"resizeConnection %ux%u cells", columns, rows);
-        _connection.Resize(rows, columns);
-    }
-    CATCH_LOG()
-
-    TerminalConnection::ConnectionState GhosttyControlCore::ConnectionState() const
-    {
-        return _connection ? _connection.State() : TerminalConnection::ConnectionState::Closed;
-    }
