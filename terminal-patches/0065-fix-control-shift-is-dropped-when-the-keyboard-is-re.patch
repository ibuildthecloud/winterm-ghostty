+    void GhosttyControlCore::Close()
+    {
+        if (_closing)
+        {
+            return;
+        }
+        _closing = true;
+
+        _connectionOutputRevoker.revoke();
+        _connectionStateRevoker.revoke();
+
+        if (_connection)
+        {
+            _connection.Close();
+        }
+
+        // Free the surface before dropping the connection reference: the
+        // surface's threads can still be calling back into us until it is gone.
+        _destroySurface();
+    }
+
+    void GhosttyControlCore::RequestClose() noexcept
+    {
+        _raiseOnUiThread([this]() { CloseTerminalRequested.raise(*this, nullptr); });
+    }
+
+    void GhosttyControlCore::WriteClipboard(std::string&& plain, std::string&& html) noexcept
+    try
+    {
+        if (plain.empty() && html.empty())
+        {
+            return;
+        }
+
+        auto args = winrt::make<WriteToClipboardEventArgs>(
+            winrt::hstring{ til::u8u16(plain) },
+            std::move(html),
+            // ghostty has no RTF. Sending an empty one is honest: the
+            // clipboard simply carries no RTF flavour.
+            std::string{});
+
+        // Arrives on libghostty's thread; the event is one TermControl expects
+        // on the UI thread.
+        _raiseOnUiThread([this, args = std::move(args)]() {
+            WriteToClipboard.raise(*this, args);
+        });
+    }
+    CATCH_LOG()
+
+#pragma region Connection
+
+    TerminalConnection::ITerminalConnection GhosttyControlCore::Connection()
+    {
+        return _connection;
+    }
+
+    void GhosttyControlCore::Connection(const TerminalConnection::ITerminalConnection& connection)
+    {
+        _connectionOutputRevoker.revoke();
+        _connectionStateRevoker.revoke();
+
+        _connection = connection;
+        if (!_connection)
+        {
+            return;
+        }
+
+        _connectionOutputRevoker = _connection.TerminalOutput(winrt::auto_revoke, [this](const winrt::array_view<const char16_t>& data) {
+            _connectionOutputHandler(data);
+        });
+        _connectionStateRevoker = _connection.StateChanged(winrt::auto_revoke, [this](auto&&, auto&&) {
+            _connectionStateChangedHandler();
+        });
+    }
+
+    // Raised on the connection's own output thread, never the UI thread
+    // (ConptyConnection creates it with CreateThread). That matters: this call
+    // blocks until libghostty has parsed the bytes, and blocking here is
+    // exactly how backpressure reaches the child - the pipe fills and the child
+    // stalls on write.
+    //
+    // The contract that makes it safe: hold no WT-side lock across the call and
+    // do not wait on the dispatcher. libghostty's parse and render threads must
+    // never be able to block on something this thread holds.
+    void GhosttyControlCore::_connectionOutputHandler(const winrt::array_view<const char16_t>& data)
+    {
+        if (!_surface || _closing)
+        {
+            return;
+        }
+
+        const std::wstring_view wide{ reinterpret_cast<const wchar_t*>(data.data()), data.size() };
+
+        _utf8Scratch.clear();
+        if (FAILED(til::u16u8(wide, _utf8Scratch, _u16State)))
+        {
+            return;
+        }
+        if (_utf8Scratch.empty())
+        {
+            // A lone high surrogate: buffered in _u16State until its partner
+            // arrives in a later event.
+            return;
+        }
+
+        ghostty_surface_write_pty_output(_surface,
+                                         reinterpret_cast<const uint8_t*>(_utf8Scratch.data()),
+                                         _utf8Scratch.size());
+        // No render is forced here, and that is deliberate.
+        //
+        // Until 2026-08-07 this handler called ghostty_surface_render_now on
+        // every chunk, later throttled to 8ms, to work around a pane that froze
+        // mid-output. The freeze was blamed on libghostty's wakeup coalescing.
+        // It was not: on Windows, pty output never woke the renderer at all,
+        // because ghostty held the renderer wakeup by value and libxev's IOCP
+        // async keeps its state in the struct - so the copy's notify() set a
+        // bool nobody read. Fixed in ghostty patch 34; output now drives
+        // rendering by itself, measured at 321 renders in the second where it
+        // used to manage 2.
+        //
+        // Forcing a render here was expensive as well as unnecessary: this runs
+        // on the connection's output thread, whose blocking *is* the
+        // backpressure to the child, and render_now is a synchronous rebuild
+        // and present.
+    }
+
+    void GhosttyControlCore::_connectionStateChangedHandler()
+    {
+        // Re-apply the grid size the moment the pty can receive it.
+        //
+        // ConptyConnection::Resize only reaches the pseudoconsole while the
+        // connection is Connected; before that it just remembers the numbers for
+        // Start() to use. But Start() transitions to Connecting, *then* creates
+        // the pseudoconsole, and only reaches Connected afterwards - so a resize
+        // arriving in that window is recorded and never applied to anything.
+        //
+        // That window is exactly where ours arrives. TermControl initializes the
+        // core before starting the connection, libghostty sizes its surface
+        // during that initialization, and the resulting resize_pty callback is
+        // the one carrying the real grid. The result was a child that spent its
+        // whole life believing the terminal was 56x18 while the pane was 109x27:
+        // `stty size` disagreed with the pane's own CSI 18 t, long lines wrapped
+        // at half the width, and any full-screen program drew into a box a third
+        // of the pane. Resizing the window fixed it, because by then the state
+        // was Connected - which is what made it look like a rendering quirk
+        // rather than a pty bug.
+        //
+        // Resize is idempotent, so replaying it costs nothing when the size
+        // already took.
+        if (_connection && !_closing && _ptyColumns > 0 && _ptyRows > 0 &&
+            _connection.State() == TerminalConnection::ConnectionState::Connected)
+        {
+            _trace(L"reapplying pty size %ux%u on connect", _ptyColumns, _ptyRows);
+            _connection.Resize(_ptyRows, _ptyColumns);
+        }
+
+        _raiseOnUiThread([this]() { ConnectionStateChanged.raise(*this, nullptr); });
+    }
+
+    // Bytes the terminal wants to send to the child, arriving on libghostty's
+    // io thread. WriteInput is thread-safe on ConptyConnection, so this goes
+    // straight through rather than hopping to the UI thread.
+    void GhosttyControlCore::WriteToConnection(std::string_view utf8) noexcept
+    try
+    {
+        if (!_connection || _closing || _readOnly)
+        {
+            return;
+        }
+
+        const auto wide = til::u8u16(utf8);
+        _connection.WriteInput(winrt::array_view<const char16_t>{
+            reinterpret_cast<const char16_t*>(wide.data()),
+            reinterpret_cast<const char16_t*>(wide.data() + wide.size()) });
+    }
+    CATCH_LOG()
+
+    void GhosttyControlCore::ResizeConnection(uint16_t columns, uint16_t rows) noexcept
+    try
+    {
+        // Remembered even when there is no connection to tell yet: this is the
+        // authoritative grid size, and _connectionStateChangedHandler replays it
+        // once the pty can actually receive it.
+        _ptyColumns = columns;
+        _ptyRows = rows;
+
+        if (!_connection || _closing)
+        {
+            return;
+        }
+        _trace(L"resizeConnection %ux%u cells", columns, rows);
+        _connection.Resize(rows, columns);
+    }
+    CATCH_LOG()
+
+    TerminalConnection::ConnectionState GhosttyControlCore::ConnectionState() const
+    {
+        return _connection ? _connection.State() : TerminalConnection::ConnectionState::Closed;
+    }
+
+    void GhosttyControlCore::HardResetWithoutErase()
+    {
+        // Cascadia uses this to reset VT state without clearing the buffer on
+        // a connection restart. libghostty has no equivalent C entry point yet.
+    }
+
+#pragma endregion
+
+#pragma region Actions from libghostty
+
+    bool GhosttyControlCore::HandleAction(const ghostty_action_s& action) noexcept
+    try
+    {
+        switch (action.tag)
+        {
+        case GHOSTTY_ACTION_SET_TITLE:
+        {
+            const auto title = til::u8u16(std::string_view{ action.action.set_title.title });
+            _raiseOnUiThread([this, title = winrt::hstring{ title }]() {
+                _title = title;
+                TitleChanged.raise(*this, winrt::make<implementation::TitleChangedEventArgs>(title));
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_PWD:
+        {
+            const auto pwd = til::u8u16(std::string_view{ action.action.pwd.pwd });
+            _raiseOnUiThread([this, pwd = winrt::hstring{ pwd }]() { _workingDirectory = pwd; });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_CELL_SIZE:
+        {
+            // libghostty's own arithmetic is the authority here; deriving cell
+            // metrics on our side would let the two disagree and tell the child
+            // a size the terminal is not using.
+            const auto width = static_cast<float>(action.action.cell_size.width);
+            const auto height = static_cast<float>(action.action.cell_size.height);
+            _trace(L"cellSize %.0fx%.0f px", width, height);
+            _raiseOnUiThread([this, width, height]() {
+                _cellSize = { width, height };
+                FontSizeChanged.raise(*this, winrt::make<implementation::FontSizeChangedArgs>(static_cast<int>(width), static_cast<int>(height)));
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_SCROLLBAR:
+        {
+            const auto total = static_cast<int32_t>(action.action.scrollbar.total);
+            const auto offset = static_cast<int32_t>(action.action.scrollbar.offset);
+            const auto len = static_cast<int32_t>(action.action.scrollbar.len);
+            _raiseOnUiThread([this, total, offset, len]() {
+                _bufferHeight = total;
+                _scrollOffset = offset;
+                _viewHeight = len;
+                ScrollPositionChanged.raise(*this, winrt::make<implementation::ScrollPositionChangedArgs>(offset, len, total));
+            });
+            return true;
+        }
+
+        // The answers to a search, arriving after Search() has already had to
+        // return. Both carry -1 for "not known", which is what ghostty means by
+        // a null total or null selection, and what WT's status box renders as
+        // "Searching..." - so the value crosses unchanged.
+        case GHOSTTY_ACTION_SEARCH_TOTAL:
+        {
+            const auto total = static_cast<int32_t>(action.action.search_total.total);
+            _raiseOnUiThread([this, total]() {
+                _searchTotal = total;
+
+                // A fresh search has matches but no current one, and WT renders
+                // that as "?/9". Cascadia lands on a match as you type - the
+                // one nearest the bottom of the buffer, so a search from the
+                // prompt starts at 9 of 9 - and ghostty's own first pick is the
+                // same match: selectNext with nothing selected takes
+                // active_results[len - 1] (search/screen.zig). So this asks for
+                // ghostty's, and the two agree without either side having to
+                // model the other's idea of "nearest".
+                //
+                // One-shot, because the total is re-reported whenever output
+                // changes what matches - re-selecting on every one of those
+                // would drag the highlight back under the user mid-navigation.
+                if (_selectFirstMatch && total > 0)
+                {
+                    _selectFirstMatch = false;
+                    _navigateSearch(false);
+                }
+                SearchResultsChanged.raise(*this, nullptr);
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_SEARCH_SELECTED:
+        {
+            const auto selected = static_cast<int32_t>(action.action.search_selected.selected);
+            _raiseOnUiThread([this, selected]() {
+                _searchSelected = selected;
+                SearchResultsChanged.raise(*this, nullptr);
+            });
+            return true;
+        }
+
+        // ghostty asks the embedder to open its search UI. WT's search box is
+        // opened by WT's own action, and this only ever arrives because we sent
+        // a search - so it is claimed rather than left to log as unhandled.
+        case GHOSTTY_ACTION_START_SEARCH:
+        case GHOSTTY_ACTION_END_SEARCH:
+            return true;
+
+        case GHOSTTY_ACTION_SWAP_CHAIN_CHANGED:
+        {
+            // The handle travels in the event args, boxed as a uint64 -
+            // TermControl::RenderEngineSwapChainChanged unboxes it and binds
+            // that, and never re-reads SwapChainHandle(). Raising this with
+            // null args is not a no-op, it throws in the unbox.
+            //
+            // This is also the *only* path that ever binds the panel on a
+            // normal (non-reattach) startup, which is why getting it wrong
+            // shows up as a permanently blank pane rather than a late one.
+            _raiseSwapChainChanged();
+            return true;
+        }
+
+        case GHOSTTY_ACTION_RING_BELL:
+        {
+            _raiseOnUiThread([this]() { WarningBell.raise(*this, nullptr); });
+            return true;
+        }
+
+        // OSC 777;notify, and iTerm2's bare OSC 9;<text>. Everything a
+        // notification needs after this point is TerminalPage's and knows
+        // nothing about engines - the toast itself, the rate limit, the "do
+        // not notify about the pane you are already looking at" rule, and
+        // clicking the toast to summon the window - so raising the same event
+        // ControlCore raises is the whole job.
+        //
+        // An empty title is not a defect to paper over here: ghostty leaves it
+        // empty for OSC 9, which carries only a body, and Tab.cpp fills it in
+        // with the tab's own title.
+        //
+        // The user's switch is the profile's `compatibility.allowOSC777`,
+        // which GhosttySettingsTranslator hands to ghostty as
+        // `desktop-notifications`. A pane whose profile says no therefore
+        // never reaches this case at all - Surface.zig tests the config before
+        // dispatching the action - so there is deliberately no second gate
+        // here to disagree with the first.
+        case GHOSTTY_ACTION_DESKTOP_NOTIFICATION:
+        {
+            const auto title = til::u8u16(std::string_view{ action.action.desktop_notification.title });
+            const auto body = til::u8u16(std::string_view{ action.action.desktop_notification.body });
+            // A notification that does not appear has four places it can have
+            // been dropped - the profile, ghostty's own rate limit, WT's "you
+            // are looking at that pane already" rule, and the toast API itself -
+            // and only this one is ours. Sizes rather than the text: the
+            // debugger channel is the wrong place for what a program chose to
+            // say to the user.
+            _trace(L"notification title=%u body=%u chars", static_cast<unsigned>(title.size()), static_cast<unsigned>(body.size()));
+            _raiseOnUiThread([this, title = winrt::hstring{ title }, body = winrt::hstring{ body }]() {
+                ShowNotification.raise(*this, winrt::make<implementation::ShowNotificationEventArgs>(title, body));
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_PROGRESS_REPORT:
+        {
+            const auto state = static_cast<size_t>(action.action.progress_report.state);
+            const auto progress = static_cast<size_t>(action.action.progress_report.progress);
+            _raiseOnUiThread([this, state, progress]() {
+                _taskbarState = state;
+                _taskbarProgress = progress;
+                TaskbarProgressChanged.raise(*this, nullptr);
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_COLOR_CHANGE:
+        {
+            const auto kind = action.action.color_change.kind;
+            const til::color color{ action.action.color_change.r, action.action.color_change.g, action.action.color_change.b };
+            _raiseOnUiThread([this, kind, color]() {
+                if (kind == GHOSTTY_ACTION_COLOR_KIND_BACKGROUND)
+                {
+                    BackgroundColorChanged.raise(*this, nullptr);
+                }
+                TabColorChanged.raise(*this, nullptr);
+            });
+            return true;
+        }
+
+        // The link under the pointer - the only way an embedder learns there
+        // is one, because ghostty owns link detection (its `link-url` regex and
+        // OSC 8) and draws the highlight itself. An empty URL means the pointer
+        // left the link. Reported only when the highlight changes, so this is
+        // not a per-move event.
+        case GHOSTTY_ACTION_MOUSE_OVER_LINK:
+        {
+            // The bytes belong to an arena that dies with this call, so the
+            // copy happens here rather than on the UI thread.
+            const auto& link = action.action.mouse_over_link;
+            const winrt::hstring uri{ link.len > 0 ? til::u8u16(std::string_view{ link.url, link.len }) : std::wstring{} };
+            _raiseOnUiThread([this, uri]() {
+                if (_hoveredUri == uri)
+                {
+                    return;
+                }
+                _hoveredUri = uri;
+                HoveredHyperlinkChanged.raise(*this, nullptr);
+            });
+            return true;
+        }
+
+        // ghostty decided a link should open: a ctrl+click it handled itself,
+        // or an `open_url` binding. Windows Terminal has its own opener, with
+        // the confirmation dialog for schemes it does not trust, so this is
+        // handed up rather than opened here - and *claimed*, because a
+        // libghostty told that nobody handled it falls back to its own opener
+        // (rundll32 url.dll,FileProtocolHandler, os/open.zig), which would step
+        // around that dialog.
+        case GHOSTTY_ACTION_OPEN_URL:
+        {
+            if (_suppressOpenUrl)
+            {
+                return true;
+            }
+            const auto& open = action.action.open_url;
+            const winrt::hstring uri{ til::u8u16(std::string_view{ open.url, open.len }) };
+            _raiseOnUiThread([this, uri]() {
+                OpenHyperlink.raise(*this, winrt::make<implementation::OpenHyperlinkEventArgs>(uri));
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_RENDERER_HEALTH:
+        {
+            if (action.action.renderer_health != GHOSTTY_RENDERER_HEALTH_HEALTHY)
+            {
+                _raiseOnUiThread([this]() { RendererEnteredErrorState.raise(*this, nullptr); });
+            }
+            return true;
+        }
+
+        // Tab and split creation belong to WT's own keybindings, which sit
+        // above the interface. Reporting these unhandled is correct, not a gap.
+        case GHOSTTY_ACTION_NEW_TAB:
+        case GHOSTTY_ACTION_NEW_SPLIT:
+        case GHOSTTY_ACTION_NEW_WINDOW:
+        default:
+            return false;
+        }
+    }
+    catch (...)
+    {
+        LOG_CAUGHT_EXCEPTION();
+        return false;
+    }
+
+    // Re-read the handle and hand it to the control, boxed the way
+    // TermControl expects. Read on the UI thread rather than captured at the
+    // raise site: the renderer may have replaced it again in between, and the
+    // last one wins either way.
+    void GhosttyControlCore::_raiseSwapChainChanged()
+    {
+        _raiseOnUiThread([this]() {
+            const auto handle = SwapChainHandle();
+            if (handle == 0)
+            {
+                return;
+            }
+            SwapChainChanged.raise(*this, winrt::box_value<uint64_t>(handle));
+        });
+    }
+
+    // Events that IControlCore documents as UI-thread must arrive there. If we
+    // are already on it, run inline so ordering with the caller is preserved.
+    void GhosttyControlCore::_raiseOnUiThread(std::function<void()> action)
+    {
+        if (!_dispatcher || _dispatcher.HasThreadAccess())
+        {
+            action();
+            return;
+        }
+
+        _dispatcher.TryEnqueue([action = std::move(action)]() { action(); });
+    }
+
+#pragma endregion
+
+#pragma region Size and font
+
+    // TermControl hands out the panel's size in DIPs, but ghostty_surface_set_size
+    // takes physical pixels - it is sizing the swap chain, not a layout box.
+    // Passing DIPs makes an undersized swap chain that the panel then upscales
+    // by the composition scale: glyphs come out magnified and soft, and the
+    // edges do not quite reach, which reads as a border around the terminal.
+    // Cascadia does the same multiply (ControlCore.cpp: _panelWidth * _compositionScale).
+    void GhosttyControlCore::SizeChanged(const float width, const float height)
+    {
+        _panelWidth = width;
+        _panelHeight = height;
+        _pushSize();
+    }
+
+    void GhosttyControlCore::ScaleChanged(const float scale)
+    {
+        _compositionScale = scale;
+        if (_surface)
+        {
+            ghostty_surface_set_content_scale(_surface, scale, scale);
+        }
+        _pushSize();
+    }
+
+    void GhosttyControlCore::SizeOrScaleChanged(const float width, const float height, const float scale)
+    {
+        _compositionScale = scale;
+        _panelWidth = width;
+        _panelHeight = height;
+        if (_surface)
+        {
+            ghostty_surface_set_content_scale(_surface, scale, scale);
+        }
+        _pushSize();
+    }
+
+    void GhosttyControlCore::_pushSize()
+    {
+        if (!_surface)
+        {
+            return;
+        }
+
+        const auto w = static_cast<uint32_t>(std::lrint(std::max(0.0f, _panelWidth) * _compositionScale));
+        const auto h = static_cast<uint32_t>(std::lrint(std::max(0.0f, _panelHeight) * _compositionScale));
+
+        // Windows sends 0x0 on minimize, and a swap chain cannot be resized to
+        // zero.
+        if (w == 0 || h == 0)
+        {
+            return;
+        }
+
+        _trace(L"pushSize panel=%.1fx%.1f dips scale=%.3f -> %ux%u px", _panelWidth, _panelHeight, _compositionScale, w, h);
+        ghostty_surface_set_size(_surface, w, h);
+    }
+
+    // Sizing and DPI bugs here are invisible from the outside - the pane just
+    // looks wrong - and a packaged app has no stdout, so the traces go to the
+    // debugger channel where `scripts\smoke-release.ps1` can also read them and
+    // prove which engine a window is running.
+    //
+    // They go out on their own thread, and that is not tidiness.
+    // OutputDebugString is **not** the free call this code used to claim it was
+    // when no debugger is attached: DBWIN is a machine-wide channel, and once
+    // anything has attached to it and stopped servicing it - a debugger that was
+    // killed, a script that exited without closing the shared events - every
+    // writer on the machine waits on DBWIN_BUFFER_READY and gives up only after
+    // **ten seconds**, per call. Measured here at 10,005 ms a call after a probe
+    // script leaked its listener. A pane traces about forty lines while it comes
+    // up, on the UI thread, so the terminal window took minutes to appear and
+    // looked for all the world like a hang - reported as "nothing pops up, the
+    // terminal is never shown".
+    //
+    // A bounded queue drained by one worker means a wedged channel costs a
+    // trace and never the terminal. Formatting stays on the caller so the line
+    // reflects the moment it was traced.
+    namespace
+    {
+        class TraceSink
+        {
+        public:
+            static TraceSink& Get()
+            {
+                // Deliberately leaked. The worker has to outlive static
+                // destruction: a trace emitted while the process is tearing
+                // itself down must not reach a half-destroyed object.
+                static TraceSink* sink = new TraceSink();
+                return *sink;
+            }
+
+            void Write(std::wstring line)
+            {
+                {
+                    std::lock_guard<std::mutex> guard{ _mutex };
+                    // Drop rather than grow without bound or wait, which is the
+                    // whole point of being here.
+                    if (_queue.size() >= 512)
+                    {
+                        return;
+                    }
+                    _queue.push_back(std::move(line));
+                }
+                _cv.notify_one();
+            }
+
+        private:
+            TraceSink()
+            {
+                std::thread{ [this]() { _run(); } }.detach();
+            }
+
+            void _run()
+            {
+                for (;;)
+                {
+                    std::wstring line;
+                    {
+                        std::unique_lock<std::mutex> guard{ _mutex };
+                        _cv.wait(guard, [this]() { return !_queue.empty(); });
+                        line = std::move(_queue.front());
+                        _queue.pop_front();
+                    }
+                    // One call per line, not three: each is a round trip on the
+                    // channel, and three was three times the exposure.
+                    OutputDebugStringW(line.c_str());
+                }
+            }
+
+            std::mutex _mutex;
+            std::condition_variable _cv;
+            std::deque<std::wstring> _queue;
+        };
+    }
+
+    void GhosttyControlCore::_trace(const wchar_t* format, ...)
+    {
+        wchar_t buf[512];
+        va_list args;
+        va_start(args, format);
+        const auto n = _vsnwprintf_s(buf, _TRUNCATE, format, args);
+        va_end(args);
+        if (n > 0)
+        {
+            TraceSink::Get().Write(L"[ghostty] " + std::wstring{ buf } + L"\n");
+        }
+    }
+
+    uint64_t GhosttyControlCore::SwapChainHandle() const
+    {
+        if (!_surface)
+        {
+            return 0;
+        }
+        return reinterpret_cast<uint64_t>(ghostty_surface_get_swap_chain_handle(_surface));
+    }
+
+    winrt::Windows::Foundation::Size GhosttyControlCore::FontSize() const noexcept
+    {
+        return _cellSize;
+    }
+
+    winrt::Windows::Foundation::Size GhosttyControlCore::FontSizeInDips() const
+    {
+        return { _cellSize.Width / _compositionScale, _cellSize.Height / _compositionScale };
+    }
+
+    uint16_t GhosttyControlCore::FontWeight() const noexcept
+    {
+        return static_cast<uint16_t>(400);
+    }
+
+    void GhosttyControlCore::AdjustFontSize(float /*fontSizeDelta*/)
+    {
+        // Needs the config C API; see _applySettingsToConfig.
+    }
+
+    void GhosttyControlCore::ResetFontSize()
+    {
+    }
+
+#pragma endregion
+
+#pragma region Input
+
+    // The modifier bits libghostty wants, from the modifier state Windows
+    // Terminal reports on the event that carried them. Every path into
+    // libghostty that takes modifiers comes through here, so they cannot drift
+    // apart.
+    static ghostty_input_mods_e GhosttyMods(const ControlKeyStates states) noexcept
+    {
+        auto mods = GHOSTTY_MODS_NONE;
+        if (states.IsShiftPressed()) { mods = static_cast<ghostty_input_mods_e>(mods | GHOSTTY_MODS_SHIFT); }
+        if (states.IsCtrlPressed()) { mods = static_cast<ghostty_input_mods_e>(mods | GHOSTTY_MODS_CTRL); }
+        if (states.IsAltPressed()) { mods = static_cast<ghostty_input_mods_e>(mods | GHOSTTY_MODS_ALT); }
+        return mods;
+    }
+
+    // The text a key press produces, as UTF-8, or empty for keys that produce
+    // none. ToUnicode rather than waiting for the CharacterReceived event, so
+    // the text arrives *with* the key ghostty is given rather than as a
+    // separate message that would have to be correlated back to it.
+    //
+    // The 1<<2 flag is load-bearing: it tells ToUnicode not to modify
+    // kernel-side keyboard state. Without it, probing a dead key here consumes
+    // it and the next key silently loses its accent.
+    bool GhosttyControlCore::TrySendKeyEvent(const WORD vkey,
+                                             const WORD scanCode,
+                                             const ControlKeyStates modifiers,
+                                             const bool keyDown)
+    {
+        // What was held when this key was pressed, which is not what the
+        // modifiers handed to us say - they are a snapshot taken when XAML
+        // raised the event, and it can be later than the key. See
+        // GhosttyModifiersFor and KD-25. Updated first, and on every path out
+        // of here, because it is the *stream* that is being tracked: a key
+        // event dropped for being read-only still says shift went down.
+        const ControlKeyStates held{ GhosttyModifiersFor(_heldMods,
+                                                         modifiers.Value(),
+                                                         vkey,
+                                                         (modifiers.Value() & ENHANCED_KEY) != 0,
+                                                         keyDown) };
+
+        // Once the child has exited, ctrl+d and Enter are the host's keys, not
+        // the terminal's - the connection has just printed a message promising
+        // that they close the pane and restart it. Cascadia keeps that promise
+        // in SendCharEvent, which a ghostty pane never reaches: libghostty
+        // encodes Enter and ctrl+d itself and reports the key handled, so no
+        // CharacterReceived event follows. Answered here instead, ahead of the
+        // surface, and the release is swallowed with the press so the dead
+        // surface is not handed a lone key-up. See KD-24.
+        //
+        // Before the read-only check on purpose: a read-only pane whose process
+        // is gone still has to be closable, which is cascadia's behaviour too.
+        if (_connection && _connection.State() >= TerminalConnection::ConnectionState::Closed)
+        {
+            switch (GhosttyExitKeyFor(vkey, held.Value()))
+            {
+            case GhosttyExitKey::Close:
+                // Already on the UI thread - this is TermControl's key handler.
+                if (keyDown)
+                {
+                    CloseTerminalRequested.raise(*this, nullptr);
+                }
+                return true;
+            case GhosttyExitKey::Restart:
+                if (keyDown)
+                {
+                    // The host answers by handing us a fresh connection.
+                    RestartTerminalRequested.raise(*this, nullptr);
+                }
+                return true;
+            default:
+                break;
+            }
+        }
+
+        if (!_surface || _readOnly)
+        {
+            return false;
+        }
+
+        ghostty_input_key_s ev{};
+        ev.action = keyDown ? GHOSTTY_ACTION_PRESS : GHOSTTY_ACTION_RELEASE;
+
+        // Native keycode, not the virtual key - see GhosttyKeyTranslator.h for
+        // why, and what happened when it was the virtual key.
+        ev.keycode = GhosttyNativeKeycode(scanCode, (modifiers.Value() & ENHANCED_KEY) != 0);
+        ev.composing = false;
+
+        const auto mods = GhosttyMods(held);
+        ev.mods = mods;
+
+        // Kept for the pointer, which has to state the modifiers on every
+        // position it sends and is handed none by WT's hover call. Not a second
+        // source of truth: ghostty derives its own modifier state from these
+        // same key events, so the two can only ever agree.
+        _keyMods = mods;
+        // consumed_mods is set below, once the text is known - it cannot be
+        // decided before we have seen what the layout produced.
+
+        // The text has to travel with the key. TermControl treats a handled
+        // key as "the terminal translated it" and suppresses the
+        // CharacterReceived event that would otherwise carry the character, so
+        // a key reported as handled with no text would swallow it.
+        std::string text;
+        std::string unshifted;
+        if (keyDown)
+        {
+            // Under what was held when the key arrived, never the thread's
+            // keyboard state - see GhosttyKeyTextFor and GhosttyModifiersFor,
+            // and the two separate ways `?` came out as `/`.
+            text = GhosttyKeyTextFor(held.Value(), vkey, scanCode);
+
+            // What key bindings match against, so it has to ignore Shift and
+            // the lock keys - otherwise ctrl+shift+c would fail to match a
+            // binding written against `c`.
+            unshifted = GhosttyKeyTextFor(0, vkey, scanCode);
+        }
+        // Which modifiers were *consumed* to produce that text, which is not
+        // the same question as which were held. Shift held while typing `?` is
+        // consumed by the layout: the character already accounts for it.
+        //
+        // This was hardcoded to NONE, and only the kitty keyboard protocol
+        // noticed. ghostty computes effectiveMods() = mods.unset(consumed_mods)
+        // and sends text directly only when the result is empty
+        // (key_encode.zig, "Send plain-text non-modified text directly"). With
+        // nothing marked consumed, `?` looked like shift+<something>, so the
+        // branch was skipped and it encoded CSI 47;2u instead - the *unshifted*
+        // codepoint 47 (`/`) plus a shift modifier. An application reading the
+        // base key printed `/` for a typed `?`.
+        //
+        // Legacy apps never saw it because that path writes the UTF-8 as-is,
+        // which is why this looked like a single misbehaving application rather
+        // than a defect here.
+        //
+        // Determined by asking the layout, not by assuming a US keyboard: if
+        // removing a modifier changes the text it produces, that modifier was
+        // consumed.
+        auto consumed = GHOSTTY_MODS_NONE;
+        if (keyDown && !text.empty())
+        {
+            const auto raw = held.Value();
+            if (held.IsShiftPressed() &&
+                GhosttyKeyTextFor(raw & ~SHIFT_PRESSED, vkey, scanCode) != text)
+            {
+                consumed = static_cast<ghostty_input_mods_e>(consumed | GHOSTTY_MODS_SHIFT);
+            }
+
+            // AltGr arrives as ctrl+alt on Windows and is consumed the same
+            // way - on a German layout it is what turns `q` into `@`.
+            constexpr uint32_t ctrlAlt = LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED |
+                                         LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED;
+            if ((held.IsCtrlPressed() || held.IsAltPressed()) &&
+                GhosttyKeyTextFor(raw & ~ctrlAlt, vkey, scanCode) != text)
+            {
+                if (held.IsCtrlPressed()) { consumed = static_cast<ghostty_input_mods_e>(consumed | GHOSTTY_MODS_CTRL); }
+                if (held.IsAltPressed()) { consumed = static_cast<ghostty_input_mods_e>(consumed | GHOSTTY_MODS_ALT); }
+            }
+        }
+        ev.consumed_mods = consumed;
+
+        ev.text = text.empty() ? nullptr : text.c_str();
+        ev.unshifted_codepoint = (!unshifted.empty() && gsl::narrow_cast<unsigned char>(unshifted[0]) < 0x80) ?
+                                     gsl::narrow_cast<uint32_t>(gsl::narrow_cast<unsigned char>(unshifted[0])) :
+                                     0;
+
+        return ghostty_surface_key(_surface, ev);
+    }
+
+    // A character the key path did not consume, written literally.
+    //
+    // Not ghostty_surface_text: that is libghostty's *paste* entry point, and
+    // input/paste.zig replaces every control character with a space. A char
+    // event is the user typing, so the bytes go through as they are - which is
+    // what cascadia does too, encoding the character and writing it to the
+    // connection rather than pasting it. See GD-15.
+    bool GhosttyControlCore::SendCharEvent(const wchar_t ch, const WORD /*scanCode*/, const ControlKeyStates /*modifiers*/)
+    {
+        // The same two post-exit keys as TrySendKeyEvent, matched on the
+        // character exactly as cascadia matches them. In practice the key path
+        // above answers first and nothing arrives here; this is for the char
+        // that reaches us without a key event we recognised - an IME commit, an
+        // injected VK_PACKET - so the promise does not depend on which path the
+        // character took. See KD-24.
+        if (_connection && _connection.State() >= TerminalConnection::ConnectionState::Closed)
+        {
+            if (ch == L'\x04')
+            {
+                CloseTerminalRequested.raise(*this, nullptr);
+                return true;
+            }
+            if (ch == L'\r')
+            {
+                RestartTerminalRequested.raise(*this, nullptr);
+                return true;
+            }
+        }
+
+        if (!_surface || _readOnly)
+        {
+            return false;
+        }
+
+        const wchar_t buf[2]{ ch, L'\0' };
+        WriteToConnection(til::u16u8(std::wstring_view{ buf, 1 }));
+        return true;
+    }
+
+    // Bytes the user deliberately asked to send: the `sendInput` action and
+    // broadcast input (RawWriteString). Literal - unfiltered and unframed.
+    //
+    // This used to call ghostty_surface_text, whose own doc comment says it is
+    // "treated like a paste so this isn't useful for sending escape
+    // sequences". It was not: every ESC in a sendInput action arrived as a
+    // space, wrapped in a ESC[200~/ESC[201~ pair the action never asked for
+    // (GD-15). Only PasteText wants that encoder, and only PasteText calls it.
+    //
+    // What a direct write skips is libghostty's scroll-to-bottom, which
+    // completeClipboardPaste does on the way through. That is the paste's
+    // behaviour, not this path's: cascadia does not snap the viewport for
+    // SendInput either - TrySnapOnInput sits on the key and paste paths only -
+    // so not scrolling here is the parity behaviour rather than an omission.
+    void GhosttyControlCore::SendInput(std::wstring_view wstr)
+    {
+        if (_readOnly || wstr.empty())
+        {
+            return;
+        }
+        WriteToConnection(til::u16u8(wstr));
+    }
+
+    void GhosttyControlCore::PasteText(const winrt::hstring& hstr)
+    {
+        if (!_surface || _readOnly)
+        {
+            return;
+        }
+
+        // Non-empty text needs nothing from us: ghostty_surface_text is
+        // libghostty's paste entry point, so it already fenceposts the data
+        // when mode 2004 is on and strips the bytes xterm strips. Adding our
+        // own ESC[200~ here would send two of them. This is the one caller
+        // that wants that encoder - SendInput stopped routing through it in
+        // GD-15.
+        //
+        // Empty text is the exception, and it is not a no-op. An empty
+        // bracketed paste is how an application learns a paste happened with
+        // nothing on the clipboard - WT's own core calls that load-bearing and
+        // GNOME Terminal does the same. libghostty returns early on
+        // zero-length input before the encoder ever sees it, so the bare pair
+        // has to come from here.
+        //
+        // Reachable only since BracketedPasteEnabled started telling the
+        // truth: TerminalPage discards an empty paste outright when it thinks
+        // the mode is off, which it always did before.
+        if (hstr.empty())
+        {
+            if (BracketedPasteEnabled())
+            {
+                WriteToConnection("\x1b[200~\x1b[201~");
+            }
+            return;
+        }
+
+        const auto utf8 = til::u16u8(std::wstring_view{ hstr });
+        ghostty_surface_text(_surface, utf8.data(), utf8.size());
+    }
+
+    // Focus is traced because it is not observable any other way and it decides
+    // whether an idle pane costs a rebuild and a present every 600 ms. These
+    // are XAML's *routed* focus events on the control, which is not the same
+    // thing as the window being active - see _createSurface and KD-04.
+    void GhosttyControlCore::GotFocus()
+    {
+        _trace(L"GotFocus (surface=%p)", _surface);
+        _focused = true;
+
+        // Nothing held before we had the keyboard was seen as an event here,
+        // and its release will be. Starting from empty is the only state that
+        // cannot be wrong in the direction that matters - a modifier believed
+        // held that is not would put every key in the wrong case.
+        _heldMods = 0;
+        if (_surface)
+        {
+            ghostty_surface_set_focus(_surface, true);
+        }
+    }
+
+    void GhosttyControlCore::LostFocus()
+    {
+        _trace(L"LostFocus (surface=%p)", _surface);
+        _focused = false;
+
+        // What is held while another window owns the keyboard is not ours to
+        // report. Keeping it would let a ctrl released elsewhere go on
+        // highlighting links here on the next hover - and, for the keys we
+        // track ourselves, a release delivered to that other window would
+        // never reach us at all, leaving shift stuck down here forever.
+        _keyMods = GHOSTTY_MODS_NONE;
+        _heldMods = 0;
+        if (_surface)
+        {
+            ghostty_surface_set_focus(_surface, false);
+        }
+    }
+
+    // Mouse reporting: the path an application takes when it has asked for the
+    // mouse with DECSET 1000/1002/1003/1006 and friends.
+    //
+    // Returning false here used to mean "not handled", which routed every
+    // pointer event down WT's *selection* path instead. Applications still saw
+    // events, because the selection path drives ghostty's mouse to make
+    // selections and ghostty reports whatever mouse input it receives - but
+    // what they saw was the shape of the selection machinery rather than their
+    // input: presses arrived twice (SetSelectionAnchor presses, and
+    // LeftClickOnTerminal replays one press per click of a multi-click), a
+    // plain single click sent no press at all, and the right button, the
+    // middle button and the wheel never arrived because the selection path only
+    // ever sends GHOSTTY_MOUSE_LEFT. See GD-07 and docs/MOUSE-DUPLICATE-REPORTS.md.
+    //
+    // The arbitration between "this is a selection" and "the application owns
+    // the mouse" is not ours: ControlInteractivity::_canSendVTMouseInput picks
+    // this path over the selection path, and it also implements the convention
+    // that holding shift suppresses reporting so a user can always select. All
+    // this has to do is answer honestly and do what it is told.
+    bool GhosttyControlCore::SendMouseEvent(const Core::Point viewportPosCore,
+                                            const uint32_t uiButton,
+                                            const ControlKeyStates states,
+                                            const int16_t wheelDelta,
+                                            const Control::MouseButtonState /*state*/)
+    {
+        if (!_surface || !ghostty_surface_mouse_captured(_surface))
+        {
+            return false;
+        }
+
+        const auto mods = GhosttyMods(states);
+
+        // Every report carries a position, so the pointer moves first whatever
+        // the event is. ghostty derives the reported cell from this.
+        _mouseTo(viewportPosCore, mods);
+
+        const auto button = [&]() {
+            switch (uiButton)
+            {
+            case WM_LBUTTONDOWN:
+            case WM_LBUTTONUP:
+                return GHOSTTY_MOUSE_LEFT;
+            case WM_RBUTTONDOWN:
+            case WM_RBUTTONUP:
+                return GHOSTTY_MOUSE_RIGHT;
+            case WM_MBUTTONDOWN:
+            case WM_MBUTTONUP:
+                return GHOSTTY_MOUSE_MIDDLE;
+            default:
+                return GHOSTTY_MOUSE_UNKNOWN;
+            }
+        }();
+
+        switch (uiButton)
+        {
+        case WM_LBUTTONDOWN:
+        case WM_RBUTTONDOWN:
+        case WM_MBUTTONDOWN:
+            ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, button, mods);
+            // The selection path synthesises a release before it starts or ends
+            // a selection, keyed off this flag. A press sent from here must set
+            // it too, or leaving mouse mode mid-drag leaves ghostty believing a
+            // button is still down.
+            _mouseDown = true;
+            break;
+
+        case WM_LBUTTONUP:
+        case WM_RBUTTONUP:
+        case WM_MBUTTONUP:
+            ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_RELEASE, button, mods);
+            _mouseDown = false;
+            break;
+
+        case WM_MOUSEWHEEL:
+        case WM_MOUSEHWHEEL:
+        {
+            // ghostty documents its own convention on scrollCallback: "negative
+            // is down, left; positive is up, right", and in a non-precision
+            // event the offset is in wheel *ticks*. Windows agrees on both
+            // signs, so this is a division by WHEEL_DELTA and not a negation -
+            // getting that wrong inverts scrolling, which is easy to ship and
+            // annoying to live with.
+            const auto ticks = static_cast<double>(wheelDelta) / WHEEL_DELTA;
+            const auto x = uiButton == WM_MOUSEHWHEEL ? ticks : 0.0;
+            const auto y = uiButton == WM_MOUSEHWHEEL ? 0.0 : ticks;
+            // Scroll mods are precision/momentum, which a Windows wheel has
+            // neither of; a mouse wheel is exactly the non-precision case.
+            ghostty_surface_mouse_scroll(_surface, x, y, 0);
+            break;
+        }
+
+        default:
+            // WM_MOUSEMOVE and anything else: the position above is the whole
+            // event. ghostty decides whether motion is worth reporting from the
+            // modes the application set (1002 wants drags, 1003 wants all
+            // motion), which is not a decision to duplicate here.
+            break;
+        }
+
+        return true;
+    }
+
+    // The scrollbar's thumb, dragged. WT gives an absolute buffer row for the
+    // top of the viewport, which is exactly what ghostty's scroll_to_row takes
+    // (0 being the first row of the screen, scrollback included), so the two
+    // coordinate systems line up without arithmetic.
+    //
+    // Driven through the binding-action API because that is the only route to
+    // an absolute scroll position; the mouse-scroll entry point only moves by
+    // deltas and would drift against the thumb.
+    void GhosttyControlCore::UserScrollViewport(const int32_t viewTop)
+    {
+        if (!_surface)
+        {
+            return;
+        }
+
+        const auto action = fmt::format("scroll_to_row:{}", std::max(0, viewTop));
+        _bindingAction(action);
+    }
+
+    // Most of what an embedder needs from libghostty has no C entry point and
+    // is reached through a *named binding action* instead - the same route
+    // ghostty's own keybindings take. `scroll_to_row` in Phase 5 was the first;
+    // selection, search and copy in Phase 6 all arrive the same way.
+    // There is no _renderNow, and that is deliberate - see KD-19.
+    //
+    // It used to call ghostty_surface_render_now, which ran the renderer's
+    // whole frame update on *this* thread. That is not a thing a second thread
+    // may do: upstream calls updateFrame from the surface's render thread and
+    // nowhere else, and the parts of it that clear and repopulate each row's
+    // highlight list, and that resize row_data, run outside any lock another
+    // caller would take. A ghostty pane crashed on 2026-08-18 reading a freed
+    // highlight list, with the UI thread inside rebuildCells and that surface's
+    // render thread parked on a renderer futex.
+    //
+    // Nothing replaces it, because nothing needs to: every operation these call
+    // sites perform already calls queueRender inside libghostty - selection
+    // through cursorPosCallback and mouseButtonCallback, select_all and
+    // clear_selection in their binding actions, preedit on all three of its
+    // paths, and the scroll actions through the IO thread. The render thread
+    // renders immediately on that wakeup; its coalescing timer is commented out
+    // upstream.
+    //
+    // The staleness this was written to fix was never coalescing either. It was
+    // the renderer wakeup being held by value, so notify() set a bool nobody
+    // read - ghostty patch 34, after which output alone drove 321 renders in
+    // the second where it used to manage 2.
+
+    bool GhosttyControlCore::_bindingAction(const std::string_view action) const
+    {
+        if (!_surface)
+        {
+            return false;
+        }
+        if (!ghostty_surface_binding_action(_surface, action.data(), action.size()))
+        {
+            _trace(L"binding action rejected (%.*hs)", gsl::narrow_cast<int>(action.size()), action.data());
+            return false;
+        }
+        return true;
+    }
+
+#pragma endregion
+
+#pragma region Selection
+
+    // What WT hands out is not a cell under the pointer - it is a selection
+    // *boundary*, already rounded. ControlInteractivity does that rounding
+    // before the core is called: the drag anchor floors the touchdown point and
+    // adds one when the drag runs leftwards, and the far end rounds to the
+    // nearest cell edge. Measured against the real cascadia core in
+    // UnitTests_Control::SelectionDragGeometryTests; see docs/selection-geometry.md.
+    //
+    // ghostty is a boundary model too, but it derives the boundary from where
+    // in the cell the pointer is: at or past 60% of the cell width, the
+    // boundary is the cell's right edge, otherwise its left edge
+    // (SelectionGesture.zig, threshold `@round(cell_width * 0.6)`; confirmed on
+    // the real engine with GHOSTTY_HARNESS_SELECT_SWEEP).
+    //
+    // So to mean boundary B, send a pixel inside cell B below that threshold.
+    // A quarter of the way across leaves margin on both sides: the cell's own
+    // left edge below, the 60% threshold above, with room for the content scale
+    // and for ghostty truncating to whole pixels. The cell *centre*, which this
+    // used to send, also lands below 60% - the far end of a drag was never the
+    // bug - but 0.1 of a cell is not a margin worth relying on.
+    void GhosttyControlCore::_mouseTo(const Core::Point cell, const ghostty_input_mods_e mods) const
+    {
+        if (!_surface)
+        {
+            return;
+        }
+        // DIPs, not physical pixels. libghostty applies the content scale to
+        // mouse positions itself, and _cellSize is in pixels - so multiplying
+        // cells by it directly lands scale-times too far across the screen.
+        // On a 100% display that is invisible; at 200% a selection starts
+        // roughly twice as far right as the pointer.
+        //
+        // Measured, not reasoned: driving this sequence in harness/hwnd-host
+        // with GHOSTTY_HARNESS_SELECT on a 200% monitor asked for cells 2..4
+        // and got 5..8 back, and asked for 5..9 and got 11..14.
+        //
+        // No padding term: the settings translator pins window-padding-x/y to
+        // zero because WT insets the SwapChainPanel itself. ghostty's own
+        // arithmetic does subtract padding_left before taking the fraction, so
+        // if that ever stops being zero this has to grow the term with it.
+        const auto cellWidth = _cellSize.Width / _compositionScale;
+        const auto cellHeight = _cellSize.Height / _compositionScale;
+        const auto x = (static_cast<double>(cell.X) + 0.25) * cellWidth;
+        const auto y = (static_cast<double>(cell.Y) + 0.5) * cellHeight;
+        ghostty_surface_mouse_pos(_surface, x, y, mods);
+    }
+
+    // Every mouse event of a selection carries these, because the engine reads
+    // block-vs-linear off the modifiers of each event rather than latching a
+    // mode at the press. GhosttySelectionMods.h has the engine's rule; what is
+    // decided here is only *when* WT considers a drag to be a block one, which
+    // is the alt state at the click, held for the drag.
+    ghostty_input_mods_e GhosttyControlCore::_selectionMods() const noexcept
+    {
+        return GhosttySelectionMods(_blockSelect);
+    }
+
+    // Windows Terminal never tells the core that the button came up: only VT
+    // mouse mode sees a release, and selection is the non-VT path. ghostty
+    // needs one, or it treats the next pointer move as a continued drag.
+    //
+    // So the release is synthesised lazily - immediately before anything that
+    // starts or ends a selection. Between the user letting go and that next
+    // action, no mouse events are sent at all, so ghostty's belief that a drag
+    // is still live has nothing to act on.
+    void GhosttyControlCore::_releaseMouseIfHeld() const
+    {
+        if (!_surface || !_mouseDown)
+        {
+            return;
+        }
+
+        // ghostty opens a link on the *release* of a click over one
+        // (Surface.zig, processLinks). This release is not a click - WT never
+        // said the button came up, we are inferring it - so a URL that opened
+        // out of it would be one nobody asked for. The action arrives
+        // synchronously, on this thread, so a flag separates the two.
+        _suppressOpenUrl = true;
+        ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_RELEASE, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
+        _suppressOpenUrl = false;
+        _mouseDown = false;
+    }
+
+    // This is where a drag's anchor actually comes from, and it is the only
+    // place that knows it: ControlInteractivity calls it on the first pointer
+    // movement past the drag threshold, with the *touchdown* point floored, and
+    // one cell further right when the drag runs leftwards. That +1 is why the
+    // character you started on stays selected whichever way you drag.
+    //
+    // The press has to happen here rather than at the click. ghostty latches
+    // its anchor when the button goes down and will not re-latch, so pressing
+    // at click time - before the direction is known - latched WT's *rounded*
+    // click position instead, one character late whenever the click landed in
+    // the right half of a character. That was the reported bug.
+    //
+    // clear_selection first, because a press within one cell width of the last
+    // one is a double click to ghostty and would select by word. The action
+    // ends the click sequence, so this press counts as one.
+    void GhosttyControlCore::SetSelectionAnchor(const Core::Point positionCore)
+    {
+        if (!_surface)
+        {
+            return;
+        }
+
+        _releaseMouseIfHeld();
+        _bindingAction("clear_selection");
+        _selectionDroveTheMouse();
+        _mouseTo(positionCore, _selectionMods());
+
+        // The press carries no modifiers, and that is deliberate: ghostty reads
+        // the rectangle off each mouse *position*, but off the press it reads
+        // something else entirely - `if (mods.ctrlOrSuper()) .output else .line`
+        // picks what a third click would select. A press claiming ctrl would
+        // quietly turn alt+triple-click into "select the command's output".
+        ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
+        _mouseDown = true;
+
+        // A drag is about to make a selection, and ControlInteractivity decides
+        // whether to copy it on release from this event - the click that began
+        // the drag had nothing to copy yet and said so.
+        //
+        // ClearMarkers is *true*, as it is on cascadia for a mouse drag: the
+        // markers are the keyboard/mark-mode affordance, and ControlCore only
+        // asks for them when SelectionMode() >= Keyboard. Passing false instead
+        // told TermControl to show them, and it places them from SelectionInfo(),
+        // which this engine cannot fill in - so both handles were drawn at cell
+        // (0,0) and a stray sliver appeared at the top-left of the pane on every
+        // rightward drag.
+        UpdateSelectionMarkers.raise(*this, winrt::make<implementation::UpdateSelectionMarkersEventArgs>(true));
+    }
+
+    void GhosttyControlCore::SetEndSelectionPoint(const Core::Point positionCore)
+    {
+        // Only meaningful mid-drag, which is the only time WT calls it.
+        _selectionDroveTheMouse();
+        _mouseTo(positionCore, _selectionMods());
+    }
+
+    // The click that begins a selection.
+    //
+    // A single click sends no press at all. The position WT gives here is
+    // rounded to the nearest cell edge, which is a guess at where the selection
+    // should start; the drag anchor that follows knows, because by then the
+    // direction is known. Pressing on that guess is what latched the anchor a
+    // character late. All a single click owes ghostty is that the old selection
+    // goes away, and clear_selection does that without latching anything.
+    //
+    // Multi-clicks do press, once per click, so ghostty's own count reaches the
+    // behaviour Windows already decided on: two presses select a word, three a
+    // line. Replaying rather than forwarding a count keeps the two sides'
+    // click-timing rules out of it - and because click one cleared the sequence,
+    // the replay always starts from zero.
+    void GhosttyControlCore::LeftClickOnTerminal(const Core::Point terminalPositionCore,
+                                                 const int32_t numberOfClicks,
+                                                 const bool altEnabled,
+                                                 const bool /*shiftEnabled*/,
+                                                 const bool /*isOnOriginalPosition*/,
+                                                 bool& selectionNeedsToBeCopied)
+    {
+        if (!_surface)
+        {
+            return;
+        }
+
+        // Alt at the click is what makes the drag that follows a block
+        // selection, exactly as it is for cascadia (ControlCore's
+        // SetBlockSelection(altEnabled) on this same call). The drag arrives
+        // later, through SetSelectionAnchor and SetEndSelectionPoint, and
+        // neither is told about modifiers - so the answer is latched here.
+        _blockSelect = altEnabled;
+
+        // A new physical click ends whatever drag ghostty still thinks is in
+        // progress. Without this a press below is swallowed as a move and the
+        // click extends the previous selection instead of starting one.
+        _releaseMouseIfHeld();
+        _bindingAction("clear_selection");
+        _selectionDroveTheMouse();
+
+        if (numberOfClicks > 1)
+        {
+            // A double- or triple-click drag selects by word or by line, and
+            // ghostty's gesture ignores `rectangle` for both - the same as
+            // cascadia, whose expansion modes overrule block mode too. So the
+            // position carries the drag's modifiers for whatever follows, and
+            // the presses stay bare for the reason SetSelectionAnchor gives.
+            _mouseTo(terminalPositionCore, _selectionMods());
+            for (auto i = 0; i < numberOfClicks; ++i)
+            {
+                ghostty_surface_mouse_button(_surface, GHOSTTY_MOUSE_PRESS, GHOSTTY_MOUSE_LEFT, GHOSTTY_MODS_NONE);
+            }
+            _mouseDown = true;
+        }
+
+
+        // Cascadia's meaning, not "is copy-on-select on": the flag says whether
+        // there is now a selection worth copying when the button comes up. A
+        // single click cleared one, so there is nothing; a double or triple
+        // click just made one.
+        //
+        // A drag makes one too, and says so from SetSelectionAnchor - the
+        // release that would copy it comes long after this call.
+        selectionNeedsToBeCopied = numberOfClicks > 1;
+    }
