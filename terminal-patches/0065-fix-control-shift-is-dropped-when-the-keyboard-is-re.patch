-    void GhosttyControlCore::WriteClipboard(std::string&& plain, std::string&& html) noexcept
-    try
-    {
-        if (plain.empty() && html.empty())
-        {
-            return;
-        }
-
-        auto args = winrt::make<WriteToClipboardEventArgs>(
-            winrt::hstring{ til::u8u16(plain) },
