+    void GhosttyControlCore::_applySettingsToConfig(ghostty_config_t config) const
+    {
+        for (const auto& [key, value] : TranslateGhosttySettings(_settings))
+        {
+            // A rejected entry is worth a log line but not a failed pane: the
+            // rest of the configuration is still worth applying.
+            if (!ghostty_config_set_kv(config, key.data(), key.size(), value.data(), value.size()))
+            {
+                LOG_HR_MSG(E_INVALIDARG, "ghostty rejected config entry");
+                _trace(L"REJECTED %hs = %hs", key.c_str(), value.c_str());
+            }
+            else
+            {
+                _trace(L"set %hs = %hs", key.c_str(), value.c_str());
+            }
+        }
+    }
