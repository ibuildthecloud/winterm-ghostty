+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x09").empty(), L"Tab");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x0d").empty(), L"Enter");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x1b").empty(), L"Escape");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x03").empty(), L"ctrl+c");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"\x7f").empty(), L"Delete");
+        VERIFY_IS_TRUE(GhosttyKeyText(L"").empty(), L"a key that produces nothing");
+
+        // One control character poisons the whole string rather than being
+        // stripped out of it: a mixed result would still short circuit
+        // ghostty's encoding, just less obviously.
+        VERIFY_IS_TRUE(GhosttyKeyText(L"a\x08").empty());
+    }
+
+    // The `?` bug. Text has to be translated under the modifiers the key event
+    // carried, not under whatever the calling thread's keyboard state happens
+    // to say - the two diverge as soon as anyone types at speed, because XAML
+    // raises KeyDown behind its own message pump.
+    //
+    // No key is pressed while this test runs, so the thread's Shift is up. An
+    // implementation that reaches for GetKeyboardState() therefore fails the
+    // very first assertion, which is exactly the bug: `?` arrived as `/`.
+    void GhosttyKeyTests::ShiftComesFromTheEventNotTheThread()
+    {
+        // US layout. Skipping rather than failing elsewhere: the mapping being
+        // asserted is the layout's, not ours.
+        const auto layout = GetKeyboardLayout(0);
+        if (LOWORD(reinterpret_cast<UINT_PTR>(layout)) != 0x0409)
+        {
+            Log::Result(WEX::Logging::TestResults::Skipped, L"not a US layout");
+            return;
+        }
+
+        constexpr uint16_t vkOem2 = VK_OEM_2; // the `/?` key
+        constexpr uint16_t scanOem2 = 0x35;
+
+        VERIFY_ARE_EQUAL("?", GhosttyKeyTextFor(SHIFT_PRESSED, vkOem2, scanOem2));
+        VERIFY_ARE_EQUAL("/", GhosttyKeyTextFor(0, vkOem2, scanOem2));
+
+        // The same asymmetry on a letter, where Caps Lock is a second way in.
+        constexpr uint16_t vkA = 'A';
+        constexpr uint16_t scanA = 0x1E;
+        VERIFY_ARE_EQUAL("a", GhosttyKeyTextFor(0, vkA, scanA));
+        VERIFY_ARE_EQUAL("A", GhosttyKeyTextFor(SHIFT_PRESSED, vkA, scanA));
+        VERIFY_ARE_EQUAL("A", GhosttyKeyTextFor(CAPSLOCK_ON, vkA, scanA));
+        VERIFY_ARE_EQUAL("a", GhosttyKeyTextFor(CAPSLOCK_ON | SHIFT_PRESSED, vkA, scanA));
+
+        // ctrl+c translates to 0x03, which is not text - ghostty owns that
+        // encoding. Proves the ctrl bit reaches ToUnicode at all.
+        VERIFY_IS_TRUE(GhosttyKeyTextFor(LEFT_CTRL_PRESSED, 'C', 0x2E).empty());
+    }
+
+    // The case a remote desktop client produces, and the one the Windows App on
+    // Android produced every time: shift is in the event stream, and in nothing
+    // else. The snapshot passed with each event says no modifier is held -
+    // which is what TermControl really reported, because it asks
+    // CoreWindow::GetKeyState when XAML raises the event, by which time the
+    // client has already released shift.
+    //
+    // Typed from Android into a ghostty pane, `?` arrived as `/` and `A` as
+    // `a`; a cascadia pane in the same window was correct, because its text
+    // comes from the character message rather than from ToUnicode. KD-25.
+    void GhosttyKeyTests::ShiftHeldOnlyInTheEventStreamStillShifts()
+    {
+        const auto layout = GetKeyboardLayout(0);
+        if (LOWORD(reinterpret_cast<UINT_PTR>(layout)) != 0x0409)
+        {
+            Log::Result(WEX::Logging::TestResults::Skipped, L"not a US layout");
+            return;
+        }
+
+        constexpr uint16_t vkOem2 = VK_OEM_2; // the `/?` key
+        constexpr uint16_t scanOem2 = 0x35;
+
+        uint32_t held = 0;
+
+        // Shift down. The snapshot is empty even for shift's own event - the
+        // key is already back up by the time it is taken.
+        const auto onShift = GhosttyModifiersFor(held, 0, VK_LSHIFT, false, true);
+        VERIFY_ARE_EQUAL(static_cast<uint32_t>(SHIFT_PRESSED), onShift & SHIFT_PRESSED);
+
+        // The key it modifies, still with an empty snapshot. This is the
+        // assertion the old code fails: it used the snapshot, so it translated
+        // `/`.
+        const auto onKey = GhosttyModifiersFor(held, 0, vkOem2, false, true);
+        VERIFY_ARE_EQUAL("?", GhosttyKeyTextFor(onKey, vkOem2, scanOem2));
+
+        // And shift up, after which the same key is `/` again.
+        VERIFY_ARE_EQUAL(static_cast<uint32_t>(0), GhosttyModifiersFor(held, 0, VK_LSHIFT, false, false) & SHIFT_PRESSED);
+        VERIFY_ARE_EQUAL("/", GhosttyKeyTextFor(GhosttyModifiersFor(held, 0, vkOem2, false, true), vkOem2, scanOem2));
+    }
+
+    // The other direction, which is what makes tracking safe: a release is
+    // believed, and a modifier held according to the snapshot alone is still
+    // reported. Sides are kept apart because AltGr is left ctrl plus right alt,
+    // and the extended flag is what says which alt arrived when the virtual key
+    // does not.
+    void GhosttyKeyTests::AModifierReleaseStopsApplying()
+    {
+        uint32_t held = 0;
+
+        VERIFY_ARE_EQUAL(static_cast<uint32_t>(LEFT_CTRL_PRESSED),
+                         GhosttyModifiersFor(held, 0, VK_CONTROL, false, true) & (LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED));
+        VERIFY_ARE_EQUAL(static_cast<uint32_t>(RIGHT_ALT_PRESSED),
+                         GhosttyModifiersFor(held, 0, VK_MENU, true, true) & (LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED));
+
+        // AltGr, as the layout sees it.
+        const auto altGr = GhosttyModifiersFor(held, 0, 'Q', false, true);
+        VERIFY_ARE_EQUAL(static_cast<uint32_t>(LEFT_CTRL_PRESSED | RIGHT_ALT_PRESSED),
+                         altGr & (LEFT_CTRL_PRESSED | RIGHT_ALT_PRESSED));
+
+        // Both released, and nothing lingers.
+        GhosttyModifiersFor(held, 0, VK_CONTROL, false, false);
+        GhosttyModifiersFor(held, 0, VK_MENU, true, false);
+        VERIFY_ARE_EQUAL(static_cast<uint32_t>(0), GhosttyModifiersFor(held, 0, 'Q', false, true));
+
+        // A modifier the snapshot reports but that was never seen as an event -
+        // held before this pane had focus - still counts.
+        VERIFY_ARE_EQUAL(static_cast<uint32_t>(SHIFT_PRESSED),
+                         GhosttyModifiersFor(held, SHIFT_PRESSED, 'Q', false, true) & SHIFT_PRESSED);
+    }
+
+    // The pane's process has exited and the connection has printed "You can now
+    // close this terminal with Ctrl+D, or press Enter to restart". Which key
+    // means which, and - as much as it matters - which keys mean neither.
+    //
+    // These are the only keys a closed connection answers itself; everything
+    // else still goes to the surface. KD-24.
+    void GhosttyKeyTests::TheKeysThatAnswerAnExitedProcess()
+    {
+        // The promise, both halves.
+        VERIFY_IS_TRUE(GhosttyExitKey::Restart == GhosttyExitKeyFor(VK_RETURN, 0));
+        VERIFY_IS_TRUE(GhosttyExitKey::Close == GhosttyExitKeyFor('D', LEFT_CTRL_PRESSED));
+        VERIFY_IS_TRUE(GhosttyExitKey::Close == GhosttyExitKeyFor('D', RIGHT_CTRL_PRESSED));
+
+        // Shift rides along with both: ctrl+shift+d is still 0x04, and
+        // shift+enter is still CR, which is what cascadia matches on.
+        VERIFY_IS_TRUE(GhosttyExitKey::Restart == GhosttyExitKeyFor(VK_RETURN, SHIFT_PRESSED));
+        VERIFY_IS_TRUE(GhosttyExitKey::Close == GhosttyExitKeyFor('D', LEFT_CTRL_PRESSED | SHIFT_PRESSED));
+
+        // ctrl+enter is LF, not CR. Cascadia does not restart on it, so neither
+        // do we - it goes to the surface like any other key.
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor(VK_RETURN, LEFT_CTRL_PRESSED));
+
+        // alt+enter is WT's fullscreen binding and alt+d is a readline word
+        // kill. Neither is part of the promise.
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor(VK_RETURN, LEFT_ALT_PRESSED));
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor('D', LEFT_ALT_PRESSED));
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor('D', LEFT_CTRL_PRESSED | LEFT_ALT_PRESSED));
+
+        // A bare `d` types a letter, even here.
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor('D', 0));
+
+        // And the neighbours of both keys, so a widened rule fails here.
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor('C', LEFT_CTRL_PRESSED));
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor(VK_ESCAPE, 0));
+        VERIFY_IS_TRUE(GhosttyExitKey::None == GhosttyExitKeyFor(VK_SPACE, 0));
+    }
+}
