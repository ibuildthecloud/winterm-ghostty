+    IReference<Core::Point> GhosttyControlCore::HoveredCell() const
+    {
+        return (_hoveredUri.empty() || !_hoveredCell) ? nullptr :
+                                                        IReference<Core::Point>{ _hoveredCell->to_core_point() };
+    }
