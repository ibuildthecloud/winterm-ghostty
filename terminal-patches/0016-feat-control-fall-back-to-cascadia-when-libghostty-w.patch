diff --git a/src/cascadia/TerminalControl/ControlInteractivity.cpp b/src/cascadia/TerminalControl/ControlInteractivity.cpp
index 2b18f8f64..ad1665754 100644
--- a/src/cascadia/TerminalControl/ControlInteractivity.cpp
+++ b/src/cascadia/TerminalControl/ControlInteractivity.cpp
@@ -54,15 +54,25 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         // already fallen back to the default and raised
         // SettingsLoadWarnings::UnknownEngine.
         //
-        // A ghostty core that cannot bring libghostty up does not throw here -
-        // it fails from Initialize(), which is the path TermControl already
-        // handles, and the pane falls back to cascadia rather than the window
-        // failing to open.
+        // The engine is asked for before the core is committed to it. If
+        // libghostty cannot be brought up at all - no DLL, a failed
+        // ghostty_init - a ghostty core could only fail from Initialize(), and
+        // by then TermControl has bound its events to it: that path reports
+        // the error but leaves a dead pane behind. Choosing here, before
+        // anything binds, is what makes ADR 0007's fallback real. A surface
+        // that fails later still goes the Initialize()/RendererEnteredErrorState
+        // route, because by then there is a pane to report it on.
         switch (settings.Engine())
         {
         case Control::TerminalEngine::Ghostty:
-            _core = winrt::make<GhosttyControlCore>(settings, unfocusedAppearance, connection);
-            break;
+            if (GhosttyEngine::TryGet())
+            {
+                _core = winrt::make<GhosttyControlCore>(settings, unfocusedAppearance, connection);
+                break;
+            }
+            // The engine logs why once. This says what was done about it.
+            LOG_HR_MSG(E_FAIL, "libghostty is unavailable; this pane falls back to the cascadia engine");
+            [[fallthrough]];
 
         case Control::TerminalEngine::Cascadia:
         default:
