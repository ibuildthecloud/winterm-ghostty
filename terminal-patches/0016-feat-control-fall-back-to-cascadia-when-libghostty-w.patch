     <ClCompile Include="..\TerminalControl\GhosttySettingsTranslator.cpp" />
diff --git a/src/cascadia/UnitTests_Control/GhosttyEngineSelectionTests.cpp b/src/cascadia/UnitTests_Control/GhosttyEngineSelectionTests.cpp
new file mode 100644
index 000000000..a873cc2b2
--- /dev/null
+++ b/src/cascadia/UnitTests_Control/GhosttyEngineSelectionTests.cpp
@@ -0,0 +1,136 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// The engine factory (ADR 0007): which core a profile's "engine" gets, and
+// what happens when the engine it asks for cannot be brought up.
+//
+// The fallback is the point. A profile asking for ghostty on a machine where
+// libghostty will not start must still open a working pane on the cascadia
+// engine - not a pane that reports an error and then sits there dead, which
+// is what deciding this any later than construction would give. By the time
+// Initialize() can report a failure, TermControl has bound its events to the
+// core it was handed, and there is no swapping it out underneath.
+
+#include "pch.h"
+#include "../TerminalControl/ControlInteractivity.h"
+#include "../TerminalControl/ControlCore.h"
+#include "../TerminalControl/GhosttyEngine.h"
+#include "MockControlSettings.h"
+#include "MockConnection.h"
+
+using namespace WEX::Logging;
+using namespace WEX::TestExecution;
+using namespace WEX::Common;
+
+using namespace winrt;
+using namespace winrt::Microsoft::Terminal;
+
+namespace ControlUnitTests
+{
+    class GhosttyEngineSelectionTests
+    {
+        BEGIN_TEST_CLASS(GhosttyEngineSelectionTests)
+            TEST_CLASS_PROPERTY(L"TestTimeout", L"0:1:00")
+        END_TEST_CLASS()
+
+        TEST_METHOD(DefaultEngineIsCascadia);
+        TEST_METHOD(CascadiaEngineGetsACascadiaCore);
+        TEST_METHOD(GhosttyEngineAlwaysGetsAUsableCore);
+        TEST_METHOD(GhosttyFallsBackToCascadiaWhenTheEngineIsUnavailable);
+
+    private:
+        // Puts the engine back however the test left it, including on failure.
+        struct EngineUnavailable
+        {
+            EngineUnavailable() noexcept
+            {
+                Control::implementation::GhosttyEngine::_unavailableForTests = true;
+            }
+            ~EngineUnavailable()
+            {
+                Control::implementation::GhosttyEngine::_unavailableForTests = false;
+            }
+        };
+
+        static winrt::com_ptr<Control::implementation::ControlInteractivity>
+        _interactivity(Control::TerminalEngine engine)
+        {
+            auto settings = winrt::make_self<MockControlSettings>();
+            settings->Engine(engine);
+            auto conn = winrt::make_self<MockConnection>();
+
+            auto interactivity = winrt::make_self<Control::implementation::ControlInteractivity>(
+                *settings, *settings, *conn);
+            VERIFY_IS_NOT_NULL(interactivity);
+
+            // Same as the rest of this suite: cascadia's core starts a real
+            // renderer otherwise, and tearing one down in a test host hangs.
+            if (const auto cascadia = interactivity->_cascadiaCore())
+            {
+                cascadia->_inUnitTests = true;
+            }
+            return interactivity;
+        }
+    };
+
+    // Cascadia is the default in ControlProperties.h, and it staying the
+    // default is what keeps a second engine opt-in.
+    void GhosttyEngineSelectionTests::DefaultEngineIsCascadia()
+    {
+        auto settings = winrt::make_self<MockControlSettings>();
+        VERIFY_ARE_EQUAL(Control::TerminalEngine::Cascadia, settings->Engine());
+    }
+
+    void GhosttyEngineSelectionTests::CascadiaEngineGetsACascadiaCore()
+    {
+        const auto interactivity = _interactivity(Control::TerminalEngine::Cascadia);
+        VERIFY_IS_NOT_NULL(interactivity->_cascadiaCore(),
+                           L"a cascadia profile must get cascadia's own core");
+    }
+
+    // Whichever way the engine goes, the pane gets a core it can use. If
+    // libghostty came up this is the ghostty core; if it did not, the factory
+    // fell back and this is cascadia's. Both are passes - what would fail is
+    // a null core, or one that throws the moment it is asked anything, which
+    // is what a ghostty core built against a dead engine would be.
+    void GhosttyEngineSelectionTests::GhosttyEngineAlwaysGetsAUsableCore()
+    {
+        const auto interactivity = _interactivity(Control::TerminalEngine::Ghostty);
+
+        const auto core = interactivity->Core();
+        VERIFY_IS_NOT_NULL(core, L"a ghostty profile must never end up with no core at all");
+
+        if (interactivity->_cascadiaCore())
+        {
+            Log::Comment(L"libghostty is unavailable here; the factory fell back to cascadia.");
+        }
+        else
+        {
+            Log::Comment(L"libghostty came up; this pane is on the ghostty engine.");
+        }
+
+        // Asked the things a pane is asked before it is initialized. The
+        // engine-specific answers differ; that any answer comes back at all
+        // is the invariant.
+        VERIFY_IS_NOT_NULL(core.Connection(), L"the connection must survive the choice of engine");
+        VERIFY_ARE_NOT_EQUAL(TerminalConnection::ConnectionState::Failed, core.ConnectionState());
+        VERIFY_IS_FALSE(core.IsInReadOnlyMode());
+    }
+
+    // The deliverable itself (PLAN Phase 5, ADR 0007): on a machine where
+    // libghostty will not start, a ghostty profile opens on cascadia instead
+    // of opening dead. Deciding this at construction is the whole point - by
+    // the time Initialize() could report the failure, TermControl has bound
+    // its events to the core and the pane cannot be re-engined.
+    void GhosttyEngineSelectionTests::GhosttyFallsBackToCascadiaWhenTheEngineIsUnavailable()
+    {
+        const EngineUnavailable noEngine;
+
+        const auto interactivity = _interactivity(Control::TerminalEngine::Ghostty);
+
+        VERIFY_IS_NOT_NULL(interactivity->_cascadiaCore(),
+                           L"with no engine, a ghostty profile must fall back to cascadia's core");
+        VERIFY_IS_NOT_NULL(interactivity->Core().Connection(),
+                           L"and it must keep the connection it was created with");
+    }
+}
