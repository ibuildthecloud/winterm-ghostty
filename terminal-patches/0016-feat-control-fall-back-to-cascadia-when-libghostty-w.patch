diff --git a/src/cascadia/TerminalControl/GhosttyControlCore.cpp b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
index 8cf240a5f..b97123998 100644
--- a/src/cascadia/TerminalControl/GhosttyControlCore.cpp
+++ b/src/cascadia/TerminalControl/GhosttyControlCore.cpp
@@ -43,8 +43,14 @@ namespace winrt::Microsoft::Terminal::Control::implementation
 
     // The engine is resolved here rather than in the constructor so a failure
     // has somewhere to be reported: Initialize returning false is the signal
-    // TermControl already understands, and ControlInteractivity turns it into
-    // the cascadia fallback.
+    // TermControl already understands.
+    //
+    // Reaching this with no engine is the unlikely case - ControlInteractivity
+    // only builds a ghostty core once TryGet has succeeded, so the engine
+    // would have to have gone away in between. The common failure here is a
+    // surface that cannot be created, which is per-pane and has no fallback:
+    // the pane reports the error state rather than silently changing engine
+    // under a session that may already have output in it.
     bool GhosttyControlCore::Initialize(const float actualWidth,
                                         const float actualHeight,
                                         const float compositionScale)
diff --git a/src/cascadia/TerminalControl/GhosttyEngine.cpp b/src/cascadia/TerminalControl/GhosttyEngine.cpp
index 2d10dc1c2..aecfbf7da 100644
--- a/src/cascadia/TerminalControl/GhosttyEngine.cpp
+++ b/src/cascadia/TerminalControl/GhosttyEngine.cpp
@@ -7,8 +7,19 @@
 
 namespace winrt::Microsoft::Terminal::Control::implementation
 {
+    bool GhosttyEngine::_unavailableForTests = false;
+
     GhosttyEngine* GhosttyEngine::TryGet() noexcept
     {
+        // The fallback to cascadia only runs on a machine where libghostty
+        // will not start, which is not a state a test can reach by asking. It
+        // is checked before the cached engine so a test can force it either
+        // way regardless of what ran first.
+        if (_unavailableForTests)
+        {
+            return nullptr;
+        }
+
         // Deliberately leaked: libghostty's app owns threads that outlive any
         // sensible teardown point in a process that is exiting anyway, and
         // running its destructor during static destruction would race them.
diff --git a/src/cascadia/TerminalControl/GhosttyEngine.h b/src/cascadia/TerminalControl/GhosttyEngine.h
index 11c4db7cb..c27da6888 100644
--- a/src/cascadia/TerminalControl/GhosttyEngine.h
+++ b/src/cascadia/TerminalControl/GhosttyEngine.h
@@ -17,6 +17,11 @@
 
 #include <ghostty.h>
 
+namespace ControlUnitTests
+{
+    class GhosttyEngineSelectionTests;
+};
+
 namespace winrt::Microsoft::Terminal::Control::implementation
 {
     struct GhosttyControlCore;
@@ -53,6 +58,12 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         GhosttyEngine() = default;
         bool _initialize() noexcept;
 
+        // Makes TryGet answer as it would on a machine without a working
+        // libghostty. The cascadia fallback is otherwise unreachable from a
+        // test, and an untested fallback is a fallback nobody has seen work.
+        // Same shape as ControlCore::_inUnitTests.
+        static bool _unavailableForTests;
+
         // libghostty wakes us from its own threads; ghostty_app_tick has to run
         // on one consistent thread, so it gets a dedicated one rather than
         // borrowing the UI thread (which would tie engine liveness to XAML
@@ -91,5 +102,7 @@ namespace winrt::Microsoft::Terminal::Control::implementation
         static void _closeSurface(void* userdata, bool processAlive) noexcept;
         static void _writePty(void* userdata, const uint8_t* data, size_t len) noexcept;
         static void _resizePty(void* userdata, uint16_t columns, uint16_t rows) noexcept;
+
+        friend class ControlUnitTests::GhosttyEngineSelectionTests;
     };
 }
