@@ -0,0 +1,233 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+
+#include "pch.h"
+#include "GhosttyEngine.h"
+#include "GhosttyControlCore.h"
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    GhosttyEngine* GhosttyEngine::TryGet() noexcept
+    {
+        // Deliberately leaked: libghostty's app owns threads that outlive any
+        // sensible teardown point in a process that is exiting anyway, and
+        // running its destructor during static destruction would race them.
+        static GhosttyEngine* engine = []() -> GhosttyEngine* {
+            // Private ctor, so no make_unique.
+            std::unique_ptr<GhosttyEngine> candidate{ new GhosttyEngine{} };
+            if (!candidate->_initialize())
+            {
+                return nullptr;
+            }
+            return candidate.release();
+        }();
+
+        return engine;
+    }
+
+    // Starts the engine thread and waits for it to report whether libghostty
+    // came up. The bootstrap runs *there*, not here, because it needs far more
+    // stack than the calling (UI) thread has - see EngineThreadStackReserve.
+    bool GhosttyEngine::_initialize() noexcept
+    try
+    {
+        _wakeupEvent.create(wil::EventOptions::ManualReset);
+        _readyEvent.create(wil::EventOptions::ManualReset);
+
+        _tickThread.reset(CreateThread(
+            nullptr,
+            EngineThreadStackReserve,
+            [](LPVOID param) -> DWORD {
+                static_cast<GhosttyEngine*>(param)->_threadMain();
+                return 0;
+            },
+            this,
+            STACK_SIZE_PARAM_IS_A_RESERVATION,
+            nullptr));
+        RETURN_LAST_ERROR_IF_NULL_MSG(_tickThread.get(), "ghostty engine thread");
+
+        _readyEvent.wait();
+        return _bootstrapped;
+    }
+    CATCH_RETURN_FALSE()
+
+    void GhosttyEngine::_threadMain() noexcept
+    {
+        _bootstrapped = _bootstrap();
+        _readyEvent.SetEvent();
+
+        if (_bootstrapped)
+        {
+            _tickLoop();
+        }
+    }
+
+    bool GhosttyEngine::_bootstrap() noexcept
+    try
+    {
+        // ghostty_init_w takes the WTF-16 command line rather than argv - see
+        // the init-wtf16 patch. It parses ghostty's own CLI flags out of it,
+        // which for us is a no-op: WT's command line means nothing to ghostty
+        // and any unrecognised argument is ignored rather than fatal.
+        const auto commandLine = GetCommandLineW();
+        if (ghostty_init_w(wcslen(commandLine), reinterpret_cast<const uint16_t*>(commandLine)) != 0)
+        {
+            LOG_HR_MSG(E_FAIL, "ghostty_init_w failed");
+            return false;
+        }
+
+        ghostty_runtime_config_s runtime{};
+        runtime.userdata = this;
+        runtime.supports_selection_clipboard = false;
+        runtime.wakeup_cb = &GhosttyEngine::_wakeup;
+        runtime.action_cb = &GhosttyEngine::_action;
+        runtime.read_clipboard_cb = &GhosttyEngine::_readClipboard;
+        runtime.confirm_read_clipboard_cb = &GhosttyEngine::_confirmReadClipboard;
+        runtime.write_clipboard_cb = &GhosttyEngine::_writeClipboard;
+        runtime.close_surface_cb = &GhosttyEngine::_closeSurface;
+        runtime.write_pty_cb = &GhosttyEngine::_writePty;
+        runtime.resize_pty_cb = &GhosttyEngine::_resizePty;
+
+        const auto config = NewConfig();
+        if (!config)
+        {
+            return false;
+        }
+        // The app takes its own copy, so ours goes back immediately.
+        const auto freeConfig = wil::scope_exit([&]() { ghostty_config_free(config); });
+
+        _app = ghostty_app_new(&runtime, config);
+        if (!_app)
+        {
+            LOG_HR_MSG(E_FAIL, "ghostty_app_new failed");
+            return false;
+        }
+
+        return true;
+    }
+    CATCH_RETURN_FALSE()
+
+    GhosttyEngine::~GhosttyEngine()
+    {
+        _stopping.store(true, std::memory_order_release);
+        if (_wakeupEvent)
+        {
+            _wakeupEvent.SetEvent();
+        }
+        if (_tickThread)
+        {
+            WaitForSingleObject(_tickThread.get(), 2000);
+        }
+        if (_app)
+        {
+            ghostty_app_free(_app);
+        }
+    }
+
+    ghostty_config_t GhosttyEngine::NewConfig() const noexcept
+    {
+        const auto config = ghostty_config_new();
+        if (!config)
+        {
+            LOG_HR_MSG(E_FAIL, "ghostty_config_new failed");
+            return nullptr;
+        }
+
+        // Deliberately NOT ghostty_config_load_default_files: a pane's
+        // configuration comes from the WT profile, and silently mixing in
+        // ~/.config/ghostty would make two settings systems fight over the
+        // same pane. The translator in GhosttyControlCore is the only source.
+        ghostty_config_finalize(config);
+        return config;
+    }
+
+    void GhosttyEngine::_tickLoop() noexcept
+    {
+        while (!_stopping.load(std::memory_order_acquire))
+        {
+            WaitForSingleObject(_wakeupEvent.get(), INFINITE);
+            _wakeupEvent.ResetEvent();
+            if (_stopping.load(std::memory_order_acquire))
+            {
+                break;
+            }
+            ghostty_app_tick(_app);
+        }
+    }
+
+    void GhosttyEngine::_wakeup(void* userdata) noexcept
+    {
+        // Called from libghostty's own threads. Signalling an event is all we
+        // may safely do here; the tick happens on our thread.
+        if (const auto self = static_cast<GhosttyEngine*>(userdata))
+        {
+            self->_wakeupEvent.SetEvent();
+        }
+    }
+
+    GhosttyControlCore* GhosttyEngine::_coreFor(ghostty_target_s target) noexcept
+    {
+        if (target.tag != GHOSTTY_TARGET_SURFACE || !target.target.surface)
+        {
+            return nullptr;
+        }
+        return static_cast<GhosttyControlCore*>(ghostty_surface_userdata(target.target.surface));
+    }
+
+    bool GhosttyEngine::_action(ghostty_app_t /*app*/, ghostty_target_s target, ghostty_action_s action) noexcept
+    {
+        const auto core = _coreFor(target);
+        if (!core)
+        {
+            // App-targeted actions (quit, new window, global keybinds) belong to
+            // WT's own command layer, not to us. Reporting them unhandled is
+            // how libghostty learns the embedder did not act.
+            return false;
+        }
+
+        return core->HandleAction(action);
+    }
+
+    bool GhosttyEngine::_readClipboard(void* /*userdata*/, ghostty_clipboard_e /*loc*/, void* /*state*/) noexcept
+    {
+        // Paste is driven from WT's side (ControlInteractivity raises
+        // PasteFromClipboard and calls PasteText), so libghostty never needs to
+        // pull. Returning false means "no clipboard content available".
+        return false;
+    }
+
+    void GhosttyEngine::_confirmReadClipboard(void* /*userdata*/, const char* /*str*/, void* /*state*/, ghostty_clipboard_request_e /*req*/) noexcept
+    {
+    }
+
+    void GhosttyEngine::_writeClipboard(void* userdata, ghostty_clipboard_e /*loc*/, const ghostty_clipboard_content_s* /*content*/, size_t /*len*/, bool /*confirm*/) noexcept
+    {
+        // OSC 52. Phase 6 wires this to WriteToClipboard; until then a clipboard
+        // write from inside the terminal is dropped rather than half-applied.
+        UNREFERENCED_PARAMETER(userdata);
+    }
+
+    void GhosttyEngine::_closeSurface(void* userdata, bool /*processAlive*/) noexcept
+    {
+        if (const auto core = static_cast<GhosttyControlCore*>(userdata))
+        {
+            core->RequestClose();
+        }
+    }
+
+    void GhosttyEngine::_writePty(void* userdata, const uint8_t* data, size_t len) noexcept
+    {
+        if (const auto core = static_cast<GhosttyControlCore*>(userdata))
+        {
+            core->WriteToConnection({ reinterpret_cast<const char*>(data), len });
+        }
+    }
+
+    void GhosttyEngine::_resizePty(void* userdata, uint16_t columns, uint16_t rows) noexcept
+    {
+        if (const auto core = static_cast<GhosttyControlCore*>(userdata))
+        {
+            core->ResizeConnection(columns, rows);
+        }
+    }
+}
diff --git a/src/cascadia/TerminalControl/GhosttyEngine.h b/src/cascadia/TerminalControl/GhosttyEngine.h
new file mode 100644
index 000000000..1feb978a3
--- /dev/null
+++ b/src/cascadia/TerminalControl/GhosttyEngine.h
@@ -0,0 +1,83 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT license.
+//
+// Module Name:
+// - GhosttyEngine.h
+//
+// Abstract:
+// - Process-wide libghostty bootstrap: one ghostty_init, one ghostty_app_t, and
+//   the runtime callbacks that route libghostty's actions back to whichever
+//   GhosttyControlCore owns the surface that raised them.
+//
+//   There is exactly one of these per process because ghostty_init sets up
+//   global state (logging, allocators, the config search path) and an app owns
+//   the mailbox that surfaces post to. Surfaces are per-pane; the app is not.
+
+#pragma once
+
+#include <ghostty.h>
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    struct GhosttyControlCore;
+
+    class GhosttyEngine
+    {
+    public:
+        // Returns null if libghostty could not be brought up, rather than
+        // throwing: a missing or broken engine DLL must degrade to the cascadia
+        // engine, not take the window down. The reason is logged once.
+        static GhosttyEngine* TryGet() noexcept;
+
+        ghostty_app_t App() const noexcept { return _app; }
+
+        // A fresh config, pre-loaded with our defaults. The caller owns it and
+        // must ghostty_config_free it.
+        ghostty_config_t NewConfig() const noexcept;
+
+        ~GhosttyEngine();
+
+    private:
+        GhosttyEngine() = default;
+        bool _initialize() noexcept;
+
+        // libghostty wakes us from its own threads; ghostty_app_tick has to run
+        // on one consistent thread, so it gets a dedicated one rather than
+        // borrowing the UI thread (which would tie engine liveness to XAML
+        // being pumped, and stall ticks behind layout).
+        //
+        // That thread is also where the engine is *brought up*, and it is
+        // reserved 16 MB of stack to do it. ghostty_init overflows the 1 MB
+        // MSVC gives a main thread - measured, twice: the Phase 0 harness hit
+        // the same STATUS_STACK_OVERFLOW and links itself with /STACK:16MB.
+        // Zig-built code is written against Zig's 16 MiB default, so this is
+        // the outlier being accommodated, not a leak. Doing it here rather than
+        // raising WindowsTerminal.exe's own reserve keeps the requirement where
+        // it belongs - in the engine that has it.
+        static constexpr SIZE_T EngineThreadStackReserve = 16 * 1024 * 1024;
+
+        void _threadMain() noexcept;
+        bool _bootstrap() noexcept;
+        void _tickLoop() noexcept;
+
+        ghostty_app_t _app{ nullptr };
+        wil::unique_event _wakeupEvent;
+        wil::unique_event _readyEvent;
+        wil::unique_handle _tickThread;
+        std::atomic<bool> _stopping{ false };
+        bool _bootstrapped{ false };
+
+        // Resolves the surface that raised an action back to its core. Returns
+        // null for app-targeted actions and for surfaces we no longer own.
+        static GhosttyControlCore* _coreFor(ghostty_target_s target) noexcept;
+
+        static void _wakeup(void* userdata) noexcept;
+        static bool _action(ghostty_app_t app, ghostty_target_s target, ghostty_action_s action) noexcept;
+        static bool _readClipboard(void* userdata, ghostty_clipboard_e loc, void* state) noexcept;
+        static void _confirmReadClipboard(void* userdata, const char* str, void* state, ghostty_clipboard_request_e req) noexcept;
+        static void _writeClipboard(void* userdata, ghostty_clipboard_e loc, const ghostty_clipboard_content_s* content, size_t len, bool confirm) noexcept;
+        static void _closeSurface(void* userdata, bool processAlive) noexcept;
+        static void _writePty(void* userdata, const uint8_t* data, size_t len) noexcept;
+        static void _resizePty(void* userdata, uint16_t columns, uint16_t rows) noexcept;
+    };
+}
