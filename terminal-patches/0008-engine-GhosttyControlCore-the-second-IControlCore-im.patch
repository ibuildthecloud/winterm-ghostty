+
+namespace Microsoft.Terminal.Control
+{
+    // The ghostty engine: implementation #2 of IControlCore (ADR 0001).
+    //
+    // Everything the shell needs is on IControlCore, so this class body holds
+    // only the constructor - the same shape as ControlCore, and for the same
+    // MIDL reason (a runtimeclass that is constructed needs a default
+    // interface, which [default_interface] supplies).
+    //
+    // The engine is chosen per profile and bound at pane creation by the
+    // factory in ControlInteractivity (ADR 0007); nothing above that layer
+    // knows which implementation it is talking to.
+    [default_interface] runtimeclass GhosttyControlCore : IControlCore, ICoreState
+    {
+        GhosttyControlCore(IControlSettings settings,
+                           IControlAppearance unfocusedAppearance,
+                           Microsoft.Terminal.TerminalConnection.ITerminalConnection connection);
+    };
+}
diff --git a/src/cascadia/TerminalControl/GhosttyEngine.cpp b/src/cascadia/TerminalControl/GhosttyEngine.cpp
