diff --git a/src/cascadia/TerminalControl/libghostty.props b/src/cascadia/TerminalControl/libghostty.props
new file mode 100644
index 000000000..e6d2c32c1
--- /dev/null
+++ b/src/cascadia/TerminalControl/libghostty.props
@@ -0,0 +1,47 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  libghostty, the ghostty engine (ADR 0003).
+
+  The DLL and its header come from the sibling ghostty/ clone, built by
+  scripts/build-ghostty.ps1 - which also synthesizes ghostty.lib, since zig
+  emits no import library of its own for ghostty-internal.dll.
+
+  Override GhosttyOutDir to build against a libghostty from somewhere else.
+-->
+<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
+  <PropertyGroup>
+    <GhosttyOutDir Condition="'$(GhosttyOutDir)'==''">$(OpenConsoleDir)..\ghostty\zig-out\</GhosttyOutDir>
+    <GhosttyIncludeDir>$(GhosttyOutDir)include\</GhosttyIncludeDir>
+    <GhosttyLibDir>$(GhosttyOutDir)lib\</GhosttyLibDir>
+  </PropertyGroup>
+
+  <ItemDefinitionGroup>
+    <ClCompile>
+      <AdditionalIncludeDirectories>$(GhosttyIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
+    </ClCompile>
+    <Link>
+      <AdditionalLibraryDirectories>$(GhosttyLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
+      <AdditionalDependencies>ghostty.lib;%(AdditionalDependencies)</AdditionalDependencies>
+    </Link>
+  </ItemDefinitionGroup>
+
+  <!--
+    The DLL has to sit next to the executable at load time. It is content
+    rather than a project reference, so this copies it into the output and
+    into the package payload.
+  -->
+  <ItemGroup>
+    <None Include="$(GhosttyLibDir)ghostty-internal.dll" Condition="Exists('$(GhosttyLibDir)ghostty-internal.dll')">
+      <DeploymentContent>true</DeploymentContent>
+      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
+      <Link>ghostty-internal.dll</Link>
+    </None>
+  </ItemGroup>
+
+  <Target Name="GhosttyCheck" BeforeTargets="ClCompile">
+    <Error Condition="!Exists('$(GhosttyIncludeDir)ghostty.h')"
+           Text="libghostty not found at $(GhosttyOutDir). Run scripts\build-ghostty.ps1 first, or set GhosttyOutDir." />
+    <Error Condition="!Exists('$(GhosttyLibDir)ghostty.lib')"
+           Text="ghostty.lib not found at $(GhosttyLibDir). Run scripts\build-ghostty.ps1 - it synthesizes the import library." />
+  </Target>
+</Project>
