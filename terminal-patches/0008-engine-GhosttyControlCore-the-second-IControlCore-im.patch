+        winrt::hstring _title;
+        winrt::hstring _workingDirectory;
+        std::optional<til::color> _tabColor;
+        uint64_t _owningHwnd{ 0 };
+        size_t _taskbarState{ 0 };
+        size_t _taskbarProgress{ 0 };
+        bool _initializedTerminal{ false };
+        bool _closing{ false };
+        bool _readOnly{ false };
+        bool _focused{ false };
+
+        // Cell metrics as libghostty last reported them, in pixels. The
+        // CELL_SIZE action is the only authority for these: our own arithmetic
+        // and its must not diverge, or a resize tells the child a size the
+        // terminal is not using.
+        winrt::Windows::Foundation::Size _cellSize{ 0, 0 };
+        float _compositionScale{ 1.0f };
