+        til::typed_event<IInspectable, Control::NoticeEventArgs> RaiseNotice;
+        til::typed_event<IInspectable, Control::TransparencyChangedEventArgs> TransparencyChanged;
+        til::typed_event<> OutputIdle;
+        til::typed_event<IInspectable, Control::ShowWindowArgs> ShowWindowChanged;
+        til::typed_event<IInspectable, Control::UpdateSelectionMarkersEventArgs> UpdateSelectionMarkers;
+        til::typed_event<IInspectable, Control::OpenHyperlinkEventArgs> OpenHyperlink;
+        til::typed_event<IInspectable, Control::CompletionsChangedEventArgs> CompletionsChanged;
+        til::typed_event<IInspectable, Control::SearchMissingCommandEventArgs> SearchMissingCommand;
+        til::typed_event<IInspectable, Control::ShowNotificationEventArgs> ShowNotification;
+        til::typed_event<> RefreshQuickFixUI;
+        til::typed_event<IInspectable, Control::WindowSizeChangedEventArgs> WindowSizeChanged;
+        til::typed_event<> CloseTerminalRequested;
+        til::typed_event<> RestartTerminalRequested;
+        til::typed_event<> Attached;
+        // clang-format on
+
+    private:
+        void _createSurface(const float width, const float height, const float scale);
+        void _destroySurface() noexcept;
+        void _applySettingsToConfig(ghostty_config_t config) const;
+        void _connectionOutputHandler(const winrt::array_view<const char16_t>& data);
+        void _connectionStateChangedHandler();
+        void _raiseOnUiThread(std::function<void()> action);
+
+        Control::IControlSettings _settings{ nullptr };
+        Control::IControlAppearance _unfocusedAppearance{ nullptr };
+        TerminalConnection::ITerminalConnection _connection{ nullptr };
+        TerminalConnection::ITerminalConnection::TerminalOutput_revoker _connectionOutputRevoker;
+        TerminalConnection::ITerminalConnection::StateChanged_revoker _connectionStateRevoker;
+
+        GhosttyEngine* _engine{ nullptr };
+        ghostty_surface_t _surface{ nullptr };
+
+        // The UTF-16 -> UTF-8 boundary. ITerminalConnection deals in UTF-16 and
+        // ghostty parses bytes, and a surrogate pair may be split across two
+        // TerminalOutput events - so this holds the partial across calls. WT
+        // already ships the state machine; we just keep one per pane.
+        // (With ConptyConnection a split pair should never arrive, because its
+        // own til::u8state only ever emits whole codepoints. AzureConnection
+        // makes no such promise, and this costs nothing.)
+        ::til::u16state _u16State;
+        std::string _utf8Scratch;
