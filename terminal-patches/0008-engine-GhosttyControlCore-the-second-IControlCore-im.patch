+#include "pch.h"
+#include "GhosttyControlCore.h"
+
+#include "GhosttyControlCore.g.cpp"
+
+using namespace ::Microsoft::Terminal::Core;
+using namespace winrt::Windows::Foundation;
+using namespace winrt::Microsoft::Terminal::TerminalConnection;
+
+namespace winrt::Microsoft::Terminal::Control::implementation
+{
+    GhosttyControlCore::GhosttyControlCore(Control::IControlSettings settings,
+                                           Control::IControlAppearance unfocusedAppearance,
+                                           TerminalConnection::ITerminalConnection connection) :
+        _settings{ settings },
+        _unfocusedAppearance{ unfocusedAppearance }
+    {
+        // Captured on the thread that creates the pane, which is the UI thread.
+        // Actions arrive on libghostty's threads and the WinRT events they turn
+        // into are ones TermControl expects on the UI thread, so this is how
+        // they get back (the marshalling rows of the Phase 5 threading table).
+        _dispatcher = winrt::Windows::System::DispatcherQueue::GetForCurrentThread();
+
+        // Seed the title the way cascadia does: the profile's starting title
+        // stands until the child sets one with OSC 0/2. Without this a ghostty
+        // tab is nameless for as long as the shell stays quiet.
+        if (_settings)
+        {
+            _title = _settings.StartingTitle();
+        }
+
+        Connection(connection);
+    }
+
+    GhosttyControlCore::~GhosttyControlCore()
+    {
+        Close();
+    }
+
+    // The engine is resolved here rather than in the constructor so a failure
+    // has somewhere to be reported: Initialize returning false is the signal
+    // TermControl already understands, and ControlInteractivity turns it into
+    // the cascadia fallback.
+    bool GhosttyControlCore::Initialize(const float actualWidth,
+                                        const float actualHeight,
+                                        const float compositionScale)
+    try
+    {
+        if (_initializedTerminal)
+        {
+            return true;
+        }
+
+        _engine = GhosttyEngine::TryGet();
+        if (!_engine)
+        {
+            RendererEnteredErrorState.raise(*this, nullptr);
+            return false;
+        }
+
+        _createSurface(actualWidth, actualHeight, compositionScale);
+        if (!_surface)
+        {
+            RendererEnteredErrorState.raise(*this, nullptr);
+            return false;
+        }
+
+        _initializedTerminal = true;
+        return true;
+    }
+    catch (...)
+    {
+        LOG_CAUGHT_EXCEPTION();
+        RendererEnteredErrorState.raise(*this, nullptr);
+        return false;
+    }
+
+    void GhosttyControlCore::_createSurface(const float width, const float height, const float scale)
+    {
+        _compositionScale = scale;
+
+        auto config = _engine->NewConfig();
+        THROW_HR_IF_NULL(E_FAIL, config);
+        const auto freeConfig = wil::scope_exit([&]() { ghostty_config_free(config); });
+        _applySettingsToConfig(config);
+
+        auto surfaceConfig = ghostty_surface_config_new();
+        surfaceConfig.platform_tag = GHOSTTY_PLATFORM_WINDOWS;
+
+        // Composition mode: libghostty presents into a DirectComposition
+        // surface handle that we hand to the SwapChainPanel, which is the same
+        // binding cascadia's renderer uses. No HWND is involved - the pane is
+        // XAML, not a child window.
+        surfaceConfig.platform.windows.hwnd = nullptr;
+        surfaceConfig.platform.windows.composition = true;
+        surfaceConfig.platform.windows.shared_texture.enabled = false;
+
+        // WT owns the pty (ADR 0006). libghostty spawns nothing; bytes come in
+        // through write_pty_output and go out through the engine's callbacks.
+        surfaceConfig.io_backend = GHOSTTY_IO_BACKEND_EXTERNAL;
+
+        surfaceConfig.scale_factor = scale;
+        surfaceConfig.userdata = this;
+
+        _surface = ghostty_surface_new(_engine->App(), &surfaceConfig);
+        THROW_HR_IF_NULL_MSG(E_FAIL, _surface, "ghostty_surface_new failed");
+
+        ghostty_surface_set_content_scale(_surface, scale, scale);
+        SizeChanged(width, height);
+    }
+
+    void GhosttyControlCore::_destroySurface() noexcept
+    {
+        if (_surface)
+        {
+            ghostty_surface_free(_surface);
+            _surface = nullptr;
+        }
+    }
+
+    // Settings -> ghostty_config_t. The MVP scope is deliberately five fields
+    // (font, size, scheme, scrollback, padding): the ones without which a pane
+    // is visibly wrong rather than merely unstyled. Everything else - opacity,
+    // acrylic, background image, cursor and selection colours, bell style - is
+    // Phase 6 parity work and is left at ghostty's defaults on purpose, so a
+    // half-applied setting never looks like a translator bug.
+    void GhosttyControlCore::_applySettingsToConfig(ghostty_config_t /*config*/) const
+    {
+        // TODO(phase-5): ghostty_config_set_* has no C entry point yet - the
+        // config is populated from strings/CLI today. Wiring the five fields
+        // needs a small additive C API on the ghostty side, which is a patch of
+        // its own rather than something to fake here. Until then a ghostty pane
+        // renders with ghostty's defaults, which is visibly a working terminal.
+    }
+
+    void GhosttyControlCore::EnablePainting()
+    {
+        // libghostty's renderer thread starts with the surface; there is no
+        // separate "begin painting" gate to open.
+    }
+
+    void GhosttyControlCore::Detach()
+    {
+        _connectionOutputRevoker.revoke();
+        _connectionStateRevoker.revoke();
+    }
+
+    void GhosttyControlCore::AttachToNewControl()
+    {
+        Attached.raise(*this, nullptr);
+    }
+
+    void GhosttyControlCore::Close()
+    {
+        if (_closing)
+        {
+            return;
+        }
+        _closing = true;
+
+        _connectionOutputRevoker.revoke();
+        _connectionStateRevoker.revoke();
+
+        if (_connection)
+        {
+            _connection.Close();
+        }
+
+        // Free the surface before dropping the connection reference: the
+        // surface's threads can still be calling back into us until it is gone.
+        _destroySurface();
+    }
+
+    void GhosttyControlCore::RequestClose() noexcept
+    {
+        _raiseOnUiThread([this]() { CloseTerminalRequested.raise(*this, nullptr); });
+    }
+
+#pragma region Connection
+
+    TerminalConnection::ITerminalConnection GhosttyControlCore::Connection()
+    {
+        return _connection;
+    }
+
+    void GhosttyControlCore::Connection(const TerminalConnection::ITerminalConnection& connection)
+    {
+        _connectionOutputRevoker.revoke();
+        _connectionStateRevoker.revoke();
+
+        _connection = connection;
+        if (!_connection)
+        {
+            return;
+        }
+
+        _connectionOutputRevoker = _connection.TerminalOutput(winrt::auto_revoke, [this](const winrt::array_view<const char16_t>& data) {
+            _connectionOutputHandler(data);
+        });
+        _connectionStateRevoker = _connection.StateChanged(winrt::auto_revoke, [this](auto&&, auto&&) {
+            _connectionStateChangedHandler();
+        });
+    }
+
+    // Raised on the connection's own output thread, never the UI thread
+    // (ConptyConnection creates it with CreateThread). That matters: this call
+    // blocks until libghostty has parsed the bytes, and blocking here is
+    // exactly how backpressure reaches the child - the pipe fills and the child
+    // stalls on write.
+    //
+    // The contract that makes it safe: hold no WT-side lock across the call and
+    // do not wait on the dispatcher. libghostty's parse and render threads must
+    // never be able to block on something this thread holds.
+    void GhosttyControlCore::_connectionOutputHandler(const winrt::array_view<const char16_t>& data)
+    {
+        if (!_surface || _closing)
+        {
+            return;
+        }
+
+        const std::wstring_view wide{ reinterpret_cast<const wchar_t*>(data.data()), data.size() };
+
+        _utf8Scratch.clear();
+        if (FAILED(til::u16u8(wide, _utf8Scratch, _u16State)))
+        {
+            return;
+        }
+        if (_utf8Scratch.empty())
+        {
+            // A lone high surrogate: buffered in _u16State until its partner
+            // arrives in a later event.
+            return;
+        }
+
+        ghostty_surface_write_pty_output(_surface,
+                                         reinterpret_cast<const uint8_t*>(_utf8Scratch.data()),
+                                         _utf8Scratch.size());
+    }
+
+    void GhosttyControlCore::_connectionStateChangedHandler()
+    {
+        _raiseOnUiThread([this]() { ConnectionStateChanged.raise(*this, nullptr); });
+    }
+
+    // Bytes the terminal wants to send to the child, arriving on libghostty's
+    // io thread. WriteInput is thread-safe on ConptyConnection, so this goes
+    // straight through rather than hopping to the UI thread.
+    void GhosttyControlCore::WriteToConnection(std::string_view utf8) noexcept
+    try
+    {
+        if (!_connection || _closing || _readOnly)
+        {
+            return;
+        }
+
+        const auto wide = til::u8u16(utf8);
+        _connection.WriteInput(winrt::array_view<const char16_t>{
+            reinterpret_cast<const char16_t*>(wide.data()),
+            reinterpret_cast<const char16_t*>(wide.data() + wide.size()) });
+    }
+    CATCH_LOG()
+
+    void GhosttyControlCore::ResizeConnection(uint16_t columns, uint16_t rows) noexcept
+    try
+    {
+        if (!_connection || _closing)
+        {
+            return;
+        }
+        _connection.Resize(rows, columns);
+    }
+    CATCH_LOG()
+
+    TerminalConnection::ConnectionState GhosttyControlCore::ConnectionState() const
+    {
+        return _connection ? _connection.State() : TerminalConnection::ConnectionState::Closed;
+    }
+
+    void GhosttyControlCore::HardResetWithoutErase()
+    {
+        // Cascadia uses this to reset VT state without clearing the buffer on
+        // a connection restart. libghostty has no equivalent C entry point yet.
+    }
+
+#pragma endregion
+
+#pragma region Actions from libghostty
+
+    bool GhosttyControlCore::HandleAction(const ghostty_action_s& action) noexcept
+    try
+    {
+        switch (action.tag)
+        {
+        case GHOSTTY_ACTION_SET_TITLE:
+        {
+            const auto title = til::u8u16(std::string_view{ action.action.set_title.title });
+            _raiseOnUiThread([this, title = winrt::hstring{ title }]() {
+                _title = title;
+                TitleChanged.raise(*this, winrt::make<implementation::TitleChangedEventArgs>(title));
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_PWD:
+        {
+            const auto pwd = til::u8u16(std::string_view{ action.action.pwd.pwd });
+            _raiseOnUiThread([this, pwd = winrt::hstring{ pwd }]() { _workingDirectory = pwd; });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_CELL_SIZE:
+        {
+            // libghostty's own arithmetic is the authority here; deriving cell
+            // metrics on our side would let the two disagree and tell the child
+            // a size the terminal is not using.
+            const auto width = static_cast<float>(action.action.cell_size.width);
+            const auto height = static_cast<float>(action.action.cell_size.height);
+            _raiseOnUiThread([this, width, height]() {
+                _cellSize = { width, height };
+                FontSizeChanged.raise(*this, winrt::make<implementation::FontSizeChangedArgs>(static_cast<int>(width), static_cast<int>(height)));
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_SCROLLBAR:
+        {
+            const auto total = static_cast<int32_t>(action.action.scrollbar.total);
+            const auto offset = static_cast<int32_t>(action.action.scrollbar.offset);
+            const auto len = static_cast<int32_t>(action.action.scrollbar.len);
+            _raiseOnUiThread([this, total, offset, len]() {
+                _bufferHeight = total;
+                _scrollOffset = offset;
+                _viewHeight = len;
+                ScrollPositionChanged.raise(*this, winrt::make<implementation::ScrollPositionChangedArgs>(offset, len, total));
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_SWAP_CHAIN_CHANGED:
+        {
+            // Device loss produced a new handle; the panel's binding is stale.
+            // This is a UI-thread event in IControlCore, and getting it wrong
+            // shows as a frozen pane rather than an error.
+            _raiseOnUiThread([this]() { SwapChainChanged.raise(*this, nullptr); });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_RING_BELL:
+        {
+            _raiseOnUiThread([this]() { WarningBell.raise(*this, nullptr); });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_PROGRESS_REPORT:
+        {
+            const auto state = static_cast<size_t>(action.action.progress_report.state);
+            const auto progress = static_cast<size_t>(action.action.progress_report.progress);
+            _raiseOnUiThread([this, state, progress]() {
+                _taskbarState = state;
+                _taskbarProgress = progress;
+                TaskbarProgressChanged.raise(*this, nullptr);
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_COLOR_CHANGE:
+        {
+            const auto kind = action.action.color_change.kind;
+            const til::color color{ action.action.color_change.r, action.action.color_change.g, action.action.color_change.b };
+            _raiseOnUiThread([this, kind, color]() {
+                if (kind == GHOSTTY_ACTION_COLOR_KIND_BACKGROUND)
+                {
+                    BackgroundColorChanged.raise(*this, nullptr);
+                }
+                TabColorChanged.raise(*this, nullptr);
+            });
+            return true;
+        }
+
+        case GHOSTTY_ACTION_RENDERER_HEALTH:
+        {
+            if (action.action.renderer_health != GHOSTTY_RENDERER_HEALTH_HEALTHY)
+            {
+                _raiseOnUiThread([this]() { RendererEnteredErrorState.raise(*this, nullptr); });
+            }
+            return true;
+        }
+
+        // Tab and split creation belong to WT's own keybindings, which sit
+        // above the interface. Reporting these unhandled is correct, not a gap.
+        case GHOSTTY_ACTION_NEW_TAB:
+        case GHOSTTY_ACTION_NEW_SPLIT:
+        case GHOSTTY_ACTION_NEW_WINDOW:
+        default:
+            return false;
+        }
+    }
+    catch (...)
+    {
+        LOG_CAUGHT_EXCEPTION();
+        return false;
+    }
+
+    // Events that IControlCore documents as UI-thread must arrive there. If we
+    // are already on it, run inline so ordering with the caller is preserved.
+    void GhosttyControlCore::_raiseOnUiThread(std::function<void()> action)
+    {
+        if (!_dispatcher || _dispatcher.HasThreadAccess())
+        {
+            action();
+            return;
+        }
+
+        _dispatcher.TryEnqueue([action = std::move(action)]() { action(); });
+    }
+
+#pragma endregion
+
+#pragma region Size and font
+
+    void GhosttyControlCore::SizeChanged(const float width, const float height)
+    {
+        if (!_surface)
+        {
+            return;
+        }
+        const auto w = static_cast<uint32_t>(std::max(0.0f, width));
+        const auto h = static_cast<uint32_t>(std::max(0.0f, height));
+        if (w == 0 || h == 0)
+        {
+            return;
+        }
+        ghostty_surface_set_size(_surface, w, h);
+    }
+
+    void GhosttyControlCore::ScaleChanged(const float scale)
+    {
+        _compositionScale = scale;
+        if (_surface)
+        {
+            ghostty_surface_set_content_scale(_surface, scale, scale);
+        }
+    }
+
+    void GhosttyControlCore::SizeOrScaleChanged(const float width, const float height, const float scale)
+    {
+        ScaleChanged(scale);
+        SizeChanged(width, height);
+    }
+
+    uint64_t GhosttyControlCore::SwapChainHandle() const
+    {
+        if (!_surface)
+        {
+            return 0;
+        }
+        return reinterpret_cast<uint64_t>(ghostty_surface_get_swap_chain_handle(_surface));
+    }
+
+    winrt::Windows::Foundation::Size GhosttyControlCore::FontSize() const noexcept
+    {
+        return _cellSize;
+    }
+
+    winrt::Windows::Foundation::Size GhosttyControlCore::FontSizeInDips() const
+    {
+        return { _cellSize.Width / _compositionScale, _cellSize.Height / _compositionScale };
+    }
+
+    uint16_t GhosttyControlCore::FontWeight() const noexcept
+    {
+        return static_cast<uint16_t>(400);
+    }
+
+    void GhosttyControlCore::AdjustFontSize(float /*fontSizeDelta*/)
+    {
+        // Needs the config C API; see _applySettingsToConfig.
+    }
+
+    void GhosttyControlCore::ResetFontSize()
+    {
+    }
