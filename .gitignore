# Forks and reference clones are separate git repositories, not submodules.
# This repo tracks docs/, harness/, scripts/, and ghostty-patches/ only.
# The fork's commits are reproducible from the recorded upstream pin plus the
# exported patches in ghostty-patches/ (ADR 0004), which ARE tracked here.
/ghostty/
/terminal/
/reference/

# Build outputs
/build/
zig-out/
.zig-cache/
zig-cache/
/tools/

# Visual Studio / MSBuild
.vs/
*.user
*.suo
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# OS
Thumbs.db
desktop.ini

# Probe build output
harness/warp-probe/*.exe
harness/warp-probe/*.obj


# Harness build output
harness/hwnd-host/*.exe
harness/hwnd-host/*.obj
harness/hwnd-host/*.pdb
harness/hwnd-host/*.ilk
harness/hwnd-host/*.lib
harness/hwnd-host/*.def
harness/hwnd-host/*.dll

harness/hwnd-host/*.exp
harness/hwnd-host/*.txt

harness/xaml-host/*.exe
harness/xaml-host/*.obj
harness/xaml-host/*.pdb
harness/xaml-host/*.ilk
harness/xaml-host/*.dll
harness/xaml-host/*.txt

harness/hwnd-host/ghostty.pdb
harness/hwnd-host/crash.dmp

harness/wgc-shot/*.exe
harness/wgc-shot/*.obj
harness/wgc-shot/*.pdb
harness/wgc-shot/*.ilk

harness/pdbaddr/*.exe
harness/pdbaddr/*.obj
harness/pdbaddr/*.pdb
harness/pdbaddr/*.ilk

# Crash dumps from debugging sessions are artifacts, not deliverables.
*.dmp

# Harness run logs
harness/*/*.err

# Release artifacts. The .msix is 38 MB and is reproducible from the fork plus
# scripts/package.ps1; it belongs on a GitHub release, not in git history.
# The .cer is public, but it is regenerated with the package so it lives here too.
/dist/
*.pfx

harness/rawin/*.exe
harness/rawin/*.obj
harness/rawin/*.log

# harness/keylog: did the client send shift as a key at all, and when? KD-25.
harness/keylog/*.exe
harness/keylog/*.obj
harness/keylog/*.txt

# harness/glyphmask: is the glyph atlas coverage, or has D2D corrected it?
harness/glyphmask/*.exe
harness/glyphmask/*.obj
