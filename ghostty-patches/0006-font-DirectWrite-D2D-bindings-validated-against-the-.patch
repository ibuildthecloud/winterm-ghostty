+//! Direct2D and WIC bindings, enough to rasterize a glyph run into CPU memory.
+//!
+//! Why D2D rather than `IDWriteGlyphRunAnalysis`: AtlasEngine has both, and the
+//! GlyphRunAnalysis version is behind `#if 0` with the note that Direct2D is
+//! "roughly 2x faster" thanks to its staging-texture glyph uploader. More
+//! importantly for us, D2D handles monochrome *and* colour glyphs through one
+//! path - `TranslateColorGlyphRun` returning null is itself the "this glyph is
+//! monochrome" test - so there is one rasterizer instead of two plus a rule for
+//! choosing between them.
+//!
+//! We render into a WIC bitmap rather than a DXGI surface because ghostty's
+//! `font.Atlas` is CPU-side and owns its own rect packing. See the note in
+//! DESIGN.md correcting ADR 0005 on this point.
+//!
+//! Vtable slots are ABI. The slot comments are load-bearing.
+
+const std = @import("std");
+const dw = @import("api.zig");
+
+const GUID = dw.GUID;
+const HRESULT = dw.HRESULT;
+const Reserved = dw.Reserved;
+const IUnknown = dw.IUnknown;
+
+// =============================================================================
+// Shared types
+// =============================================================================
+
+pub const D2D1_COLOR_F = extern struct { r: f32, g: f32, b: f32, a: f32 };
+pub const D2D1_POINT_2F = extern struct { x: f32, y: f32 };
+pub const D2D1_RECT_F = extern struct { left: f32, top: f32, right: f32, bottom: f32 };
+pub const D2D1_SIZE_U = extern struct { width: u32, height: u32 };
+
+pub const D2D1_ALPHA_MODE = enum(u32) {
+    UNKNOWN = 0,
+    PREMULTIPLIED = 1,
+    STRAIGHT = 2,
+    IGNORE = 3,
+};
+
+pub const D2D1_PIXEL_FORMAT = extern struct {
+    format: u32, // DXGI_FORMAT
+    alphaMode: D2D1_ALPHA_MODE,
+};
+
+pub const D2D1_RENDER_TARGET_TYPE = enum(u32) { DEFAULT = 0, SOFTWARE = 1, HARDWARE = 2 };
+pub const D2D1_RENDER_TARGET_USAGE = u32;
+pub const D2D1_FEATURE_LEVEL = enum(u32) { DEFAULT = 0, _ };
+
+pub const D2D1_RENDER_TARGET_PROPERTIES = extern struct {
+    type: D2D1_RENDER_TARGET_TYPE,
+    pixelFormat: D2D1_PIXEL_FORMAT,
+    dpiX: f32,
+    dpiY: f32,
+    usage: D2D1_RENDER_TARGET_USAGE,
+    minLevel: D2D1_FEATURE_LEVEL,
+};
+
+pub const D2D1_TEXT_ANTIALIAS_MODE = enum(u32) {
+    DEFAULT = 0,
+    CLEARTYPE = 1,
+    /// The only mode we use. ClearType subpixel output is wrong over a
+    /// premultiplied-alpha composition surface, and AtlasEngine forces
+    /// grayscale for colour glyphs for the same reason.
+    GRAYSCALE = 2,
+    ALIASED = 3,
+};
+
+pub const D2D1_DRAW_TEXT_OPTIONS = u32;
