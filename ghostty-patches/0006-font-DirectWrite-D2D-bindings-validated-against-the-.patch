+/// Returned by TranslateColorGlyphRun when the glyph has no colour layers.
+/// Not an error - it is the "this glyph is monochrome" answer, and it is how we
+/// decide which rasterization path a glyph takes.
+pub const DWRITE_E_NOCOLOR: HRESULT = @bitCast(@as(u32, 0x88985003));
+
+pub const DWRITE_COLOR_F = extern struct { r: f32, g: f32, b: f32, a: f32 };
+
+/// One colour layer of a glyph, as produced by TranslateColorGlyphRun.
+/// `paletteIndex == 0xFFFF` means "no palette entry, draw with the caller's
+/// foreground colour" - AtlasEngine's rule, and it is load-bearing for glyphs
+/// that mix coloured and text-coloured layers.
+pub const DWRITE_COLOR_GLYPH_RUN = extern struct {
+    glyphRun: DWRITE_GLYPH_RUN,
+    glyphRunDescription: ?*anyopaque,
+    baselineOriginX: f32,
+    baselineOriginY: f32,
+    runColor: DWRITE_COLOR_F,
+    paletteIndex: u16,
+};
+
+pub const DWRITE_NO_PALETTE_INDEX: u16 = 0xFFFF;
