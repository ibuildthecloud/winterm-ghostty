+
+// =============================================================================
+// IDWriteFactory2 — inherits IDWriteFactory (24 slots) + IDWriteFactory1 (2).
+// Its own methods start at 26:
+//   26 GetSystemFontFallback
+//   27 CreateFontFallbackBuilder
+//   28 TranslateColorGlyphRun
+//   29 CreateCustomRenderingParams
+//   30 CreateGlyphRunAnalysis
+//
+// Deliberately Factory2 rather than Factory4. Factory4's TranslateColorGlyphRun
+// additionally handles SVG/PNG/bitmap glyph formats, but sits ~43 slots deep
+// through two more inheritance levels - a lot of hand-counted offsets, each of
+// which fails silently. Factory2 handles COLR, which is what Segoe UI Emoji
+// uses and exactly what AtlasEngine renders. Factory4 is a later upgrade for
+// the rarer formats.
+// =============================================================================
+pub const IDWriteFactory2 = extern struct {
+    vtable: *const VTable,
+
+    pub const IID = GUID{
+        .data1 = 0x0439fc60,
+        .data2 = 0xca44,
+        .data3 = 0x4994,
+        .data4 = .{ 0x8d, 0xee, 0x3a, 0x9a, 0xf7, 0xb7, 0x32, 0xec },
+    };
+
+    pub const VTable = extern struct {
+        // IUnknown 0-2
+        QueryInterface: *const fn (*IDWriteFactory2, *const GUID, *?*anyopaque) callconv(.winapi) HRESULT,
+        AddRef: *const fn (*IDWriteFactory2) callconv(.winapi) u32,
+        Release: *const fn (*IDWriteFactory2) callconv(.winapi) u32,
+        // IDWriteFactory 3-23 (21 methods)
+        _f0: Reserved,
+        _f1: Reserved,
+        _f2: Reserved,
+        _f3: Reserved,
+        _f4: Reserved,
+        _f5: Reserved,
+        _f6: Reserved,
+        _f7: Reserved,
+        _f8: Reserved,
+        _f9: Reserved,
+        _f10: Reserved,
+        _f11: Reserved,
+        _f12: Reserved,
+        _f13: Reserved,
+        _f14: Reserved,
+        _f15: Reserved,
+        _f16: Reserved,
+        _f17: Reserved,
+        _f18: Reserved,
+        _f19: Reserved,
+        _f20: Reserved,
+        // IDWriteFactory1 24-25 (2 methods)
+        _f1_0: Reserved,
+        _f1_1: Reserved,
+        // IDWriteFactory2 26-30
+        GetSystemFontFallback: *const fn (*IDWriteFactory2, *?*IDWriteFontFallback) callconv(.winapi) HRESULT,
+        CreateFontFallbackBuilder: Reserved,
+        TranslateColorGlyphRun: *const fn (
+            *IDWriteFactory2,
+            f32, // baselineOriginX
+            f32, // baselineOriginY
+            *const DWRITE_GLYPH_RUN,
+            ?*const anyopaque, // glyphRunDescription
+            DWRITE_MEASURING_MODE,
+            ?*const DWRITE_MATRIX,
+            u32, // colorPaletteIndex
+            *?*IDWriteColorGlyphRunEnumerator,
+        ) callconv(.winapi) HRESULT,
+        CreateCustomRenderingParams: Reserved,
+        CreateGlyphRunAnalysis: Reserved,
+    };
+
+    /// Returns null when the glyph has no colour layers (DWRITE_E_NOCOLOR).
+    /// That is the monochrome answer, not a failure.
+    pub inline fn TranslateColorGlyphRun(
+        self: *IDWriteFactory2,
+        baseline_x: f32,
+        baseline_y: f32,
+        run: *const DWRITE_GLYPH_RUN,
+        out: *?*IDWriteColorGlyphRunEnumerator,
+    ) HRESULT {
+        return self.vtable.TranslateColorGlyphRun(
+            self,
+            baseline_x,
+            baseline_y,
+            run,
+            null,
+            .NATURAL,
+            null,
+            0,
+            out,
+        );
+    }
+
+    pub inline fn GetSystemFontFallback(
+        self: *IDWriteFactory2,
+        out: *?*IDWriteFontFallback,
+    ) HRESULT {
+        return self.vtable.GetSystemFontFallback(self, out);
+    }
+
+    pub inline fn Release(self: *IDWriteFactory2) u32 {
+        return self.vtable.Release(self);
+    }
+};
+
+/// Opaque for now; `MapCharacters` is wired when discovery fallback lands.
+pub const IDWriteFontFallback = extern struct {
+    vtable: *const anyopaque,
+};
+
+pub const DWriteCreateFactory = @extern(*const fn (
+    factoryType: DWRITE_FACTORY_TYPE,
+    iid: *const GUID,
+    factory: *?*anyopaque,
+) callconv(.winapi) HRESULT, .{
+    .library_name = "dwrite",
+    .name = "DWriteCreateFactory",
+});
+
+test "vtable slot counts" {
+    // Vtable layout is ABI-critical; a wrong size means a wrong slot offset,
+    // which silently calls the wrong function rather than failing to compile.
+    // IUnknown contributes 3 slots to each.
+    try std.testing.expectEqual(
+        (3 + 21) * @sizeOf(usize), // IDWriteFactory has 21 own methods
+        @sizeOf(IDWriteFactory.VTable),
+    );
+    try std.testing.expectEqual(
+        (3 + 11) * @sizeOf(usize), // IDWriteFontFace has 11 own methods
+        @sizeOf(IDWriteFontFace.VTable),
+    );
+    try std.testing.expectEqual(
+        (3 + 5) * @sizeOf(usize), // IDWriteFactory1 adds 2, IDWriteFactory2 adds 5
+        @sizeOf(IDWriteFactory2.VTable) - (3 + 21 + 2) * @sizeOf(usize),
+    );
+    try std.testing.expectEqual(
+        (3 + 2) * @sizeOf(usize), // MoveNext, GetCurrentRun
+        @sizeOf(IDWriteColorGlyphRunEnumerator.VTable),
+    );
+}
