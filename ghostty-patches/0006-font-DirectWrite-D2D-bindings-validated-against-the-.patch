+
+pub const DWRITE_GLYPH_METRICS = extern struct {
+    leftSideBearing: i32,
+    advanceWidth: u32,
+    rightSideBearing: i32,
+    topSideBearing: i32,
+    advanceHeight: u32,
+    bottomSideBearing: i32,
+    verticalOriginY: i32,
