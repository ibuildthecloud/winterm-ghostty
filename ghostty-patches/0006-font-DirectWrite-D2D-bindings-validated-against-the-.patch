+    vtable: *const VTable,
+
+    pub const IID = GUID{
+        .data1 = 0xb859ee5a,
+        .data2 = 0xd838,
+        .data3 = 0x4b5b,
+        .data4 = .{ 0xa2, 0xe8, 0x1a, 0xdc, 0x7d, 0x93, 0xdb, 0x48 },
