+        SetTextRenderingParams: Reserved, // 36
+        GetTextRenderingParams: Reserved, // 37
+        SetTags: Reserved, // 38
+        GetTags: Reserved, // 39
+        PushLayer: Reserved, // 40
+        PopLayer: Reserved, // 41
+        Flush: Reserved, // 42
+        SaveDrawingState: Reserved, // 43
+        RestoreDrawingState: Reserved, // 44
+        PushAxisAlignedClip: Reserved, // 45
+        PopAxisAlignedClip: Reserved, // 46
+        Clear: *const fn (*ID2D1RenderTarget, ?*const D2D1_COLOR_F) callconv(.winapi) void, // 47
+        BeginDraw: *const fn (*ID2D1RenderTarget) callconv(.winapi) void, // 48
+        EndDraw: *const fn (*ID2D1RenderTarget, ?*u64, ?*u64) callconv(.winapi) HRESULT, // 49
+    };
+
+    pub inline fn CreateSolidColorBrush(
+        self: *ID2D1RenderTarget,
+        color: *const D2D1_COLOR_F,
+        out: *?*ID2D1SolidColorBrush,
+    ) HRESULT {
+        return self.vtable.CreateSolidColorBrush(self, color, null, out);
+    }
+
+    pub inline fn DrawGlyphRun(
+        self: *ID2D1RenderTarget,
+        origin: D2D1_POINT_2F,
+        run: *const dw.DWRITE_GLYPH_RUN,
+        brush: *ID2D1SolidColorBrush,
+    ) void {
+        self.vtable.DrawGlyphRun(self, origin, run, @ptrCast(brush), .NATURAL);
+    }
+
+    pub inline fn SetTextAntialiasMode(self: *ID2D1RenderTarget, mode: D2D1_TEXT_ANTIALIAS_MODE) void {
+        self.vtable.SetTextAntialiasMode(self, mode);
+    }
+
+    pub inline fn Clear(self: *ID2D1RenderTarget, color: ?*const D2D1_COLOR_F) void {
+        self.vtable.Clear(self, color);
+    }
+
+    pub inline fn BeginDraw(self: *ID2D1RenderTarget) void {
+        self.vtable.BeginDraw(self);
+    }
+
+    pub inline fn EndDraw(self: *ID2D1RenderTarget) HRESULT {
+        return self.vtable.EndDraw(self, null, null);
+    }
+
+    pub inline fn QueryInterface(self: *ID2D1RenderTarget, iid: *const GUID, out: *?*anyopaque) HRESULT {
+        return self.vtable.QueryInterface(self, iid, out);
+    }
+
+    pub inline fn Release(self: *ID2D1RenderTarget) u32 {
+        return self.vtable.Release(self);
+    }
+};
+
+// =============================================================================
+// ID2D1Factory — we call CreateWicBitmapRenderTarget(13)
+// =============================================================================
