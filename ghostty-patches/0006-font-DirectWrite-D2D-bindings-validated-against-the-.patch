+    pub inline fn GetCurrentRun(
+        self: *IDWriteColorGlyphRunEnumerator,
+        out: *?*const DWRITE_COLOR_GLYPH_RUN,
+    ) HRESULT {
+        return self.vtable.GetCurrentRun(self, out);
+    }
+
+    pub inline fn Release(self: *IDWriteColorGlyphRunEnumerator) u32 {
+        return self.vtable.Release(self);
+    }
