+    designUnitsPerEm: u16,
+    ascent: u16,
+    descent: u16,
+    lineGap: i16,
+    capHeight: u16,
+    xHeight: u16,
+    underlinePosition: i16,
+    underlineThickness: u16,
+    strikethroughPosition: i16,
+    strikethroughThickness: u16,
