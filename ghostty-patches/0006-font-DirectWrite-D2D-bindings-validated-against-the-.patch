+    NORMAL = 5,
+    _,
+};
+
+pub const DWRITE_FONT_SIMULATIONS = u32;
+pub const DWRITE_FONT_SIMULATIONS_NONE: DWRITE_FONT_SIMULATIONS = 0;
+pub const DWRITE_FONT_SIMULATIONS_BOLD: DWRITE_FONT_SIMULATIONS = 1;
+pub const DWRITE_FONT_SIMULATIONS_OBLIQUE: DWRITE_FONT_SIMULATIONS = 2;
+
+pub const DWRITE_FONT_FACE_TYPE = enum(u32) {
+    CFF = 0,
+    TRUETYPE = 1,
+    OPENTYPE_COLLECTION = 2,
+    _,
+};
+
+pub const DWRITE_MEASURING_MODE = enum(u32) {
+    NATURAL = 0,
+    GDI_CLASSIC = 1,
+    GDI_NATURAL = 2,
+};
+
