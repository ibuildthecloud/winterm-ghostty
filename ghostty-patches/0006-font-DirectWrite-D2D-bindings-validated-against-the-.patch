+
+    pub const VTable = extern struct {
+        QueryInterface: *const fn (*IDWriteGlyphRunAnalysis, *const GUID, *?*anyopaque) callconv(.winapi) HRESULT,
+        AddRef: *const fn (*IDWriteGlyphRunAnalysis) callconv(.winapi) u32,
