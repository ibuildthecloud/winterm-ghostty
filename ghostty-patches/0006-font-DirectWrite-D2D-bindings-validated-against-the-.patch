+//! DirectWrite COM bindings.
+//!
+//! Deliberately self-contained rather than sharing the renderer's
+//! `directx11/com.zig`: the font backend is its own upstream patch
+//! (`dwrite-discovery` in ADR 0004's series) and should not depend on the
+//! renderer patch landing first. The IUnknown boilerplate duplicated here is
+//! ~40 lines and buys that independence.
+//!
+//! Vtable layouts are ABI. A method declared in the wrong slot silently calls
+//! the wrong function rather than failing to compile, so the slot comments are
+//! load-bearing - keep them accurate and never insert into the middle.
+
+const std = @import("std");
+
+pub const HRESULT = i32;
+
+pub const GUID = extern struct {
+    data1: u32,
+    data2: u16,
+    data3: u16,
+    data4: [8]u8,
+};
+
+pub inline fn SUCCEEDED(hr: HRESULT) bool {
+    return hr >= 0;
+}
+pub inline fn FAILED(hr: HRESULT) bool {
+    return hr < 0;
+}
+
+pub const S_OK: HRESULT = 0;
+pub const E_NOINTERFACE: HRESULT = @bitCast(@as(u32, 0x80004002));
+
+/// Placeholder for vtable slots we do not call. Present so that the slots we
+/// do call land at the right offsets.
+pub const Reserved = *const fn () callconv(.winapi) void;
+
+pub const IUnknown = extern struct {
+    vtable: *const VTable,
+
+    pub const VTable = extern struct {
+        QueryInterface: *const fn (*IUnknown, *const GUID, *?*anyopaque) callconv(.winapi) HRESULT,
+        AddRef: *const fn (*IUnknown) callconv(.winapi) u32,
+        Release: *const fn (*IUnknown) callconv(.winapi) u32,
+    };
+
+    pub inline fn Release(self: *IUnknown) u32 {
+        return self.vtable.Release(self);
+    }
+};
+
+// =============================================================================
+// Enums and structs
+// =============================================================================
+
+pub const DWRITE_FACTORY_TYPE = enum(u32) {
+    SHARED = 0,
+    ISOLATED = 1,
+};
+
+pub const DWRITE_FONT_WEIGHT = enum(u32) {
+    THIN = 100,
+    NORMAL = 400,
+    BOLD = 700,
+    _,
+};
+
+pub const DWRITE_FONT_STYLE = enum(u32) {
