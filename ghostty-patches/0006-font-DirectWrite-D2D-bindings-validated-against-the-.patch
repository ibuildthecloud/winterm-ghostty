+
+// =============================================================================
+// IDWriteFontFace — count matters; we call GetMetrics(6), GetDesignGlyphMetrics(7),
+// GetGlyphIndices(8), TryGetFontTable(9), ReleaseFontTable(10)
+// =============================================================================
+pub const IDWriteFontFace = extern struct {
+    vtable: *const VTable,
+
+    pub const IID = GUID{
+        .data1 = 0x5f49804d,
+        .data2 = 0x7024,
+        .data3 = 0x4d43,
+        .data4 = .{ 0xbf, 0xa9, 0xd2, 0x59, 0x84, 0xf5, 0x38, 0x49 },
+    };
+
+    pub const VTable = extern struct {
+        // IUnknown (0-2)
+        QueryInterface: *const fn (*IDWriteFontFace, *const GUID, *?*anyopaque) callconv(.winapi) HRESULT,
+        AddRef: *const fn (*IDWriteFontFace) callconv(.winapi) u32,
+        Release: *const fn (*IDWriteFontFace) callconv(.winapi) u32,
+        // IDWriteFontFace (3-)
+        GetType: Reserved,
+        GetFiles: Reserved,
+        GetIndex: Reserved,
+        GetSimulations: Reserved,
+        IsSymbolFont: Reserved,
+        GetMetrics: *const fn (*IDWriteFontFace, *DWRITE_FONT_METRICS) callconv(.winapi) void,
+        GetGlyphCount: Reserved,
+        GetDesignGlyphMetrics: *const fn (
+            *IDWriteFontFace,
+            [*]const u16, // glyphIndices
+            u32, // glyphCount
+            [*]DWRITE_GLYPH_METRICS,
+            i32, // isSideways (BOOL)
+        ) callconv(.winapi) HRESULT,
+        GetGlyphIndices: *const fn (
+            *IDWriteFontFace,
+            [*]const u32, // codePoints
+            u32, // codePointCount
+            [*]u16, // glyphIndices out
+        ) callconv(.winapi) HRESULT,
+        TryGetFontTable: *const fn (
+            *IDWriteFontFace,
+            u32, // openTypeTableTag
+            *?*const anyopaque, // tableData
+            *u32, // tableSize
+            *?*anyopaque, // tableContext
+            *i32, // exists (BOOL)
+        ) callconv(.winapi) HRESULT,
+        ReleaseFontTable: *const fn (*IDWriteFontFace, ?*anyopaque) callconv(.winapi) void,
+    };
+
+    pub inline fn GetMetrics(self: *IDWriteFontFace) DWRITE_FONT_METRICS {
+        var m: DWRITE_FONT_METRICS = undefined;
+        self.vtable.GetMetrics(self, &m);
+        return m;
+    }
+
+    pub inline fn GetDesignGlyphMetrics(
+        self: *IDWriteFontFace,
+        indices: []const u16,
+        out: []DWRITE_GLYPH_METRICS,
+    ) HRESULT {
+        return self.vtable.GetDesignGlyphMetrics(
+            self,
+            indices.ptr,
+            @intCast(indices.len),
+            out.ptr,
+            0,
+        );
+    }
+
+    pub inline fn GetGlyphIndices(
+        self: *IDWriteFontFace,
+        codepoints: []const u32,
+        out: []u16,
+    ) HRESULT {
+        return self.vtable.GetGlyphIndices(
+            self,
+            codepoints.ptr,
+            @intCast(codepoints.len),
+            out.ptr,
+        );
+    }
+
+    pub inline fn TryGetFontTable(
+        self: *IDWriteFontFace,
+        table_tag: u32,
+        data: *?*const anyopaque,
+        size: *u32,
+        context: *?*anyopaque,
+        exists: *i32,
+    ) HRESULT {
+        return self.vtable.TryGetFontTable(self, table_tag, data, size, context, exists);
+    }
+
+    pub inline fn ReleaseFontTable(self: *IDWriteFontFace, context: ?*anyopaque) void {
+        self.vtable.ReleaseFontTable(self, context);
+    }
+
+    pub inline fn Release(self: *IDWriteFontFace) u32 {
+        return self.vtable.Release(self);
+    }
+};
+
+/// OpenType table tags are little-endian four-character codes.
+pub inline fn tag(comptime s: *const [4]u8) u32 {
+    return @as(u32, s[0]) |
+        (@as(u32, s[1]) << 8) |
+        (@as(u32, s[2]) << 16) |
+        (@as(u32, s[3]) << 24);
+}
