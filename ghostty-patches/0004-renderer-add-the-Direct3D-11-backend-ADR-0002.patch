--- /dev/null
+++ b/src/renderer/D3D11.zig
@@ -0,0 +1,354 @@
+//! Graphics API wrapper for Direct3D 11 (ADR 0002).
+//!
+//! This implements the `GraphicsAPI` contract that `renderer/generic.zig`
+//! requires, mirroring the structure of `Metal.zig` and `OpenGL.zig`.
+//!
+//! ## Phase 1 status
+//!
+//! What is real: device creation with the hardware -> WARP degradation ladder,
+//! the hwnd-mode swap chain, render targets, textures, samplers, buffers,
+//! resize, device-lost detection, and clear + present. That is enough for
+//! `GenericRenderer.drawFrame` to run end to end and produce a correctly
+//! cleared, correctly sized surface.
+//!
+//! What is not, and is marked `phase1_skeleton` where it matters: the cell
+//! pipelines, the HLSL shader set, and therefore any actual drawing.
+//! `RenderPass.step` accepts steps and ignores them. PLAN Phase 3 fills these
+//! in; the markers must all be gone by the end of it.
+//!
+//! Composition mode (the DirectComposition surface handle that a XAML
+//! SwapChainPanel consumes, and the mode Windows Terminal uses) is Phase 2.
+
+pub const D3D11 = @This();
+
+const std = @import("std");
+const builtin = @import("builtin");
+const Allocator = std.mem.Allocator;
+
+const apprt = @import("../apprt.zig");
+const configpkg = @import("../config.zig");
+const global = @import("../global.zig");
+const font = @import("../font/main.zig");
+const rendererpkg = @import("../renderer.zig");
+const shadertoy = @import("shadertoy.zig");
+const Renderer = rendererpkg.GenericRenderer(D3D11);
+
+const com = @import("directx11/com.zig");
+const d3d11 = @import("directx11/d3d11.zig");
+const dxgi = @import("directx11/dxgi.zig");
+const devicepkg = @import("directx11/device.zig");
+
+pub const GraphicsAPI = D3D11;
+pub const Target = @import("directx11/Target.zig");
+pub const Frame = @import("directx11/Frame.zig");
+pub const RenderPass = @import("directx11/RenderPass.zig");
+const bufferpkg = @import("directx11/buffer.zig");
+pub const Buffer = bufferpkg.Buffer;
+pub const Sampler = @import("directx11/Sampler.zig");
+pub const Texture = @import("directx11/Texture.zig");
+pub const shaders = @import("directx11/shaders.zig");
+pub const Pipeline = shaders.Pipeline;
+
+pub const Device = devicepkg.Device;
+pub const DriverKind = devicepkg.DriverKind;
+
+/// HLSL, compiled to DXBC with fxc. Note this is SM 5.0, not the SM 6 DXIL
+/// that dxc emits - D3D11 cannot consume DXIL.
+pub const custom_shader_target: shadertoy.Target = .hlsl;
+
+/// D3D11's clip space has +Y = up but its texture/fragment coordinates have
+/// +Y = down, matching Metal.
+pub const custom_shader_y_is_down = true;
+
+/// Double buffering. FLIP_SEQUENTIAL requires at least two buffers, and we do
+/// not yet have the waitable swap chain that would make a third useful
+/// (Phase 7).
+pub const swap_chain_count = 2;
+
+const log = std.log.scoped(.directx11);
+
+alloc: Allocator,
+
+/// Alpha blending mode.
+blending: configpkg.Config.AlphaBlending,
+
+/// The D3D11 device, swap chain, and back-buffer view.
+device: Device,
+
+/// The most recently presented target, in case we need to present it again.
+last_target: ?Target = null,
+
+pub const Error = error{
+    /// The surface was created without a Windows platform payload, or with one
+    /// selecting a mode this build does not implement yet.
+    UnsupportedSurface,
+} || devicepkg.Error;
+
+pub fn init(alloc: Allocator, opts: rendererpkg.Options) !D3D11 {
+    comptime switch (builtin.os.tag) {
+        .windows => {},
+        else => @compileError("unsupported platform for D3D11"),
+    };
+
+    // The surface tells us where to present. Only hwnd mode exists in Phase 1;
+    // composition mode arrives in Phase 2.
+    const target: devicepkg.Target = switch (opts.rt_surface.platform) {
+        .win32 => |v| if (v.hwnd) |hwnd|
+            .{ .hwnd = hwnd }
+        else if (v.composition)
+            // Phase 2. Fail loudly rather than silently presenting nowhere.
+            return Error.UnsupportedSurface
+        else
+            return Error.UnsupportedSurface,
+
+        else => return Error.UnsupportedSurface,
+    };
+
+    const size = opts.rt_surface.size;
+    const device = try Device.init(
+        target,
+        @max(size.width, 1),
+        @max(size.height, 1),
+        forced_driver,
+    );
+
+    return .{
+        .alloc = alloc,
+        .blending = opts.config.blending,
+        .device = device,
+    };
+}
+
+/// Set by the harness (via the GHOSTTY_D3D11_DRIVER environment variable) to
+/// pin the rasterizer. This is how the forced-WARP exit criterion is exercised
+/// on a machine that has a working GPU.
+var forced_driver: ?DriverKind = null;
+
+fn utf16(comptime s: []const u8) [:0]const u16 {
+    return std.unicode.utf8ToUtf16LeStringLiteral(s);
+}
+
+/// ASCII case-insensitive comparison of a UTF-16 environment value against an
+/// ASCII literal. Values here are always ASCII keywords, so this does not need
+/// to handle full Unicode case folding.
+fn eqlIgnoreCaseUtf16(value: []const u16, comptime expect: []const u8) bool {
+    if (value.len != expect.len) return false;
+    for (value, expect) |v, e| {
+        if (v > 127) return false;
+        if (std.ascii.toLower(@intCast(v)) != std.ascii.toLower(e)) return false;
+    }
+    return true;
+}
+
+/// Read the driver override once at startup. Called by `surfaceInit`.
+fn readDriverOverride() void {
+    const value = global.environ().getWindows(
+        utf16("GHOSTTY_D3D11_DRIVER"),
+    ) orelse return;
+
+    if (eqlIgnoreCaseUtf16(value, "warp")) {
+        forced_driver = .warp;
+        log.info("GHOSTTY_D3D11_DRIVER=warp, forcing software rasterizer", .{});
+    } else if (eqlIgnoreCaseUtf16(value, "hardware")) {
+        forced_driver = .hardware;
+        log.info("GHOSTTY_D3D11_DRIVER=hardware, disabling WARP fallback", .{});
+    } else {
+        log.warn("unrecognized GHOSTTY_D3D11_DRIVER value, ignoring", .{});
+    }
+}
+
+pub fn deinit(self: *D3D11) void {
+    if (self.last_target) |*t| t.deinit();
+    self.device.deinit();
+    self.* = undefined;
+}
+
+/// Called early right after surface creation, before the renderer thread.
+pub fn surfaceInit(surface: *apprt.Surface) !void {
+    _ = surface;
+    readDriverOverride();
+}
+
+pub fn drawFrameStart(self: *D3D11) void {
+    // Pick up window resizes before `surfaceSize()` is consulted. drawFrame
+    // calls this first and then compares surfaceSize() against its own state
+    // to decide whether to rebuild targets, so doing it here is what makes a
+    // resized window actually reach the renderer.
+    self.device.syncToWindow();
+}
+
+pub fn drawFrameEnd(self: *D3D11) void {
+    _ = self;
+}
+
+pub fn initShaders(
+    self: *const D3D11,
+    alloc: Allocator,
+    custom_shaders: []const [:0]const u8,
+) !shaders.Shaders {
+    _ = alloc;
+    return try shaders.Shaders.init(self.alloc, custom_shaders);
+}
+
+/// Get the current size of the runtime surface.
+pub fn surfaceSize(self: *const D3D11) !struct { width: u32, height: u32 } {
+    return .{ .width = self.device.width, .height = self.device.height };
+}
+
+/// Initialize a new render target which can be presented by this API.
+pub fn initTarget(self: *const D3D11, width: usize, height: usize) !Target {
+    return Target.init(.{
+        .device = self.device.device,
+        .width = @max(width, 1),
+        .height = @max(height, 1),
+        .srgb = self.blending.isLinear(),
+    });
+}
+
+/// Present the provided target by copying it to the swap chain back buffer.
+///
+/// A copy rather than rendering straight to the back buffer is what keeps the
+/// post-process shader chain (Phase 6) and damage-gated presentation (Phase 7)
+/// possible without restructuring.
+pub fn present(self: *D3D11, target: Target) !void {
+    // The swap chain may have been resized since this target was made. Growing
+    // the window before the target catches up is normal for a frame or two.
+    if (target.width != self.device.width or
+        target.height != self.device.height)
+    {
+        log.debug("target {d}x{d} does not match swap chain {d}x{d}, skipping copy", .{
+            target.width, target.height, self.device.width, self.device.height,
+        });
+    } else if (self.device.backBuffer()) |back| {
+        defer _ = back.Release();
+        self.device.context.CopyResource(@ptrCast(back), @ptrCast(target.texture));
+    }
+
+    const lost = self.device.present(true);
+    if (lost) return error.DeviceLost;
+
+    self.last_target = target;
+}
+
+/// Present the last presented target again.
+pub fn presentLastTarget(self: *D3D11) !void {
+    if (self.last_target) |target| try self.present(target);
+}
+
+/// Resize the swap chain to match the surface.
+pub fn resize(self: *D3D11, width: u32, height: u32) !void {
+    try self.device.resize(width, height);
+}
+
+/// Returns the options to use when constructing buffers.
+pub inline fn bufferOptions(self: D3D11) bufferpkg.Options {
+    return .{
+        .device = self.device.device,
+        .context = self.device.context,
+        .bind = .vertex,
+    };
+}
+
+pub inline fn uniformBufferOptions(self: D3D11) bufferpkg.Options {
+    return .{
+        .device = self.device.device,
+        .context = self.device.context,
+        .bind = .constant,
+    };
+}
+
+pub const instanceBufferOptions = bufferOptions;
+pub const fgBufferOptions = bufferOptions;
+pub const bgBufferOptions = bufferOptions;
+pub const imageBufferOptions = bufferOptions;
+pub const bgImageBufferOptions = bufferOptions;
+
+/// Returns the options to use when constructing textures.
+pub inline fn textureOptions(self: D3D11) Texture.Options {
+    return .{
+        .device = self.device.device,
+        .context = self.device.context,
+        .format = .rgba,
+        .srgb = true,
+    };
+}
+
+/// Returns the options to use when constructing samplers.
+pub inline fn samplerOptions(self: D3D11) Sampler.Options {
+    return .{
+        .device = self.device.device,
+        .min_filter = .linear,
+        .mag_filter = .linear,
+        .wrap_s = .clamp_to_edge,
+        .wrap_t = .clamp_to_edge,
+    };
+}
+
+/// Pixel format for image texture options.
+pub const ImageTextureFormat = enum {
+    gray,
+    rgba,
+    bgra,
+
+    fn toTextureFormat(self: ImageTextureFormat) Texture.Format {
+        return switch (self) {
+            .gray => .gray,
+            .rgba => .rgba,
+            .bgra => .bgra,
+        };
+    }
+};
+
+pub inline fn imageTextureOptions(
+    self: D3D11,
+    format: ImageTextureFormat,
+    srgb: bool,
+) Texture.Options {
+    return .{
+        .device = self.device.device,
+        .context = self.device.context,
+        .format = format.toTextureFormat(),
+        .srgb = srgb,
+    };
+}
+
+/// Initializes a Texture suitable for the provided font atlas.
+pub fn initAtlasTexture(
+    self: *const D3D11,
+    atlas: *const font.Atlas,
+) Texture.Error!Texture {
+    const format: Texture.Format = switch (atlas.format) {
+        .grayscale => .gray,
+        .bgra => .bgra,
+        else => return Texture.Error.UnsupportedFormat,
+    };
+
+    return try Texture.init(
+        .{
+            .device = self.device.device,
+            .context = self.device.context,
+            .format = format,
+            // The glyph atlas holds coverage/color data that the shader
+            // samples directly; it must not be sRGB-decoded on read.
+            .srgb = false,
+        },
+        atlas.size,
+        atlas.size,
+        null,
+    );
+}
+
+/// Begin a frame.
+pub inline fn beginFrame(
+    self: *const D3D11,
+    renderer: *Renderer,
+    target: *Target,
+) !Frame {
+    _ = self;
+    return try Frame.begin(.{}, renderer, target);
+}
+
+test {
+    _ = shaders;
+    _ = devicepkg;
+}
