diff --git a/src/renderer/directx11/Frame.zig b/src/renderer/directx11/Frame.zig
new file mode 100644
index 000000000..05c495983
--- /dev/null
+++ b/src/renderer/directx11/Frame.zig
@@ -0,0 +1,110 @@
+//! Wrapper for handling frames.
+//!
+//! D3D11's immediate context has no explicit frame object, so this is a thin
+//! bookkeeping type: it owns the target for the duration of the frame, hands
+//! out render passes, and reports health on completion.
+
+const Self = @This();
+
+const std = @import("std");
+
+const D3D11 = @import("../D3D11.zig");
+const Renderer = @import("../generic.zig").Renderer(D3D11);
+const Target = @import("Target.zig");
+const RenderPass = @import("RenderPass.zig");
+
+const Health = @import("../../renderer.zig").Health;
+
+const log = std.log.scoped(.directx11);
+
+/// Options for beginning a frame.
+pub const Options = struct {};
+
+renderer: *Renderer,
+target: *Target,
+
+pub fn begin(
+    opts: Options,
+    /// Once the frame has been completed, the `frameCompleted` method
+    /// on the renderer is called with the health status of the frame.
+    renderer: *Renderer,
+    /// The target is presented via the provided renderer's API when completed.
+    target: *Target,
+) !Self {
+    _ = opts;
+    return .{ .renderer = renderer, .target = target };
+}
+
+/// Add a render pass to this frame with the provided attachments.
+pub inline fn renderPass(
+    self: *const Self,
+    attachments: []const RenderPass.Options.Attachment,
+) RenderPass {
+    return RenderPass.begin(.{
+        .api = &self.renderer.api,
+        .attachments = attachments,
+        .skeleton_clear = self.skeletonClear(),
+    });
+}
+
+/// phase1_skeleton: the colour the surface should end up when nothing can be
+/// drawn yet.
+///
+/// `generic.zig` clears each pass to transparent black and paints the real
+/// background with the `bg_color` *pipeline*, deliberately avoiding
+/// `clear_color` so it does not have to do colour-space conversion on the CPU.
+/// With draw steps stubbed out that leaves a black window, which is
+/// indistinguishable from a broken swap chain and proves nothing.
+///
+/// So until Phase 3 supplies pipelines, clear to the terminal's own background
+/// colour instead. It comes from the same uniforms the shader would have read,
+/// so the window visibly tracks the config - `--background=ff0000` turns it
+/// red - which is what makes this phase's deliverable meaningful.
+///
+/// The colour-space handling here is the thing `generic.zig`'s comment is
+/// warning about. When alpha blending is linear the render target has an
+/// `_SRGB` format, and `ClearRenderTargetView` treats the value it is given as
+/// *linear*, re-encoding it to sRGB on store. Passing the config's sRGB bytes
+/// straight through therefore renders visibly too bright - #282C34 came out as
+/// #6E737D before this conversion was added.
+fn skeletonClear(self: *const Self) ?[4]f32 {
+    const bg = self.renderer.uniforms.bg_color;
+    const to_linear = self.renderer.api.blending.isLinear();
+
+    var out: [4]f32 = .{ 0, 0, 0, 1 };
+    for (0..3) |i| {
+        const c = @as(f32, @floatFromInt(bg[i])) / 255.0;
+        out[i] = if (to_linear) srgbToLinear(c) else c;
+    }
+    return out;
+}
+
+/// The standard sRGB electro-optical transfer function.
+fn srgbToLinear(c: f32) f32 {
+    return if (c <= 0.04045)
+        c / 12.92
+    else
+        std.math.pow(f32, (c + 0.055) / 1.055, 2.4);
+}
+
+/// Complete this frame and present the target.
+///
+/// `sync` is ignored: Phase 1 presents on the immediate context and does not
+/// yet use a waitable swap chain. The frame-latency wait object and the
+/// damage-gated present policy are Phase 7 (DESIGN presentation policy).
+pub fn complete(self: *const Self, sync: bool) void {
+    _ = sync;
+
+    // Health is driven by whether presentation reported a lost device. There
+    // is no fence to wait on here, so a frame that reached present without the
+    // device dropping is healthy.
+    const health: Health = health: {
+        self.renderer.api.present(self.target.*) catch |err| {
+            log.err("failed to present render target: err={}", .{err});
+            break :health .unhealthy;
+        };
+        break :health .healthy;
+    };
+
+    self.renderer.frameCompleted(health);
+}
diff --git a/src/renderer/directx11/RenderPass.zig b/src/renderer/directx11/RenderPass.zig
new file mode 100644
index 000000000..d70356af9
--- /dev/null
+++ b/src/renderer/directx11/RenderPass.zig
@@ -0,0 +1,140 @@
+//! Wrapper for handling render passes.
+//!
+//! Phase 1 status: attachment handling (bind + clear) is real, because that is
+//! what produces the cleared surface this phase has to demonstrate. Draw steps
+//! are **not** - `step` is a documented no-op until the cell pipelines, glyph
+//! atlas, and HLSL land in Phase 3. See the `phase1_skeleton` marker in
+//! `../D3D11.zig`.
+
+const Self = @This();
+
+const std = @import("std");
+
+const com = @import("com.zig");
+const d3d11 = @import("d3d11.zig");
+
+const Sampler = @import("Sampler.zig");
+const Target = @import("Target.zig");
+const Texture = @import("Texture.zig");
+const shaders = @import("shaders.zig");
+const Pipeline = shaders.Pipeline;
+const Buffer = @import("buffer.zig").Buffer;
+
+const log = std.log.scoped(.directx11);
+
+/// Options for beginning a render pass.
+pub const Options = struct {
+    /// The graphics API, for access to the immediate context.
+    api: *const @import("../D3D11.zig"),
+
+    /// Color attachments for this render pass.
+    attachments: []const Attachment,
+
+    /// phase1_skeleton: substituted for a fully-transparent `clear_color`.
+    /// See `Frame.skeletonClear` for why this exists.
+    skeleton_clear: ?[4]f32 = null,
+
+    pub const Attachment = struct {
+        target: union(enum) {
+            texture: Texture,
+            target: Target,
+        },
+        clear_color: ?[4]f32 = null,
+    };
+};
+
+/// Describes a step in a render pass.
+///
+/// The field set mirrors the Metal and OpenGL backends so that Phase 3 fills in
+/// `step`'s body without reshaping callers in `generic.zig`.
+pub const Step = struct {
+    pipeline: Pipeline,
+    uniforms: ?*d3d11.ID3D11Buffer = null,
+    buffers: []const ?*d3d11.ID3D11Buffer = &.{},
+    textures: []const ?Texture = &.{},
+    samplers: []const ?Sampler = &.{},
+    draw: Draw,
+
+    pub const Draw = struct {
+        type: Primitive,
+        vertex_count: usize,
+        instance_count: usize = 1,
+    };
+
+    /// Backend-neutral primitive names, matching what `generic.zig` passes and
+    /// what `gl.Primitive` spells them as. Mapped to D3D topology at draw
+    /// time rather than exposing `D3D_PRIMITIVE_TOPOLOGY` directly, so the
+    /// generic renderer stays free of D3D vocabulary.
+    pub const Primitive = enum {
+        triangle,
+        triangle_strip,
+
+        pub fn topology(self: Primitive) d3d11.D3D_PRIMITIVE_TOPOLOGY {
+            return switch (self) {
+                .triangle => .TRIANGLELIST,
+                .triangle_strip => .TRIANGLESTRIP,
+            };
+        }
+    };
+};
+
+api: *const @import("../D3D11.zig"),
+attachments: []const Options.Attachment,
+step_number: usize = 0,
+
+/// Begin a render pass: bind the attachments and clear those that ask for it.
+pub fn begin(opts: Options) Self {
+    const ctx = opts.api.device.context;
+
+    // D3D11 binds a fixed-size array of render targets, so gather the views
+    // first. Eight is the D3D11 limit for simultaneous render targets.
+    var rtvs: [8]?*d3d11.ID3D11RenderTargetView = @splat(null);
+    var count: usize = 0;
+    for (opts.attachments) |attachment| {
+        if (count >= rtvs.len) {
+            log.warn("more than {d} attachments, ignoring the rest", .{rtvs.len});
+            break;
+        }
+        const rtv: *d3d11.ID3D11RenderTargetView = switch (attachment.target) {
+            .target => |t| t.rtv,
+            .texture => |t| t.rtv orelse {
+                // A texture used as an attachment must have been created with
+                // render-target binding; skip it rather than crash.
+                log.warn("attachment texture has no render target view", .{});
+                continue;
+            },
+        };
+        rtvs[count] = rtv;
+        count += 1;
+
+        if (attachment.clear_color) |c| {
+            // phase1_skeleton: a fully transparent clear means "the pipelines
+            // will paint this", which they cannot yet. Substitute the
+            // terminal background so the surface shows something real.
+            const use_skeleton = c[3] == 0.0 and opts.skeleton_clear != null;
+            ctx.ClearRenderTargetView(rtv, if (use_skeleton)
+                &opts.skeleton_clear.?
+            else
+                &c);
+        }
+    }
+
+    ctx.OMSetRenderTargets(rtvs[0..count], null);
+
+    return .{ .api = opts.api, .attachments = opts.attachments };
+}
+
+/// Add a step to this render pass.
+///
+/// phase1_skeleton: no-op. Issuing a draw needs a compiled pipeline, an input
+/// layout, and a bound glyph atlas, none of which exist before Phase 3.
+/// Silently ignoring steps is what lets `GenericRenderer.drawFrame` run
+/// end-to-end and produce a correctly cleared, correctly sized surface now.
+pub fn step(self: *Self, s: Step) void {
+    _ = s;
+    self.step_number += 1;
+}
+
+pub fn complete(self: *const Self) void {
+    _ = self;
+}
diff --git a/src/renderer/directx11/Sampler.zig b/src/renderer/directx11/Sampler.zig
new file mode 100644
index 000000000..8ed6ff3ec
--- /dev/null
+++ b/src/renderer/directx11/Sampler.zig
@@ -0,0 +1,76 @@
+//! Wrapper for handling samplers.
+
+const Self = @This();
+
+const std = @import("std");
+
+const com = @import("com.zig");
+const d3d11 = @import("d3d11.zig");
+
+const log = std.log.scoped(.directx11);
+
+pub const Error = error{
+    SamplerCreationFailed,
+};
+
+pub const Filter = enum { nearest, linear };
+pub const AddressMode = enum { clamp_to_edge, repeat };
+
+/// Options for initializing a sampler.
+pub const Options = struct {
+    /// Borrowed; the `D3D11` instance outlives its samplers.
+    device: *d3d11.ID3D11Device,
+
+    min_filter: Filter = .linear,
+    mag_filter: Filter = .linear,
+    wrap_s: AddressMode = .clamp_to_edge,
+    wrap_t: AddressMode = .clamp_to_edge,
+};
+
+sampler: *d3d11.ID3D11SamplerState,
+
+pub fn init(opts: Options) Error!Self {
+    // D3D11 encodes min/mag/mip filtering in a single enum rather than as
+    // separate fields, and only exposes the combinations it has values for. We
+    // only ever use all-point or all-linear, so collapse to those two: if
+    // either filter asks for linear, use linear.
+    const filter: d3d11.D3D11_FILTER =
+        if (opts.min_filter == .linear or opts.mag_filter == .linear)
+            .MIN_MAG_MIP_LINEAR
+        else
+            .MIN_MAG_MIP_POINT;
+
+    const desc: d3d11.D3D11_SAMPLER_DESC = .{
+        .Filter = filter,
+        .AddressU = addressMode(opts.wrap_s),
+        .AddressV = addressMode(opts.wrap_t),
+        .AddressW = .CLAMP,
+        .MipLODBias = 0,
+        .MaxAnisotropy = 1,
+        .ComparisonFunc = .NEVER,
+        .BorderColor = .{ 0, 0, 0, 0 },
+        .MinLOD = 0,
+        .MaxLOD = 0,
+    };
+
+    var sampler: ?*d3d11.ID3D11SamplerState = null;
+    if (com.FAILED(opts.device.CreateSamplerState(&desc, &sampler)) or
+        sampler == null)
+    {
+        log.err("failed to create sampler state", .{});
+        return Error.SamplerCreationFailed;
+    }
+
+    return .{ .sampler = sampler.? };
+}
+
+fn addressMode(mode: AddressMode) d3d11.D3D11_TEXTURE_ADDRESS_MODE {
+    return switch (mode) {
+        .clamp_to_edge => .CLAMP,
+        .repeat => .WRAP,
+    };
+}
+
+pub fn deinit(self: Self) void {
+    _ = self.sampler.Release();
+}
diff --git a/src/renderer/directx11/Target.zig b/src/renderer/directx11/Target.zig
new file mode 100644
index 000000000..bd886a869
--- /dev/null
+++ b/src/renderer/directx11/Target.zig
@@ -0,0 +1,100 @@
+//! Represents a render target: an offscreen D3D11 texture plus its render
+//! target view.
+//!
+//! `GenericRenderer` renders into a target and then asks the API to present it,
+//! rather than drawing straight to the back buffer. Keeping that indirection
+//! is what makes custom post-process shaders (Phase 6) and the damage-gated
+//! present policy (Phase 7) possible later, so we honour it now even though
+//! Phase 1 only clears.
+
+const Self = @This();
+
+const std = @import("std");
+
+const com = @import("com.zig");
+const d3d11 = @import("d3d11.zig");
+const dxgi = @import("dxgi.zig");
+
+const log = std.log.scoped(.directx11);
+
+pub const Error = error{
+    TextureCreationFailed,
+    RenderTargetViewFailed,
+};
+
+/// Options for initializing a Target.
+pub const Options = struct {
+    /// Device used to allocate the texture. Borrowed, not retained: the
+    /// `D3D11` instance outlives every target it hands out.
+    device: *d3d11.ID3D11Device,
+
+    width: usize,
+    height: usize,
+
+    /// Use an sRGB texture format so blending happens in linear space and the
+    /// hardware re-encodes on store. Mirrors the OpenGL backend's choice of
+    /// internal format based on the alpha-blending config.
+    srgb: bool,
+};
+
+texture: *d3d11.ID3D11Texture2D,
+rtv: *d3d11.ID3D11RenderTargetView,
+
+width: usize,
+height: usize,
+
+pub fn init(opts: Options) Error!Self {
+    const format: dxgi.DXGI_FORMAT = if (opts.srgb)
+        .B8G8R8A8_UNORM_SRGB
+    else
+        .B8G8R8A8_UNORM;
+
+    const desc: d3d11.D3D11_TEXTURE2D_DESC = .{
+        .Width = @intCast(opts.width),
+        .Height = @intCast(opts.height),
+        .MipLevels = 1,
+        .ArraySize = 1,
+        .Format = format,
+        .SampleDesc = .{ .Count = 1, .Quality = 0 },
+        .Usage = .DEFAULT,
+        // SHADER_RESOURCE is needed so post-process shaders can sample this
+        // target as an input in Phase 6.
+        .BindFlags = d3d11.D3D11_BIND_RENDER_TARGET |
+            d3d11.D3D11_BIND_SHADER_RESOURCE,
+        .CPUAccessFlags = 0,
+        .MiscFlags = 0,
+    };
+
+    var texture: ?*d3d11.ID3D11Texture2D = null;
+    if (com.FAILED(opts.device.CreateTexture2D(&desc, null, &texture)) or
+        texture == null)
+    {
+        log.err("failed to create {d}x{d} render target texture", .{
+            opts.width, opts.height,
+        });
+        return Error.TextureCreationFailed;
+    }
+    errdefer _ = texture.?.Release();
+
+    var rtv: ?*d3d11.ID3D11RenderTargetView = null;
+    if (com.FAILED(opts.device.CreateRenderTargetView(
+        @ptrCast(texture.?),
+        null,
+        &rtv,
+    )) or rtv == null) {
+        return Error.RenderTargetViewFailed;
+    }
+
+    return .{
+        .texture = texture.?,
+        .rtv = rtv.?,
+        .width = opts.width,
+        .height = opts.height,
+    };
+}
+
+pub fn deinit(self: *Self) void {
+    _ = self.rtv.Release();
+    _ = self.texture.Release();
+    self.* = undefined;
+}
diff --git a/src/renderer/directx11/Texture.zig b/src/renderer/directx11/Texture.zig
new file mode 100644
index 000000000..38e096e57
--- /dev/null
+++ b/src/renderer/directx11/Texture.zig
@@ -0,0 +1,186 @@
+//! Wrapper for handling textures.
+//!
+//! Used for the glyph atlas and for image content. Phase 1 creates and uploads
+//! textures correctly, because `GenericRenderer` builds the atlas regardless of
+//! whether anything is drawn with it; only the draw path is deferred.
+
+const Self = @This();
+
+const std = @import("std");
+
+const com = @import("com.zig");
+const d3d11 = @import("d3d11.zig");
+const dxgi = @import("dxgi.zig");
+
+const log = std.log.scoped(.directx11);
+
+pub const Error = error{
+    TextureCreationFailed,
+    ShaderResourceViewFailed,
+    /// The requested pixel format has no D3D11 equivalent we support.
+    UnsupportedFormat,
+};
+
+/// Pixel formats we can create textures for.
+pub const Format = enum {
+    /// 1 byte per pixel, used by the grayscale glyph atlas.
+    gray,
+    /// 4 bytes per pixel RGBA.
+    rgba,
+    /// 4 bytes per pixel BGRA.
+    bgra,
+
+    fn dxgiFormat(self: Format, srgb: bool) dxgi.DXGI_FORMAT {
+        return switch (self) {
+            // R8_UNORM is the D3D11 spelling of a single-channel 8-bit
+            // texture; the shader swizzles it to alpha.
+            .gray => .R8_UNORM,
+            .rgba => if (srgb) .R8G8B8A8_UNORM_SRGB else .R8G8B8A8_UNORM,
+            .bgra => if (srgb) .B8G8R8A8_UNORM_SRGB else .B8G8R8A8_UNORM,
+        };
+    }
+
+    fn bytesPerPixel(self: Format) usize {
+        return switch (self) {
+            .gray => 1,
+            .rgba, .bgra => 4,
+        };
+    }
+};
+
+/// Options for initializing a texture.
+pub const Options = struct {
+    /// Borrowed; the `D3D11` instance outlives its textures.
+    device: *d3d11.ID3D11Device,
+    context: *d3d11.ID3D11DeviceContext,
+
+    format: Format = .rgba,
+    srgb: bool = false,
+
+    /// Also create a render target view, so this texture can be used as a
+    /// render pass attachment. Needed for post-process targets (Phase 6).
+    render_target: bool = false,
+};
+
+texture: *d3d11.ID3D11Texture2D,
+srv: *d3d11.ID3D11ShaderResourceView,
+rtv: ?*d3d11.ID3D11RenderTargetView,
+
+/// Borrowed context, for uploads.
+context: *d3d11.ID3D11DeviceContext,
+
+width: usize,
+height: usize,
+format: Format,
+
+pub fn init(
+    opts: Options,
+    width: usize,
+    height: usize,
+    data: ?[]const u8,
+) Error!Self {
+    var bind: u32 = d3d11.D3D11_BIND_SHADER_RESOURCE;
+    if (opts.render_target) bind |= d3d11.D3D11_BIND_RENDER_TARGET;
+
+    const desc: d3d11.D3D11_TEXTURE2D_DESC = .{
+        .Width = @intCast(width),
+        .Height = @intCast(height),
+        .MipLevels = 1,
+        .ArraySize = 1,
+        .Format = opts.format.dxgiFormat(opts.srgb),
+        .SampleDesc = .{ .Count = 1, .Quality = 0 },
+        // DEFAULT + UpdateSubresource rather than DYNAMIC + Map: atlas updates
+        // are region replacements, not whole-surface rewrites, and DYNAMIC
+        // textures only support full-discard maps.
+        .Usage = .DEFAULT,
+        .BindFlags = bind,
+        .CPUAccessFlags = 0,
+        .MiscFlags = 0,
+    };
+
+    var initial: d3d11.D3D11_SUBRESOURCE_DATA = undefined;
+    const initial_ptr: ?[*]const d3d11.D3D11_SUBRESOURCE_DATA = if (data) |d| blk: {
+        initial = .{
+            .pSysMem = d.ptr,
+            .SysMemPitch = @intCast(width * opts.format.bytesPerPixel()),
+            .SysMemSlicePitch = 0,
+        };
+        break :blk @ptrCast(&initial);
+    } else null;
+
+    var texture: ?*d3d11.ID3D11Texture2D = null;
+    if (com.FAILED(opts.device.CreateTexture2D(&desc, initial_ptr, &texture)) or
+        texture == null)
+    {
+        log.err("failed to create {d}x{d} texture", .{ width, height });
+        return Error.TextureCreationFailed;
+    }
+    errdefer _ = texture.?.Release();
+
+    var srv: ?*d3d11.ID3D11ShaderResourceView = null;
+    if (com.FAILED(opts.device.CreateShaderResourceView(
+        @ptrCast(texture.?),
+        null,
+        &srv,
+    )) or srv == null) {
+        return Error.ShaderResourceViewFailed;
+    }
+    errdefer _ = srv.?.Release();
+
+    var rtv: ?*d3d11.ID3D11RenderTargetView = null;
+    if (opts.render_target) {
+        if (com.FAILED(opts.device.CreateRenderTargetView(
+            @ptrCast(texture.?),
+            null,
+            &rtv,
+        ))) {
+            return Error.ShaderResourceViewFailed;
+        }
+    }
+
+    return .{
+        .texture = texture.?,
+        .srv = srv.?,
+        .rtv = rtv,
+        .context = opts.context,
+        .width = width,
+        .height = height,
+        .format = opts.format,
+    };
+}
+
+pub fn deinit(self: Self) void {
+    if (self.rtv) |rtv| _ = rtv.Release();
+    _ = self.srv.Release();
+    _ = self.texture.Release();
+}
+
+/// Replace a region of the texture with the provided data.
+///
+/// Does NOT check the dimensions of the data to ensure correctness, matching
+/// the other backends.
+pub fn replaceRegion(
+    self: Self,
+    x: usize,
+    y: usize,
+    width: usize,
+    height: usize,
+    data: []const u8,
+) Error!void {
+    const box: d3d11.D3D11_BOX = .{
+        .left = @intCast(x),
+        .top = @intCast(y),
+        .front = 0,
+        .right = @intCast(x + width),
+        .bottom = @intCast(y + height),
+        .back = 1,
+    };
+    self.context.UpdateSubresource(
+        @ptrCast(self.texture),
+        0,
+        &box,
+        data.ptr,
+        @intCast(width * self.format.bytesPerPixel()),
+        0,
+    );
+}
diff --git a/src/renderer/directx11/buffer.zig b/src/renderer/directx11/buffer.zig
new file mode 100644
index 000000000..07650bb8a
--- /dev/null
+++ b/src/renderer/directx11/buffer.zig
@@ -0,0 +1,184 @@
+//! GPU buffer wrapper.
+//!
+//! `GenericRenderer` keeps these long-lived and re-syncs their whole contents
+//! each frame, so they are created DYNAMIC and updated with a discard Map,
+//! which is the cheapest path for full rewrites on D3D11.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+const com = @import("com.zig");
+const d3d11 = @import("d3d11.zig");
+
+const log = std.log.scoped(.directx11);
+
+/// Options for initializing a buffer.
+pub const Options = struct {
+    /// Borrowed; the `D3D11` instance outlives its buffers.
+    device: *d3d11.ID3D11Device,
+    context: *d3d11.ID3D11DeviceContext,
+
+    /// What the buffer is bound as. Constant buffers have stricter size rules
+    /// (see `init`).
+    bind: Bind = .vertex,
+
+    pub const Bind = enum {
+        vertex,
+        constant,
+
+        fn flag(self: Bind) u32 {
+            return switch (self) {
+                .vertex => d3d11.D3D11_BIND_VERTEX_BUFFER,
+                .constant => d3d11.D3D11_BIND_CONSTANT_BUFFER,
+            };
+        }
+    };
+};
+
+pub const Error = error{
+    BufferCreationFailed,
+    MapFailed,
+};
+
+pub fn Buffer(comptime T: type) type {
+    return struct {
+        const Self = @This();
+
+        buffer: *d3d11.ID3D11Buffer,
+        opts: Options,
+
+        /// Current allocated length of the data store, in units of `T`.
+        len: usize,
+
+        pub fn init(opts: Options, len: usize) !Self {
+            const buffer = try create(opts, len, null);
+            return .{ .buffer = buffer, .opts = opts, .len = len };
+        }
+
+        pub fn initFill(opts: Options, data: []const T) !Self {
+            const buffer = try create(opts, data.len, data);
+            return .{ .buffer = buffer, .opts = opts, .len = data.len };
+        }
+
+        fn create(
+            opts: Options,
+            len: usize,
+            data: ?[]const T,
+        ) Error!*d3d11.ID3D11Buffer {
+            // A zero-byte buffer is invalid in D3D11, and the renderer does
+            // ask for empty buffers before it knows the grid size.
+            const count = @max(len, 1);
+            var byte_width: u32 = @intCast(count * @sizeOf(T));
+
+            // Constant buffers must be a multiple of 16 bytes.
+            if (opts.bind == .constant) {
+                byte_width = std.mem.alignForward(u32, byte_width, 16);
+            }
+
+            const desc: d3d11.D3D11_BUFFER_DESC = .{
+                .ByteWidth = byte_width,
+                .Usage = .DYNAMIC,
+                .BindFlags = opts.bind.flag(),
+                .CPUAccessFlags = d3d11.D3D11_CPU_ACCESS_WRITE,
+                .MiscFlags = 0,
+                .StructureByteStride = 0,
+            };
+
+            var initial: d3d11.D3D11_SUBRESOURCE_DATA = undefined;
+            const initial_ptr: ?*const d3d11.D3D11_SUBRESOURCE_DATA = if (data) |d| blk: {
+                if (d.len == 0) break :blk null;
+                initial = .{
+                    .pSysMem = d.ptr,
+                    .SysMemPitch = 0,
+                    .SysMemSlicePitch = 0,
+                };
+                break :blk &initial;
+            } else null;
+
+            var buffer: ?*d3d11.ID3D11Buffer = null;
+            if (com.FAILED(opts.device.CreateBuffer(&desc, initial_ptr, &buffer)) or
+                buffer == null)
+            {
+                log.err("failed to create {d}-byte buffer", .{byte_width});
+                return Error.BufferCreationFailed;
+            }
+            return buffer.?;
+        }
+
+        pub fn deinit(self: Self) void {
+            _ = self.buffer.Release();
+        }
+
+        /// Sync new contents to the buffer. The data is expected to be the
+        /// complete contents. Grows (reallocating) if the data does not fit.
+        pub fn sync(self: *Self, data: []const T) !void {
+            if (data.len > self.len) {
+                // Grow to double what we need, matching the other backends, so
+                // a steadily growing grid does not reallocate every frame.
+                const new_len = data.len * 2;
+                const new_buffer = try create(self.opts, new_len, null);
+                _ = self.buffer.Release();
+                self.buffer = new_buffer;
+                self.len = new_len;
+            }
+            try self.write(data, 0);
+        }
+
+        /// Like `sync` but gathers from several array lists. Returns the
+        /// number of items synced.
+        pub fn syncFromArrayLists(
+            self: *Self,
+            lists: []const std.ArrayListUnmanaged(T),
+        ) !usize {
+            var total: usize = 0;
+            for (lists) |list| total += list.items.len;
+
+            if (total > self.len) {
+                const new_len = total * 2;
+                const new_buffer = try create(self.opts, new_len, null);
+                _ = self.buffer.Release();
+                self.buffer = new_buffer;
+                self.len = new_len;
+            }
+
+            // One Map for the whole gather: mapping per list would discard the
+            // previous list's writes, since DYNAMIC buffers only support
+            // WRITE_DISCARD.
+            var mapped: d3d11.D3D11_MAPPED_SUBRESOURCE = undefined;
+            if (com.FAILED(self.opts.context.Map(
+                @ptrCast(self.buffer),
+                0,
+                .WRITE_DISCARD,
+                0,
+                &mapped,
+            ))) return Error.MapFailed;
+            defer self.opts.context.Unmap(@ptrCast(self.buffer), 0);
+
+            const dst: [*]T = @ptrCast(@alignCast(mapped.pData));
+            var i: usize = 0;
+            for (lists) |list| {
+                @memcpy(dst[i .. i + list.items.len], list.items);
+                i += list.items.len;
+            }
+
+            return total;
+        }
+
+        fn write(self: *Self, data: []const T, offset: usize) Error!void {
+            if (data.len == 0) return;
+
+            var mapped: d3d11.D3D11_MAPPED_SUBRESOURCE = undefined;
+            if (com.FAILED(self.opts.context.Map(
+                @ptrCast(self.buffer),
+                0,
+                .WRITE_DISCARD,
+                0,
+                &mapped,
+            ))) return Error.MapFailed;
+            defer self.opts.context.Unmap(@ptrCast(self.buffer), 0);
+
+            const dst: [*]T = @ptrCast(@alignCast(mapped.pData));
+            @memcpy(dst[offset .. offset + data.len], data);
+        }
+    };
+}
diff --git a/src/renderer/directx11/com.zig b/src/renderer/directx11/com.zig
new file mode 100644
index 000000000..0562bbcc0
--- /dev/null
+++ b/src/renderer/directx11/com.zig
@@ -0,0 +1,70 @@
+//! Minimal COM support: GUIDs, HRESULT, and IUnknown.
+//!
+//! Harvested from ghostty-org/ghostty PR #11886 by deblasis (MIT), which is
+//! also the upstream home of the D3D11 work this backend builds on. Extended
+//! here as the renderer needed more of the API surface.
+const std = @import("std");
+
+/// COM GUID (Globally Unique Identifier).
+pub const GUID = extern struct {
+    data1: u32,
+    data2: u16,
+    data3: u16,
+    data4: [8]u8,
+};
+
+/// COM HRESULT return type.
+pub const HRESULT = i32;
+
+/// Returns true if the HRESULT indicates success (non-negative).
+pub inline fn SUCCEEDED(hr: HRESULT) bool {
+    return hr >= 0;
+}
+
+/// Returns true if the HRESULT indicates failure (negative).
+pub inline fn FAILED(hr: HRESULT) bool {
+    return hr < 0;
+}
+
+pub const S_OK: HRESULT = 0;
+pub const E_NOINTERFACE: HRESULT = @bitCast(@as(u32, 0x80004002));
+pub const E_FAIL: HRESULT = @bitCast(@as(u32, 0x80004005));
+pub const DXGI_ERROR_DEVICE_REMOVED: HRESULT = @bitCast(@as(u32, 0x887A0005));
+
+/// IUnknown — base COM interface that all COM objects implement.
+pub const IUnknown = extern struct {
+    vtable: *const VTable,
+
+    pub const VTable = extern struct {
+        QueryInterface: *const fn (
+            self: *IUnknown,
+            riid: *const GUID,
+            ppvObject: *?*anyopaque,
+        ) callconv(.winapi) HRESULT,
+        AddRef: *const fn (self: *IUnknown) callconv(.winapi) u32,
+        Release: *const fn (self: *IUnknown) callconv(.winapi) u32,
+    };
+
+    pub inline fn Release(self: *IUnknown) u32 {
+        return self.vtable.Release(self);
+    }
+
+    pub inline fn AddRef(self: *IUnknown) u32 {
+        return self.vtable.AddRef(self);
+    }
+
+    pub inline fn QueryInterface(
+        self: *IUnknown,
+        riid: *const GUID,
+        ppvObject: *?*anyopaque,
+    ) HRESULT {
+        return self.vtable.QueryInterface(self, riid, ppvObject);
+    }
+};
+
+/// Stub vtable entry for COM methods not yet wrapped.
+pub const Reserved = *const fn () callconv(.winapi) void;
+
+test {
+    _ = @import("com_test.zig");
+}
diff --git a/src/renderer/directx11/com_test.zig b/src/renderer/directx11/com_test.zig
new file mode 100644
index 000000000..8ffcfddbc
--- /dev/null
+++ b/src/renderer/directx11/com_test.zig
@@ -0,0 +1,116 @@
+//! Tests for the COM layer.
+//!
+//! Harvested from ghostty-org/ghostty PR #11886 by deblasis (MIT).
+const std = @import("std");
+const com = @import("com.zig");
+const dxgi = @import("dxgi.zig");
+const d3d11 = @import("d3d11.zig");
+
+// Verify COM GUID byte layout matches the Windows SDK definitions.
+// GUIDs are stored as { u32, u16, u16, [8]u8 } in little-endian.
+
+test "IUnknown GUID has no definition" {
+    // IUnknown doesn't define its own IID in our bindings (it's accessed
+    // via derived interfaces), so verify the base struct layout instead.
+    try std.testing.expectEqual(@sizeOf(com.GUID), 16);
+    try std.testing.expectEqual(@alignOf(com.GUID), 4);
+}
+
+test "HRESULT helpers" {
+    try std.testing.expect(com.SUCCEEDED(com.S_OK));
+    try std.testing.expect(!com.FAILED(com.S_OK));
+    try std.testing.expect(com.FAILED(com.E_FAIL));
+    try std.testing.expect(!com.SUCCEEDED(com.E_FAIL));
+    try std.testing.expect(com.FAILED(com.E_NOINTERFACE));
+    try std.testing.expect(com.FAILED(com.DXGI_ERROR_DEVICE_REMOVED));
+}
+
+test "Reserved type is function pointer sized" {
+    try std.testing.expectEqual(@sizeOf(com.Reserved), @sizeOf(*anyopaque));
+}
+
+// Verify struct sizes match the C ABI (these are extern structs that
+// cross the COM boundary, so size mismatches cause runtime crashes).
+
+test "DXGI_SWAP_CHAIN_DESC1 size" {
+    // DXGI_SWAP_CHAIN_DESC1 is 48 bytes on 64-bit Windows.
+    try std.testing.expectEqual(@sizeOf(dxgi.DXGI_SWAP_CHAIN_DESC1), 48);
+}
+
+test "DXGI_SAMPLE_DESC size" {
+    try std.testing.expectEqual(@sizeOf(dxgi.DXGI_SAMPLE_DESC), 8);
+}
+
+test "D3D11_VIEWPORT size" {
+    // D3D11_VIEWPORT is 6 floats = 24 bytes.
+    try std.testing.expectEqual(@sizeOf(d3d11.D3D11_VIEWPORT), 24);
+}
+
+test "D3D11_BUFFER_DESC size" {
+    // D3D11_BUFFER_DESC is 24 bytes (6 u32 fields).
+    try std.testing.expectEqual(@sizeOf(d3d11.D3D11_BUFFER_DESC), 24);
+}
+
+test "D3D11_INPUT_ELEMENT_DESC size" {
+    // D3D11_INPUT_ELEMENT_DESC: ptr + u32 + enum + enum + u32 + u32 + enum = 32 bytes on 64-bit.
+    const expected: usize = if (@sizeOf(*anyopaque) == 8) 32 else 24;
+    try std.testing.expectEqual(@sizeOf(d3d11.D3D11_INPUT_ELEMENT_DESC), expected);
+}
+
+test "D3D11_MAPPED_SUBRESOURCE size" {
+    // D3D11_MAPPED_SUBRESOURCE: ptr + u32 + u32.
+    const expected: usize = if (@sizeOf(*anyopaque) == 8) 16 else 12;
+    try std.testing.expectEqual(@sizeOf(d3d11.D3D11_MAPPED_SUBRESOURCE), expected);
+}
+
+// Verify vtable pointer layout — COM objects are a single pointer to a vtable.
+
+test "IDXGIDevice is a single vtable pointer" {
+    try std.testing.expectEqual(@sizeOf(dxgi.IDXGIDevice), @sizeOf(*anyopaque));
+}
+
+test "IDXGISwapChain1 is a single vtable pointer" {
+    try std.testing.expectEqual(@sizeOf(dxgi.IDXGISwapChain1), @sizeOf(*anyopaque));
+}
+
+test "ID3D11Device is a single vtable pointer" {
+    try std.testing.expectEqual(@sizeOf(d3d11.ID3D11Device), @sizeOf(*anyopaque));
+}
+
+test "ID3D11DeviceContext is a single vtable pointer" {
+    try std.testing.expectEqual(@sizeOf(d3d11.ID3D11DeviceContext), @sizeOf(*anyopaque));
+}
+
+// Verify GUID constants are the right values (cross-referenced with
+// Windows SDK headers).
+
+test "IDXGIDevice IID" {
+    const iid = dxgi.IDXGIDevice.IID;
+    try std.testing.expectEqual(iid.data1, 0x54ec77fa);
+    try std.testing.expectEqual(iid.data2, 0x1377);
+    try std.testing.expectEqual(iid.data3, 0x44e6);
+    try std.testing.expectEqualSlices(u8, &iid.data4, &[_]u8{ 0x8c, 0x32, 0x88, 0xfd, 0x5f, 0x44, 0xc8, 0x4c });
+}
+
+test "IDXGIFactory2 IID" {
+    const iid = dxgi.IDXGIFactory2.IID;
+    try std.testing.expectEqual(iid.data1, 0x50c83a1c);
+    try std.testing.expectEqual(iid.data2, 0xe072);
+    try std.testing.expectEqual(iid.data3, 0x4c48);
+    try std.testing.expectEqualSlices(u8, &iid.data4, &[_]u8{ 0x87, 0xb0, 0x36, 0x30, 0xfa, 0x36, 0xa6, 0xd0 });
+}
+
+test "ISwapChainPanelNative IID" {
+    const iid = dxgi.ISwapChainPanelNative.IID;
+    try std.testing.expectEqual(iid.data1, 0xf92f19d2);
+    try std.testing.expectEqual(iid.data2, 0x3ade);
+    try std.testing.expectEqual(iid.data3, 0x45a6);
+    try std.testing.expectEqualSlices(u8, &iid.data4, &[_]u8{ 0xa2, 0x0c, 0xf6, 0xf1, 0xea, 0x90, 0x55, 0x4b });
+}
+
+test "ID3D11Texture2D IID" {
+    const iid = d3d11.ID3D11Texture2D.IID;
+    try std.testing.expectEqual(iid.data1, 0x6f15aaf2);
+    try std.testing.expectEqual(iid.data2, 0xd208);
+    try std.testing.expectEqual(iid.data3, 0x4e89);
+}
