+//! Shader data layouts and the pipeline collection for the D3D11 backend.
+//!
+//! **The GPU data structs below are byte-identical to `metal/shaders.zig` by
+//! design, not by coincidence.** `GenericRenderer` writes the same bytes for
+//! every backend, so any divergence here is a silent corruption rather than a
+//! compile error. The alignments are copied verbatim from the Metal versions
+//! for that reason - do not "tidy" them.
+//!
+//! Phase 1 status: the data layouts are real and complete. The pipeline
+//! objects are not - HLSL, the glyph atlas, and the cell pipelines are Phase 3
+//! (ADR 0002, PLAN Phase 3). `Shaders.init` therefore produces an empty
+//! collection, and `RenderPass.step` ignores steps. See the `phase1_skeleton`
+//! marker in `../D3D11.zig`.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const math = @import("../../math.zig");
+
+const log = std.log.scoped(.directx11);
+
+/// A single render pipeline (vertex + fragment program pair).
+///
+/// Phase 1: an empty placeholder so the `GraphicsAPI` contract compiles. Phase
+/// 3 replaces this with compiled DXBC shader objects and input layouts.
+pub const Pipeline = struct {
+    pub fn deinit(self: *Pipeline) void {
+        _ = self;
+    }
+};
+
+/// The set of pipelines the generic renderer expects to be able to draw with.
+///
+/// Field names must match what `GenericRenderer` reaches for; they are kept
+/// even though Phase 1 never draws through them, so that Phase 3 fills in
+/// bodies rather than reshaping the type.
+pub const PipelineCollection = struct {
+    /// Fills the whole surface with the background color.
+    bg_color: Pipeline = .{},
+    /// Draws the per-cell background colors.
+    cell_bg: Pipeline = .{},
+    /// Draws glyphs from the atlas.
+    cell_text: Pipeline = .{},
+    /// Draws inline images (kitty graphics).
+    image: Pipeline = .{},
+    /// Draws the configured background image.
+    bg_image: Pipeline = .{},
+};
+
+pub const Shaders = struct {
+    pipelines: PipelineCollection,
+
+    /// Custom postprocess shaders run against the final drawable texture.
+    /// Phase 1 never populates this; ghostty's custom-shader support is
+    /// surfaced in Phase 6.
+    post_pipelines: []const Pipeline,
+
+    /// Set once deinited so a double-deinit is a no-op rather than a
+    /// double-free, matching the OpenGL and Metal implementations.
+    defunct: bool = false,
+
+    pub fn init(
+        alloc: Allocator,
+        post_shaders: []const [:0]const u8,
+    ) !Shaders {
+        _ = alloc;
+
+        if (post_shaders.len > 0) {
+            // Not a failure: custom shaders must never block the terminal from
+            // working, which is why the other backends also degrade rather
+            // than error here.
+            log.warn(
+                "custom shaders are not implemented for D3D11 yet, ignoring {d}",
+                .{post_shaders.len},
+            );
+        }
+
+        return .{
+            .pipelines = .{},
+            .post_pipelines = &.{},
+        };
+    }
+
+    pub fn deinit(self: *Shaders, alloc: Allocator) void {
+        if (self.defunct) return;
+        _ = alloc;
+        self.defunct = true;
+    }
+};
+
+pub const Uniforms = extern struct {
+    // Note: all of the explicit alignments are copied from the Metal
+    // implementation, which copied them from the MSL developer reference.
+    // These must not drift - see the file header.
+
+    /// The projection matrix for turning world coordinates to normalized.
+    /// This is calculated based on the size of the screen.
+    projection_matrix: math.Mat align(16),
+
+    /// Size of the screen (render target) in pixels.
+    screen_size: [2]f32 align(8),
+
+    /// Size of a single cell in pixels, unscaled.
+    cell_size: [2]f32 align(8),
+
+    /// Size of the grid in columns and rows.
+    grid_size: [2]u16 align(4),
+
+    /// The padding around the terminal grid in pixels. In order:
+    /// top, right, bottom, left.
+    grid_padding: [4]f32 align(16),
+
+    /// Bit mask defining which directions to
+    /// extend cell colors in to the padding.
+    /// Order, LSB first: left, right, up, down
+    padding_extend: PaddingExtend align(1),
+
+    /// The minimum contrast ratio for text. The contrast ratio is calculated
+    /// according to the WCAG 2.0 spec.
+    min_contrast: f32 align(4),
+
+    /// The cursor position and color.
+    cursor_pos: [2]u16 align(4),
+    cursor_color: [4]u8 align(4),
+
+    /// The background color for the whole surface.
+    bg_color: [4]u8 align(4),
+
+    /// Various booleans.
+    bools: extern struct {
+        /// Whether the cursor is 2 cells wide.
+        cursor_wide: bool align(1),
+
+        /// Indicates that colors provided to the shader are already in
+        /// the P3 color space, so they don't need to be converted from
+        /// sRGB.
+        use_display_p3: bool align(1),
+
+        /// Indicates that the color attachments for the shaders have
+        /// an sRGB pixel format, which means the shaders need to output
+        /// linear RGB colors rather than gamma encoded colors, since
+        /// blending is performed in linear space and re-encoded on store.
+        use_linear_blending: bool align(1),
+
+        /// Enables a weight correction step that makes text rendered
+        /// with linear alpha blending have a similar apparent weight
+        /// (thickness) to gamma-incorrect blending.
+        use_linear_correction: bool align(1) = false,
+    },
+
+    const PaddingExtend = packed struct(u8) {
+        left: bool = false,
+        right: bool = false,
+        up: bool = false,
+        down: bool = false,
+        _padding: u4 = 0,
+    };
+};
+
+/// This is a single parameter for the terminal cell shader.
+pub const CellText = extern struct {
+    glyph_pos: [2]u32 align(8) = .{ 0, 0 },
+    glyph_size: [2]u32 align(8) = .{ 0, 0 },
+    bearings: [2]i16 align(4) = .{ 0, 0 },
+    grid_pos: [2]u16 align(4),
+    color: [4]u8 align(4),
+    atlas: Atlas align(1),
+    bools: packed struct(u8) {
+        no_min_contrast: bool = false,
+        is_cursor_glyph: bool = false,
+        _padding: u6 = 0,
+    } align(1) = .{},
+
+    pub const Atlas = enum(u8) {
+        grayscale = 0,
+        color = 1,
+    };
+
+    test {
+        // Minimizing the size of this struct is important, and it must match
+        // Metal exactly, so we test it to be aware of any changes.
+        try std.testing.expectEqual(32, @sizeOf(CellText));
+    }
+};
+
+/// This is a single parameter for the cell bg shader.
+pub const CellBg = [4]u8;
+
+/// Single parameter for the image shader. See shader for field details.
+pub const Image = extern struct {
+    grid_pos: [2]f32,
+    cell_offset: [2]f32,
+    source_rect: [4]f32,
+    dest_size: [2]f32,
+};
+
+/// Single parameter for the bg image shader.
+pub const BgImage = extern struct {
+    opacity: f32 align(4),
+    info: Info align(1),
+
+    pub const Info = packed struct(u8) {
+        position: Position,
+        fit: Fit,
+        repeat: bool,
+        _padding: u1 = 0,
+
+        pub const Position = enum(u4) {
+            tl = 0,
+            tc = 1,
+            tr = 2,
+            ml = 3,
+            mc = 4,
+            mr = 5,
+            bl = 6,
+            bc = 7,
+            br = 8,
+        };
+
+        pub const Fit = enum(u2) {
+            contain = 0,
+            cover = 1,
+            stretch = 2,
+            none = 3,
+        };
+    };
+};
+
+test {
+    _ = Uniforms;
+    _ = CellText;
+    _ = BgImage;
+}
