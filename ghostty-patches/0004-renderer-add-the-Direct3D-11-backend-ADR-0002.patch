new file mode 100644
index 000000000..c9d0d32c4
--- /dev/null
+++ b/src/renderer/directx11/device.zig
@@ -0,0 +1,399 @@
+//! D3D11 device and swap-chain lifecycle.
+//!
+//! This is deliberately *not* the `device.zig` from PR #11886. That one takes
+//! an `ISwapChainPanelNative` and hardcodes `D3D_DRIVER_TYPE.HARDWARE` with no
+//! fallback, because it only ever targeted a XAML panel. Two things ADR 0002
+//! requires are therefore ours to write:
+//!
+//!   1. The **degradation ladder**: hardware -> WARP. WARP is the same code
+//!      path, not a reduced one, which is what makes it viable for RDP and
+//!      driverless machines. Verified on the dev box (`harness/warp-probe`):
+//!      hardware and WARP both report feature level 11_1.
+//!   2. **hwnd presentation mode**, for the standalone harness. Composition
+//!      mode (the Windows Terminal path) arrives in Phase 2.
+//!
+//! Threading: D3D11 is free-threaded and we keep ghostty's renderer thread, so
+//! nothing here assumes an app-thread affinity.
+
+const std = @import("std");
+const builtin = @import("builtin");
+
+const com = @import("com.zig");
+const d3d11 = @import("d3d11.zig");
+const dxgi = @import("dxgi.zig");
+
+const log = std.log.scoped(.directx11);
+
+const HRESULT = com.HRESULT;
+
+/// Which rasterizer backed the device we ended up with. Reported so the
+/// embedder can surface "running in software" without having to re-query DXGI,
+/// and so tests can force a path.
+pub const DriverKind = enum {
+    hardware,
+    /// Windows Advanced Rasterization Platform - the software rasterizer.
+    warp,
+
+    pub fn driverType(self: DriverKind) d3d11.D3D_DRIVER_TYPE {
+        return switch (self) {
+            .hardware => .HARDWARE,
+            .warp => .WARP,
+        };
+    }
+};
+
+/// Where a device presents. Mirrors `apprt.embedded.Platform.Win32`, but as a
+/// renderer-side concept so this module does not depend on the apprt.
+pub const Target = union(enum) {
+    /// Present to a window.
+    hwnd: *anyopaque,
+
+    /// Present to a DirectComposition surface handle (Phase 2).
+    composition,
+};
+
+pub const Error = error{
+    DeviceCreationFailed,
+    NoSuitableDriver,
+    QueryInterfaceFailed,
+    GetAdapterFailed,
+    GetFactoryFailed,
+    SwapChainCreationFailed,
+    BackBufferFailed,
+    RenderTargetViewFailed,
+    ResizeFailed,
+    Unsupported,
+};
+
+/// We ask for 11_0 as the floor. Everything the terminal renderer needs is in
+/// 11_0, and WARP provides it on every supported Windows version.
+const feature_levels = [_]d3d11.D3D_FEATURE_LEVEL{ .@"11_1", .@"11_0" };
+
+/// FLIP_SEQUENTIAL requires at least 2 buffers and a flip-model format.
+const buffer_count: u32 = 2;
+const swap_chain_format: dxgi.DXGI_FORMAT = .B8G8R8A8_UNORM;
+
+const RECT = extern struct { left: i32, top: i32, right: i32, bottom: i32 };
+
+extern "user32" fn GetClientRect(hWnd: *anyopaque, lpRect: *RECT) callconv(.winapi) i32;
+
+pub const Device = struct {
+    device: *d3d11.ID3D11Device,
+    context: *d3d11.ID3D11DeviceContext,
+    swap_chain: *dxgi.IDXGISwapChain1,
+    rtv: ?*d3d11.ID3D11RenderTargetView,
+
+    /// Where this device presents. Retained so we can re-query the window for
+    /// its size; see `syncToWindow`.
+    target: Target,
+
+    driver: DriverKind,
+    feature_level: d3d11.D3D_FEATURE_LEVEL,
+    width: u32,
+    height: u32,
+
+    /// Create a device and swap chain for `target`.
+    ///
+    /// `force_driver` pins the rasterizer instead of walking the ladder, which
+    /// is how the harness exercises the forced-WARP exit criterion without
+    /// needing a machine that lacks a GPU.
+    pub fn init(
+        target: Target,
+        width: u32,
+        height: u32,
+        force_driver: ?DriverKind,
+    ) Error!Device {
+        if (comptime builtin.os.tag != .windows) return Error.Unsupported;
+
+        const ladder: []const DriverKind = if (force_driver) |d|
+            &.{d}
+        else
+            &.{ .hardware, .warp };
+
+        var device: ?*d3d11.ID3D11Device = null;
+        var context: ?*d3d11.ID3D11DeviceContext = null;
+        var level: d3d11.D3D_FEATURE_LEVEL = .@"11_0";
+        var chosen: DriverKind = .hardware;
+
+        for (ladder) |kind| {
+            // BGRA_SUPPORT is required for D2D/DirectComposition interop. We
+            // ask for it even in hwnd mode so that a device created here stays
+            // usable when composition mode lands in Phase 2.
+            const hr = d3d11.D3D11CreateDevice(
+                null, // default adapter for this driver type
+                kind.driverType(),
+                null,
+                d3d11.D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                &feature_levels,
+                feature_levels.len,
+                d3d11.D3D11_SDK_VERSION,
+                &device,
+                &level,
+                &context,
+            );
+            if (com.SUCCEEDED(hr)) {
+                chosen = kind;
+                break;
+            }
+            log.warn("D3D11CreateDevice failed for {t}: hr=0x{x}", .{
+                kind, @as(u32, @bitCast(hr)),
+            });
+        } else {
+            // Every rung of the ladder failed. There is nothing below WARP.
+            log.err("no D3D11 driver could be created", .{});
+            return Error.NoSuitableDriver;
+        }
+
+        const dev = device orelse return Error.DeviceCreationFailed;
+        errdefer _ = dev.Release();
+        const ctx = context orelse return Error.DeviceCreationFailed;
+        errdefer _ = ctx.Release();
+
+        if (chosen == .warp) {
+            log.info("using WARP software rasterizer", .{});
+        }
+
+        const factory = try getFactory(dev);
+        defer _ = factory.Release();
+
+        const desc: dxgi.DXGI_SWAP_CHAIN_DESC1 = .{
+            .Width = width,
+            .Height = height,
+            .Format = swap_chain_format,
+            .Stereo = 0,
+            .SampleDesc = .{ .Count = 1, .Quality = 0 },
+            .BufferUsage = dxgi.DXGI_USAGE_RENDER_TARGET_OUTPUT,
+            .BufferCount = buffer_count,
+            .Scaling = .NONE,
+            .SwapEffect = .FLIP_SEQUENTIAL,
+            // Alpha mode is not a free choice: DXGI rejects PREMULTIPLIED for
+            // hwnd swap chains with DXGI_ERROR_INVALID_CALL (0x887A0001).
+            // Transparency only means something when a compositor is behind
+            // the surface, so premultiplied belongs to composition mode and
+            // IGNORE is the only sensible value for a window.
+            .AlphaMode = switch (target) {
+                .hwnd => .IGNORE,
+                .composition => .PREMULTIPLIED,
+            },
+            .Flags = 0,
+        };
+
+        var swap_chain: ?*dxgi.IDXGISwapChain1 = null;
+        const hr = switch (target) {
+            .hwnd => |hwnd| factory.CreateSwapChainForHwnd(
+                @ptrCast(dev),
+                hwnd,
+                &desc,
+                null, // windowed; never take over the display mode
+                null,
+                &swap_chain,
+            ),
+            .composition => return Error.Unsupported, // Phase 2
+        };
+        if (com.FAILED(hr) or swap_chain == null) {
+            log.err("swap chain creation failed: hr=0x{x}", .{@as(u32, @bitCast(hr))});
+            return Error.SwapChainCreationFailed;
+        }
+        errdefer _ = swap_chain.?.Release();
+
+        var self: Device = .{
+            .device = dev,
+            .context = ctx,
+            .swap_chain = swap_chain.?,
+            .rtv = null,
+            .target = target,
+            .driver = chosen,
+            .feature_level = level,
+            .width = width,
+            .height = height,
+        };
+        try self.createRenderTarget();
+
+        log.info("D3D11 device ready: driver={t} feature_level={t} size={d}x{d}", .{
+            chosen, level, width, height,
+        });
+        return self;
+    }
+
+    pub fn deinit(self: *Device) void {
+        self.releaseRenderTarget();
+        _ = self.swap_chain.Release();
+        _ = self.context.Release();
+        _ = self.device.Release();
+        self.* = undefined;
+    }
+
+    /// Walk device -> IDXGIDevice -> adapter -> factory. Using the factory that
+    /// owns our device (rather than a fresh CreateDXGIFactory) is required: a
+    /// swap chain must come from the same factory as its device, and it also
+    /// keeps us on the WARP adapter when that is what we fell back to.
+    fn getFactory(dev: *d3d11.ID3D11Device) Error!*dxgi.IDXGIFactory2 {
+        var dxgi_device_opt: ?*anyopaque = null;
+        if (com.FAILED(dev.QueryInterface(&dxgi.IDXGIDevice.IID, &dxgi_device_opt)) or
+            dxgi_device_opt == null)
+        {
+            return Error.QueryInterfaceFailed;
+        }
+        const dxgi_device: *dxgi.IDXGIDevice = @ptrCast(@alignCast(dxgi_device_opt.?));
+        defer _ = dxgi_device.Release();
+
+        var adapter: ?*dxgi.IDXGIAdapter = null;
+        if (com.FAILED(dxgi_device.GetAdapter(&adapter)) or adapter == null) {
+            return Error.GetAdapterFailed;
+        }
+        defer _ = adapter.?.Release();
+
+        var factory_opt: ?*anyopaque = null;
+        if (com.FAILED(adapter.?.GetParent(&dxgi.IDXGIFactory2.IID, &factory_opt)) or
+            factory_opt == null)
+        {
+            return Error.GetFactoryFailed;
+        }
+        return @ptrCast(@alignCast(factory_opt.?));
+    }
+
+    fn createRenderTarget(self: *Device) Error!void {
+        var back_buffer_opt: ?*anyopaque = null;
+        if (com.FAILED(self.swap_chain.GetBuffer(
+            0,
+            &d3d11.ID3D11Texture2D.IID,
+            &back_buffer_opt,
+        )) or back_buffer_opt == null) {
+            return Error.BackBufferFailed;
+        }
+        const back_buffer: *d3d11.ID3D11Texture2D = @ptrCast(@alignCast(back_buffer_opt.?));
+        defer _ = back_buffer.Release();
+
+        var rtv: ?*d3d11.ID3D11RenderTargetView = null;
+        if (com.FAILED(self.device.CreateRenderTargetView(
+            @ptrCast(back_buffer),
+            null,
+            &rtv,
+        )) or rtv == null) {
+            return Error.RenderTargetViewFailed;
+        }
+        self.rtv = rtv;
+    }
+
+    fn releaseRenderTarget(self: *Device) void {
+        if (self.rtv) |rtv| {
+            // The context can still hold a reference to the view through OM
+            // state. Unbind before releasing, otherwise ResizeBuffers fails
+            // with "outstanding references to the swap chain's buffers".
+            self.context.OMSetRenderTargets(&.{null}, null);
+            _ = rtv.Release();
+            self.rtv = null;
+        }
+    }
+
+    /// Resize the swap chain. No-op when the size is unchanged, and ignores
+    /// zero dimensions, which Windows sends on minimize.
+    pub fn resize(self: *Device, width: u32, height: u32) Error!void {
+        if (width == 0 or height == 0) return;
+        if (width == self.width and height == self.height) return;
+
+        self.releaseRenderTarget();
+
+        const hr = self.swap_chain.ResizeBuffers(
+            buffer_count,
+            width,
+            height,
+            swap_chain_format,
+            0,
+        );
+        if (com.FAILED(hr)) {
+            log.err("ResizeBuffers failed: hr=0x{x}", .{@as(u32, @bitCast(hr))});
+            return Error.ResizeFailed;
+        }
+
+        self.width = width;
+        self.height = height;
+        try self.createRenderTarget();
+    }
+
+    /// Re-sync the swap chain to the window's current client size.
+    ///
+    /// In hwnd mode the window is the authority on how big the surface is, and
+    /// `GenericRenderer` learns about size changes solely by comparing
+    /// `surfaceSize()` against its own state. If this is not called, a resized
+    /// window never reaches the renderer: it keeps drawing at the old size and
+    /// the newly exposed region stays blank.
+    ///
+    /// Composition mode has no window to ask, so it is driven by the
+    /// embedder's explicit resize call instead (Phase 2).
+    pub fn syncToWindow(self: *Device) void {
+        const hwnd = switch (self.target) {
+            .hwnd => |h| h,
+            .composition => return,
+        };
+
+        var rect: RECT = undefined;
+        if (GetClientRect(hwnd, &rect) == 0) return;
+
+        const w: u32 = @intCast(@max(rect.right - rect.left, 0));
+        const h: u32 = @intCast(@max(rect.bottom - rect.top, 0));
+        if (w == 0 or h == 0) return; // minimized
+        if (w == self.width and h == self.height) return;
+
+        self.resize(w, h) catch |err| {
+            log.warn("failed to resize swap chain to {d}x{d}: {}", .{ w, h, err });
+        };
+    }
+
+    /// Borrow the swap chain's back buffer texture. The caller must Release
+    /// it. Returns null if the buffer could not be obtained, which callers
+    /// treat as "skip this frame" rather than a fatal error.
+    pub fn backBuffer(self: *Device) ?*d3d11.ID3D11Texture2D {
+        var buffer: ?*anyopaque = null;
+        if (com.FAILED(self.swap_chain.GetBuffer(
+            0,
+            &d3d11.ID3D11Texture2D.IID,
+            &buffer,
+        )) or buffer == null) return null;
+        return @ptrCast(@alignCast(buffer.?));
+    }
+
+    /// Bind the back buffer and set a full-surface viewport.
+    pub fn bindRenderTarget(self: *Device) void {
+        const rtv = self.rtv orelse return;
+        self.context.OMSetRenderTargets(&.{rtv}, null);
+        const viewport: d3d11.D3D11_VIEWPORT = .{
+            .TopLeftX = 0,
+            .TopLeftY = 0,
+            .Width = @floatFromInt(self.width),
+            .Height = @floatFromInt(self.height),
+            .MinDepth = 0,
+            .MaxDepth = 1,
+        };
+        self.context.RSSetViewports(&.{viewport});
+    }
+
+    pub fn clear(self: *Device, rgba: [4]f32) void {
+        const rtv = self.rtv orelse return;
+        self.context.ClearRenderTargetView(rtv, &rgba);
+    }
+
+    /// Present the back buffer. Returns true if the device was lost, which the
+    /// caller must handle by rebuilding (step 3 of ADR 0002's ladder).
+    pub fn present(self: *Device, vsync: bool) bool {
+        const hr = self.swap_chain.Present(if (vsync) 1 else 0, 0);
+        if (hr == com.DXGI_ERROR_DEVICE_REMOVED or
+            hr == DXGI_ERROR_DEVICE_RESET)
+        {
+            log.warn("device lost on present: hr=0x{x}", .{@as(u32, @bitCast(hr))});
+            return true;
+        }
+        if (com.FAILED(hr)) {
+            log.warn("Present failed: hr=0x{x}", .{@as(u32, @bitCast(hr))});
+        }
+        return false;
+    }
+};
+
+const DXGI_ERROR_DEVICE_RESET: HRESULT = @bitCast(@as(u32, 0x887A0007));
+
+test "DriverKind maps to D3D driver types" {
+    const testing = std.testing;
+    try testing.expectEqual(d3d11.D3D_DRIVER_TYPE.HARDWARE, DriverKind.hardware.driverType());
+    try testing.expectEqual(d3d11.D3D_DRIVER_TYPE.WARP, DriverKind.warp.driverType());
+}
