diff --git a/src/termio/External.zig b/src/termio/External.zig
new file mode 100644
index 000000000..6aad31818
--- /dev/null
+++ b/src/termio/External.zig
@@ -0,0 +1,324 @@
+//! External implements a termio backend for embedders that own the pty
+//! themselves. Where `Exec` spawns a child and reads its pty, this backend
+//! spawns nothing: the embedder pushes output bytes in with `writePtyOutput`
+//! and receives the terminal's input bytes through a callback.
+//!
+//! This exists because some hosts already have a pty and a process lifecycle
+//! of their own that they cannot give up. Windows Terminal is the motivating
+//! case: its `ITerminalConnection` layer owns ConPTY, and its default-terminal
+//! handoff receives an *already running* ConPTY from conhost, so there is no
+//! child left for us to spawn.
+//!
+//! ## Flow control
+//!
+//! `writePtyOutput` parses on the calling thread and returns when the bytes
+//! have been consumed. That *is* the backpressure: a host that cannot hand
+//! off its next read stops reading its pty, the pty's buffer fills, and the
+//! child blocks on write. It is the same end state `Exec` reaches by blocking
+//! its gather stage when the batch ring is full, reached without a ring,
+//! a second thread, or a copy of every byte.
+//!
+//! The obligation this puts on the embedder is therefore: **do not call
+//! `writePtyOutput` while holding a lock that the terminal's render or io
+//! threads can need.** Blocking the caller is safe; blocking it while holding
+//! something the engine wants is a deadlock.
+const External = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const global = @import("../global.zig");
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+
+const log = std.log.scoped(.io_external);
+
+/// The embedder's side of the pty. All of these are called from the terminal's
+/// threads, never from the thread that calls `writePtyOutput`.
+pub const Handler = struct {
+    ctx: ?*anyopaque,
+    vtable: *const VTable,
+
+    pub const VTable = struct {
+        /// Bytes the terminal wants to send to the child (key encodings,
+        /// paste, terminal report replies). Called on the io thread. The
+        /// slice is only valid for the duration of the call.
+        write: *const fn (ctx: ?*anyopaque, data: []const u8) void,
+
+        /// The terminal's grid was resized. The embedder owns the pty, so it
+        /// owns telling the child. Called on the io thread, and once during
+        /// terminal init before the io thread starts.
+        ///
+        /// The size is passed rather than left for the embedder to compute:
+        /// the embedder's pixel-to-cell arithmetic and ours must agree
+        /// exactly or the child is told a size the terminal is not using.
+        resize: *const fn (
+            ctx: ?*anyopaque,
+            grid_size: renderer.GridSize,
+            screen_size: renderer.ScreenSize,
+        ) void,
+    };
+
+    fn write(self: Handler, data: []const u8) void {
+        self.vtable.write(self.ctx, data);
+    }
+
+    fn resize(
+        self: Handler,
+        grid_size: renderer.GridSize,
+        screen_size: renderer.ScreenSize,
+    ) void {
+        self.vtable.resize(self.ctx, grid_size, screen_size);
+    }
+};
+
+pub const Config = struct {
+    handler: Handler,
+};
+
+/// The embedder's side of the pty.
+handler: Handler,
+
+/// Serializes `writePtyOutput` callers. The embedder is expected to have a
+/// single reader thread, but `ITerminalConnection`-style interfaces do not
+/// promise that, and interleaving two threads' bytes mid-escape-sequence
+/// would corrupt the stream rather than merely reorder it.
+write_mutex: std.Io.Mutex = .init,
+
+pub fn init(_: Allocator, cfg: Config) !External {
+    return .{ .handler = cfg.handler };
+}
+
+pub fn deinit(self: *External) void {
+    _ = self;
+}
+
+/// Call to initialize the terminal state as necessary for this backend.
+/// This is called before any termio begins.
+pub fn initTerminal(self: *External, term: *terminal.Terminal) void {
+    // Tell the embedder the size we start at, the same way Exec sizes its
+    // pty here. Without this the child would run at whatever size the
+    // embedder guessed before the terminal existed.
+    self.resize(.{
+        .columns = term.cols,
+        .rows = term.rows,
+    }, .{
+        .width = term.width_px,
+        .height = term.height_px,
+    }) catch unreachable;
+}
+
+pub fn threadEnter(
+    self: *External,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+
+    // There is nothing to start: no child, and no read thread, because the
+    // embedder's own reader calls writePtyOutput directly.
+    td.backend = .{ .external = .{} };
+}
+
+pub fn threadExit(self: *External, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    _ = td;
+}
+
+pub fn focusGained(
+    self: *External,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+
+    // Exec polls termios here to decide whether the child wants focus
+    // reporting. We have no pty to ask, so focus events are the embedder's
+    // to report if it wants them.
+}
+
+pub fn resize(
+    self: *External,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    self.handler.resize(grid_size, screen_size);
+}
+
+pub fn queueWrite(
+    self: *External,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = alloc;
+    _ = td;
+
+    // Exec chunks into pooled buffers because it hands them to an async
+    // write queue that outlives the call. Our handler writes synchronously,
+    // so the only reason to touch the data at all is the linefeed rewrite.
+    if (!linefeed) {
+        self.handler.write(data);
+        return;
+    }
+
+    var buf: [4096]u8 = undefined;
+    var i: usize = 0;
+    var rest = data;
+    while (rest.len > 0) {
+        const ch = rest[0];
+        rest = rest[1..];
+
+        if (ch != '\r') {
+            buf[i] = ch;
+            i += 1;
+        } else {
+            buf[i] = '\r';
+            buf[i + 1] = '\n';
+            i += 2;
+        }
+
+        // Flush with room to spare for the two bytes a \r can become.
+        if (i >= buf.len - 1) {
+            self.handler.write(buf[0..i]);
+            i = 0;
+        }
+    }
+    if (i > 0) self.handler.write(buf[0..i]);
+}
+
+pub fn childExitedAbnormally(
+    self: *External,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+
+    // Unreachable in practice: this is driven by our own child-exit watcher,
+    // and we have no child. The embedder owns the process lifecycle and
+    // whatever it wants to show when it ends.
+}
+
+pub fn getProcessInfo(self: *External, comptime info: ProcessInfo) ?ProcessInfo.Type(info) {
+    _ = self;
+
+    // The embedder owns the process and the pty, so it is the one that can
+    // answer these. Everything that consumes them treats null as "unknown".
+    return null;
+}
+
+/// Feed pty output into the terminal.
+///
+/// Called from whatever thread the embedder reads its pty on - NOT the io
+/// thread. That is not a special case: `Exec`'s parse stage is a dedicated
+/// thread too, and this takes the same lock it does, for the same duration.
+///
+/// Returns when the bytes have been parsed. See the flow-control note at the
+/// top of this file for what the caller may not be holding when it calls.
+pub fn writePtyOutput(self: *External, io: *termio.Termio, data: []const u8) void {
+    self.write_mutex.lockUncancelable(global.io());
+    defer self.write_mutex.unlock(global.io());
+
+    io.processOutput(data);
+
+    // Hand the renderer state mutex off if the renderer is waiting on it.
+    // Without this a saturated stream keeps re-acquiring it and the surface
+    // stops painting while the flood runs. See renderer.State.lockDemand.
+    io.renderer_state.yieldToDemand(global.io());
+}
+
+/// The thread local data for the external implementation. There is none:
+/// no child to watch, no write queue to drain, no read thread to join.
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
+
+test "queueWrite linefeed rewrites CR to CRLF" {
+    const testing = std.testing;
+
+    const Collect = struct {
+        buf: [64]u8 = undefined,
+        len: usize = 0,
+
+        fn onWrite(ctx: ?*anyopaque, data: []const u8) void {
+            const self: *@This() = @ptrCast(@alignCast(ctx.?));
+            @memcpy(self.buf[self.len..][0..data.len], data);
+            self.len += data.len;
+        }
+
+        fn onResize(_: ?*anyopaque, _: renderer.GridSize, _: renderer.ScreenSize) void {}
+
+        const vtable: Handler.VTable = .{ .write = &onWrite, .resize = &onResize };
+
+        fn items(self: *const @This()) []const u8 {
+            return self.buf[0..self.len];
+        }
+    };
+
+    var collect: Collect = .{};
+
+    var ext: External = try .init(testing.allocator, .{ .handler = .{
+        .ctx = &collect,
+        .vtable = &Collect.vtable,
+    } });
+    defer ext.deinit();
+
+    var td: termio.Termio.ThreadData = undefined;
+    try ext.queueWrite(testing.allocator, &td, "a\rb\r", true);
+    try testing.expectEqualStrings("a\r\nb\r\n", collect.items());
+
+    collect.len = 0;
+    try ext.queueWrite(testing.allocator, &td, "a\rb\r", false);
+    try testing.expectEqualStrings("a\rb\r", collect.items());
+}
+
+test "resize is forwarded to the embedder" {
+    const testing = std.testing;
+
+    const Collect = struct {
+        grid: ?renderer.GridSize = null,
+        screen: ?renderer.ScreenSize = null,
+
+        fn onWrite(_: ?*anyopaque, _: []const u8) void {}
+
+        fn onResize(
+            ctx: ?*anyopaque,
+            grid_size: renderer.GridSize,
+            screen_size: renderer.ScreenSize,
+        ) void {
+            const self: *@This() = @ptrCast(@alignCast(ctx.?));
+            self.grid = grid_size;
+            self.screen = screen_size;
+        }
+
+        const vtable: Handler.VTable = .{ .write = &onWrite, .resize = &onResize };
+    };
+
+    var collect: Collect = .{};
+    var ext: External = try .init(testing.allocator, .{ .handler = .{
+        .ctx = &collect,
+        .vtable = &Collect.vtable,
+    } });
+    defer ext.deinit();
+
+    try ext.resize(.{ .columns = 80, .rows = 24 }, .{ .width = 800, .height = 480 });
+    try testing.expectEqual(@as(u16, 80), collect.grid.?.columns);
+    try testing.expectEqual(@as(u16, 24), collect.grid.?.rows);
+    try testing.expectEqual(@as(u32, 800), collect.screen.?.width);
+}
