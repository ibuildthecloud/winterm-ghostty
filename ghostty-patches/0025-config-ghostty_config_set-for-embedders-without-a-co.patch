From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Darren Shepherd <darren@obot.ai>
Date: Tue, 4 Aug 2026 22:49:07 -0700
Subject: [PATCH] config: ghostty_config_set for embedders without a config
 file

Some embedders hold their configuration in their own settings system and
have no file to point us at. Windows Terminal is the case that motivated
this: a pane's font, colours and scrollback come from a WT profile.

Config.loadEntry runs a single "key = value" through the very same
LineIterator loadFile uses, so quoting, trimming, comments and every
key's own value syntax behave exactly as they do in a config file - none
of it is duplicated, and a key added later needs no new API. The C entry
point is one function rather than a setter per field, for the same
reason.

Two tests: a plain value, and a quoted one containing spaces (a font
family, which is the case that would break a naive implementation).

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012ee27Fih3vSPYsqrUBpUoc
---
 include/ghostty.h     | 12 ++++++++++++
 src/config/CApi.zig   | 22 ++++++++++++++++++++++
 src/config/Config.zig | 43 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 77 insertions(+)

diff --git a/include/ghostty.h b/include/ghostty.h
index 878e88782..6c1315258 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -1148,6 +1148,18 @@ GHOSTTY_API void ghostty_config_load_cli_args(ghostty_config_t);
 GHOSTTY_API void ghostty_config_load_file(ghostty_config_t, const char*);
 GHOSTTY_API void ghostty_config_load_default_files(ghostty_config_t);
 GHOSTTY_API void ghostty_config_load_recursive_files(ghostty_config_t);
+// Apply a single "key = value" entry, using the same syntax a config file
+// uses. Returns false if it could not be applied (the reason is logged).
+//
+// For embedders whose configuration lives in their own settings system, with
+// no file to point ghostty at. Every config key works, and so does every
+// value syntax - including quoting for values containing spaces:
+//
+//     ghostty_config_set(cfg, "font-family = \"JetBrains Mono\"");
+//     ghostty_config_set(cfg, "scrollback-limit = 10000");
+//
+// Call before ghostty_config_finalize().
+GHOSTTY_API bool ghostty_config_set(ghostty_config_t, const char*);
 GHOSTTY_API void ghostty_config_finalize(ghostty_config_t);
 GHOSTTY_API bool ghostty_config_get(ghostty_config_t, void*, const char*, uintptr_t);
 GHOSTTY_API ghostty_input_trigger_s ghostty_config_trigger(ghostty_config_t,
diff --git a/src/config/CApi.zig b/src/config/CApi.zig
index f69f48ea4..cc4fc0592 100644
--- a/src/config/CApi.zig
+++ b/src/config/CApi.zig
@@ -75,6 +75,28 @@ export fn ghostty_config_load_file(self: *Config, path: [*:0]const u8) void {
     };
 }
 
+/// Apply a single `key = value` entry, using the same syntax a config file
+/// uses. Returns false if the entry could not be applied; the reason is
+/// logged.
+///
+/// For embedders whose configuration lives in their own settings system and
+/// who therefore have no file to point us at. Because it goes through the
+/// config-file parser, every key works and every value syntax works, including
+/// quoting for values with spaces:
+///
+///     ghostty_config_set(cfg, "font-family = \"JetBrains Mono\"");
+///     ghostty_config_set(cfg, "scrollback-limit = 10000");
+///
+/// Call before ghostty_config_finalize, as with any other load.
+export fn ghostty_config_set(self: *Config, entry: [*:0]const u8) bool {
+    const entry_slice = std.mem.span(entry);
+    self.loadEntry(global.alloc(), entry_slice) catch |err| {
+        log.err("error applying config entry entry={s} err={}", .{ entry_slice, err });
+        return false;
+    };
+    return true;
+}
+
 /// Load the configuration from the user-specified configuration
 /// file locations in the previously loaded configuration. This will
 /// recursively continue to load up to a built-in limit.
diff --git a/src/config/Config.zig b/src/config/Config.zig
index 9b5982229..4cebe7f45 100644
--- a/src/config/Config.zig
+++ b/src/config/Config.zig
@@ -3957,6 +3957,49 @@ pub fn loadIter(
     try cli.args.parse(Config, alloc, self, iter);
 }
 
+/// Apply a single configuration entry, in the same `key = value` syntax a
+/// config file uses.
+///
+/// This exists for embedders that hold their configuration somewhere else
+/// entirely - a host application's own settings system - and need to push
+/// values in rather than point ghostty at a file. Windows Terminal is the
+/// motivating case: a pane's font, colours and scrollback come from a WT
+/// profile, and there is no file to hand over.
+///
+/// It runs the entry through the very same LineIterator that `loadFile` uses,
+/// so quoting, trimming, comments and every key's own value syntax behave
+/// identically to a config file - none of it is duplicated here, and a key
+/// added later needs no new API.
+pub fn loadEntry(self: *Config, alloc: Allocator, entry: []const u8) !void {
+    var reader: std.Io.Reader = .fixed(entry);
+    var iter: cli.args.LineIterator = .{ .r = &reader, .filepath = "(embedder)" };
+    try self.loadIter(alloc, &iter);
+}
+
+test "loadEntry sets a value" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var cfg: Config = try .default(alloc);
+    defer cfg.deinit();
+
+    try cfg.loadEntry(alloc, "scrollback-limit-lines = 12345");
+    try testing.expectEqual(@as(usize, 12345), cfg.@"scrollback-limit-lines".value);
+}
+
+test "loadEntry honours config-file quoting" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var cfg: Config = try .default(alloc);
+    defer cfg.deinit();
+
+    // The quotes are the file syntax, not part of the value - a font whose
+    // name contains spaces is the case that proves it.
+    try cfg.loadEntry(alloc, "font-family = \"JetBrains Mono\"");
+    try testing.expectEqualStrings("JetBrains Mono", cfg.@"font-family".list.items[0]);
+}
+
 /// Load configuration from the target config file at `path`.
 ///
 /// `path` must be resolved and absolute.
