From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Claude (agent session)" <darren@obot.ai>
Date: Fri, 31 Jul 2026 16:15:32 -0700
Subject: [PATCH] windows: accept a WTF-16 command line via ghostty_init_w

Implements the prescription in the TODO at the error.UnsupportedOSForCApi
site in global.zig: let the C API take a UNICODE_STRING-style []u16 so it
can be handed to std.process.Args directly.

std.process.Args.Vector is `[]const u16` on Windows - a single WTF-16
command-line string, not an argv array - so (argc, argv) has no faithful
Windows interpretation. Rather than inventing one (splitting, or converting
UTF-8 argv back to UTF-16 and re-joining, both of which would corrupt
unpaired surrogates), add an entry point shaped like what the platform
actually wants.

  ghostty_init_w(uintptr_t len, const uint16_t *cmdline)

`cmdline` is the whole command line including argv[0], exactly as
GetCommandLineW() returns it, because that is what Zig's Windows argument
iterator parses. `len` is in UTF-16 code units, not bytes, and the buffer
need not be NUL-terminated - a UNICODE_STRING has an explicit length and may
legitimately contain no terminator. It only has to outlive the call.

Additive, as required:
  - ghostty_init keeps its exact signature on every platform. On Windows it
    now fails with a log line naming ghostty_init_w instead of returning
    error.UnsupportedOSForCApi from deep inside global.init.
  - ghostty_init_w is exported on Windows only and declared under #ifdef
    _WIN32. A WTF-16 command line is meaningless where Args.Vector is an
    argv array, so exporting a stub that could only ever fail would be API
    noise rather than portability.

InitOpts.c now carries a ready-made Args.Vector instead of (argc, argv).
That moves the platform split to main_c.zig, where the C signatures already
differ, and lets global.init drop its Windows special case entirely - the
error.UnsupportedOSForCApi path no longer exists. The environment block
computation is shared by both entry points as cEnviron().

zig build -Dapp-runtime=none -> ok
zig build test                -> 3061 passed, 55 skipped, 0 failed

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 include/ghostty.h | 11 +++++++
 src/global.zig    | 21 ++++++-------
 src/main_c.zig    | 79 +++++++++++++++++++++++++++++++++++++++--------
 3 files changed, 86 insertions(+), 25 deletions(-)

diff --git a/include/ghostty.h b/include/ghostty.h
index 72bbb57a8..dd52cc01f 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -1062,6 +1062,17 @@ typedef enum {
 // Published API
 
 GHOSTTY_API int ghostty_init(uintptr_t, char**);
+
+#ifdef _WIN32
+// Windows variant of ghostty_init. Zig's std.process.Args on Windows is a
+// single WTF-16 command-line string rather than an argv array, so pass the
+// command line as returned by GetCommandLineW() (including argv[0]) and its
+// length in UTF-16 code units, not bytes. The buffer need not be
+// NUL-terminated and only has to outlive the call.
+//
+// ghostty_init itself always fails on Windows.
+GHOSTTY_API int ghostty_init_w(uintptr_t, const uint16_t*);
+#endif
 GHOSTTY_API void ghostty_cli_try_action(void);
 GHOSTTY_API ghostty_info_s ghostty_info(void);
 GHOSTTY_API const char* ghostty_translate(const char*);
diff --git a/src/global.zig b/src/global.zig
index 3c2ddbb72..edb4da8c7 100644
--- a/src/global.zig
+++ b/src/global.zig
@@ -44,8 +44,14 @@ pub const InitOpts = union(enum) {
     tool: std.process.Init.Minimal,
 
     c: struct {
-        argc: usize,
-        argv: [*][*:0]u8,
+        /// Command-line arguments already in the shape `std.process.Args`
+        /// wants for this target: on Windows a single WTF-16 command-line
+        /// string, elsewhere a vector of NUL-terminated argv pointers.
+        ///
+        /// The C entry points in `main_c.zig` are responsible for building
+        /// this, because the two shapes need different C signatures
+        /// (`ghostty_init` vs `ghostty_init_w`).
+        args: std.process.Args.Vector,
         environ: std.process.Environ,
     },
 };
@@ -65,16 +71,7 @@ pub fn init(opts: InitOpts) !void {
         },
         .args = switch (opts) {
             .main, .tool => |m| m.args,
-            // TODO: Using the C API from Windows is unsupported at this time.
-            //
-            // When do we plan on supporting Windows, it's recommended to
-            // ensure that the C API can take a UNICODE_STRING (aka []16, a
-            // WTF-16 string) so that it can just be passed into
-            // std.process.Args.Vector directly.
-            .c => |c| .{ .vector = if (builtin.os.tag == .windows)
-                return error.UnsupportedOSForCApi
-            else
-                c.argv[0..c.argc] },
+            .c => |c| .{ .vector = c.args },
         },
         .tmp_dir_path = null,
         .action = null,
diff --git a/src/main_c.zig b/src/main_c.zig
index 3e331e022..0125676d1 100644
--- a/src/main_c.zig
+++ b/src/main_c.zig
@@ -107,24 +107,68 @@ pub const String = extern struct {
 };
 
 /// Initialize ghostty global state.
+/// The environment block for the C entry points. Identical for every C init
+/// variant, so it lives here rather than being duplicated per entry point.
+fn cEnviron() std.process.Environ {
+    if (comptime std.process.Environ.Block == std.process.Environ.PosixBlock) {
+        // Asserting libc means that we can fast-path all POSIX blocks
+        return .{ .block = .{ .slice = std.c.environ[0..env_len: {
+            var len: usize = 0;
+            while (std.c.environ[len]) |_| : (len += 1) {}
+            break :env_len len;
+        } :null] } };
+    } else {
+        // Anything that is not using PosixBlock is a global block for
+        // purposes of initialization.
+        return .{ .block = .{ .use_global = true } };
+    }
+}
+
 pub export fn ghostty_init(argc: usize, argv: [*][*:0]u8) c_int {
     assert(builtin.link_libc);
 
+    if (comptime builtin.os.tag == .windows) {
+        // `std.process.Args.Vector` is a single WTF-16 command-line string on
+        // Windows, not an argv array, so there is nothing meaningful we can do
+        // with (argc, argv) here. Windows embedders call `ghostty_init_w`.
+        std.log.err("ghostty_init is not supported on Windows; use ghostty_init_w", .{});
+        return 1;
+    } else {
+        global.init(.{
+            .c = .{
+                .args = argv[0..argc],
+                .environ = cEnviron(),
+            },
+        }) catch |err| {
+            std.log.err("failed to initialize ghostty error={}", .{err});
+            return 1;
+        };
+
+        return 0;
+    }
+}
+
+/// Windows variant of `ghostty_init` taking a WTF-16 command line, which is
+/// what `std.process.Args.Vector` is on this target. This is the shape
+/// upstream's own TODO at the `error.UnsupportedOSForCApi` site asked for: a
+/// UNICODE_STRING-style `[]u16` that can be handed to `std.process.Args`
+/// directly.
+///
+/// `cmdline` is the full command line *including* argv[0], exactly as
+/// `GetCommandLineW()` returns it, because that is what Zig's Windows argument
+/// iterator expects to parse. It is not required to be NUL-terminated; `len` is
+/// in UTF-16 code units, not bytes.
+///
+/// The pointer only needs to stay valid for the duration of the call.
+///
+/// Additive: `ghostty_init` keeps its signature on every platform.
+fn ghostty_init_w(len: usize, cmdline: [*]const u16) callconv(.c) c_int {
+    assert(builtin.link_libc);
+
     global.init(.{
         .c = .{
-            .argc = argc,
-            .argv = argv,
-            .environ = if (std.process.Environ.Block == std.process.Environ.PosixBlock)
-                // Asserting libc means that we can fast-path all POSIX blocks
-                .{ .block = .{ .slice = std.c.environ[0..env_len: {
-                    var len: usize = 0;
-                    while (std.c.environ[len]) |_| : (len += 1) {}
-                    break :env_len len;
-                } :null] } }
-            else
-                // Anything that is not using PosixBlock is a global block for
-                // purposes of initialization.
-                .{ .block = .{ .use_global = true } },
+            .args = cmdline[0..len],
+            .environ = cEnviron(),
         },
     }) catch |err| {
         std.log.err("failed to initialize ghostty error={}", .{err});
@@ -134,6 +178,15 @@ pub export fn ghostty_init(argc: usize, argv: [*][*:0]u8) c_int {
     return 0;
 }
 
+comptime {
+    // Windows-only: the WTF-16 command line has no meaning on targets whose
+    // `Args.Vector` is an argv array, so we do not export a stub that could
+    // only ever fail.
+    if (builtin.os.tag == .windows) {
+        @export(&ghostty_init_w, .{ .name = "ghostty_init_w" });
+    }
+}
+
 /// Runs an action if it is specified. If there is no action this returns
 /// false. If there is an action then this doesn't return.
 pub export fn ghostty_cli_try_action() void {
