diff --git a/src/font/sprite/Face.zig b/src/font/sprite/Face.zig
index e2e37d2af..533f2f227 100644
--- a/src/font/sprite/Face.zig
+++ b/src/font/sprite/Face.zig
@@ -567,6 +567,47 @@ test "sprite face render all sprites" {
     try std.testing.expect(!diff); // There should be no diffs from reference.
 }
 
+// The two shapes Windows Terminal has and DECSCUSR does not. Both are drawn
+// against the cell rather than being full-height cursors, so they are checked
+// for what makes them different from `cursor_underline` - that they are inside
+// the cell, and that the thick one really is thick.
+test "underline cursor sprites" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var atlas: font.Atlas = try .init(alloc, 128, .grayscale);
+    defer atlas.deinit(alloc);
+
+    // face with an 8x16 cell dimension.
+    var face: Face = .{
+        .metrics = .calc(.{
+            .px_per_em = 16,
+            .cell_width = 8.0,
+            .ascent = 12.0,
+            .descent = -4.0,
+            .line_gap = 0.0,
+        }),
+    };
+    try testing.expectEqual(16, face.metrics.cell_height);
+
+    const single = try face.renderGlyph(alloc, &atlas, @intFromEnum(Sprite.cursor_underline), .{ .grid_metrics = face.metrics });
+    const double = try face.renderGlyph(alloc, &atlas, @intFromEnum(Sprite.cursor_underline_double), .{ .grid_metrics = face.metrics });
+    const thick = try face.renderGlyph(alloc, &atlas, @intFromEnum(Sprite.cursor_underline_thick), .{ .grid_metrics = face.metrics });
+
+    // All three span the cell horizontally - none of them is a bar.
+    try testing.expectEqual(single.width, double.width);
+    try testing.expectEqual(single.width, thick.width);
+
+    // The double is taller than the single: it is two bands and a gap, not one
+    // band. Without this the sprite could quietly be a single underline.
+    try testing.expect(double.height > single.height);
+
+    // A quarter of a 16px cell, and thicker than the single underline - that
+    // difference is the whole point of the shape.
+    try testing.expectEqual(4, thick.height);
+    try testing.expect(thick.height > single.height);
+}
+
 test "full height cursor sprites respect cursor height metric" {
     const testing = std.testing;
     const alloc = testing.allocator;
diff --git a/src/font/sprite/draw/special.zig b/src/font/sprite/draw/special.zig
index 8cad9ceba..2268ec33b 100644
--- a/src/font/sprite/draw/special.zig
+++ b/src/font/sprite/draw/special.zig
@@ -370,3 +370,65 @@ pub fn cursor_underline(
         .height = @intCast(metrics.cursor_thickness),
     }, .on);
 }
+
+pub fn cursor_underline_double(
+    cp: u32,
+    canvas: *font.sprite.Canvas,
+    width: u32,
+    height: u32,
+    metrics: font.Metrics,
+) !void {
+    _ = cp;
+
+    // Two lines with a gap of one thickness between them, placed so the pair
+    // straddles where the single underline would sit - the same arrangement
+    // `underline_double` uses for text, so a double-underline cursor and a
+    // double-underlined character line up.
+    //
+    // The clamp leaves room for all three bands rather than one, which is why
+    // it subtracts three thicknesses and not one.
+    const t = metrics.cursor_thickness;
+    const y = @min(
+        metrics.underline_position,
+        height +| canvas.padding_y -| 3 * t,
+    );
+
+    canvas.rect(.{
+        .x = 0,
+        .y = @intCast(y -| t),
+        .width = @intCast(width),
+        .height = @intCast(t),
+    }, .on);
+    canvas.rect(.{
+        .x = 0,
+        .y = @intCast(y +| t),
+        .width = @intCast(width),
+        .height = @intCast(t),
+    }, .on);
+}
+
+pub fn cursor_underline_thick(
+    cp: u32,
+    canvas: *font.sprite.Canvas,
+    width: u32,
+    height: u32,
+    metrics: font.Metrics,
+) !void {
+    _ = cp;
+
+    // The bottom quarter of the cell, filled. This is the shape the Windows
+    // console has drawn for decades, and a quarter is what Windows Terminal
+    // still defaults its own `cursorHeight` to.
+    //
+    // Measured from the bottom of the *cell* rather than from the underline
+    // position: this one is a short block, not a thick line, and hanging it
+    // off the underline would put it somewhere different in every font.
+    const thickness = @max(metrics.cursor_thickness, height / 4);
+
+    canvas.rect(.{
+        .x = 0,
+        .y = @intCast(height -| thickness),
+        .width = @intCast(width),
+        .height = @intCast(thickness),
+    }, .on);
+}
