From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Claude (agent session)" <darren@obot.ai>
Date: Sat, 1 Aug 2026 20:11:38 -0700
Subject: [PATCH] renderer/d3d11: regression test for cell background grid
 alignment

Renders two rows of differently coloured cells offscreen and asserts every
pixel row of each cell carries its own colour, so the boundary must land
exactly on a cell edge. Nothing else in the suite checks WHERE a cell lands -
the font tests assert ink and colour within a glyph's own box - so this covers
a class of geometry bug that is highly visible to a user and invisible to
everything else.

Factors the offscreen scaffolding out of the bg_color test into OffscreenTest:
WARP device, render target, viewport, constant buffer, structured buffer with
its SRV, and a staging readback. Runs headless, so it works in CI and over a
detached RDP session.

It passes today, and that is the useful result: it rules out cell backgrounds
as the cause of the misrendering reported live (a block cursor sitting too high
and top's reverse-video header looking wrong). I had claimed the backgrounds
were ~12px off-grid, measured from a capture - that was wrong. The grid origin
sits below the window title bar, so rows fall at 33, 54, 75 ... 159, and the
header bar at 159-179 is exactly one 21px cell. I had assumed rows began at
y=42, which is only where ink starts inside a row.

size.zig's blankPadding is also ruled out: it returns top=0 and left=0, putting
leftover space at bottom/right only, so grid_padding agrees with the
projection's origin on the axes that matter.

That leaves glyph placement WITHIN the cell as the remaining hypothesis, which
would explain both symptoms at once. Tracked separately.

  default: 3085 pass, 58 skip, 0 fail

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 src/renderer/directx11/shaders.zig | 275 +++++++++++++++++++++++++++++
 1 file changed, 275 insertions(+)

diff --git a/src/renderer/directx11/shaders.zig b/src/renderer/directx11/shaders.zig
index fa6ecf5eb..07b215077 100644
--- a/src/renderer/directx11/shaders.zig
+++ b/src/renderer/directx11/shaders.zig
@@ -325,6 +325,281 @@ test {
     _ = BgImage;
 }
 
+/// Minimal offscreen D3D11 setup for the pixel tests below.
+const OffscreenTest = struct {
+    device: *d3d11.ID3D11Device,
+    context: *d3d11.ID3D11DeviceContext,
+    rt: *d3d11.ID3D11Texture2D,
+    rtv: *d3d11.ID3D11RenderTargetView,
+    w: u32,
+    h: u32,
+
+    fn init(w: u32, h: u32) !OffscreenTest {
+        var device_o: ?*d3d11.ID3D11Device = null;
+        var context_o: ?*d3d11.ID3D11DeviceContext = null;
+        const levels = [_]d3d11.D3D_FEATURE_LEVEL{ .@"11_1", .@"11_0" };
+        // WARP so this runs on a CI machine with no GPU.
+        if (com.FAILED(d3d11.D3D11CreateDevice(
+            null,
+            .WARP,
+            null,
+            0,
+            &levels,
+            levels.len,
+            d3d11.D3D11_SDK_VERSION,
+            &device_o,
+            null,
+            &context_o,
+        )) or device_o == null or context_o == null) return error.SkipZigTest;
+        errdefer _ = device_o.?.Release();
+        errdefer _ = context_o.?.Release();
+
+        const desc: d3d11.D3D11_TEXTURE2D_DESC = .{
+            .Width = w,
+            .Height = h,
+            .MipLevels = 1,
+            .ArraySize = 1,
+            .Format = .B8G8R8A8_UNORM,
+            .SampleDesc = .{ .Count = 1, .Quality = 0 },
+            .Usage = .DEFAULT,
+            .BindFlags = d3d11.D3D11_BIND_RENDER_TARGET,
+            .CPUAccessFlags = 0,
+            .MiscFlags = 0,
+        };
+        var rt_o: ?*d3d11.ID3D11Texture2D = null;
+        if (com.FAILED(device_o.?.CreateTexture2D(&desc, null, &rt_o)) or rt_o == null) {
+            return error.SkipZigTest;
+        }
+        errdefer _ = rt_o.?.Release();
+
+        var rtv_o: ?*d3d11.ID3D11RenderTargetView = null;
+        if (com.FAILED(device_o.?.CreateRenderTargetView(@ptrCast(rt_o.?), null, &rtv_o)) or
+            rtv_o == null) return error.SkipZigTest;
+
+        return .{
+            .device = device_o.?,
+            .context = context_o.?,
+            .rt = rt_o.?,
+            .rtv = rtv_o.?,
+            .w = w,
+            .h = h,
+        };
+    }
+
+    fn deinit(self: *OffscreenTest) void {
+        _ = self.rtv.Release();
+        _ = self.rt.Release();
+        _ = self.context.Release();
+        _ = self.device.Release();
+    }
+
+    /// Bind the target, clear it, and set a full-surface viewport.
+    fn beginFrame(self: *OffscreenTest) void {
+        const rtvs = [_]?*d3d11.ID3D11RenderTargetView{self.rtv};
+        self.context.OMSetRenderTargets(&rtvs, null);
+        const clear = [4]f32{ 0, 0, 0, 0 };
+        self.context.ClearRenderTargetView(self.rtv, &clear);
+        const viewport: d3d11.D3D11_VIEWPORT = .{
+            .TopLeftX = 0,
+            .TopLeftY = 0,
+            .Width = @floatFromInt(self.w),
+            .Height = @floatFromInt(self.h),
+            .MinDepth = 0,
+            .MaxDepth = 1,
+        };
+        self.context.RSSetViewports(&.{viewport});
+    }
+
+    fn constantBuffer(self: *OffscreenTest, uniforms: *const Uniforms) !*d3d11.ID3D11Buffer {
+        const desc: d3d11.D3D11_BUFFER_DESC = .{
+            .ByteWidth = @intCast(std.mem.alignForward(usize, @sizeOf(Uniforms), 16)),
+            .Usage = .DEFAULT,
+            .BindFlags = d3d11.D3D11_BIND_CONSTANT_BUFFER,
+            .CPUAccessFlags = 0,
+            .MiscFlags = 0,
+            .StructureByteStride = 0,
+        };
+        const data: d3d11.D3D11_SUBRESOURCE_DATA = .{
+            .pSysMem = uniforms,
+            .SysMemPitch = 0,
+            .SysMemSlicePitch = 0,
+        };
+        var buf: ?*d3d11.ID3D11Buffer = null;
+        if (com.FAILED(self.device.CreateBuffer(&desc, &data, &buf)) or buf == null) {
+            return error.SkipZigTest;
+        }
+        return buf.?;
+    }
+
+    /// A `StructuredBuffer<uint>` plus its SRV, for the cell background colors.
+    fn structuredU32(
+        self: *OffscreenTest,
+        values: []const u32,
+        srv_out: **d3d11.ID3D11ShaderResourceView,
+    ) !*d3d11.ID3D11Buffer {
+        const desc: d3d11.D3D11_BUFFER_DESC = .{
+            .ByteWidth = @intCast(values.len * @sizeOf(u32)),
+            .Usage = .DEFAULT,
+            .BindFlags = d3d11.D3D11_BIND_SHADER_RESOURCE,
+            .CPUAccessFlags = 0,
+            .MiscFlags = d3d11.D3D11_RESOURCE_MISC_BUFFER_STRUCTURED,
+            .StructureByteStride = @sizeOf(u32),
+        };
+        const data: d3d11.D3D11_SUBRESOURCE_DATA = .{
+            .pSysMem = values.ptr,
+            .SysMemPitch = 0,
+            .SysMemSlicePitch = 0,
+        };
+        var buf: ?*d3d11.ID3D11Buffer = null;
+        if (com.FAILED(self.device.CreateBuffer(&desc, &data, &buf)) or buf == null) {
+            return error.SkipZigTest;
+        }
+        errdefer _ = buf.?.Release();
+
+        const srv_desc: d3d11.D3D11_SHADER_RESOURCE_VIEW_DESC = .{
+            .Format = .UNKNOWN,
+            .ViewDimension = .BUFFER,
+            .u = .{ .Buffer = .{ .FirstElement = 0, .NumElements = @intCast(values.len) } },
+        };
+        var srv: ?*d3d11.ID3D11ShaderResourceView = null;
+        if (com.FAILED(self.device.CreateShaderResourceView(
+            @ptrCast(buf.?),
+            &srv_desc,
+            &srv,
+        )) or srv == null) return error.SkipZigTest;
+        srv_out.* = srv.?;
+        return buf.?;
+    }
+
+    /// Copy the target to a staging texture and hand back the mapped pixels.
+    /// Caller must call `endReadback`.
+    fn readback(self: *OffscreenTest, stage_out: **d3d11.ID3D11Texture2D) ![]const u8 {
+        const desc: d3d11.D3D11_TEXTURE2D_DESC = .{
+            .Width = self.w,
+            .Height = self.h,
+            .MipLevels = 1,
+            .ArraySize = 1,
+            .Format = .B8G8R8A8_UNORM,
+            .SampleDesc = .{ .Count = 1, .Quality = 0 },
+            .Usage = .STAGING,
+            .BindFlags = 0,
+            .CPUAccessFlags = d3d11.D3D11_CPU_ACCESS_READ,
+            .MiscFlags = 0,
+        };
+        var stage_o: ?*d3d11.ID3D11Texture2D = null;
+        if (com.FAILED(self.device.CreateTexture2D(&desc, null, &stage_o)) or stage_o == null) {
+            return error.SkipZigTest;
+        }
+        errdefer _ = stage_o.?.Release();
+        self.context.CopyResource(@ptrCast(stage_o.?), @ptrCast(self.rt));
+
+        var mapped: d3d11.D3D11_MAPPED_SUBRESOURCE = undefined;
+        if (com.FAILED(self.context.Map(@ptrCast(stage_o.?), 0, .READ, 0, &mapped))) {
+            return error.SkipZigTest;
+        }
+        stage_out.* = stage_o.?;
+        const ptr: [*]const u8 = @ptrCast(mapped.pData);
+        return ptr[0 .. mapped.RowPitch * self.h];
+    }
+
+    fn endReadback(self: *OffscreenTest, stage: *d3d11.ID3D11Texture2D) void {
+        self.context.Unmap(@ptrCast(stage), 0);
+        _ = stage.Release();
+    }
+};
+
+test "offscreen: cell backgrounds land on the cell grid" {
+    // Regression test for cell backgrounds being vertically misaligned with
+    // the glyph grid, which showed up as a reverse-video bar (top's column
+    // header) sitting off-grid and as the block cursor appearing too high.
+    //
+    // Two rows of cells with different colors: the boundary between them must
+    // fall exactly on a cell edge. Nothing else in the suite checks WHERE a
+    // cell lands - the font tests only assert ink within a glyph's own box -
+    // so this covers a whole class of geometry bug that is highly visible to a
+    // user and invisible to everything else.
+    const testing = std.testing;
+
+    const cell_w: u32 = 8;
+    const cell_h: u32 = 16;
+    const cols: u32 = 2;
+    const rows: u32 = 2;
+
+    var t = OffscreenTest.init(cell_w * cols, cell_h * rows) catch return error.SkipZigTest;
+    defer t.deinit();
+
+    var shaders = try Shaders.init(testing.allocator, t.device, &.{});
+    defer shaders.deinit(testing.allocator);
+
+    var uniforms: Uniforms = std.mem.zeroes(Uniforms);
+    uniforms.projection_matrix = math.ortho2d(
+        0,
+        @floatFromInt(t.w),
+        @floatFromInt(t.h),
+        0,
+    );
+    uniforms.screen_size = .{ @floatFromInt(t.w), @floatFromInt(t.h) };
+    uniforms.cell_size = .{ @floatFromInt(cell_w), @floatFromInt(cell_h) };
+    uniforms.grid_size = .{ @intCast(cols), @intCast(rows) };
+    uniforms.grid_padding = .{ 0, 0, 0, 0 };
+    uniforms.bools.use_linear_blending = false;
+
+    const cb = try t.constantBuffer(&uniforms);
+    defer _ = cb.Release();
+
+    // Row 0 red, row 1 blue, both opaque. Packed R,G,B,A little-endian.
+    const red: u32 = 0xFF0000FF;
+    const blue: u32 = 0xFFFF0000;
+    const cells = [_]u32{ red, red, blue, blue };
+    var srv: *d3d11.ID3D11ShaderResourceView = undefined;
+    const cells_buf = try t.structuredU32(&cells, &srv);
+    defer _ = cells_buf.Release();
+    defer _ = srv.Release();
+
+    t.beginFrame();
+    const cbs = [_]?*d3d11.ID3D11Buffer{cb};
+    t.context.VSSetConstantBuffers(0, &cbs);
+    t.context.PSSetConstantBuffers(0, &cbs);
+    // cell_bg reads its colors from t1.
+    const srvs = [_]?*d3d11.ID3D11ShaderResourceView{ null, srv, null, null };
+    t.context.VSSetShaderResources(0, &srvs);
+    t.context.PSSetShaderResources(0, &srvs);
+    t.context.VSSetShader(shaders.pipelines.cell_bg.vs.?);
+    t.context.PSSetShader(shaders.pipelines.cell_bg.ps.?);
+    t.context.IASetPrimitiveTopology(.TRIANGLELIST);
+    t.context.OMSetBlendState(shaders.pipelines.cell_bg.blend);
+    t.context.Draw(3, 0);
+
+    var stage: *d3d11.ID3D11Texture2D = undefined;
+    const pixels = try t.readback(&stage);
+    defer t.endReadback(stage);
+
+    const pitch = pixels.len / t.h;
+
+    const x: usize = cell_w / 2;
+    // B8G8R8A8 on the way out.
+    const want_red = [3]u8{ 0x00, 0x00, 0xFF }; // B, G, R
+    const want_blue = [3]u8{ 0xFF, 0x00, 0x00 };
+
+    // Every row of cell 0 must be red and every row of cell 1 blue. Checking
+    // the rows either side of the boundary is the part that fails when the
+    // background rect is offset from the grid.
+    for (0..cell_h) |y| {
+        const px = pixels[y * pitch + x * 4 ..][0..3];
+        testing.expectEqualSlices(u8, &want_red, px) catch |err| {
+            std.debug.print("row {d} of cell 0 is not the row-0 color\n", .{y});
+            return err;
+        };
+    }
+    for (cell_h..cell_h * 2) |y| {
+        const px = pixels[y * pitch + x * 4 ..][0..3];
+        testing.expectEqualSlices(u8, &want_blue, px) catch |err| {
+            std.debug.print("row {d} of cell 1 is not the row-1 color\n", .{y});
+            return err;
+        };
+    }
+}
+
 test "offscreen: bg_color renders the configured background" {
     // Renders one frame into an offscreen texture and reads the pixels back.
     //
