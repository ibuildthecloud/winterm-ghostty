-    if (lost) return error.DeviceLost;
+    frames_presented +|= 1;
+    const simulated = simulate_loss_after > 0 and
+        frames_presented == simulate_loss_after;
+    if (simulated) log.warn("simulating device loss (frame {d})", .{frames_presented});
+
+    if (self.device.present(true) or simulated) {
+        // Step 3 of ADR 0002's degradation ladder. Rebuild in place, then tell
+        // the embedder its handle is stale - in composition mode the new swap
+        // chain has a new DirectComposition surface, and a XAML panel still
+        // bound to the old one would show a frozen last frame rather than
+        // anything obviously broken.
+        self.device.recreate(forced_driver) catch |err| {
+            log.err("failed to rebuild device after loss: {}", .{err});
+            return error.DeviceLost;
+        };
+
+        // The old target came from the dead device and cannot be presented.
+        // GenericRenderer rebuilds targets when it next sees a size change or
+        // is asked to redraw; dropping it here just avoids reusing dead memory.
+        self.last_target = null;
+        self.notifySwapChainChanged();
+        return;
+    }
 
     self.last_target = target;
 }
 
+/// Tell the embedder the swap chain handle it holds is stale.
+///
+/// Only meaningful in composition mode - an hwnd swap chain is bound to the
+/// window, not to a handle the embedder passes around, so there is nothing for
+/// it to re-attach.
+///
+/// This goes through the surface mailbox rather than dispatching the apprt
+/// action directly, because we are on the renderer thread and action delivery
+/// belongs to the app thread.
+fn notifySwapChainChanged(self: *D3D11) void {
+    if (self.device.target != .composition) return;
+
+    _ = self.surface_mailbox.push(
+        .{ .swap_chain_changed = {} },
+        .{ .forever = {} },
+    );
+}
+
 /// Present the last presented target again.
