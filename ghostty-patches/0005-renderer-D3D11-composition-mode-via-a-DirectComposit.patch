+/// Read the device-loss simulation setting once at startup.
+fn readSimulateLoss() void {
+    const value = global.environ().getWindows(
+        utf16("GHOSTTY_D3D11_SIMULATE_DEVICE_LOSS"),
+    ) orelse return;
+
+    // Small ASCII decimal only; anything else is ignored rather than guessed at.
+    var n: u32 = 0;
+    for (value) |c| {
+        if (c < '0' or c > '9') return;
+        n = n *| 10 +| @as(u32, @intCast(c - '0'));
+    }
+    if (n == 0) return;
+
+    simulate_loss_after = n;
+    log.info("will simulate device loss after {d} frames", .{n});
+}
