+    /// Rebuild after the device was lost (TDR, driver update, GPU reset).
+    ///
+    /// Everything created from the old device is dead, so this constructs a
+    /// whole new `Device` in place, preserving the presentation target and
+    /// size. In composition mode that yields a **new** surface handle, which is
+    /// why the embedder has to be told - see the `swap_chain_changed` action.
+    ///
+    /// Deliberately re-walks the full driver ladder rather than pinning the
+    /// previous rasterizer: a device can be lost precisely because the hardware
+    /// went away (an eGPU unplugged, a driver uninstalled), and in that case
+    /// falling to WARP is the correct outcome rather than failing repeatedly.
+    pub fn recreate(self: *Device, force_driver: ?DriverKind) Error!void {
+        const target = self.target;
+        const width = self.width;
+        const height = self.height;
+
+        log.info("rebuilding device after loss ({d}x{d})", .{ width, height });
+        self.deinit();
+
+        self.* = try Device.init(target, width, height, force_driver);
+        log.info("device rebuilt: driver={t}", .{self.driver});
+    }
+
+    /// Re-sync the swap chain to a size the embedder supplied.
+    ///
