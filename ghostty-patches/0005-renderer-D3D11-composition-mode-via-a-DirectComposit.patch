+//! DirectComposition surface handles.
+//!
+//! Harvested from deblasis/wintty (MIT). wintty's copy lives under its D3D12
+//! renderer, but nothing here is D3D-version specific - the handle is a
+//! composition primitive, and the swap-chain creator that consumes it takes an
+//! `IUnknown*`.
+//!
+//! This is the primitive the whole Windows Terminal integration rests on. A
+//! swap chain created against one of these handles (via
+//! `IDXGIFactoryMedia.CreateSwapChainForCompositionSurfaceHandle`) can be bound
+//! to a XAML `SwapChainPanel` with `ISwapChainPanelNative2::SetSwapChainHandle`
+//! - which is exactly what WT already does in
+//! `TermControl::_AttachDxgiSwapChainToXaml`.
+//!
+//! The indirection matters: **the panel references the handle, not the swap
+//! chain object.** So a resize (`ResizeBuffers`) leaves the binding intact and
+//! the embedder does not need to re-attach. Only losing the device forces a new
+//! handle, because the new swap chain must be created against a new one.
+//!
+//! Note we deliberately do *not* create a DirectComposition device. XAML owns
+//! the composition tree; we only supply the surface it points at.
+
+const std = @import("std");
+
+const com = @import("com.zig");
+
+const HRESULT = com.HRESULT;
+const HANDLE = std.os.windows.HANDLE;
+
+/// Access mask for `DCompositionCreateSurfaceHandle`. This value is not
+/// exposed by any public header; DirectComposition's own samples and Windows
+/// Terminal both use it to request full access to the surface handle.
+pub const COMPOSITIONOBJECT_ALL_ACCESS: u32 = 0x0003;
+
+/// Create a standalone DirectComposition surface handle.
+///
+/// The caller owns the returned handle and must `CloseHandle` it. Note that an
+/// embedder binding it into XAML will typically `DuplicateHandle` first - WT
+/// does exactly that in `ControlCore::_renderEngineSwapChainChanged` - so
+/// closing ours does not pull the surface out from under the panel.
+pub extern "dcomp" fn DCompositionCreateSurfaceHandle(
+    desiredAccess: u32,
+    securityAttributes: ?*anyopaque,
+    surfaceHandle: *HANDLE,
+) callconv(.winapi) HRESULT;
