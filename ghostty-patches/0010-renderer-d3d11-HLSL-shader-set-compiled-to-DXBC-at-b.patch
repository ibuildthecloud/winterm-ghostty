+// Fills the whole surface with the terminal background color.
+// Ported from `glsl/bg_color.f.glsl`.
+#include "common.hlsli"
+
+FullScreenOut vs_main(uint vid : SV_VertexID) {
+    return full_screen_vs(vid);
+}
+
+float4 ps_main(FullScreenOut input) : SV_Target {
+    return load_color(
+        unpack4u8(bg_color_packed),
+        get_bool(BOOL_USE_LINEAR_BLENDING)
+    );
+}
diff --git a/src/renderer/shaders/hlsl/cell_bg.hlsl b/src/renderer/shaders/hlsl/cell_bg.hlsl
new file mode 100644
index 000000000..d64a4d2e5
--- /dev/null
+++ b/src/renderer/shaders/hlsl/cell_bg.hlsl
@@ -0,0 +1,59 @@
+// Draws the per-cell background colors.
+// Ported from `glsl/cell_bg.f.glsl`.
+//
+// This runs as a full screen pass that maps each fragment back to a grid cell,
+// which is why the cell colors are a StructuredBuffer rather than vertex data:
+// the lookup index is computed per fragment.
+#include "common.hlsli"
+
+StructuredBuffer<uint> bg_cells : register(t1);
+
+FullScreenOut vs_main(uint vid : SV_VertexID) {
+    return full_screen_vs(vid);
+}
+
+float4 ps_main(FullScreenOut input) : SV_Target {
+    uint2 grid_size = unpack2u16(grid_size_packed);
+    uint extend = padding_extend();
+
+    // `grid_padding` is ordered top, right, bottom, left, so .wx is (left, top).
+    // SV_Position is already upper-left origin in D3D, matching the
+    // `origin_upper_left` layout qualifier the GLSL version has to ask for.
+    int2 grid_pos = int2(floor((input.pos.xy - float2(grid_padding.w, grid_padding.x)) / cell_size));
+
+    float4 transparent = float4(0.0, 0.0, 0.0, 0.0);
+
+    // Clamp x, extending edge colors into the padding when asked.
+    if (grid_pos.x < 0) {
+        if ((extend & EXTEND_LEFT) != 0u) {
+            grid_pos.x = 0;
+        } else {
+            return transparent;
+        }
+    } else if (grid_pos.x > int(grid_size.x) - 1) {
+        if ((extend & EXTEND_RIGHT) != 0u) {
+            grid_pos.x = int(grid_size.x) - 1;
+        } else {
+            return transparent;
+        }
+    }
+
+    if (grid_pos.y < 0) {
+        if ((extend & EXTEND_UP) != 0u) {
+            grid_pos.y = 0;
+        } else {
+            return transparent;
+        }
+    } else if (grid_pos.y > int(grid_size.y) - 1) {
+        if ((extend & EXTEND_DOWN) != 0u) {
+            grid_pos.y = int(grid_size.y) - 1;
+        } else {
+            return transparent;
+        }
+    }
+
+    return load_color(
+        unpack4u8(bg_cells[grid_pos.y * int(grid_size.x) + grid_pos.x]),
+        get_bool(BOOL_USE_LINEAR_BLENDING)
+    );
+}
diff --git a/src/renderer/shaders/hlsl/cell_text.hlsl b/src/renderer/shaders/hlsl/cell_text.hlsl
new file mode 100644
index 000000000..3d2c6b675
--- /dev/null
+++ b/src/renderer/shaders/hlsl/cell_text.hlsl
@@ -0,0 +1,160 @@
+// Draws glyphs from the atlas, one instanced quad per glyph.
+// Ported from `glsl/cell_text.v.glsl` and `glsl/cell_text.f.glsl`.
+//
+// The GLSL backend feeds the per-glyph data in as instanced vertex attributes.
+// Here it is a StructuredBuffer indexed by SV_InstanceID instead, which is what
+// the Metal backend does and what lets this draw with no vertex buffer and no
+// input layout.
+#include "common.hlsli"
+
+// Must match `CellText` in `directx11/shaders.zig`, which is asserted to be 32
+// bytes and to match Metal. HLSL packs structured buffer members tightly on
+// 4-byte boundaries (the float4-straddling rule applies to cbuffers, not to
+// these), which gives 8+8+4+4+4+4 = 32 and matches the StructureByteStride the
+// buffer is created with.
+struct CellText {
+    uint2 glyph_pos;       //  0  texture position, pixels
+    uint2 glyph_size;      //  8  texture size, pixels
+    int   bearings_packed; // 16  2 x i16
+    uint  grid_pos_packed; // 20  2 x u16
+    uint  color_packed;    // 24  4 x u8
+    uint  atlas_bools;     // 28  atlas in byte 0, bools in byte 1
+};
+
+StructuredBuffer<CellText> cells    : register(t0);
+StructuredBuffer<uint>     bg_cells : register(t1);
+
+Texture2D<float4> atlas_grayscale : register(t2);
+Texture2D<float4> atlas_color     : register(t3);
+
+// Values the `atlas` byte can take.
+static const uint ATLAS_GRAYSCALE = 0u;
+static const uint ATLAS_COLOR     = 1u;
+
+// Masks for the `bools` byte.
+static const uint NO_MIN_CONTRAST = 1u;
+static const uint IS_CURSOR_GLYPH = 2u;
+
+struct VSOut {
+    float4 pos                        : SV_Position;
+    nointerpolation uint   atlas      : ATLAS;
+    nointerpolation float4 color      : COLOR0;
+    nointerpolation float4 bg_color   : COLOR1;
+    float2                 tex_coord  : TEXCOORD0;
+};
+
+VSOut vs_main(uint vid : SV_VertexID, uint iid : SV_InstanceID) {
+    CellText cell = cells[iid];
+
+    uint2 grid_size  = unpack2u16(grid_size_packed);
+    uint2 cursor_pos = unpack2u16(cursor_pos_packed);
+    uint2 grid_pos   = unpack2u16(cell.grid_pos_packed);
+    int2  bearings   = unpack2i16(cell.bearings_packed);
+    uint  atlas      = cell.atlas_bools & 0xFFu;
+    uint  glyph_bools = (cell.atlas_bools >> 8u) & 0xFFu;
+
+    bool cursor_wide         = get_bool(BOOL_CURSOR_WIDE);
+    bool use_linear_blending = get_bool(BOOL_USE_LINEAR_BLENDING);
+
+    // A 4-vertex triangle strip makes each quad:
+    //   0 --> 1
+    //   |   .'|
+    //   |  /  |
+    //   | L   |
+    //   2 --> 3
+    float2 corner;
+    corner.x = (vid == 1u || vid == 3u) ? 1.0 : 0.0;
+    corner.y = (vid == 2u || vid == 3u) ? 1.0 : 0.0;
+
+    // The Y bearing is measured from the bottom of the cell up to the top of
+    // the glyph, so it becomes a downward offset by subtracting from the cell
+    // height. The X bearing is already a left offset.
+    float2 size   = float2(cell.glyph_size);
+    float2 offset = float2(bearings);
+    offset.y = cell_size.y - offset.y;
+
+    float2 cell_pos = cell_size * float2(grid_pos) + size * corner + offset;
+
+    VSOut o;
+    // `Mat` stores columns, so this matches the GLSL `projection_matrix * v`.
+    o.pos = mul(projection_matrix, float4(cell_pos.x, cell_pos.y, 0.0, 1.0));
+    o.atlas = atlas;
+
+    // Unnormalized, in pixels: the atlas is read with Load rather than sampled.
+    o.tex_coord = float2(cell.glyph_pos) + float2(cell.glyph_size) * corner;
+
+    // Always fetch linearized, so the contrast math below is well defined.
+    o.color = load_color(unpack4u8(cell.color_packed), true);
+    o.bg_color = load_color(
+        unpack4u8(bg_cells[grid_pos.y * grid_size.x + grid_pos.x]),
+        true
+    );
+
+    // Blend the cell background over the global background.
+    float4 global_bg = load_color(unpack4u8(bg_color_packed), true);
+    o.bg_color += global_bg * (1.0 - o.bg_color.a);
+
+    if (min_contrast > 1.0 && (glyph_bools & NO_MIN_CONTRAST) == 0u) {
+        o.color = contrasted_color(min_contrast, o.color, o.bg_color);
+    }
+
+    // Cells under the cursor take the cursor color, unless this *is* the
+    // cursor glyph being drawn.
+    bool is_cursor_pos =
+        ((grid_pos.x == cursor_pos.x) ||
+         (cursor_wide && (grid_pos.x == cursor_pos.x + 1u))) &&
+        (grid_pos.y == cursor_pos.y);
+    if ((glyph_bools & IS_CURSOR_GLYPH) == 0u && is_cursor_pos) {
+        o.color = load_color(unpack4u8(cursor_color_packed), use_linear_blending);
+    }
+
+    return o;
+}
+
+float4 ps_main(VSOut input) : SV_Target {
+    bool use_linear_blending   = get_bool(BOOL_USE_LINEAR_BLENDING);
+    bool use_linear_correction = get_bool(BOOL_USE_LINEAR_CORRECTION);
+
+    // Pixel centres land on glyph_pos + k + 0.5 for k in [0, size), so
+    // truncating stays inside the glyph's rect in the atlas.
+    int3 texel = int3(int2(input.tex_coord), 0);
+
+    if (input.atlas == ATLAS_COLOR) {
+        // Color glyphs are already premultiplied linear.
+        float4 color = atlas_color.Load(texel);
+        if (use_linear_blending) return color;
+
+        // Undo the premultiply before re-encoding, then redo it.
+        color.rgb /= color.a;
+        color = unlinearize(color);
+        color.rgb *= color.a;
+        return color;
+    }
+
+    // Grayscale: the input color is linear, the texture is a coverage mask.
+    float4 color = input.color;
+    if (!use_linear_blending) {
+        color.rgb /= color.a;
+        color = unlinearize(color);
+        color.rgb *= color.a;
+    }
+
+    float a = atlas_grayscale.Load(texel).r;
+
+    // Correct the alpha so linear blending has the apparent weight that
+    // gamma-incorrect blending would have produced.
+    if (use_linear_correction) {
+        float fg_l = luminance(color.rgb);
+        float bg_l = luminance(input.bg_color.rgb);
+        // Skip when the luminances are too close, to avoid dividing by ~0.
+        if (abs(fg_l - bg_l) > 0.001) {
+            float blend_l = linearize_f(
+                unlinearize_f(fg_l) * a + unlinearize_f(bg_l) * (1.0 - a)
+            );
+            a = clamp((blend_l - bg_l) / (fg_l - bg_l), 0.0, 1.0);
+        }
+    }
+
+    // Premultiplied alpha, so scaling the whole color applies the mask.
+    return color * a;
+}
diff --git a/src/renderer/shaders/hlsl/common.hlsli b/src/renderer/shaders/hlsl/common.hlsli
new file mode 100644
index 000000000..3c75c811e
--- /dev/null
+++ b/src/renderer/shaders/hlsl/common.hlsli
@@ -0,0 +1,174 @@
+// Common definitions shared by the D3D11 shaders. This is the HLSL counterpart
+// of `glsl/common.glsl`, and the function bodies are ported from it directly so
+// that the two backends produce the same pixels.
+//
+// ===========================================================================
+// The `Globals` layout is load-bearing and is NOT free to be tidied.
+// ===========================================================================
+//
+// `GenericRenderer` writes one byte layout for every backend, so this cbuffer
+// must match `directx11/shaders.zig`'s `Uniforms` exactly. Every field carries
+// an explicit `packoffset` rather than relying on HLSL's packing rules, because
+// a mismatch here is not a compile error - it silently reads the wrong field.
+// The offsets below were derived from the Zig struct's explicit alignments:
+//
+//   projection_matrix   0    (64 bytes, c0-c3)
+//   screen_size        64    (c4.xy)
+//   cell_size          72    (c4.zw)
+//   grid_size          80    (c5.x)     -- 2 x u16 packed
+//   <4 bytes padding to the 16-byte alignment of grid_padding>
+//   grid_padding       96    (c6)
+//   padding_extend    112    (c7.x)     -- u8 bitfield, low byte
+//   min_contrast      116    (c7.y)
+//   cursor_pos        120    (c7.z)     -- 2 x u16 packed
+//   cursor_color      124    (c7.w)     -- 4 x u8 packed
+//   bg_color          128    (c8.x)     -- 4 x u8 packed
+//   bools             132    (c8.y)     -- 4 separate bytes, see below
+//                     136 -> 144 with trailing alignment
+cbuffer Globals : register(b0) {
+    float4x4 projection_matrix     : packoffset(c0);
+    float2   screen_size           : packoffset(c4.x);
+    float2   cell_size             : packoffset(c4.z);
+    uint     grid_size_packed      : packoffset(c5.x);
+    float4   grid_padding          : packoffset(c6);
+    uint     padding_extend_packed : packoffset(c7.x);
+    float    min_contrast          : packoffset(c7.y);
+    uint     cursor_pos_packed     : packoffset(c7.z);
+    uint     cursor_color_packed   : packoffset(c7.w);
+    uint     bg_color_packed       : packoffset(c8.x);
+    uint     bools_packed          : packoffset(c8.y);
+};
+
+// `bools` is four `bool align(1)` fields - one whole BYTE each, not a bitmask.
+// The GLSL backend packs the same information into bit flags, so porting its
+// `bools & USE_LINEAR_BLENDING` test verbatim would be wrong here.
+#define BOOL_CURSOR_WIDE           0
+#define BOOL_USE_DISPLAY_P3        1
+#define BOOL_USE_LINEAR_BLENDING   2
+#define BOOL_USE_LINEAR_CORRECTION 3
+
+bool get_bool(uint index) {
+    return ((bools_packed >> (index * 8u)) & 0xFFu) != 0u;
+}
+
+// `padding_extend` is a packed u8 bitfield, so it does read as flags.
+static const uint EXTEND_LEFT  = 1u;
+static const uint EXTEND_RIGHT = 2u;
+static const uint EXTEND_UP    = 4u;
+static const uint EXTEND_DOWN  = 8u;
+
+uint padding_extend() {
+    return padding_extend_packed & 0xFFu;
+}
+
+//---------------------------------------------------------------------------//
+// Unpacking
+//---------------------------------------------------------------------------//
+// These assume little-endian, as the GLSL versions do.
+
+uint4 unpack4u8(uint v) {
+    return uint4(
+        (v >>  0u) & 0xFFu,
+        (v >>  8u) & 0xFFu,
+        (v >> 16u) & 0xFFu,
+        (v >> 24u) & 0xFFu
+    );
+}
+
+uint2 unpack2u16(uint v) {
+    return uint2(v & 0xFFFFu, (v >> 16u) & 0xFFFFu);
+}
+
+// x is the low half and y the high half, both sign extended. HLSL's `>>` on a
+// signed int is an arithmetic shift, which is what does the sign extension.
+int2 unpack2i16(int v) {
+    return int2((v << 16) >> 16, v >> 16);
+}
+
+//---------------------------------------------------------------------------//
+// Color
+//---------------------------------------------------------------------------//
+
+// Takes colors in linear RGB space.
+float luminance(float3 color) {
+    return dot(color, float3(0.2126, 0.7152, 0.0722));
+}
+
+// https://www.w3.org/TR/2008/REC-WCAG20-20081211/#contrast-ratiodef
+float contrast_ratio(float3 color1, float3 color2) {
+    float luminance1 = luminance(color1) + 0.05;
+    float luminance2 = luminance(color2) + 0.05;
+    return max(luminance1, luminance2) / min(luminance1, luminance2);
+}
+
+// Return fg if it already meets the ratio, otherwise whichever of white or
+// black has the most contrast with bg.
+float4 contrasted_color(float min_ratio, float4 fg, float4 bg) {
+    float ratio = contrast_ratio(fg.rgb, bg.rgb);
+    if (ratio < min_ratio) {
+        float white_ratio = contrast_ratio(float3(1.0, 1.0, 1.0), bg.rgb);
+        float black_ratio = contrast_ratio(float3(0.0, 0.0, 0.0), bg.rgb);
+        if (white_ratio > black_ratio) {
+            return float4(1.0, 1.0, 1.0, 1.0);
+        } else {
+            return float4(0.0, 0.0, 0.0, 1.0);
+        }
+    }
+    return fg;
+}
+
+// The `pow` inputs below are clamped to be non-negative, which the GLSL
+// versions do not bother with. It is not defensive noise here: HLSL's `lerp`
+// evaluates both branches, so a NaN produced by the branch the cutoff does not
+// select still propagates (`NaN + 1*(b - NaN)` is NaN) instead of being
+// discarded. The premultiplied color paths divide by alpha before calling
+// these, so a zero-alpha pixel really can reach them with a negative or
+// non-finite value. `fxc /WX` refuses to compile the unguarded form.
+
+float4 linearize(float4 srgb) {
+    bool3  cutoff = srgb.rgb <= 0.04045;
+    float3 higher = pow(max((srgb.rgb + 0.055) / 1.055, 0.0), 2.4);
+    float3 lower  = srgb.rgb / 12.92;
+    return float4(lerp(higher, lower, (float3)cutoff), srgb.a);
+}
+
+float linearize_f(float v) {
+    return v <= 0.04045 ? v / 12.92 : pow(max((v + 0.055) / 1.055, 0.0), 2.4);
+}
+
+float4 unlinearize(float4 lin) {
+    bool3  cutoff = lin.rgb <= 0.0031308;
+    float3 higher = pow(max(lin.rgb, 0.0), 1.0 / 2.4) * 1.055 - 0.055;
+    float3 lower  = lin.rgb * 12.92;
+    return float4(lerp(higher, lower, (float3)cutoff), lin.a);
+}
+
+float unlinearize_f(float v) {
+    return v <= 0.0031308 ? v * 12.92 : pow(max(v, 0.0), 1.0 / 2.4) * 1.055 - 0.055;
+}
+
+// Load a 4 byte RGBA non-premultiplied color, linearizing if asked, and
+// premultiply it. `linear` is an HLSL interpolation modifier, hence the name.
+float4 load_color(uint4 in_color, bool want_linear) {
+    float4 color = float4(in_color) / 255.0;
+    if (want_linear) color = linearize(color);
+    color.rgb *= color.a;
+    return color;
+}
+
+//---------------------------------------------------------------------------//
+// Full screen triangle
+//---------------------------------------------------------------------------//
+// Three vertices covering the whole target, so the background passes need no
+// vertex buffer. D3D's clip space is y-up and its viewport origin is top-left.
+
+struct FullScreenOut {
+    float4 pos : SV_Position;
+};
+
+FullScreenOut full_screen_vs(uint vid) {
+    float2 uv = float2((vid << 1u) & 2u, vid & 2u);
+    FullScreenOut o;
+    o.pos = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+    return o;
+}
