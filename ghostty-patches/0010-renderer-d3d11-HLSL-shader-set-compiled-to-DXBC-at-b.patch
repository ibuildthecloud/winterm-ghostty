@@ -15,16 +15,54 @@
 const std = @import("std");
 const Allocator = std.mem.Allocator;
 const math = @import("../../math.zig");
+const com = @import("com.zig");
+const d3d11 = @import("d3d11.zig");
 
 const log = std.log.scoped(.directx11);
 
-/// A single render pipeline (vertex + fragment program pair).
+/// A single render pipeline (vertex + pixel program pair).
 ///
-/// Phase 1: an empty placeholder so the `GraphicsAPI` contract compiles. Phase
-/// 3 replaces this with compiled DXBC shader objects and input layouts.
+/// There is no input layout: every pipeline generates its vertices from
+/// `SV_VertexID` and reads per-cell data out of structured buffers, so nothing
+/// is fed through the input assembler.
 pub const Pipeline = struct {
+    vs: ?*d3d11.ID3D11VertexShader = null,
+    ps: ?*d3d11.ID3D11PixelShader = null,
+
+    /// Premultiplied-alpha blending, shared between pipelines and owned by
+    /// `Shaders`, so this is borrowed and not released here.
+    blend: ?*d3d11.ID3D11BlendState = null,
+
+    pub fn init(
+        device: *d3d11.ID3D11Device,
+        vs_bytecode: []const u8,
+        ps_bytecode: []const u8,
