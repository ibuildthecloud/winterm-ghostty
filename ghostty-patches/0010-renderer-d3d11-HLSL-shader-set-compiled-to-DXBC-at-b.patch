diff --git a/src/renderer/directx11/RenderPass.zig b/src/renderer/directx11/RenderPass.zig
index 91f9c417f..35098262d 100644
--- a/src/renderer/directx11/RenderPass.zig
+++ b/src/renderer/directx11/RenderPass.zig
@@ -127,13 +127,70 @@ pub fn begin(opts: Options) Self {
 
 /// Add a step to this render pass.
 ///
-/// phase1_skeleton: no-op. Issuing a draw needs a compiled pipeline, an input
-/// layout, and a bound glyph atlas, none of which exist before Phase 3.
-/// Silently ignoring steps is what lets `GenericRenderer.drawFrame` run
-/// end-to-end and produce a correctly cleared, correctly sized surface now.
+/// Shader resource registers are assigned by a fixed convention rather than by
+/// packing the two lists end to end, so that the HLSL register numbers stay
+/// the same no matter how many bindings a given step happens to supply:
+///
+///   t0, t1  `buffers[0]`, `buffers[1]`   (structured buffers)
+///   t2, t3  `textures[0]`, `textures[1]` (grayscale atlas, color atlas)
+///   b0      `uniforms`
+///   s0..    `samplers`
+///
+/// A step whose pipeline has no shaders is skipped. That is how the not-yet
+/// ported `image` and `bg_image` pipelines stay harmless instead of drawing
+/// with whatever was bound last.
 pub fn step(self: *Self, s: Step) void {
-    _ = s;
     self.step_number += 1;
+
+    const vs = s.pipeline.vs orelse return;
+    const ps = s.pipeline.ps orelse return;
+    const ctx = self.api.device.context;
+
+    ctx.VSSetShader(vs);
+    ctx.PSSetShader(ps);
+    ctx.IASetPrimitiveTopology(s.draw.type.topology());
+
+    if (s.uniforms) |u| {
+        const cbs = [_]?*d3d11.ID3D11Buffer{u.buf};
+        ctx.VSSetConstantBuffers(0, &cbs);
+        ctx.PSSetConstantBuffers(0, &cbs);
+    }
+
+    // Both stages get the same table: the text vertex shader reads the cell
+    // and background buffers, and its pixel shader reads the atlases.
+    var srvs: [4]?*d3d11.ID3D11ShaderResourceView = @splat(null);
+    for (s.buffers, 0..) |maybe, i| {
+        if (i >= 2) break;
+        if (maybe) |b| srvs[i] = b.srv;
+    }
+    for (s.textures, 0..) |maybe, i| {
+        if (i >= 2) break;
+        if (maybe) |t| srvs[2 + i] = t.srv;
+    }
+    ctx.VSSetShaderResources(0, &srvs);
+    ctx.PSSetShaderResources(0, &srvs);
+
+    if (s.samplers.len > 0) {
+        var samplers: [4]?*d3d11.ID3D11SamplerState = @splat(null);
+        for (s.samplers, 0..) |maybe, i| {
+            if (i >= samplers.len) break;
+            if (maybe) |sm| samplers[i] = sm.sampler;
+        }
+        ctx.PSSetSamplers(0, samplers[0..@min(s.samplers.len, samplers.len)]);
+    }
+
+    ctx.OMSetBlendState(s.pipeline.blend);
+
+    if (s.draw.instance_count == 1) {
+        ctx.Draw(@intCast(s.draw.vertex_count), 0);
+    } else {
+        ctx.DrawInstanced(
+            @intCast(s.draw.vertex_count),
+            @intCast(s.draw.instance_count),
+            0,
+            0,
+        );
+    }
 }
 
