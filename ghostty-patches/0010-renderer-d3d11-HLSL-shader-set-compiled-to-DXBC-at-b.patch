+    if (step.rootModuleTarget().os.tag == .windows) {
+        const hlsl_dir = b.path("src/renderer/shaders/hlsl");
+        for (hlsl_shaders) |shader| {
+            const fxc = FxcStep.create(b, .{
+                .name = shader.import,
+                .source = b.path(b.fmt(
+                    "src/renderer/shaders/hlsl/{s}.hlsl",
+                    .{shader.file},
+                )),
+                .entry = shader.entry,
+                .profile = shader.profile,
+                .include = hlsl_dir,
+            });
+            fxc.output.addStepDependencies(&step.step);
+            step.root_module.addAnonymousImport(shader.import, .{
+                .root_source_file = fxc.output,
+            });
+        }
+    }
+
