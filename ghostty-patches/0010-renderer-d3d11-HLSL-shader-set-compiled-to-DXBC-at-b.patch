diff --git a/src/build/FxcStep.zig b/src/build/FxcStep.zig
new file mode 100644
index 000000000..cac520b06
--- /dev/null
+++ b/src/build/FxcStep.zig
@@ -0,0 +1,103 @@
+/// A zig build step that compiles one HLSL entry point into a DXBC blob with
+/// `fxc` from the Windows SDK.
+///
+/// D3D11 consumes DXBC and only DXBC. `dxc` emits DXIL, which is D3D12-only, so
+/// this deliberately uses the older compiler rather than the newer one.
+///
+/// One step per entry point, because `fxc` compiles a single entry point and
+/// profile per invocation. This is the D3D11 counterpart of `MetallibStep`.
+const FxcStep = @This();
+
+const std = @import("std");
+const Step = std.Build.Step;
+const RunStep = std.Build.Step.Run;
+const LazyPath = std.Build.LazyPath;
+
+pub const Options = struct {
+    /// Name for the output blob, used for the step name too.
+    name: []const u8,
+
+    /// The .hlsl source file.
+    source: LazyPath,
+
+    /// Entry point function, e.g. "vs_main".
+    entry: []const u8,
+
+    /// Shader profile, e.g. "vs_5_0". Must be a Shader Model 5 profile: that
+    /// is the highest DXBC supports, and D3D11 cannot load anything newer.
+    profile: []const u8,
+
+    /// Directory searched for `#include`. `fxc` already resolves quoted
+    /// includes relative to the including file, but the sources are reached
+    /// through a LazyPath, so this is passed explicitly.
+    include: ?LazyPath = null,
+};
+
+step: *Step,
+output: LazyPath,
+
+pub fn create(b: *std.Build, opts: Options) *FxcStep {
+    const self = b.allocator.create(FxcStep) catch @panic("OOM");
+
+    const run = RunStep.create(b, b.fmt("fxc {s}", .{opts.name}));
+    run.addArg(findFxc(b));
+    run.addArgs(&.{
+        "/nologo",
+        // Warnings are errors here for the same reason they are in the Zig
+        // code: an implicit truncation in a shader is a silently wrong pixel.
+        "/WX",
+        "/T",
+        opts.profile,
+        "/E",
+        opts.entry,
+    });
+    if (opts.include) |inc| {
+        run.addArg("/I");
+        run.addDirectoryArg(inc);
+    }
+    run.addArg("/Fo");
+    const output = run.addOutputFileArg(b.fmt("{s}.cso", .{opts.name}));
+    run.addFileArg(opts.source);
+
+    self.* = .{ .step = &run.step, .output = output };
+    return self;
+}
+
+/// Locate `fxc.exe`.
+///
+/// It ships in the Windows SDK and is not on PATH outside a developer command
+/// prompt, so fall back to scanning the SDK's versioned bin directories and
+/// take the newest. `FXC` overrides for unusual setups.
+fn findFxc(b: *std.Build) []const u8 {
+    if (b.graph.environ_map.get("FXC")) |p| return b.dupe(p);
+
+    const roots = [_][]const u8{
+        "C:\\Program Files (x86)\\Windows Kits\\10\\bin",
+        "C:\\Program Files\\Windows Kits\\10\\bin",
+    };
+    const io = b.graph.io;
+    var best: ?[]const u8 = null;
+    var best_name: []const u8 = "";
+    for (roots) |root| {
+        var dir = std.Io.Dir.openDirAbsolute(io, root, .{ .iterate = true }) catch continue;
+        defer dir.close(io);
+        var it = dir.iterate();
+        while (it.next(io) catch null) |entry| {
+            if (entry.kind != .directory) continue;
+            // Versioned SDK directories only, e.g. "10.0.26100.0".
+            if (!std.mem.startsWith(u8, entry.name, "10.")) continue;
+            const candidate = b.fmt("{s}\\{s}\\x64\\fxc.exe", .{ root, entry.name });
+            std.Io.Dir.accessAbsolute(io, candidate, .{}) catch continue;
+            // Lexicographic ordering is good enough to pick the newest here:
+            // the components are zero-padded in practice.
+            if (best == null or std.mem.order(u8, entry.name, best_name) == .gt) {
+                best = candidate;
+                best_name = b.dupe(entry.name);
+            }
+        }
+    }
+
+    // Falling back to a bare name lets a developer command prompt work, and
+    // produces a clear "not found" from the run step otherwise.
+    return best orelse "fxc.exe";
+}
