+        AddRef: *const fn (*IDWriteColorGlyphRunEnumerator1) callconv(.winapi) u32,
+        Release: *const fn (*IDWriteColorGlyphRunEnumerator1) callconv(.winapi) u32,
+        // IDWriteColorGlyphRunEnumerator 3-4
+        MoveNext: *const fn (*IDWriteColorGlyphRunEnumerator1, *i32) callconv(.winapi) HRESULT,
+        _GetCurrentRun0: Reserved,
+        // IDWriteColorGlyphRunEnumerator1 5
+        GetCurrentRun: *const fn (*IDWriteColorGlyphRunEnumerator1, *?*const DWRITE_COLOR_GLYPH_RUN1) callconv(.winapi) HRESULT,
+    };
+
+    pub inline fn MoveNext(self: *IDWriteColorGlyphRunEnumerator1, has_run: *i32) HRESULT {
+        return self.vtable.MoveNext(self, has_run);
+    }
+
+    pub inline fn GetCurrentRun(
+        self: *IDWriteColorGlyphRunEnumerator1,
+        out: *?*const DWRITE_COLOR_GLYPH_RUN1,
+    ) HRESULT {
+        return self.vtable.GetCurrentRun(self, out);
+    }
+
+    pub inline fn Release(self: *IDWriteColorGlyphRunEnumerator1) u32 {
+        return self.vtable.Release(self);
+    }
+};
+
+// =============================================================================
+// IDWriteFactory4 — inherits IDWriteFactory (21) + 1 (2) + 2 (5) + 3 (9),
+// so its own methods start at 40:
+//   40 TranslateColorGlyphRun   <- the full-format version
+//   41 ComputeGlyphOrigins
+//   42 ComputeGlyphOrigins (overload)
+//
+// Note this takes the baseline origin as a D2D1_POINT_2F by value, where
+// IDWriteFactory2 took two floats.
+// =============================================================================
+pub const IDWriteFactory4 = extern struct {
+    vtable: *const VTable,
+
+    pub const IID = GUID{
+        .data1 = 0x4b0b5bd3,
+        .data2 = 0x0797,
+        .data3 = 0x4549,
+        .data4 = .{ 0x8a, 0xc5, 0xfe, 0x91, 0x5c, 0xc5, 0x38, 0x56 },
+    };
+
+    pub const POINT_2F = extern struct { x: f32, y: f32 };
+
+    pub const VTable = extern struct {
+        QueryInterface: *const fn (*IDWriteFactory4, *const GUID, *?*anyopaque) callconv(.winapi) HRESULT,
+        AddRef: *const fn (*IDWriteFactory4) callconv(.winapi) u32,
+        Release: *const fn (*IDWriteFactory4) callconv(.winapi) u32,
+        // IDWriteFactory 3-23, IDWriteFactory1 24-25,
+        // IDWriteFactory2 26-30, IDWriteFactory3 31-39
+        _reserved: [37]Reserved,
+        // IDWriteFactory4 40-42
+        TranslateColorGlyphRun: *const fn (
+            *IDWriteFactory4,
+            POINT_2F,
+            *const DWRITE_GLYPH_RUN,
+            ?*const anyopaque,
+            DWRITE_GLYPH_IMAGE_FORMATS,
+            DWRITE_MEASURING_MODE,
+            ?*const anyopaque,
+            u32,
+            *?*IDWriteColorGlyphRunEnumerator1,
+        ) callconv(.winapi) HRESULT,
+        _ComputeGlyphOrigins0: Reserved,
+        _ComputeGlyphOrigins1: Reserved,
+    };
+
+    /// Returns DWRITE_E_NOCOLOR when the glyph has no colour in any of the
+    /// requested formats; that is the "render it as normal text" answer.
+    pub inline fn TranslateColorGlyphRun(
+        self: *IDWriteFactory4,
+        origin: POINT_2F,
+        run: *const DWRITE_GLYPH_RUN,
+        formats: DWRITE_GLYPH_IMAGE_FORMATS,
