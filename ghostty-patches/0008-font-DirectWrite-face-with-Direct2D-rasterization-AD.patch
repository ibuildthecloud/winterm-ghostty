+        .data1 = 0x7c5f86da,
+        .data2 = 0xc7a1,
+        .data3 = 0x4f05,
+        .data4 = .{ 0xb8, 0xe1, 0x55, 0xa1, 0x79, 0xfe, 0x5a, 0x35 },
