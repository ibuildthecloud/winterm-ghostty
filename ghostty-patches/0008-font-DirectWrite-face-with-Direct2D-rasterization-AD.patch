+/// Which glyph image formats `TranslateColorGlyphRun` should split a run into.
+///
+/// This is the crux of colour emoji support. dwrite_3.h states that
+/// IDWriteFactory2's TranslateColorGlyphRun "is equivalent to passing
+/// TRUETYPE|CFF|COLR" - so it answers DWRITE_E_NOCOLOR for any font whose
+/// colour lives somewhere other than a COLR table. Segoe UI Emoji is COLR/CPAL
+/// and works either way, but Noto Color Emoji - which ghostty embeds and falls
+/// back to - is CBDT/CBLC and surfaces as PNG. Requesting only the COLR subset
+/// renders it as blank or monochrome.
+pub const DWRITE_GLYPH_IMAGE_FORMATS = u32;
+pub const GLYPH_IMAGE_NONE: u32 = 0x00;
+pub const GLYPH_IMAGE_TRUETYPE: u32 = 0x01;
+pub const GLYPH_IMAGE_CFF: u32 = 0x02;
+pub const GLYPH_IMAGE_COLR: u32 = 0x04;
+pub const GLYPH_IMAGE_SVG: u32 = 0x08;
+pub const GLYPH_IMAGE_PNG: u32 = 0x10;
+pub const GLYPH_IMAGE_JPEG: u32 = 0x20;
+pub const GLYPH_IMAGE_TIFF: u32 = 0x40;
+pub const GLYPH_IMAGE_PREMULTIPLIED_B8G8R8A8: u32 = 0x80;
+
+/// Every format DirectWrite can produce. AtlasEngine requests exactly this set
+/// (see Backend.cpp), so asking for less would render fewer emoji than Windows
+/// Terminal does today.
+pub const GLYPH_IMAGE_ALL: u32 = GLYPH_IMAGE_TRUETYPE | GLYPH_IMAGE_CFF |
+    GLYPH_IMAGE_COLR | GLYPH_IMAGE_SVG | GLYPH_IMAGE_PNG | GLYPH_IMAGE_JPEG |
+    GLYPH_IMAGE_TIFF | GLYPH_IMAGE_PREMULTIPLIED_B8G8R8A8;
+
+/// Formats that arrive as a colour bitmap and must be drawn with
+/// `DrawColorBitmapGlyphRun`; `DrawGlyphRun` silently draws nothing for these.
+pub const GLYPH_IMAGE_BITMAP: u32 = GLYPH_IMAGE_PNG | GLYPH_IMAGE_JPEG |
+    GLYPH_IMAGE_TIFF | GLYPH_IMAGE_PREMULTIPLIED_B8G8R8A8;
+
+/// The colour-bearing formats, without TRUETYPE/CFF.
+///
+/// AtlasEngine asks for GLYPH_IMAGE_ALL because it wants one unified draw loop
+/// and is happy to get plain outline runs back. We ask for this subset instead,
+/// so that DWRITE_E_NOCOLOR means precisely "this glyph is monochrome" - which
+/// is the question both `isColorGlyph` and `renderGlyph` need answered, and it
+/// keeps the two agreeing by construction. Including TRUETYPE here would make
+/// every glyph in a colour font look coloured.
+pub const GLYPH_IMAGE_COLOR: u32 = GLYPH_IMAGE_COLR | GLYPH_IMAGE_SVG |
+    GLYPH_IMAGE_BITMAP;
+
+/// `DWRITE_COLOR_GLYPH_RUN` plus the format and measuring mode, as returned by
+/// `IDWriteColorGlyphRunEnumerator1::GetCurrentRun`. Exactly one format bit is
+/// set: TranslateColorGlyphRun has already split the run by format.
+///
+/// The C++ type derives from DWRITE_COLOR_GLYPH_RUN and MSVC does not reuse the
+/// base's tail padding, so the six bytes after `paletteIndex` are explicit here.
+/// The comptime asserts below are what keep that honest.
+pub const DWRITE_COLOR_GLYPH_RUN1 = extern struct {
+    glyphRun: DWRITE_GLYPH_RUN,
+    glyphRunDescription: ?*anyopaque,
+    baselineOriginX: f32,
+    baselineOriginY: f32,
+    runColor: DWRITE_COLOR_F,
+    paletteIndex: u16,
+    _tail_padding: [6]u8 = @splat(0),
+    glyphImageFormat: DWRITE_GLYPH_IMAGE_FORMATS,
+    measuringMode: DWRITE_MEASURING_MODE,
+};
+
+comptime {
+    // Verified against the SDK with offsetof/sizeof; a mismatch here would be
+    // read as garbage format bits rather than as a compile error.
+    std.debug.assert(@sizeOf(DWRITE_COLOR_GLYPH_RUN1) == 96);
+    std.debug.assert(@offsetOf(DWRITE_COLOR_GLYPH_RUN1, "paletteIndex") == 80);
+    std.debug.assert(@offsetOf(DWRITE_COLOR_GLYPH_RUN1, "glyphImageFormat") == 88);
+    std.debug.assert(@offsetOf(DWRITE_COLOR_GLYPH_RUN1, "measuringMode") == 92);
+}
