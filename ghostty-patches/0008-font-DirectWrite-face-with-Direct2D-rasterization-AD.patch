+// =============================================================================
+// IDWriteColorGlyphRunEnumerator1 — adds GetCurrentRun returning the *1* struct.
+// Slots: MoveNext(3), GetCurrentRun(4, base), GetCurrentRun(5, this one).
+// =============================================================================
