+            ?*anyopaque, // ID2D1SvgGlyphStyle
+            u32, // colorPaletteIndex
+            dw.DWRITE_MEASURING_MODE,
+        ) callconv(.winapi) void, // 112
+        _tail: [2]Reserved, // 113-114
+    };
+
+    pub inline fn SetUnitMode(self: *ID2D1DeviceContext4, mode: D2D1_UNIT_MODE) void {
+        self.vtable.SetUnitMode(self, mode);
+    }
+
+    pub inline fn DrawColorBitmapGlyphRun(
+        self: *ID2D1DeviceContext4,
+        format: u32,
+        origin: D2D1_POINT_2F,
+        run: *const dw.DWRITE_GLYPH_RUN,
+        measuring_mode: dw.DWRITE_MEASURING_MODE,
+    ) void {
+        self.vtable.DrawColorBitmapGlyphRun(self, format, origin, run, measuring_mode, .DEFAULT);
+    }
+
+    pub inline fn DrawSvgGlyphRun(
+        self: *ID2D1DeviceContext4,
+        origin: D2D1_POINT_2F,
+        run: *const dw.DWRITE_GLYPH_RUN,
+        brush: *ID2D1SolidColorBrush,
+        measuring_mode: dw.DWRITE_MEASURING_MODE,
+    ) void {
+        self.vtable.DrawSvgGlyphRun(self, origin, run, brush, null, 0, measuring_mode);
+    }
+
+    pub inline fn Release(self: *ID2D1DeviceContext4) u32 {
+        return self.vtable.Release(self);
+    }
+};
+
+test "ID2D1DeviceContext4 slot layout" {
+    // A wrong slot here calls a different method with the wrong arguments,
+    // which corrupts state instead of failing to compile.
+    try std.testing.expectEqual(115 * @sizeOf(usize), @sizeOf(ID2D1DeviceContext4.VTable));
+    try std.testing.expectEqual(
+        80 * @sizeOf(usize),
+        @offsetOf(ID2D1DeviceContext4.VTable, "SetUnitMode"),
+    );
+    try std.testing.expectEqual(
+        111 * @sizeOf(usize),
+        @offsetOf(ID2D1DeviceContext4.VTable, "DrawColorBitmapGlyphRun"),
+    );
+    try std.testing.expectEqual(
+        112 * @sizeOf(usize),
+        @offsetOf(ID2D1DeviceContext4.VTable, "DrawSvgGlyphRun"),
+    );
+}
