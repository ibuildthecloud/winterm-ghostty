+            run,
+            null,
+            formats,
+            .NATURAL,
+            null,
+            0,
+            out,
+        );
+    }
+
+    pub inline fn Release(self: *IDWriteFactory4) u32 {
+        return self.vtable.Release(self);
+    }
+};
