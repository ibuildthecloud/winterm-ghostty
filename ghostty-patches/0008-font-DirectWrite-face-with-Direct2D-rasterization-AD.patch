index 000000000..963afa89c
--- /dev/null
+++ b/src/font/face/directwrite.zig
@@ -0,0 +1,1058 @@
+//! Font face backed by DirectWrite, rasterized through Direct2D (ADR 0005).
+//!
+//! Every COM interaction here was validated by standalone spikes before being
+//! written, because a vtable slot at the wrong offset calls a different
+//! function silently rather than failing to compile. See the commit messages
+//! on `dwrite/api.zig` for the measurements.
+//!
+//! Rasterization writes into ghostty's CPU-side `font.Atlas`, exactly as the
+//! FreeType face does - **not** D2D-direct into a GPU texture. `font.Atlas`
+//! owns rect packing and is what `CodepointResolver`/`SharedGrid` build on,
+//! and glyphs are rasterized once per unique glyph rather than per frame, so
+//! the readback costs almost nothing. This corrects a consequence stated in
+//! ADR 0005; see DESIGN.md.
+
+/// This file *is* the Face. Exported so `face.zig` can refer to
+/// `directwrite.Face`, matching how the freetype and coretext backends read.
+pub const Face = @This();
+
+const std = @import("std");
+const builtin = @import("builtin");
+const Allocator = std.mem.Allocator;
+const global = @import("../../global.zig");
+
+const harfbuzz = @import("harfbuzz");
+
+const font = @import("../main.zig");
+const Glyph = font.Glyph;
+const Library = font.Library;
+const Metrics = font.Metrics;
+
+const dw = @import("dwrite/api.zig");
+const d2d = @import("dwrite/d2d.zig");
+
+const log = std.log.scoped(.font_face);
+
+/// Shared DirectWrite/D2D/WIC state. Borrowed; the Library outlives faces.
+lib: Library,
+
+/// The underlying DirectWrite face.
+face: *dw.IDWriteFontFace,
+
+/// Font file reference, when this face was built from memory. Held so it can
+/// be released with the face.
+file: ?*dw.IDWriteFontFile = null,
+
+/// Size this face renders at.
+size: font.face.DesiredSize,
+
+/// Cached design metrics; DirectWrite returns these in font design units and
+/// they never change for a face, so read them once.
+design: dw.DWRITE_FONT_METRICS,
+
+/// True if the font has colour glyphs at all (a COLR/CBDT/sbix table).
+/// Checked once at init because it gates a `TranslateColorGlyphRun` call per
+/// glyph otherwise.
+color: bool,
+
+/// HarfBuzz font used for shaping.
+///
+/// Built from the font bytes rather than from the rasterizer, because
+/// HarfBuzz has its own OpenType parser and no DirectWrite integration exists
+/// (unlike `hb_ft_font_create` / `hb_coretext`). Shaping is therefore
+/// identical to every other ghostty platform, which is the point of the
+/// `directwrite_harfbuzz` combination.
+hb_font: harfbuzz.Font,
+
+/// Set quirks.disableDefaultFontFeatures
+quirks_disable_default_font_features: bool = false,
+
+/// Synthetic styling applied by us rather than present in the font.
+synthetic: packed struct {
+    bold: bool = false,
+    italic: bool = false,
+} = .{},
+
+/// Deliberately reuses error names that already exist in
+/// `SharedGrid.RenderGlyphError`. That set is a large hand-maintained union
+/// carrying its own FIXME about being consolidated; adding Windows-specific
+/// names to a shared upstream set for one backend would make it worse, and
+/// these two carry exactly the right meaning:
+///
+///   CannotOpenResource - the font could not be opened / face not created
+///   CannotRenderGlyph  - rasterization failed
+pub const Error = error{
+    CannotOpenResource,
+    CannotRenderGlyph,
+};
+
+/// Initialize from font bytes. This is ghostty's primary Face entry point and
+/// is how embedded fonts are loaded.
+pub fn init(
+    lib: Library,
+    source: [:0]const u8,
+    opts: font.face.Options,
+) !Face {
+    lib.mutex.lockUncancelable(global.io());
+    defer lib.mutex.unlock(global.io());
+
+    var file: ?*dw.IDWriteFontFile = null;
+    if (dw.FAILED(lib.in_memory_loader.CreateInMemoryFontFileReference(
+        lib.factory,
+        source,
+        &file,
+    )) or file == null) return Error.CannotOpenResource;
+    errdefer _ = file.?.Release();
+
+    const files = [_]*dw.IDWriteFontFile{file.?};
+    var face: ?*dw.IDWriteFontFace = null;
+    if (dw.FAILED(lib.factory.CreateFontFace(
+        .TRUETYPE,
+        &files,
+        0,
+        &face,
+    )) or face == null) return Error.CannotOpenResource;
+    errdefer _ = face.?.Release();
+
+    var self = try initFace(lib, face.?, source, 0, opts);
+    self.file = file;
+    return self;
+}
+
+/// Initialize from a font file on disk.
+///
+/// This is what the Windows font-directory discovery produces, and
+/// DirectWrite references files natively so no bytes are read by us.
+pub fn initFile(
+    lib: Library,
+    path: [:0]const u8,
+    index: i32,
+    opts: font.face.Options,
+) !Face {
+    lib.mutex.lockUncancelable(global.io());
+    defer lib.mutex.unlock(global.io());
+
+    // DirectWrite paths are UTF-16.
+    var buf: [std.fs.max_path_bytes]u16 = undefined;
+    const len = std.unicode.utf8ToUtf16Le(&buf, path) catch return Error.CannotOpenResource;
+    if (len >= buf.len) return Error.CannotOpenResource;
+    buf[len] = 0;
+    const wpath: [*:0]const u16 = @ptrCast(&buf);
+
+    var file: ?*dw.IDWriteFontFile = null;
+    if (dw.FAILED(lib.factory.CreateFontFileReference(wpath, &file)) or file == null) {
+        return Error.CannotOpenResource;
+    }
+    errdefer _ = file.?.Release();
+
+    const files = [_]*dw.IDWriteFontFile{file.?};
+    var face: ?*dw.IDWriteFontFace = null;
+    if (dw.FAILED(lib.factory.CreateFontFace(
+        .TRUETYPE,
+        &files,
+        @intCast(@max(index, 0)),
+        &face,
+    )) or face == null) return Error.CannotOpenResource;
+    errdefer _ = face.?.Release();
+
+    // HarfBuzz needs the raw bytes; DirectWrite referenced the file itself, so
+    // read it once here and let HarfBuzz duplicate what it keeps.
+    const bytes = readFile(lib.alloc, path) catch return Error.CannotOpenResource;
+    defer lib.alloc.free(bytes);
+
+    var self = try initFace(lib, face.?, bytes, @intCast(@max(index, 0)), opts);
+    self.file = file;
+    return self;
+}
+
+fn readFile(alloc: Allocator, path: [:0]const u8) ![]u8 {
+    // `cwd()` with an absolute path works and avoids opening a Dir handle.
+    return try std.Io.Dir.cwd().readFileAlloc(
+        global.io(),
+        path,
+        alloc,
+        // Fonts are large but bounded; a CJK TTC can exceed 30 MB.
+        std.Io.Limit.limited(64 * 1024 * 1024),
+    );
+}
+
+/// Initialize from a DirectWrite face plus the font bytes that back it.
+///
+/// The bytes are only used to build the HarfBuzz font; DirectWrite keeps its
+/// own reference, and HarfBuzz duplicates what it needs, so the caller's
+/// buffer does not have to outlive this call.
+pub fn initFace(
+    lib: Library,
+    face: *dw.IDWriteFontFace,
+    bytes: []const u8,
+    face_index: u32,
+    opts: font.face.Options,
+) !Face {
+    var blob = harfbuzz.Blob.create(bytes, .duplicate) catch
+        return Error.CannotOpenResource;
+    defer blob.destroy();
+
+    const hb_face_handle = harfbuzz.c.hb_face_create(blob.handle, face_index) orelse
+        return Error.CannotOpenResource;
+    var hb_face = harfbuzz.Face{ .handle = hb_face_handle };
+    defer hb_face.destroy();
+
+    var hb_font = harfbuzz.Font.create(hb_face) catch return Error.CannotOpenResource;
+    errdefer hb_font.destroy();
+
+    // Match what hb_ft_font_create does: scale so shaped positions come back
+    // in 26.6 fixed-point pixels rather than font design units. Without this
+    // every advance would be off by a factor of upem/px.
+    const px = opts.size.pixels();
+    const scale: c_int = @intFromFloat(@round(px * 64.0));
+    harfbuzz.c.hb_font_set_scale(hb_font.handle, scale, scale);
+    harfbuzz.c.hb_font_set_ppem(
+        hb_font.handle,
+        @intFromFloat(@round(px)),
+        @intFromFloat(@round(px)),
+    );
+
+    return .{
+        .lib = lib,
+        .face = face,
+        .size = opts.size,
+        .design = face.GetMetrics(),
+        .color = hasColorTable(face),
+        .hb_font = hb_font,
+    };
+}
+
+pub fn deinit(self: *Face) void {
+    self.hb_font.destroy();
+    _ = self.face.Release();
+    if (self.file) |f| _ = f.Release();
+    self.* = undefined;
+}
+
+/// A font has colour glyphs if it carries any of the colour tables. Checking
+/// the tables is far cheaper than probing glyphs, and lets `renderGlyph` skip
+/// `TranslateColorGlyphRun` entirely for ordinary text fonts.
+fn hasColorTable(face: *dw.IDWriteFontFace) bool {
+    for ([_]u32{
+        dw.tag("COLR"),
+        dw.tag("CBDT"),
+        dw.tag("sbix"),
+        dw.tag("SVG "),
+    }) |t| {
+        var data: ?*const anyopaque = null;
+        var size: u32 = 0;
+        var ctx: ?*anyopaque = null;
+        var exists: i32 = 0;
+        if (dw.SUCCEEDED(face.TryGetFontTable(t, &data, &size, &ctx, &exists))) {
+            defer face.ReleaseFontTable(ctx);
+            if (exists != 0) return true;
+        }
+    }
+    return false;
+}
+
+pub fn hasColor(self: *const Face) bool {
+    return self.color;
+}
+
+/// Whether a specific glyph is coloured.
+///
+/// Answered by asking DirectWrite to translate the glyph into colour layers:
+/// `DWRITE_E_NOCOLOR` means monochrome. That is the same question
+/// `renderGlyph` has to answer, so the two agree by construction rather than
+/// by two heuristics that might diverge.
+pub fn isColorGlyph(self: *const Face, glyph_id: u32) bool {
+    if (!self.color) return false;
+
+    var indices = [_]u16{@intCast(glyph_id)};
+    const run: dw.DWRITE_GLYPH_RUN = .{
+        .fontFace = self.face,
+        .fontEmSize = self.pixelSize(),
+        .glyphCount = 1,
+        .glyphIndices = &indices,
+        .glyphAdvances = null,
+        .glyphOffsets = null,
+        .isSideways = 0,
+        .bidiLevel = 0,
+    };
+
+    var enumerator: ?*dw.IDWriteColorGlyphRunEnumerator1 = null;
+    const hr = self.lib.factory4.TranslateColorGlyphRun(
+        .{ .x = 0, .y = 0 },
+        &run,
+        dw.GLYPH_IMAGE_COLOR,
+        &enumerator,
+    );
+    if (enumerator) |e| _ = e.Release();
+    return hr != dw.DWRITE_E_NOCOLOR and dw.SUCCEEDED(hr);
+}
+
+fn pixelSize(self: *const Face) f32 {
+    return self.size.pixels();
+}
+
+/// Map a codepoint to a glyph index, or null if this face has no glyph for it.
+pub fn glyphIndex(self: Face, cp: u32) ?u32 {
+    var cps = [_]u32{cp};
+    var out = [_]u16{0};
+    if (dw.FAILED(self.face.GetGlyphIndices(&cps, &out))) return null;
+    // Index 0 is .notdef, i.e. "this face does not have it". Returning null
+    // is what lets the fallback chain take over.
+    return if (out[0] == 0) null else out[0];
+}
+
+/// The font's family name, read from the SFNT `name` table.
+///
+/// Discovery matches requested families against this, so it has to be real
+/// rather than a placeholder. DirectWrite can report family names through
+/// IDWriteFontFamily, but a face created from a file has no family object -
+/// the name table is available either way and is the authoritative source.
+pub fn name(self: *const Face, buf: []u8) Allocator.Error![]const u8 {
+    var data: ?*const anyopaque = null;
+    var size: u32 = 0;
+    var ctx: ?*anyopaque = null;
+    var exists: i32 = 0;
+    if (dw.FAILED(self.face.TryGetFontTable(
+        dw.tag("name"),
+        &data,
+        &size,
+        &ctx,
+        &exists,
+    )) or exists == 0 or data == null) return buf[0..0];
+    defer self.face.ReleaseFontTable(ctx);
+
+    const t: [*]const u8 = @ptrCast(data.?);
+    const table = t[0..size];
+    return parseNameTable(table, buf) orelse buf[0..0];
+}
+
+/// Extract nameID 1 (font family) from an OpenType `name` table.
+///
+/// All fields are big-endian. Windows records (platform 3, encoding 1) are
+/// UTF-16BE and preferred; Macintosh records (platform 1) are single-byte and
+/// used as a fallback for fonts that omit the Windows entry.
+fn parseNameTable(table: []const u8, out: []u8) ?[]const u8 {
+    if (table.len < 6) return null;
+    const be16 = struct {
+        fn f(b: []const u8, off: usize) u16 {
+            return (@as(u16, b[off]) << 8) | b[off + 1];
+        }
+    }.f;
+
+    const count = be16(table, 2);
+    const string_offset = be16(table, 4);
+
+    var best_mac: ?[]const u8 = null;
+    for (0..count) |i| {
+        const rec = 6 + i * 12;
+        if (rec + 12 > table.len) break;
+
+        const platform = be16(table, rec + 0);
+        const encoding = be16(table, rec + 2);
+        const name_id = be16(table, rec + 6);
+        const length = be16(table, rec + 8);
+        const offset = be16(table, rec + 10);
+        if (name_id != 1) continue; // family name
+
+        const start = @as(usize, string_offset) + offset;
+        if (start + length > table.len) continue;
+        const raw = table[start .. start + length];
+
+        if (platform == 3 and encoding == 1) {
+            // UTF-16BE. Decode only the ASCII subset, which is all a family
+            // name comparison needs and avoids pulling in a full decoder.
+            var n: usize = 0;
+            var j: usize = 0;
+            while (j + 1 < raw.len and n < out.len) : (j += 2) {
+                const cp = (@as(u16, raw[j]) << 8) | raw[j + 1];
+                if (cp == 0 or cp > 0x7F) continue;
+                out[n] = @intCast(cp);
+                n += 1;
+            }
+            if (n > 0) return out[0..n];
+        } else if (platform == 1 and best_mac == null) {
+            const n = @min(raw.len, out.len);
+            @memcpy(out[0..n], raw[0..n]);
+            best_mac = out[0..n];
+        }
+    }
+    return best_mac;
+}
+
+pub fn setSize(self: *Face, opts: font.face.Options) !void {
+    self.size = opts.size;
+}
+
+pub fn setVariations(
+    self: *Face,
+    vs: []const font.face.Variation,
+    opts: font.face.Options,
+) !void {
+    _ = vs;
+    _ = opts;
+    // Variable font axes need IDWriteFontFace5::GetFontResource and a
+    // variation-aware face. Not wired yet; a variable font renders at its
+    // default instance rather than failing.
+    _ = self;
+}
+
+pub fn syntheticBold(self: *const Face, opts: font.face.Options) !Face {
+    var f = self.*;
+    f.size = opts.size;
+    f.synthetic.bold = true;
+    // Both the COM face and the HarfBuzz font are refcounted and shared with
+    // the copy; without these the copy's deinit would free them out from
+    // under the original.
+    _ = self.face.vtable.AddRef(self.face);
+    _ = harfbuzz.c.hb_font_reference(self.hb_font.handle);
+    f.file = null; // the copy does not own the file reference
+    return f;
+}
+
+pub fn syntheticItalic(self: *const Face, opts: font.face.Options) !Face {
+    var f = self.*;
+    f.size = opts.size;
+    f.synthetic.italic = true;
+    _ = self.face.vtable.AddRef(self.face);
+    _ = harfbuzz.c.hb_font_reference(self.hb_font.handle);
+    f.file = null;
+    return f;
+}
+
+pub fn copyTable(
+    self: Face,
+    alloc: Allocator,
+    table_tag: *const [4]u8,
+) Allocator.Error!?[]u8 {
+    var data: ?*const anyopaque = null;
+    var size: u32 = 0;
+    var ctx: ?*anyopaque = null;
+    var exists: i32 = 0;
+
+    const t = (@as(u32, table_tag[0])) |
+        (@as(u32, table_tag[1]) << 8) |
+        (@as(u32, table_tag[2]) << 16) |
+        (@as(u32, table_tag[3]) << 24);
+
+    if (dw.FAILED(self.face.TryGetFontTable(t, &data, &size, &ctx, &exists)) or
+        exists == 0 or data == null) return null;
+    defer self.face.ReleaseFontTable(ctx);
+
+    const src: [*]const u8 = @ptrCast(data.?);
+    const buf = try alloc.alloc(u8, size);
+    @memcpy(buf, src[0..size]);
+    return buf;
+}
+
+/// Metrics describing the grid this face implies.
+///
+/// DirectWrite reports these in design units; dividing by `designUnitsPerEm`
+/// and multiplying by the pixel size converts to pixels. `cell_width` comes
+/// from measuring ASCII rather than trusting a single advance, matching what
+/// the other backends do for proportional-ish monospace fonts.
+/// sxHeight and sCapHeight straight out of the OS/2 table.
+///
+/// DWRITE_FONT_METRICS carries xHeight/capHeight too, but DirectWrite
+/// *synthesizes* them when the font does not define them: a symbols-only Nerd
+/// Font reports exactly 0.5em and ~0.7em, which look like real metrics and are
+/// not. ghostty relies on these being null for such fonts so that size
+/// adjustment falls through to matching line height instead, so the table has
+/// to be read directly. Only version 2 and later define these fields.
+fn os2Heights(face: *dw.IDWriteFontFace) ?struct { cap: i16, ex: i16 } {
+    var data: ?*const anyopaque = null;
+    var size: u32 = 0;
+    var ctx: ?*anyopaque = null;
+    var exists: i32 = 0;
+    if (dw.FAILED(face.TryGetFontTable(dw.tag("OS/2"), &data, &size, &ctx, &exists)) or
+        exists == 0 or data == null) return null;
+    defer face.ReleaseFontTable(ctx);
+
+    // sxHeight is at 86 and sCapHeight at 88, so the table must reach 90.
+    if (size < 90) return null;
+    const bytes: [*]const u8 = @ptrCast(data.?);
+    if (std.mem.readInt(u16, bytes[0..2], .big) < 2) return null;
+    return .{
+        .ex = std.mem.readInt(i16, bytes[86..88], .big),
+        .cap = std.mem.readInt(i16, bytes[88..90], .big),
+    };
+}
+
+/// Ink height of one character in design units, or null when the face has no
+/// glyph for it. The fallback the FreeType backend uses when OS/2 is too old.
+fn inkHeight(self: *Face, cp: u32) ?f64 {
+    const gid = self.glyphIndex(cp) orelse return null;
+    var indices = [_]u16{@intCast(gid)};
+    var gm: [1]dw.DWRITE_GLYPH_METRICS = undefined;
+    if (dw.FAILED(self.face.GetDesignGlyphMetrics(&indices, &gm))) return null;
+    const h = @as(i64, self.design.ascent) + self.design.descent -
+        gm[0].topSideBearing - gm[0].bottomSideBearing;
+    if (h <= 0) return null;
+    return @floatFromInt(h);
+}
+
+pub fn getMetrics(self: *Face) Metrics.FaceMetrics {
+    const px_per_em = self.pixelSize();
+    const upem: f64 = @floatFromInt(self.design.designUnitsPerEm);
+    const scale = @as(f64, px_per_em) / upem;
+
+    // Widest printable ASCII advance. A monospace font gives the same value
+    // for all of them, but measuring is correct either way.
+    var cell_width: f64 = 0;
+    {
+        var cps: [95]u32 = undefined;
+        for (&cps, 0..) |*c, i| c.* = @intCast(0x20 + i);
+        var indices: [95]u16 = undefined;
+        if (dw.SUCCEEDED(self.face.GetGlyphIndices(&cps, &indices))) {
+            var gm: [95]dw.DWRITE_GLYPH_METRICS = undefined;
+            if (dw.SUCCEEDED(self.face.GetDesignGlyphMetrics(&indices, &gm))) {
+                for (gm) |g| {
+                    const adv: f64 = @floatFromInt(g.advanceWidth);
+                    cell_width = @max(cell_width, adv * scale);
+                }
+            }
+        }
+    }
+
+    // Both null for a font that defines neither and has no 'H'/'x' - which is
+    // the signal ghostty needs in order to harmonize such a face by line height.
+    const cap_height: ?f64, const ex_height: ?f64 = heights: {
+        if (os2Heights(self.face)) |h| break :heights .{
+            @as(f64, @floatFromInt(h.cap)) * scale,
+            @as(f64, @floatFromInt(h.ex)) * scale,
+        };
+        break :heights .{
+            if (self.inkHeight('H')) |v| v * scale else null,
+            if (self.inkHeight('x')) |v| v * scale else null,
+        };
+    };
+
+    // Width of the CJK water ideograph, for the ic_width adjustment.
+    const ic_width: ?f64 = icw: {
+        const gid = self.glyphIndex('水') orelse break :icw null;
+        var indices = [_]u16{@intCast(gid)};
+        var gm: [1]dw.DWRITE_GLYPH_METRICS = undefined;
+        if (dw.FAILED(self.face.GetDesignGlyphMetrics(&indices, &gm))) break :icw null;
+        break :icw @as(f64, @floatFromInt(gm[0].advanceWidth)) * scale;
+    };
+
+    return .{
+        .px_per_em = px_per_em,
+        .cell_width = cell_width,
+        .ic_width = ic_width,
+        .ascent = @as(f64, @floatFromInt(self.design.ascent)) * scale,
+        // FaceMetrics wants +Y=up, so descent is negative.
+        .descent = -@as(f64, @floatFromInt(self.design.descent)) * scale,
+        .line_gap = @as(f64, @floatFromInt(self.design.lineGap)) * scale,
+        .underline_position = @as(f64, @floatFromInt(self.design.underlinePosition)) * scale,
+        .underline_thickness = @as(f64, @floatFromInt(self.design.underlineThickness)) * scale,
+        .strikethrough_position = @as(f64, @floatFromInt(self.design.strikethroughPosition)) * scale,
+        .strikethrough_thickness = @as(f64, @floatFromInt(self.design.strikethroughThickness)) * scale,
+        .cap_height = cap_height,
+        .ex_height = ex_height,
+    };
+}
+
+/// Rasterize a glyph into the atlas and return its placement.
+///
+/// One D2D path serves both monochrome and colour glyphs:
+/// `TranslateColorGlyphRun` returning `DWRITE_E_NOCOLOR` *is* the "this glyph
+/// is monochrome" answer, so there is no separate rasterizer and no rule for
+/// choosing between them. AtlasEngine works the same way, and it forces
+/// grayscale AA for colour glyphs, which we mirror.
+pub fn renderGlyph(
+    self: Face,
+    alloc: Allocator,
+    atlas: *font.Atlas,
+    glyph_index: u32,
+    opts: font.Glyph.RenderOptions,
+) !Glyph {
+    _ = opts;
+
+    self.lib.mutex.lockUncancelable(global.io());
+    defer self.lib.mutex.unlock(global.io());
+
+    const px_per_em = self.pixelSize();
+    const upem: f32 = @floatFromInt(self.design.designUnitsPerEm);
+    const scale = px_per_em / upem;
+
+    var indices = [_]u16{@intCast(glyph_index)};
+    var gm: [1]dw.DWRITE_GLYPH_METRICS = undefined;
+    if (dw.FAILED(self.face.GetDesignGlyphMetrics(&indices, &gm))) {
+        return Error.CannotRenderGlyph;
+    }
+
+    // Ink box in design units. topSideBearing is measured down from the
+    // ascent, and bottomSideBearing up from the descent, so the ink height is
+    // what remains between them.
+    const m = &gm[0];
+    const ink_w_du = @as(i64, m.advanceWidth) - m.leftSideBearing - m.rightSideBearing;
+    const ink_h_du = @as(i64, self.design.ascent) + self.design.descent -
+        m.topSideBearing - m.bottomSideBearing;
+
+    // Whitespace and other empty glyphs are legitimate; reserve nothing.
+    if (ink_w_du <= 0 or ink_h_du <= 0) {
+        return .{ .width = 0, .height = 0, .offset_x = 0, .offset_y = 0, .atlas_x = 0, .atlas_y = 0 };
+    }
+
+    // A pixel of slack on each side so antialiased edges are not clipped.
+    const pad: u32 = 2;
+    const w: u32 = @as(u32, @intFromFloat(@ceil(@as(f32, @floatFromInt(ink_w_du)) * scale))) + pad * 2;
+    const h: u32 = @as(u32, @intFromFloat(@ceil(@as(f32, @floatFromInt(ink_h_du)) * scale))) + pad * 2;
+
+    // Where the baseline sits inside the bitmap, and where the ink starts.
+    const left_px = @as(f32, @floatFromInt(m.leftSideBearing)) * scale;
+    const top_px = @as(f32, @floatFromInt(m.topSideBearing)) * scale;
+    const ascent_px = @as(f32, @floatFromInt(self.design.ascent)) * scale;
+    const origin_x = pad_f(pad) - left_px;
+    const origin_y = pad_f(pad) + (ascent_px - top_px);
+
+    // --- WIC bitmap + D2D target ---
+    var bmp: ?*d2d.IWICBitmap = null;
+    if (dw.FAILED(self.lib.wic_factory.CreateBitmap(
+        w,
+        h,
+        &d2d.GUID_WICPixelFormat32bppPBGRA,
+        .CacheOnLoad,
+        &bmp,
+    )) or bmp == null) return Error.CannotRenderGlyph;
+    defer _ = bmp.?.Release();
+
+    const props: d2d.D2D1_RENDER_TARGET_PROPERTIES = .{
+        .type = .SOFTWARE, // WIC targets must be software
+        .pixelFormat = .{
+            .format = d2d.DXGI_FORMAT_B8G8R8A8_UNORM,
+            .alphaMode = .PREMULTIPLIED,
+        },
+        .dpiX = 96,
+        .dpiY = 96,
+        .usage = 0,
+        .minLevel = .DEFAULT,
+    };
+    var rt: ?*d2d.ID2D1RenderTarget = null;
+    if (dw.FAILED(self.lib.d2d_factory.CreateWicBitmapRenderTarget(
+        @ptrCast(bmp.?),
+        &props,
+        &rt,
+    )) or rt == null) return Error.CannotRenderGlyph;
+    defer _ = rt.?.Release();
+
+    const white: d2d.D2D1_COLOR_F = .{ .r = 1, .g = 1, .b = 1, .a = 1 };
+    var brush: ?*d2d.ID2D1SolidColorBrush = null;
+    if (dw.FAILED(rt.?.CreateSolidColorBrush(&white, &brush)) or brush == null) {
+        return Error.CannotRenderGlyph;
+    }
+    defer _ = brush.?.Release();
+
+    const run: dw.DWRITE_GLYPH_RUN = .{
+        .fontFace = self.face,
+        .fontEmSize = px_per_em,
+        .glyphCount = 1,
+        .glyphIndices = &indices,
+        .glyphAdvances = null,
+        .glyphOffsets = null,
+        .isSideways = 0,
+        .bidiLevel = 0,
+    };
+
+    // Colour layers, if this glyph has any. Requesting only the colour formats
+    // means NOCOLOR is the "draw it as ordinary text" answer.
+    var enumerator: ?*dw.IDWriteColorGlyphRunEnumerator1 = null;
+    var is_color = false;
+    if (self.color) {
+        const hr = self.lib.factory4.TranslateColorGlyphRun(
+            .{ .x = origin_x, .y = origin_y },
+            &run,
+            dw.GLYPH_IMAGE_COLOR,
+            &enumerator,
+        );
+        is_color = hr != dw.DWRITE_E_NOCOLOR and dw.SUCCEEDED(hr) and enumerator != null;
+    }
+    defer if (enumerator) |e| {
+        _ = e.Release();
+    };
+
+    // Colour bitmap (CBDT/sbix) and SVG runs can only be drawn through
+    // ID2D1DeviceContext4. A WIC bitmap render target supports it, so this is a
+    // QueryInterface rather than a second device. Only needed for colour.
+    var dc4: ?*d2d.ID2D1DeviceContext4 = null;
+    defer if (dc4) |c| {
+        _ = c.Release();
+    };
+    if (is_color) {
+        var dc4_o: ?*anyopaque = null;
+        if (dw.FAILED(rt.?.QueryInterface(&d2d.ID2D1DeviceContext4.IID, &dc4_o)) or
+            dc4_o == null) return Error.CannotRenderGlyph;
+        dc4 = @ptrCast(@alignCast(dc4_o.?));
+        // D2D measures in DIPs by default. At 96 dpi that already equals
+        // pixels, but the glyph geometry above is all in pixels, so say so.
+        dc4.?.SetUnitMode(.PIXELS);
+    }
+
+    rt.?.SetTextAntialiasMode(.GRAYSCALE);
+    rt.?.BeginDraw();
+    const clear: d2d.D2D1_COLOR_F = .{ .r = 0, .g = 0, .b = 0, .a = 0 };
+    rt.?.Clear(&clear);
+
+    if (is_color) {
+        while (true) {
+            var has: i32 = 0;
+            if (dw.FAILED(enumerator.?.MoveNext(&has)) or has == 0) break;
+            var cr: ?*const dw.DWRITE_COLOR_GLYPH_RUN1 = null;
+            if (dw.FAILED(enumerator.?.GetCurrentRun(&cr)) or cr == null) break;
+
+            const origin: d2d.D2D1_POINT_2F = .{
+                .x = cr.?.baselineOriginX,
+                .y = cr.?.baselineOriginY,
+            };
+
+            // TranslateColorGlyphRun has already split the run so that exactly
+            // one format bit is set. Each format has its own draw call, and
+            // using the wrong one draws nothing at all rather than failing.
+            if (cr.?.glyphImageFormat & dw.GLYPH_IMAGE_BITMAP != 0) {
+                // CBDT/sbix: an embedded PNG/JPEG/TIFF bitmap. This is the path
+                // Noto Color Emoji takes.
+                dc4.?.DrawColorBitmapGlyphRun(
+                    cr.?.glyphImageFormat,
+                    origin,
+                    &cr.?.glyphRun,
+                    cr.?.measuringMode,
+                );
+            } else if (cr.?.glyphImageFormat & dw.GLYPH_IMAGE_SVG != 0) {
+                dc4.?.DrawSvgGlyphRun(origin, &cr.?.glyphRun, brush.?, cr.?.measuringMode);
+            } else {
+                // COLR layers, as in Segoe UI Emoji. A palette index of 0xFFFF
+                // means this layer takes the text colour rather than a palette
+                // colour: we rasterize those white so the shader can tint them,
+                // while palette layers keep their own colour.
+                const col: d2d.D2D1_COLOR_F = if (cr.?.paletteIndex == dw.DWRITE_NO_PALETTE_INDEX)
+                    white
+                else
+                    .{
+                        .r = cr.?.runColor.r,
+                        .g = cr.?.runColor.g,
+                        .b = cr.?.runColor.b,
+                        .a = cr.?.runColor.a,
+                    };
+                brush.?.SetColor(&col);
+                rt.?.DrawGlyphRun(origin, &cr.?.glyphRun, brush.?);
+            }
+        }
+    } else {
+        rt.?.DrawGlyphRun(.{ .x = origin_x, .y = origin_y }, &run, brush.?);
+    }
+
+    if (dw.FAILED(rt.?.EndDraw())) return Error.CannotRenderGlyph;
+
+    // --- read back into the atlas ---
+    var lock: ?*d2d.IWICBitmapLock = null;
+    const rect: d2d.WICRect = .{ .X = 0, .Y = 0, .Width = @intCast(w), .Height = @intCast(h) };
+    if (dw.FAILED(bmp.?.Lock(&rect, d2d.WICBitmapLockRead, &lock)) or lock == null) {
+        return Error.CannotRenderGlyph;
+    }
+    defer _ = lock.?.Release();
+
+    var stride: u32 = 0;
+    _ = lock.?.GetStride(&stride);
+    var buf_size: u32 = 0;
+    var data: ?[*]u8 = null;
+    if (dw.FAILED(lock.?.GetDataPointer(&buf_size, &data)) or data == null) {
+        return Error.CannotRenderGlyph;
+    }
+
+    const region = try atlas.reserve(alloc, w, h);
+
+    switch (atlas.format) {
+        // Grayscale atlas: alpha is coverage, since we drew with a white brush.
+        .grayscale => {
+            const tmp = try alloc.alloc(u8, w * h);
+            defer alloc.free(tmp);
+            for (0..h) |y| {
+                for (0..w) |x| {
+                    tmp[y * w + x] = data.?[y * stride + x * 4 + 3];
+                }
+            }
+            atlas.set(region, tmp);
+        },
+
+        // Colour atlas: BGRA, already premultiplied by D2D, which is what the
+        // shader expects.
+        .bgra => {
+            const tmp = try alloc.alloc(u8, w * h * 4);
+            defer alloc.free(tmp);
+            for (0..h) |y| {
+                const src = data.?[y * stride ..][0 .. w * 4];
+                @memcpy(tmp[y * w * 4 ..][0 .. w * 4], src);
+            }
+            atlas.set(region, tmp);
+        },
+
+        else => return Error.CannotRenderGlyph,
+    }
+
+    return .{
+        .width = w,
+        .height = h,
+        // offset_x is the left bearing; offset_y is measured from the baseline
+        // up to the top of the ink box, which is where the padding lives too.
+        .offset_x = @intFromFloat(@floor(left_px) - pad_f(pad)),
+        .offset_y = @intFromFloat(@ceil(ascent_px - top_px + pad_f(pad))),
+        .atlas_x = region.x,
+        .atlas_y = region.y,
+    };
+}
+
+inline fn pad_f(p: u32) f32 {
+    return @floatFromInt(p);
+}
+
+test {
+    // Referenced so the bindings' own vtable-layout tests run.
+    _ = dw;
+    _ = d2d;
+}
+
+test "undefined ex/cap heights stay null" {
+    // DirectWrite synthesizes xHeight/capHeight for fonts that define neither.
+    // ghostty needs null here, otherwise size adjustment harmonizes against a
+    // made-up metric instead of falling through to line height.
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var lib = try Library.init(alloc);
+    defer lib.deinit();
+
+    const opts: font.face.Options = .{ .size = .{ .points = 12, .xdpi = 96, .ydpi = 96 } };
+
+    var text = try Face.init(lib, font.embedded.inconsolata, opts);
+    defer text.deinit();
+    const tm = text.getMetrics();
+    try testing.expect(tm.ex_height != null);
+    try testing.expect(tm.cap_height != null);
+
+    // The symbols font carries an OS/2 v2 table whose sxHeight/sCapHeight are
+    // zero. The FreeType backend passes that zero through too, and ghostty's
+    // Metrics.exHeight/capHeight accessors treat "not > 0" as undefined - so
+    // null and zero are equally valid answers here. What must not happen is a
+    // plausible positive number, which is what DWRITE_FONT_METRICS reports
+    // (exactly 0.5em) and what made size adjustment harmonize against a
+    // fabricated metric.
+    var symbols = try Face.init(lib, font.embedded.symbols_nerd_font, opts);
+    defer symbols.deinit();
