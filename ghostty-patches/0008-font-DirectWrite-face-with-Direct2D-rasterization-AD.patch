+    try testing.expect(sm.cap_height == null or sm.cap_height.? <= 0);
+}
+
+test "render ascii" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const testFont = font.embedded.inconsolata;
+
+    var lib = try Library.init(alloc);
+    defer lib.deinit();
+
+    var atlas = try font.Atlas.init(alloc, 512, .grayscale);
+    defer atlas.deinit(alloc);
+
+    var face = try Face.init(
+        lib,
+        testFont,
+        .{ .size = .{ .points = 12, .xdpi = 96, .ydpi = 96 } },
+    );
+    defer face.deinit();
+
+    var i: u8 = 32;
+    while (i < 127) : (i += 1) {
+        _ = try face.renderGlyph(
+            alloc,
+            &atlas,
+            face.glyphIndex(i).?,
+            .{ .grid_metrics = font.Metrics.calc(face.getMetrics()) },
+        );
+    }
+
+    // Doubling the point size should grow the rasterized glyph. The exact
+    // pixel heights are deliberately not asserted: those are properties of
+    // the rasterizer, and pinning FreeType's numbers here would encode an
+    // expectation DirectWrite has no reason to meet.
+    {
+        const g1 = try face.renderGlyph(
+            alloc,
+            &atlas,
+            face.glyphIndex('A').?,
+            .{ .grid_metrics = font.Metrics.calc(face.getMetrics()) },
+        );
+
+        try face.setSize(.{ .size = .{ .points = 24, .xdpi = 96, .ydpi = 96 } });
+        const g2 = try face.renderGlyph(
+            alloc,
+            &atlas,
+            face.glyphIndex('A').?,
+            .{ .grid_metrics = font.Metrics.calc(face.getMetrics()) },
+        );
+
+        try testing.expect(g1.height > 0);
+        try testing.expect(g2.height > g1.height);
+    }
+}
+
+test "render produces non-blank coverage" {
+    // renderGlyph returning a plausible-looking Glyph is not evidence that
+    // anything was drawn: a D2D target that silently fails to draw yields
+    // correct metrics over an empty bitmap. Check the atlas actually has ink.
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var lib = try Library.init(alloc);
+    defer lib.deinit();
+
+    var atlas = try font.Atlas.init(alloc, 512, .grayscale);
+    defer atlas.deinit(alloc);
+
+    var face = try Face.init(
+        lib,
+        font.embedded.inconsolata,
+        .{ .size = .{ .points = 24, .xdpi = 96, .ydpi = 96 } },
+    );
+    defer face.deinit();
+
+    const g = try face.renderGlyph(
+        alloc,
+        &atlas,
+        face.glyphIndex('M').?,
+        .{ .grid_metrics = font.Metrics.calc(face.getMetrics()) },
+    );
+
+    var ink: usize = 0;
+    var y: u32 = 0;
+    while (y < g.height) : (y += 1) {
+        var x: u32 = 0;
+        while (x < g.width) : (x += 1) {
+            if (atlas.data[(g.atlas_y + y) * atlas.size + (g.atlas_x + x)] != 0) {
+                ink += 1;
+            }
+        }
+    }
+    try testing.expect(ink > 0);
+}
+
+test "color emoji" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var lib = try Library.init(alloc);
+    defer lib.deinit();
+
+    var atlas = try font.Atlas.init(alloc, 512, .bgra);
+    defer atlas.deinit(alloc);
+
+    var face = try Face.init(
+        lib,
+        font.embedded.emoji,
+        .{ .size = .{ .points = 12, .xdpi = 96, .ydpi = 96 } },
+    );
+    defer face.deinit();
+
+    const glyph_id = face.glyphIndex('🥸').?;
+    const g = try face.renderGlyph(
+        alloc,
+        &atlas,
+        glyph_id,
+        .{ .grid_metrics = font.Metrics.calc(face.getMetrics()) },
+    );
+
+    try testing.expect(face.hasColor());
+    try testing.expect(face.isColorGlyph(glyph_id));
+
+    // Two distinct failures to rule out. Fully transparent means the colour
+    // path ran and composited nothing. Opaque but grey means we fell back to
+    // rasterizing the outline, which for a CBDT font is blank or a blob - so
+    // "it drew something" is not enough, the pixels have to actually be
+    // coloured. Noto Color Emoji is CBDT, so this only passes via
+    // DrawColorBitmapGlyphRun.
+    var opaque_px: usize = 0;
+    var chromatic_px: usize = 0;
+    var y: u32 = 0;
+    while (y < g.height) : (y += 1) {
+        var x: u32 = 0;
+        while (x < g.width) : (x += 1) {
+            const i = ((g.atlas_y + y) * atlas.size + (g.atlas_x + x)) * 4;
+            if (atlas.data[i + 3] == 0) continue;
+            opaque_px += 1;
+            const b = atlas.data[i];
+            const gr = atlas.data[i + 1];
+            const r = atlas.data[i + 2];
+            const hi = @max(r, @max(gr, b));
+            const lo = @min(r, @min(gr, b));
+            if (hi - lo > 24) chromatic_px += 1;
+        }
+    }
+    try testing.expect(opaque_px > 0);
+    try testing.expect(chromatic_px > 0);
+}
