+
+/// Process-wide DirectWrite/Direct2D/WIC state (ADR 0005).
+///
+/// These really are per-process rather than per-face: the DirectWrite factory
+/// is created SHARED so DirectWrite caches font data across every face, and
+/// the in-memory font file loader has to be registered with that factory
+/// exactly once. Creating them per face would defeat DirectWrite's caching and
+/// leak loader registrations.
+pub const DirectWriteLibrary = struct {
+    const dw = @import("face/dwrite/api.zig");
+    const d2d = @import("face/dwrite/d2d.zig");
+
+    /// Base factory: discovery, font faces, glyph run analysis.
+    factory: *dw.IDWriteFactory,
+    /// System font fallback (GetSystemFontFallback), used by discovery.
+    factory2: *dw.IDWriteFactory2,
+    /// Colour glyph translation. Factory4 rather than Factory2 because only
+    /// this version splits runs into CBDT/sbix/SVG formats as well as COLR;
+    /// Factory2 reports NOCOLOR for a bitmap emoji font like Noto Color Emoji.
+    factory4: *dw.IDWriteFactory4,
+    /// Owns the in-memory font file loader.
+    factory5: *dw.IDWriteFactory5,
+    /// Registered with `factory`; turns font bytes into a font file reference.
+    in_memory_loader: *dw.IDWriteInMemoryFontFileLoader,
+
+    /// Rasterization: D2D renders glyph runs into a WIC bitmap we read back.
+    d2d_factory: *d2d.ID2D1Factory,
+    wic_factory: *d2d.IWICImagingFactory,
+
+    alloc: Allocator,
+
+    /// Held whenever a face is created or a glyph rasterized. The DirectWrite
+    /// SHARED factory is documented thread-safe, but the D2D factory is
+    /// created SINGLE_THREADED and the render targets built from it are not,
+    /// so rasterization is serialized.
+    mutex: *std.Io.Mutex,
+
+    pub const InitError = error{
+        DirectWriteUnavailable,
+        Direct2DUnavailable,
+        WICUnavailable,
+    } || Allocator.Error;
+
+    pub fn init(alloc: Allocator) InitError!Library {
+        // WIC is a COM object, so the calling thread needs an apartment. This
+        // is idempotent and safe if the host already initialized COM; a
+        // failure here is not fatal because the host may have chosen a
+        // different apartment model, which is fine for our usage.
+        _ = d2d.CoInitializeEx(null, d2d.COINIT_MULTITHREADED);
+
+        var factory_o: ?*anyopaque = null;
+        if (dw.FAILED(dw.DWriteCreateFactory(
+            .SHARED,
+            &dw.IDWriteFactory.IID,
+            &factory_o,
+        )) or factory_o == null) return error.DirectWriteUnavailable;
+        const factory: *dw.IDWriteFactory = @ptrCast(@alignCast(factory_o.?));
+        errdefer _ = factory.Release();
+
+        var f2_o: ?*anyopaque = null;
+        if (dw.FAILED(factory.QueryInterface(&dw.IDWriteFactory2.IID, &f2_o)) or
+            f2_o == null) return error.DirectWriteUnavailable;
+        const factory2: *dw.IDWriteFactory2 = @ptrCast(@alignCast(f2_o.?));
+        errdefer _ = factory2.Release();
+
+        var f4_o: ?*anyopaque = null;
+        if (dw.FAILED(factory.QueryInterface(&dw.IDWriteFactory4.IID, &f4_o)) or
+            f4_o == null) return error.DirectWriteUnavailable;
+        const factory4: *dw.IDWriteFactory4 = @ptrCast(@alignCast(f4_o.?));
+        errdefer _ = factory4.Release();
+
+        var f5_o: ?*anyopaque = null;
+        if (dw.FAILED(factory.QueryInterface(&dw.IDWriteFactory5.IID, &f5_o)) or
+            f5_o == null) return error.DirectWriteUnavailable;
+        const factory5: *dw.IDWriteFactory5 = @ptrCast(@alignCast(f5_o.?));
+        errdefer _ = factory5.Release();
+
+        var loader: ?*dw.IDWriteInMemoryFontFileLoader = null;
+        if (dw.FAILED(factory5.CreateInMemoryFontFileLoader(&loader)) or
+            loader == null) return error.DirectWriteUnavailable;
+        errdefer _ = loader.?.Release();
+
+        // A loader must be registered before any file reference it produces
+        // can become a font face.
+        if (dw.FAILED(factory.RegisterFontFileLoader(@ptrCast(loader.?)))) {
+            return error.DirectWriteUnavailable;
+        }
+        errdefer _ = factory.UnregisterFontFileLoader(@ptrCast(loader.?));
+
+        var d2d_o: ?*anyopaque = null;
+        if (dw.FAILED(d2d.D2D1CreateFactory(
+            .SINGLE_THREADED,
+            &d2d.ID2D1Factory.IID,
+            null,
+            &d2d_o,
+        )) or d2d_o == null) return error.Direct2DUnavailable;
+        const d2d_factory: *d2d.ID2D1Factory = @ptrCast(@alignCast(d2d_o.?));
+        errdefer _ = d2d_factory.Release();
+
+        var wic_o: ?*anyopaque = null;
+        if (dw.FAILED(d2d.CoCreateInstance(
+            &d2d.CLSID_WICImagingFactory,
+            null,
+            d2d.CLSCTX_INPROC_SERVER,
+            &d2d.IID_IWICImagingFactory,
+            &wic_o,
+        )) or wic_o == null) return error.WICUnavailable;
+        const wic_factory: *d2d.IWICImagingFactory = @ptrCast(@alignCast(wic_o.?));
+        errdefer _ = wic_factory.Release();
+
+        const mutex = try alloc.create(std.Io.Mutex);
+        mutex.* = .init;
+
+        return Library{
+            .factory = factory,
+            .factory2 = factory2,
+            .factory4 = factory4,
+            .factory5 = factory5,
+            .in_memory_loader = loader.?,
+            .d2d_factory = d2d_factory,
+            .wic_factory = wic_factory,
+            .alloc = alloc,
+            .mutex = mutex,
+        };
+    }
+
+    pub fn deinit(self: *Library) void {
+        self.alloc.destroy(self.mutex);
+        _ = self.wic_factory.Release();
+        _ = self.d2d_factory.Release();
+        _ = self.factory.UnregisterFontFileLoader(@ptrCast(self.in_memory_loader));
+        _ = self.in_memory_loader.Release();
+        _ = self.factory5.Release();
+        _ = self.factory4.Release();
+        _ = self.factory2.Release();
+        _ = self.factory.Release();
+    }
+};
