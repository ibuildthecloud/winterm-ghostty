             inline for (@typeInfo(PipelineCollection).@"struct".fields) |f| {
@@ -149,14 +166,19 @@ pub const Shaders = struct {
         pipelines.bg_color = try .init(device, bg_color_vs, bg_color_ps, blend);
         pipelines.cell_bg = try .init(device, cell_bg_vs, cell_bg_ps, blend);
         pipelines.cell_text = try .init(device, cell_text_vs, cell_text_ps, blend);
+        pipelines.image = try .init(device, image_vs, image_ps, blend);
+        // The image step passes a texture but no sampler, so the pipeline
+        // carries one.
