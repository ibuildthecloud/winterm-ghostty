--- a/src/renderer/directx11/RenderPass.zig
+++ b/src/renderer/directx11/RenderPass.zig
@@ -197,6 +197,12 @@ pub fn step(self: *Self, s: Step) void {
             if (maybe) |sm| samplers[i] = sm.sampler;
         }
         ctx.PSSetSamplers(0, samplers[0..@min(s.samplers.len, samplers.len)]);
+    } else if (s.pipeline.sampler) |sm| {
+        // The image step supplies a texture but no sampler; the pipeline
+        // carries one so the shader does not sample through a null and read
